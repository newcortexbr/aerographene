+      {prefs::kHeliumLayout, prefs::kVerticalCollapseShortcut},
+      base::BindRepeating(&BrowserCommandController::UpdateSaveAsState,
+                          base::Unretained(this)));
 #if BUILDFLAG(ENABLE_PRINTING)
   profile_pref_registrar_.Add(
