+bool ShouldToggleVerticalCollapse(PrefService* prefs) {
+  return prefs->GetBoolean(prefs::kVerticalCollapseShortcut) &&
+         prefs->GetInteger(prefs::kHeliumLayout) ==
+             std::to_underlying(HeliumLayoutType::kVertical);
+}
