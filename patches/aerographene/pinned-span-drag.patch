+views::View* PinnedTabContainerView::GetSpanResizeChildAt(
+    const gfx::Point& loc_in_container) const {
+  if (!collection_node_ ||
+      collection_node_->orientation() != TabStripOrientation::kVertical ||
+      GetTabStripCollapseState() !=
+          tabs::VerticalTabStripCollapseState::kExpanded ||
+      IsDragging()) {
+    return nullptr;
+  }
+  const int logical_x = GetMirroredXInView(loc_in_container.x());
+  for (const auto& child_node : collection_node_->children()) {
+    views::View* view = child_node->view();
+    // Only single tabs resize; a split already spans its own cells.
+    if (!view || !view->GetVisible() || !views::IsViewClass<TabView>(view)) {
+      continue;
+    }
+    const gfx::Rect bounds = view->bounds();
+    if (loc_in_container.y() >= bounds.y() &&
+        loc_in_container.y() < bounds.bottom() &&
+        logical_x >= bounds.right() - kSpanResizeZoneWidth &&
+        logical_x < bounds.right()) {
+      return view;
+    }
+  }
+  return nullptr;
+}
+
+views::View* PinnedTabContainerView::TargetForRect(views::View* root,
+                                                   const gfx::Rect& rect) {
+  // Mouse events only (1x1 rect): inside the resize zone the container itself
+  // is the target so the tab under it neither receives the press nor starts a
+  // tab drag. Everywhere else targeting is the default.
+  if (root == this && rect.size() == gfx::Size(1, 1) &&
+      GetSpanResizeChildAt(rect.origin())) {
+    return root;
+  }
+  return views::ViewTargeterDelegate::TargetForRect(root, rect);
+}
+
+ui::Cursor PinnedTabContainerView::GetCursor(const ui::MouseEvent& event) {
+  if (resizing_handle_ || GetSpanResizeChildAt(event.location())) {
+    return ui::Cursor(ui::mojom::CursorType::kEastWestResize);
+  }
+  return views::View::GetCursor(event);
+}
+
+bool PinnedTabContainerView::OnMousePressed(const ui::MouseEvent& event) {
+  views::View* child = event.IsOnlyLeftMouseButton()
+                           ? GetSpanResizeChildAt(event.location())
+                           : nullptr;
+  if (!child) {
+    return views::View::OnMousePressed(event);
+  }
+  // Freeze the grid geometry for the whole gesture: the span follows the
+  // pointer through these values only, so reflowing the grid while dragging
+  // cannot feed back into the span.
+  const GridMetrics metrics =
+      GetGridMetrics(views::SizeBounds(width(), {}));
+  const int pitch = metrics.cell_width + kTabPadding;
+  const int first_cell = std::clamp(child->bounds().x() / pitch, 0,
+                                    std::max(0, metrics.max_cells - 1));
+  resizing_handle_ = GetCollectionNodeFromView(*child)->GetHandle();
+  resize_origin_x_ = child->bounds().x();
+  resize_pitch_ = pitch;
+  resize_max_span_ = std::max(1, metrics.max_cells - first_cell);
+  return true;
+}
+
+bool PinnedTabContainerView::OnMouseDragged(const ui::MouseEvent& event) {
+  if (!resizing_handle_) {
+    return views::View::OnMouseDragged(event);
+  }
+  if (!collection_node_) {
+    resizing_handle_.reset();
+    return true;
+  }
+  // Snap to the nearest cell boundary: span = round((dx + padding) / pitch).
+  const int dx = std::max(0, GetMirroredXInView(event.x()) - resize_origin_x_);
+  const int span = std::clamp((dx + kTabPadding + resize_pitch_ / 2) /
+                                  resize_pitch_,
+                              1, resize_max_span_);
+  for (const auto& child_node : collection_node_->children()) {
+    if (child_node->GetHandle() == *resizing_handle_) {
+      if (views::View* view = child_node->view();
+          view && GetTabSpan(view) != span) {
+        SetTabSpan(view, span);
+      }
+      return true;
+    }
+  }
+  resizing_handle_.reset();
+  return true;
+}
+
+void PinnedTabContainerView::OnMouseReleased(const ui::MouseEvent& event) {
+  resizing_handle_.reset();
+}
+
+void PinnedTabContainerView::OnMouseCaptureLost() {
+  resizing_handle_.reset();
+}
+
+void PinnedTabContainerView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  views::View::ViewHierarchyChanged(details);
+  if (details.is_add || details.parent != this) {
+    return;
+  }
+  // A child view left the container: drop spans of tabs that are no longer
+  // direct children (closed, unpinned or moved elsewhere).
+  if (!collection_node_) {
+    tab_spans_.clear();
+    return;
+  }
+  for (auto it = tab_spans_.begin(); it != tab_spans_.end();) {
+    const bool present = std::ranges::any_of(
+        collection_node_->children(), [&](const auto& child_node) {
+          return child_node->GetHandle() == it->first;
+        });
+    it = present ? std::next(it) : tab_spans_.erase(it);
+  }
+}
