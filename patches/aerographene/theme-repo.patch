+
+TEST_F(AerographeneThemeRepoTest, NameRules) {
+  EXPECT_TRUE(IsValidThemeName("Meu Tema"));
+  EXPECT_TRUE(IsValidThemeName("açaí"));
+  EXPECT_TRUE(IsValidThemeName(std::string(64, 'a')));
+  EXPECT_FALSE(IsValidThemeName(""));
+  EXPECT_FALSE(IsValidThemeName(std::string(65, 'a')));
+  EXPECT_FALSE(IsValidThemeName("a/b"));
+  EXPECT_FALSE(IsValidThemeName("a\\b"));
+  EXPECT_FALSE(IsValidThemeName("."));
+  EXPECT_FALSE(IsValidThemeName(".."));
+  EXPECT_FALSE(IsValidThemeName(".oculto"));
+  EXPECT_FALSE(IsValidThemeName("a\nb"));
+  EXPECT_FALSE(IsValidThemeName(std::string("a\0b", 3)));
+  EXPECT_FALSE(IsValidThemeName("\xff\xfe"));
+  EXPECT_TRUE(IsValidThemeName("caf\u00e9"));
+  EXPECT_TRUE(IsReservedThemeName("default"));
+  EXPECT_TRUE(IsReservedThemeName("PIXELIZED"));
+  EXPECT_FALSE(IsReservedThemeName("defaults"));
+}
+
+TEST_F(AerographeneThemeRepoTest, ParseDefaults) {
+  ThemeData theme;
+  ASSERT_EQ(ParseThemeJson(kMinimal, &theme), ThemeParseResult::kOk);
+  EXPECT_EQ(theme.name, "Meu Tema");
+  EXPECT_EQ(theme.scheme, ThemeScheme::kDark);
+  EXPECT_EQ(theme.radius, 4);
+  EXPECT_EQ(theme.icons_base, kIconPackDefault);
+  EXPECT_EQ(theme.style, kStyleDefault);
+  EXPECT_TRUE(theme.tokens.empty());
+}
+
+TEST_F(AerographeneThemeRepoTest, ParseFull) {
+  ThemeData theme;
+  ASSERT_EQ(
+      ParseThemeJson(R"({"name":"x","mode":"light","radius":0,
+        "radius_small":2,"font":{"family":"JetBrains Mono","size_px":12},
+        "icons":{"base":"pixelized"},"style":"pixelized",
+        "tokens":{"frame":"#0A0A0A","hover":"#FFFFFF1F"}})",
+                     &theme),
+      ThemeParseResult::kOk);
+  EXPECT_EQ(theme.scheme, ThemeScheme::kLight);
+  EXPECT_EQ(theme.radius, 0);
+  EXPECT_EQ(theme.radius_small, 2);
+  EXPECT_EQ(theme.font_family, "JetBrains Mono");
+  EXPECT_EQ(theme.font_size_px, 12);
+  EXPECT_EQ(theme.icons_base, kIconPackPixelized);
+  EXPECT_EQ(theme.style, kStylePixelized);
+  ASSERT_EQ(theme.tokens.size(), 2u);
+}
+
+TEST_F(AerographeneThemeRepoTest, ParseRejects) {
+  ThemeData theme;
+  EXPECT_EQ(ParseThemeJson("nope", &theme), ThemeParseResult::kInvalidJson);
+  EXPECT_EQ(ParseThemeJson("[]", &theme), ThemeParseResult::kInvalidJson);
+  EXPECT_EQ(ParseThemeJson("{}", &theme), ThemeParseResult::kInvalidName);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"../x"})", &theme),
+            ThemeParseResult::kInvalidName);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"Default"})", &theme),
+            ThemeParseResult::kReservedName);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","icons":{"base":"zzz"}})", &theme),
+            ThemeParseResult::kInvalidField);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","style":"zzz"})", &theme),
+            ThemeParseResult::kInvalidField);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","mode":"sepia"})", &theme),
+            ThemeParseResult::kInvalidField);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","radius":99})", &theme),
+            ThemeParseResult::kInvalidField);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","font":{"family":"A"}})", &theme),
+            ThemeParseResult::kInvalidField);
+  EXPECT_EQ(ParseThemeJson(R"({"name":"x","tokens":{"frame":"red"}})", &theme),
+            ThemeParseResult::kInvalidField);
+}
+
+TEST_F(AerographeneThemeRepoTest, ResolveBuiltinsAndFallback) {
+  EXPECT_EQ(ResolveTheme("pixelized").theme.style, kStylePixelized);
+  EXPECT_EQ(ResolveTheme("Pixelized").pref_value, "pixelized");
+  EXPECT_EQ(ResolveTheme("").pref_value, "default");
+  EXPECT_EQ(ResolveTheme("../etc").pref_value, "default");
+  // Valid name without folder: default now, choice kept in the pref.
+  ResolvedTheme missing = ResolveTheme("sumiu");
+  EXPECT_EQ(missing.theme.name, "default");
+  EXPECT_EQ(missing.pref_value, "sumiu");
+}
+
+TEST_F(AerographeneThemeRepoTest, ResolveFromRepo) {
+  WriteTheme("Meu Tema", kMinimal);
+  EXPECT_EQ(ResolveTheme("Meu Tema").theme.name, "Meu Tema");
+  // Folder name and "name" must agree.
+  WriteTheme("outro", kMinimal);
+  EXPECT_EQ(ResolveTheme("outro").theme.name, "default");
+}
+
+TEST_F(AerographeneThemeRepoTest, NamesNormalizedToNfc) {
+  // "café" with a combining acute accent (NFD) is stored as NFC.
+  ThemeData theme;
+  ASSERT_EQ(ParseThemeJson("{\"name\": \"cafe\u0301\"}", &theme),
+            ThemeParseResult::kOk);
+  EXPECT_EQ(theme.name, "caf\u00e9");
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme("{\"name\": \"caf\u00e9\"}", false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kInstalled);
+  }
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme("{\"name\": \"CAFE\u0301\"}", false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kConflict);
+  }
+}
+
+TEST_F(AerographeneThemeRepoTest, ReadSkipsNonRegularFile) {
+  // A directory named theme.json is not read (fstat S_ISREG).
+  ASSERT_TRUE(base::CreateDirectory(
+      dir_.GetPath().Append("pasta").Append(kThemeFileName)));
+  EXPECT_EQ(ResolveTheme("pasta").theme.name, "default");
+}
+
+TEST_F(AerographeneThemeRepoTest, ListSkipsBroken) {
+  WriteTheme("zeta", R"({"name":"zeta"})");
+  WriteTheme("Alfa", R"({"name":"Alfa"})");
+  WriteTheme("quebrado", "{");
+  WriteTheme("default", R"({"name":"default"})");
+  base::test::TestFuture<std::vector<ThemeInfo>> future;
+  ListThemes(future.GetCallback());
+  const std::vector<ThemeInfo>& themes = future.Get();
+  ASSERT_EQ(themes.size(), 4u);
+  EXPECT_EQ(themes[0].theme.name, "default");
+  EXPECT_TRUE(themes[0].builtin);
+  EXPECT_EQ(themes[1].theme.name, "pixelized");
+  EXPECT_EQ(themes[2].theme.name, "Alfa");
+  EXPECT_EQ(themes[3].theme.name, "zeta");
+  EXPECT_FALSE(themes[3].builtin);
+}
+
+TEST_F(AerographeneThemeRepoTest, InstallConflictAndReplace) {
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme(kMinimal, false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kInstalled);
+    EXPECT_EQ(future.Get<1>(), "Meu Tema");
+  }
+  EXPECT_EQ(ResolveTheme("Meu Tema").theme.name, "Meu Tema");
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme(R"({"name": "meu tema"})", false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kConflict);
+  }
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme(R"({"name": "meu tema", "radius": 0})", true,
+                 future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kInstalled);
+  }
+  EXPECT_EQ(ResolveTheme("meu tema").theme.radius, 0);
+  // Replaced in place: one folder, no staging or backup folder left.
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Meu Tema")));
+  int folders = 0;
+  base::FileEnumerator enumerator(dir_.GetPath(), /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    ++folders;
+  }
+  EXPECT_EQ(folders, 1);
+  // The pref still holds the old case: it follows the renamed folder.
+  ResolvedTheme renamed = ResolveTheme("Meu Tema");
+  EXPECT_EQ(renamed.theme.name, "meu tema");
+  EXPECT_EQ(renamed.pref_value, "meu tema");
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme(R"({"name": "default"})", true, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kReserved);
+  }
+  {
+    base::test::TestFuture<InstallResult, std::string> future;
+    InstallTheme("lixo", true, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), InstallResult::kInvalid);
+  }
+}
