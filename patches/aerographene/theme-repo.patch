+#ifndef CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_REPO_H_
+#define CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_REPO_H_
+
+#include <stddef.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "chrome/browser/themes/aerographene_theme.h"
+
+namespace aerographene {
+
+// Global theme repository: ${XDG_CONFIG_HOME:-~/.config}/aerographene/themes/
+// <name>/theme.json, seen by every profile/space. The folder name is the
+// theme name (pref value); the "name" field of theme.json must equal it.
+inline constexpr char kThemeFileName[] = "theme.json";
+inline constexpr size_t kMaxThemeNameBytes = 64;
+inline constexpr size_t kMaxThemeFileBytes = 64 * 1024;
+
+// Name as folder key: non-empty, valid UTF-8, <= 64 bytes, not starting with
+// '.', no '/', '\\' or control characters. Spaces and accents are allowed.
+// Names are stored and compared in NFC; comparisons also ignore case.
+bool IsValidThemeName(std::string_view name);
+
+// "default" and "pixelized" (case-insensitive) belong to the built-in themes.
+bool IsReservedThemeName(std::string_view name);
+
+enum class ThemeParseResult {
+  kOk,
+  kInvalidJson,   // not JSON, not an object, or larger than the cap
+  kInvalidName,   // "name" missing or not IsValidThemeName
+  kReservedName,  // "name" is default/pixelized
+  kInvalidField,  // a field has the wrong type, range or value
+};
+
+// Validates a theme.json and fills `out` (unchanged unless kOk). Fields:
+//   name (required), mode "dark"|"light" (default "dark"),
+//   radius / radius_small (int 0..32, default 4 / 3),
+//   font {family, size_px 8..32} (optional; family needs size_px),
+//   icons {base "default"|"pixelized"} (default "default"),
+//   style "default"|"pixelized" (compiled drawing variant, default "default"),
+//   tokens {name: "#RRGGBB"|"#RRGGBBAA"} (same names as the dev theme.json).
+// Unknown keys and unknown token names are ignored; a bad color is an error.
+ThemeParseResult ParseThemeJson(std::string_view json, ThemeData* out);
+
+// Repository directory (XDG config, same base as the dev theme.json).
+base::FilePath GetThemeRepoDir();
+// Tests: replaces the repository directory; an empty path restores it.
+void SetThemeRepoDirForTesting(const base::FilePath& dir);
+
+struct ResolvedTheme {
+  ThemeData theme;
+  // Value the pref should hold after resolving: canonical case for built-ins,
+  // "default" for names that can never be valid, the folder's spelling when
+  // only a folder differing in case/normalization exists (a replace renamed
+  // it), else the input unchanged (a valid name whose folder is missing or
+  // broken keeps the user's choice and falls back to "default" only for this
+  // run).
+  std::string pref_value;
+};
+
+// Startup path (UI thread, synchronous): built-ins are memory-only; any other
+// name costs one read of a file capped at kMaxThemeFileBytes.
+ResolvedTheme ResolveTheme(std::string_view pref_value);
+
+struct ThemeInfo {
+  ThemeData theme;
+  bool builtin = false;
+};
+
+// Lists "default", "pixelized", then valid repository themes sorted by name.
+// Scans on a thread-pool task (MayBlock); `callback` runs on the calling
+// sequence. Broken folders are skipped.
+using ListThemesCallback = base::OnceCallback<void(std::vector<ThemeInfo>)>;
+void ListThemes(ListThemesCallback callback);
+
+enum class InstallResult {
+  kInstalled,
+  kInvalid,   // ParseThemeJson failed
+  kReserved,  // name is default/pixelized
+  kConflict,  // same name (case-insensitive) exists and replace == false
+  kIoError,
+};
+
+// Validates `json` and writes it to themes/<name>/theme.json on a
+// thread-pool task: staged in a hidden folder of the same directory and
+// renamed in place. An existing theme with the same name, compared without
+// case, is replaced only if `replace` (moved aside, deleted after the new one
+// is in place, restored on failure); otherwise kConflict (the import dialog
+// asks, then calls again with the same json and replace). `callback` gets the result and the
+// theme name ("" when `json` has no valid name), on the calling sequence.
+using InstallCallback = base::OnceCallback<void(InstallResult, std::string)>;
+void InstallTheme(std::string json, bool replace, InstallCallback callback);
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_REPO_H_
