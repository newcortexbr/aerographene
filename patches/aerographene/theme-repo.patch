+namespace aerographene {
+
+namespace {
+
+constexpr int kMaxRadius = 32;
+constexpr int kMinFontSize = 8;
+constexpr int kMaxFontSize = 32;
+
+base::FilePath& RepoDirOverride() {
+  static base::NoDestructor<base::FilePath> dir;
+  return *dir;
+}
+
+// NFC, so "é" typed composed or decomposed is the same theme name. Input
+// that ICU cannot normalize is returned unchanged.
+std::string NormalizeName(std::string_view name) {
+  UErrorCode status = U_ZERO_ERROR;
+  const icu::Normalizer2* nfc = icu::Normalizer2::getNFCInstance(status);
+  if (U_FAILURE(status)) {
+    return std::string(name);
+  }
+  const icu::UnicodeString src = icu::UnicodeString::fromUTF8(
+      icu::StringPiece(name.data(), static_cast<int32_t>(name.size())));
+  const icu::UnicodeString normalized = nfc->normalize(src, status);
+  if (U_FAILURE(status)) {
+    return std::string(name);
+  }
+  std::string out;
+  normalized.toUTF8String(out);
+  return out;
+}
+
+// Comparison key: NFC, then case folded.
+std::u16string FoldName(std::string_view name) {
+  return base::i18n::FoldCase(base::UTF8ToUTF16(NormalizeName(name)));
+}
+
+bool HasControlOrSeparator(std::string_view s, bool allow_slash) {
+  for (char16_t c : base::UTF8ToUTF16(s)) {
+    if (c < 0x20 || (c >= 0x7F && c <= 0x9F)) {
+      return true;
+    }
+    if (!allow_slash && (c == u'/' || c == u'\\')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int HexDigit(char c) {
+  if (c >= '0' && c <= '9') {
+    return c - '0';
+  }
+  if (c >= 'a' && c <= 'f') {
+    return c - 'a' + 10;
+  }
+  if (c >= 'A' && c <= 'F') {
+    return c - 'A' + 10;
+  }
+  return -1;
+}
+
+// #RRGGBB or #RRGGBBAA (same grammar as the dev theme.json).
+std::optional<SkColor> ParseHexColor(std::string_view s) {
+  if ((s.size() != 7 && s.size() != 9) || s[0] != '#') {
+    return std::nullopt;
+  }
+  uint32_t v = 0;
+  for (size_t i = 1; i < s.size(); ++i) {
+    const int d = HexDigit(s[i]);
+    if (d < 0) {
+      return std::nullopt;
+    }
+    v = (v << 4) | static_cast<uint32_t>(d);
+  }
+  if (s.size() == 7) {
+    return SkColorSetA(v, 0xFF);
+  }
+  return SkColorSetARGB(v & 0xFF, (v >> 24) & 0xFF, (v >> 16) & 0xFF,
+                        (v >> 8) & 0xFF);
+}
+
+// Absent key keeps *out; present key must be an int within range.
+bool ReadInt(const base::DictValue& dict,
+             const char* key,
+             int min,
+             int max,
+             int* out) {
+  const base::Value* value = dict.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_int() || value->GetInt() < min || value->GetInt() > max) {
+    return false;
+  }
+  *out = value->GetInt();
+  return true;
+}
+
+// Absent key keeps *out; present key must be one of the compiled choices.
+bool ReadChoice(const base::DictValue& dict,
+                const char* key,
+                std::string* out) {
+  const base::Value* value = dict.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_string() ||
+      (value->GetString() != kIconPackDefault &&
+       value->GetString() != kIconPackPixelized)) {
+    return false;
+  }
+  *out = value->GetString();
+  return true;
+}
+
+// Reads an open fd of a regular file, capped at kMaxThemeFileBytes.
+std::optional<std::string> ReadSmallFd(int fd) {
+  struct stat st;
+  if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+      static_cast<size_t>(st.st_size) > kMaxThemeFileBytes) {
+    return std::nullopt;
+  }
+  std::string data;
+  char buf[4096];
+  while (true) {
+    const ssize_t n = HANDLE_EINTR(read(fd, buf, sizeof(buf)));
+    if (n < 0) {
+      return std::nullopt;
+    }
+    if (n == 0) {
+      return data;
+    }
+    data.append(buf, static_cast<size_t>(n));
+    if (data.size() > kMaxThemeFileBytes) {
+      return std::nullopt;
+    }
+  }
+}
+
+// Plain POSIX read of a small file. Like theme_tokens, avoids base::File so
+// the UI thread blocking assertions do not fire. O_NONBLOCK + fstat keep a
+// FIFO or device in place of theme.json from blocking the UI thread.
+std::optional<std::string> ReadSmallFile(const base::FilePath& path) {
+  const int fd = HANDLE_EINTR(
+      open(path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK));
+  if (fd < 0) {
+    return std::nullopt;
+  }
+  std::optional<std::string> data = ReadSmallFd(fd);
+  IGNORE_EINTR(close(fd));
+  return data;
+}
+
+// Folder of `dir` whose name matches `name` without case/normalization
+// differences, POSIX only (UI thread safe like ReadSmallFile). Covers a pref
+// left with the old spelling after a replace that changed the case.
+std::optional<std::string> FindFolderFolded(const base::FilePath& dir,
+                                            std::string_view name) {
+  DIR* d = opendir(dir.value().c_str());
+  if (!d) {
+    return std::nullopt;
+  }
+  const std::u16string key = FoldName(name);
+  std::optional<std::string> found;
+  while (const dirent* entry = readdir(d)) {
+    const std::string_view folder(entry->d_name);
+    if (IsValidThemeName(folder) && FoldName(folder) == key) {
+      found = std::string(folder);
+      break;
+    }
+  }
+  closedir(d);
+  return found;
+}
+
+// Reads themes/<folder>/theme.json; the file's "name" must equal the folder.
+std::optional<ThemeData> LoadRepoTheme(const base::FilePath& dir,
+                                       const std::string& folder) {
+  if (!IsValidThemeName(folder) || IsReservedThemeName(folder)) {
+    return std::nullopt;
+  }
+  std::optional<std::string> json =
+      ReadSmallFile(dir.Append(folder).Append(kThemeFileName));
+  ThemeData theme;
+  if (!json || ParseThemeJson(*json, &theme) != ThemeParseResult::kOk ||
+      theme.name != NormalizeName(folder)) {
+    return std::nullopt;
+  }
+  return theme;
+}
+
+std::vector<ThemeInfo> ScanRepo(base::FilePath dir) {
+  std::vector<ThemeInfo> found;
+  base::FileEnumerator enumerator(dir, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    if (std::optional<ThemeData> theme =
+            LoadRepoTheme(dir, path.BaseName().AsUTF8Unsafe())) {
+      found.push_back({std::move(*theme), /*builtin=*/false});
+    }
+  }
+  std::sort(found.begin(), found.end(),
+            [](const ThemeInfo& a, const ThemeInfo& b) {
+              const std::u16string fa = FoldName(a.theme.name);
+              const std::u16string fb = FoldName(b.theme.name);
+              return fa != fb ? fa < fb : a.theme.name < b.theme.name;
+            });
+
+  std::vector<ThemeInfo> result;
+  result.push_back({GetBuiltinTheme(kThemeDefault), /*builtin=*/true});
+  result.push_back({GetBuiltinTheme(kThemePixelized), /*builtin=*/true});
+  std::set<std::u16string> seen;
+  for (ThemeInfo& info : found) {
+    if (seen.insert(FoldName(info.theme.name)).second) {
+      result.push_back(std::move(info));
+    }
+  }
+  return result;
+}
+
+InstallResult WriteTheme(base::FilePath dir,
+                         std::string name,
+                         std::string json,
+                         bool replace) {
+  if (!base::CreateDirectory(dir)) {
+    return InstallResult::kIoError;
+  }
+  const std::u16string key = FoldName(name);
+  base::FilePath existing;
+  {
+    base::FileEnumerator enumerator(dir, /*recursive=*/false,
+                                    base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      const std::string folder = path.BaseName().AsUTF8Unsafe();
+      if (IsValidThemeName(folder) && FoldName(folder) == key) {
+        existing = path;
+        break;
+      }
+    }
+  }
+  if (!existing.empty() && !replace) {
+    return InstallResult::kConflict;
+  }
+  // The new theme is written to a hidden staging folder in the same
+  // directory (scans skip names starting with '.'), then renamed in place.
+  // The old folder moves aside first and is deleted only after the new one
+  // is in place; any failure restores it.
+  base::FilePath staging;
+  if (!base::CreateTemporaryDirInDir(dir, ".install-", &staging)) {
+    return InstallResult::kIoError;
+  }
+  if (!base::ImportantFileWriter::WriteFileAtomically(
+          staging.Append(kThemeFileName), json)) {
+    base::DeletePathRecursively(staging);
+    return InstallResult::kIoError;
+  }
+  base::FilePath backup;
+  if (!existing.empty()) {
+    backup = staging.AddExtension("old");
+    if (rename(existing.value().c_str(), backup.value().c_str()) != 0) {
+      base::DeletePathRecursively(staging);
+      return InstallResult::kIoError;
+    }
+  }
+  // `name` passed IsValidThemeName: a single path component.
+  const base::FilePath target = dir.Append(name);
+  if (rename(staging.value().c_str(), target.value().c_str()) != 0) {
+    if (!backup.empty()) {
+      rename(backup.value().c_str(), existing.value().c_str());
+    }
+    base::DeletePathRecursively(staging);
+    return InstallResult::kIoError;
+  }
+  if (!backup.empty()) {
+    base::DeletePathRecursively(backup);
+  }
+  return InstallResult::kInstalled;
+}
+
+}  // namespace
+
+bool IsValidThemeName(std::string_view name) {
+  return !name.empty() && name.size() <= kMaxThemeNameBytes &&
+         base::IsStringUTF8(name) && name[0] != '.' &&
+         !HasControlOrSeparator(name, /*allow_slash=*/false);
+}
+
+bool IsReservedThemeName(std::string_view name) {
+  return base::EqualsCaseInsensitiveASCII(name, kThemeDefault) ||
+         base::EqualsCaseInsensitiveASCII(name, kThemePixelized);
+}
+
+ThemeParseResult ParseThemeJson(std::string_view json, ThemeData* out) {
+  if (json.size() > kMaxThemeFileBytes) {
+    return ThemeParseResult::kInvalidJson;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!root) {
+    return ThemeParseResult::kInvalidJson;
+  }
+
+  const std::string* raw_name = root->FindString("name");
+  if (!raw_name || !IsValidThemeName(*raw_name)) {
+    return ThemeParseResult::kInvalidName;
+  }
+  // The folder, the pref and comparisons use the NFC form.
+  const std::string name = NormalizeName(*raw_name);
+  if (!IsValidThemeName(name)) {
+    return ThemeParseResult::kInvalidName;
+  }
+  if (IsReservedThemeName(name)) {
+    return ThemeParseResult::kReservedName;
+  }
+
+  ThemeData theme;
+  theme.name = name;
+
+  if (const base::Value* mode = root->Find("mode")) {
+    if (!mode->is_string() ||
+        (mode->GetString() != "dark" && mode->GetString() != "light")) {
+      return ThemeParseResult::kInvalidField;
+    }
+    theme.scheme = mode->GetString() == "light" ? ThemeScheme::kLight
+                                                : ThemeScheme::kDark;
+  }
+  if (!ReadInt(*root, "radius", 0, kMaxRadius, &theme.radius) ||
+      !ReadInt(*root, "radius_small", 0, kMaxRadius, &theme.radius_small)) {
+    return ThemeParseResult::kInvalidField;
+  }
+
+  if (const base::Value* font = root->Find("font")) {
+    if (!font->is_dict()) {
+      return ThemeParseResult::kInvalidField;
+    }
+    const base::DictValue& font_dict = font->GetDict();
+    if (const base::Value* family = font_dict.Find("family")) {
+      if (!family->is_string() || family->GetString().empty() ||
+          family->GetString().size() > kMaxThemeNameBytes ||
+          !base::IsStringUTF8(family->GetString()) ||
+          HasControlOrSeparator(family->GetString(), /*allow_slash=*/true)) {
+        return ThemeParseResult::kInvalidField;
+      }
+      theme.font_family = family->GetString();
+      // A family needs an explicit size.
+      if (!font_dict.Find("size_px")) {
+        return ThemeParseResult::kInvalidField;
+      }
+    }
+    if (!ReadInt(font_dict, "size_px", kMinFontSize, kMaxFontSize,
+                 &theme.font_size_px)) {
+      return ThemeParseResult::kInvalidField;
+    }
+  }
+
+  if (const base::Value* icons = root->Find("icons")) {
+    // "overrides" is reserved for later; ignored today.
+    if (!icons->is_dict() ||
+        !ReadChoice(icons->GetDict(), "base", &theme.icons_base)) {
+      return ThemeParseResult::kInvalidField;
+    }
+  }
+  if (!ReadChoice(*root, "style", &theme.style)) {
+    return ThemeParseResult::kInvalidField;
+  }
+
+  if (const base::Value* tokens = root->Find("tokens")) {
+    if (!tokens->is_dict()) {
+      return ThemeParseResult::kInvalidField;
+    }
+    for (const auto [token_name, value] : tokens->GetDict()) {
+      std::optional<SkColor> color;
+      if (value.is_string()) {
+        color = ParseHexColor(value.GetString());
+      }
+      if (!color) {
+        return ThemeParseResult::kInvalidField;
+      }
+      theme.tokens.push_back({token_name, *color});
+    }
+  }
+
+  *out = std::move(theme);
+  return ThemeParseResult::kOk;
+}
+
+base::FilePath GetThemeRepoDir() {
+  if (!RepoDirOverride().empty()) {
+    return RepoDirOverride();
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  return base::nix::GetXDGDirectory(env.get(), base::nix::kXdgConfigHomeEnvVar,
+                                    base::nix::kDotConfigDir)
+      .Append("aerographene")
+      .Append("themes");
+}
+
+void SetThemeRepoDirForTesting(const base::FilePath& dir) {
+  RepoDirOverride() = dir;
+}
+
+ResolvedTheme ResolveTheme(std::string_view pref_value) {
+  ResolvedTheme resolved;
+  for (const char* builtin : {kThemeDefault, kThemePixelized}) {
+    if (base::EqualsCaseInsensitiveASCII(pref_value, builtin)) {
+      resolved.theme = GetBuiltinTheme(builtin);
+      resolved.pref_value = builtin;
+      return resolved;
+    }
+  }
+  resolved.theme = GetBuiltinTheme(kThemeDefault);
+  if (!IsValidThemeName(pref_value)) {
+    resolved.pref_value = kThemeDefault;
+    return resolved;
+  }
+  resolved.pref_value = std::string(pref_value);
+  const base::FilePath dir = GetThemeRepoDir();
+  if (std::optional<ThemeData> theme =
+          LoadRepoTheme(dir, resolved.pref_value)) {
+    resolved.theme = std::move(*theme);
+    return resolved;
+  }
+  // A replace may have changed the case (or normalization) of the folder:
+  // follow it and point the pref at the folder in use.
+  if (std::optional<std::string> folder =
+          FindFolderFolded(dir, resolved.pref_value);
+      folder && *folder != resolved.pref_value) {
+    if (std::optional<ThemeData> theme = LoadRepoTheme(dir, *folder)) {
+      resolved.theme = std::move(*theme);
+      resolved.pref_value = std::move(*folder);
+    }
+  }
+  return resolved;
+}
+
+void ListThemes(ListThemesCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ScanRepo, GetThemeRepoDir()), std::move(callback));
+}
+
+void InstallTheme(std::string json, bool replace, InstallCallback callback) {
+  ThemeData theme;
+  const ThemeParseResult parsed = ParseThemeJson(json, &theme);
+  if (parsed != ThemeParseResult::kOk) {
+    const InstallResult result = parsed == ThemeParseResult::kReservedName
+                                     ? InstallResult::kReserved
+                                     : InstallResult::kInvalid;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), result, std::string()));
+    return;
+  }
+  const std::string name = theme.name;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&WriteTheme, GetThemeRepoDir(), name, std::move(json),
+                     replace),
+      base::BindOnce(
+          [](InstallCallback callback, std::string name, InstallResult result) {
+            std::move(callback).Run(result, std::move(name));
+          },
+          std::move(callback), name));
+}
+
