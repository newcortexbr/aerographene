+class AerographeneThemeRepoTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    SetThemeRepoDirForTesting(dir_.GetPath());
+  }
+  void TearDown() override { SetThemeRepoDirForTesting(base::FilePath()); }
+
+  void WriteTheme(const std::string& folder, const std::string& json) {
+    const base::FilePath path = dir_.GetPath().Append(folder);
+    ASSERT_TRUE(base::CreateDirectory(path));
