--- /dev/null
+++ b/third_party/chromium_web_store/BUILD.gn
@@ -0,0 +1,49 @@
+# aerographene: molde de third_party/ublock/BUILD.gn (Helium, GPL-3.0), sem assets comprimidos.
+
+import("//ui/webui/resources/tools/generate_grd.gni")
+import("//tools/grit/grit_rule.gni")
+
+file_list = "$target_gen_dir/files.json"
+generated_grd = "$target_gen_dir/chromium_web_store_resources.grd"
+
+action("generate_file_list") {
+    script = "generate_file_list.py"
+    args = [
+        rebase_path("."),
+        rebase_path(file_list),
+    ]
+    inputs = [
+        "manifest.json",
+        "generate_file_list.py",
+    ]
+    outputs = [ file_list ]
+}
+
+generate_grd("chromium_web_store_grd") {
+    out_grd = generated_grd
+
+    grd_prefix = "chromium_web_store"
+    resource_path_prefix = "chromium_web_store"
+
+    manifest_files = [ file_list ]
+    deps = [":generate_file_list"]
+}
+
+grit("chromium_web_store") {
+    source = generated_grd
+
+    # Required because the .grd is generated.
+    enable_input_discovery_for_gn_analyze = false
+    use_brotli = true
+
+    output_dir = "$target_gen_dir/resources"
+
+    outputs = [
+        "grit/chromium_web_store_resources.h",
+        "grit/chromium_web_store_resources_map.cc",
+        "grit/chromium_web_store_resources_map.h",
+        "chromium_web_store_resources.pak"
+    ]
+
+    deps = [":chromium_web_store_grd"]
+}
