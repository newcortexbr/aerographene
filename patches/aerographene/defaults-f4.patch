--- /dev/null
+++ b/third_party/chromium_web_store/generate_file_list.py
@@ -0,0 +1,26 @@
+# aerographene: molde de third_party/ublock/generate_file_list.py (Helium, GPL-3.0).
+
+import json
+import os
+from fnmatch import fnmatchcase
+from sys import argv
+from pathlib import Path
+
+EXCLUDED_FILES = (
+    'BUILD.gn',
+    'README.chromium',
+    'generate_file_list.py',
+)
+
+src = Path(argv[1])
+files = []
+for root, _, filenames in os.walk(src):
+  for filename in filenames:
+    relative = (Path(root) / filename).relative_to(src).as_posix()
+    if any(fnmatchcase(relative, pattern) for pattern in EXCLUDED_FILES):
+      continue
+    files.append(relative)
+files.sort()
+
+with open(argv[2], 'w') as f:
+  json.dump({'base_dir': src.as_posix(), 'files': files}, f)
