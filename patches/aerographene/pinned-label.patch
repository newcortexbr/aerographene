+void PinnedTabContainerView::RenameClosedPinned(const base::Uuid& uuid) {
+  TabStripCollectionController* controller =
+      collection_node_ ? collection_node_->GetController() : nullptr;
+  BrowserView* browser_view =
+      controller ? controller->GetBrowserView() : nullptr;
+  if (!browser_view || !GetWidget() || !GetWindowPinnedModel()) {
+    return;
+  }
+  aerographene::ShowRenamePinnedDialog(browser_view->GetProfile(), uuid,
+                                       std::u16string(),
+                                       GetWidget()->GetNativeWindow());
+}
