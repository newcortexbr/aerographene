+// Label of a placeholder spanning 2+ cells: favicon at the start, then text.
+constexpr int kClosedPinnedTextPadding = 8;
+constexpr int kClosedPinnedIconSize = 16;
+constexpr int kClosedPinnedIconTextGap = 6;
+constexpr int kClosedPinnedRenameCommand = 1;
+
+// Pinned entry label, or empty, for the live pinned `child`.
+std::u16string GetPinnedLabel(const views::View* child) {
+  const tabs::TabInterface* tab = GetPinnedTab(child);
+  aerographene::PinnedModel* model = GetPinnedModel(tab);
+  const aerographene::PinnedTabMirror* mirror =
+      model ? model->tab_mirror() : nullptr;
+  const std::optional<base::Uuid> uuid =
+      mirror ? mirror->GetEntryForTab(tab) : std::nullopt;
+  const std::optional<aerographene::PinnedItem> item =
+      uuid ? model->Find(*uuid) : std::nullopt;
+  return item ? base::UTF8ToUTF16(item->label) : std::u16string();
+}
