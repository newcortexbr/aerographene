+#include "chrome/browser/ui/views/tabs/common/aerographene_rename_pinned_dialog.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/tabs/aerographene/pinned_model.h"
+#include "chrome/browser/ui/tabs/aerographene/pinned_model_factory.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/constrained_window/constrained_window_views.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/dialog_model_field.h"
+
+namespace aerographene {
+
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kRenamePinnedFieldId);
+
+class RenamePinnedDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  RenamePinnedDialogDelegate(Profile* profile,
+                             const base::Uuid& uuid,
+                             std::u16string initial_text,
+                             bool had_label)
+      : profile_(profile),
+        uuid_(uuid),
+        initial_text_(std::move(initial_text)),
+        had_label_(had_label) {}
+  RenamePinnedDialogDelegate(const RenamePinnedDialogDelegate&) = delete;
+  RenamePinnedDialogDelegate& operator=(const RenamePinnedDialogDelegate&) =
+      delete;
+  ~RenamePinnedDialogDelegate() override = default;
+
+  void OnAccepted() {
+    std::u16string text;
+    base::TrimWhitespace(
+        dialog_model()->GetTextfieldByUniqueId(kRenamePinnedFieldId)->text(),
+        base::TRIM_ALL, &text);
+    // Accepting the page title untouched must not freeze it as a label.
+    if (!had_label_ && text == initial_text_) {
+      return;
+    }
+    // Looked up again: the model may be gone if the profile shut down.
+    PinnedModel* model = PinnedModelFactory::GetForProfile(profile_);
+    if (!model || !model->IsLoaded()) {
+      return;
+    }
+    model->SetLabel(uuid_, base::UTF16ToUTF8(text));
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  const base::Uuid uuid_;
+  const std::u16string initial_text_;
+  const bool had_label_;
+};
+
+}  // namespace
+
+void ShowRenamePinnedDialog(Profile* profile,
+                            const base::Uuid& uuid,
+                            const std::u16string& fallback_title,
+                            gfx::NativeWindow parent) {
+  PinnedModel* model = profile ? PinnedModelFactory::GetForProfile(profile)
+                               : nullptr;
+  if (!model || !model->IsLoaded()) {
+    return;
+  }
+  const std::optional<PinnedItem> item = model->Find(uuid);
+  if (!item || item->is_folder) {
+    return;
+  }
+  const bool had_label = !item->label.empty();
+  std::u16string initial_text =
+      had_label ? base::UTF8ToUTF16(item->label)
+                : (fallback_title.empty() ? item->title : fallback_title);
+
+  auto delegate = std::make_unique<RenamePinnedDialogDelegate>(
+      profile, uuid, initial_text, had_label);
+  RenamePinnedDialogDelegate* delegate_ptr = delegate.get();
+
+  const std::u16string field_label =
+      l10n_util::GetStringUTF16(IDS_AEROGRAPHENE_RENAME_PINNED_FIELD);
+  ui::DialogModelTextfield::Params field_params;
+  field_params.SetAccessibleName(field_label);
+
+  std::unique_ptr<ui::DialogModel> dialog_model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(
+              l10n_util::GetStringUTF16(IDS_AEROGRAPHENE_RENAME_PINNED_TITLE))
+          .AddTextfield(kRenamePinnedFieldId, field_label,
+                        std::move(initial_text), field_params)
+          .AddOkButton(base::BindOnce(&RenamePinnedDialogDelegate::OnAccepted,
+                                      base::Unretained(delegate_ptr)))
+          .AddCancelButton(base::DoNothing())
+          .SetInitiallyFocusedField(kRenamePinnedFieldId)
+          .Build();
+
+  constrained_window::ShowBrowserModal(std::move(dialog_model), parent);
+}
+
+}  // namespace aerographene
