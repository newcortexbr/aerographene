 void PinnedTabContainerView::RefreshPersistedSpans() {
   for (views::View* child : children()) {
     if (auto* tab_view = views::AsViewClass<TabView>(child)) {
       tab_view->SetPinnedSpan(GetTabSpan(child));
+      tab_view->SetPinnedLabel(GetPinnedLabel(child));
     }
   }
   InvalidateLayout();
