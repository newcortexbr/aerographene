+std::optional<base::Uuid>
+TabStripCollectionController::GetAerographenePinnedEntry(
+    const tabs::TabInterface* tab) const {
+  const BrowserWindowInterface* browser = browser_view_->browser();
+  if (!tab || !tab->IsPinned() || !browser ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return std::nullopt;
+  }
+  aerographene::PinnedModel* pinned_model =
+      aerographene::PinnedModelFactory::GetForProfile(
+          browser_view_->GetProfile());
+  aerographene::PinnedTabMirror* mirror =
+      pinned_model && pinned_model->IsLoaded() ? pinned_model->tab_mirror()
+                                               : nullptr;
+  return mirror ? mirror->GetEntryForTab(tab) : std::nullopt;
+}
