+.sb-back:disabled { cursor: default; opacity: 0.6; }
+.sb-path { overflow: hidden; text-overflow: ellipsis; }
+/* estado vazio */
+.editor > .empty-state { max-width: 560px; margin-top: 54px; line-height: 2; padding: 18px 22px; }
+.empty-state p { margin: 0; }
+.empty-state kbd { display: inline-block; margin-right: 12px; min-width: 64px; text-align: center; }
+.empty-state .rec { border-top: 1px dashed var(--line); color: var(--text2); font: 11px/1.9 var(--mono); margin-top: 10px; padding-top: 8px; }
+.empty-state .rec-t { text-transform: uppercase; font-size: 10px; }
+.empty-state .rec-row { align-items: center; background: none; border: 0; color: var(--text2); cursor: pointer; display: flex; font: inherit; gap: 8px; text-align: left; width: 100%; }
+.empty-state .rec-row:hover, .empty-state .rec-row:focus-visible { color: var(--text); outline: none; }
+.empty-state .rec-row span:last-child { margin-left: auto; }
+.tablist { overflow-x: auto; scrollbar-width: none; }
