+.tree { padding: 6px 0; }
+.tree .empty { padding: 8px 12px; }
+.node {
+  align-items: center; color: var(--row); display: flex; font-family: var(--mono);
+  font-size: 12px; height: 24px; padding: 0; position: relative; white-space: nowrap;
+}
+.node.dir { color: var(--dir); }
+.node .g { flex: none; height: 14px; margin-left: 8px; position: relative; width: 14px; }
+.node .g::before {
+  border: 4px solid transparent; border-left: 6px solid var(--text2); border-right: 0;
+  content: ""; left: 4px; position: absolute; top: 3px;
+}
+.node[aria-expanded="true"] .g::before {
