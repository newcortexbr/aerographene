+// Breadcrumb: the note's folders (the file name is #noteTitle).
+function setCrumbs(path) {
+  crumbs.replaceChildren();
+  const dirs = path ? path.split('/').slice(0, -1) : [];
+  for (const d of dirs) {
+    const s = document.createElement('span');
+    s.className = 'crumb';
+    s.textContent = d;
+    const sep = document.createElement('span');
+    sep.className = 'sep';
+    sep.textContent = '/';
+    crumbs.append(s, sep);
+  }
+}
+
+// Status bar: words/characters of the open note, else visible note count.
+function updateStats() {
+  if (current && doc) {
+    const text = doc.getText();
+    const words = text.split(/\s+/).filter(Boolean).length;
+    noteStats.textContent = `${words} palavras · ${text.length} caracteres`;
+  } else if (vaultTitle) {
+    const n = tree.querySelectorAll('.node.file').length;
+    noteStats.textContent = `${n} notas visíveis`;
+  } else {
+    noteStats.textContent = '';
+  }
+}
