+#include "ui/gfx/font_list.h"
 #include "ui/native_theme/native_theme.h"
 
 #if BUILDFLAG(ENABLE_EXTENSIONS)
@@ -357,6 +361,29 @@
 
 ThemeService::~ThemeService() = default;
 
+#if BUILDFLAG(IS_LINUX)
+namespace {
+
+// aerographene: pixelized UI font, JetBrains Mono 12px (mono size in the
+// pixelized mockups); system monospace if it is not installed. Only called
+// for pixelized, so the default theme loads no extra font and keeps the
+// system UI font.
+void ApplyAerographenePixelizedFont() {
+  constexpr char kFamily[] = "JetBrains Mono";
+  constexpr int kSizePx = 12;
+  const bool installed = base::EqualsCaseInsensitiveASCII(
+      gfx::Font(kFamily, kSizePx).GetActualFontName(), kFamily);
+  // ReloadFonts() calls InitDefaultFontList(), which resets the default font
+  // description to empty (system font) and clears the font cache, so the
+  // description has to be set after it; the cache refills from it.
+  ui::ResourceBundle::GetSharedInstance().ReloadFonts();
+  gfx::FontList::SetDefaultFontDescription(base::StringPrintf(
+      "%s, %dpx", installed ? kFamily : "Monospace", kSizePx));
+}
+
+}  // namespace
+#endif
+
 void ThemeService::Init() {
   theme_helper_->DCheckCalledOnValidSequence();
 
@@ -375,6 +402,12 @@
                            aerographene::BuiltinTheme::kPixelized;
     views::LayoutProvider::SetAerographeneCornerRadii(pixelized ? 0 : 4,
                                                       pixelized ? 2 : 3);
+    // The UI font is process-wide and set once (first regular profile).
+    static bool font_applied = false;
+    if (pixelized && !font_applied) {
+      font_applied = true;
+      ApplyAerographenePixelizedFont();
+    }
   }
 #endif
 
