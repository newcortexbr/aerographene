aerographene: fonte do tema pixelized (JetBrains Mono 12px).

Origem: aerographene (original). Licença: GPL-3.0.
Depende de: aerographene/theme-radius.patch.
Propósito: só em tema com font_family (ThemeData; hoje o pixelized), uma vez por processo, em ThemeService::Init:
ResourceBundle::ReloadFonts() e depois
gfx::FontList::SetDefaultFontDescription("JetBrains Mono, 12px"). A ordem
importa: ReloadFonts chama InitDefaultFontList, que zera a descrição (fonte do
sistema) e limpa o cache; antes a descrição era definida antes e nunca valia
(causa do pixelized "só parcial" em runtime). Se a família não existir no
fontconfig, usa "Monospace, 12px". O default não carrega fonte e mantém a
fonte do sistema.


--- a/chrome/browser/themes/theme_service.cc
+++ b/chrome/browser/themes/theme_service.cc
@@ -27,6 +27,7 @@
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/string_split.h"
 #include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/single_thread_task_runner.h"
@@ -76,12 +77,15 @@
 #include "third_party/abseil-cpp/absl/cleanup/cleanup.h"
 #include "ui/base/l10n/l10n_util.h"
 #include "ui/base/mojom/themes.mojom.h"
+#include "ui/base/resource/resource_bundle.h"
 #include "ui/base/resource/resource_scale_factor.h"
 #include "ui/base/ui_base_features.h"
 #include "ui/color/color_id.h"
 #include "ui/color/color_provider.h"
 #include "ui/color/color_provider_key.h"
 #include "ui/color/color_provider_manager.h"
+#include "ui/gfx/font.h"
+#include "ui/gfx/font_list.h"
 #include "ui/native_theme/native_theme.h"
 
 #if BUILDFLAG(ENABLE_EXTENSIONS)
@@ -357,6 +361,27 @@ ThemeService::ThemeService(Profile* profile, const ThemeHelper& theme_helper)
 
 ThemeService::~ThemeService() = default;
 
+#if BUILDFLAG(IS_LINUX)
+namespace {
+
+// aerographene: UI font of the active theme (pixelized: JetBrains Mono 12px,
+// mono size in the pixelized mockups); system monospace if the family is not
+// installed. Only called for themes with a font, so the default theme loads
+// no extra font and keeps the system UI font.
+void ApplyAerographeneThemeFont(const std::string& family, int size_px) {
+  const bool installed = base::EqualsCaseInsensitiveASCII(
+      gfx::Font(family, size_px).GetActualFontName(), family);
+  // ReloadFonts() calls InitDefaultFontList(), which resets the default font
+  // description to empty (system font) and clears the font cache, so the
+  // description has to be set after it; the cache refills from it.
+  ui::ResourceBundle::GetSharedInstance().ReloadFonts();
+  gfx::FontList::SetDefaultFontDescription(base::StringPrintf(
+      "%s, %dpx", installed ? family.c_str() : "Monospace", size_px));
+}
+
+}  // namespace
+#endif
+
 void ThemeService::Init() {
   theme_helper_->DCheckCalledOnValidSequence();
 
@@ -373,6 +398,12 @@ void ThemeService::Init() {
     const aerographene::ThemeData& theme = aerographene::GetActiveTheme();
     views::LayoutProvider::SetAerographeneCornerRadii(theme.radius,
                                                       theme.radius_small);
+    // The UI font is process-wide and set once (first regular profile).
+    static bool font_applied = false;
+    if (!theme.font_family.empty() && !font_applied) {
+      font_applied = true;
+      ApplyAerographeneThemeFont(theme.font_family, theme.font_size_px);
+    }
   }
 #endif
 
