+.vault-name {
+  color: var(--accent);
+  flex: 1;
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.vault-pick {
+  background: none;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  color: var(--text2);
+  font: inherit;
+  font-size: 12px;
+  padding: 2px 8px;
+}
+.tree { flex: 1; overflow: auto; padding: 8px 0; }
+.empty, .hint { color: var(--text2); padding: 8px 12px; }
+.splitter {
+  background: var(--line);
+  cursor: col-resize;
+}
+.splitter:hover, .splitter:focus-visible, .splitter.dragging {
+  background: var(--accent);
+  outline: none;
+}
+.note { display: flex; flex-direction: column; min-width: 0; }
+.note-title { color: var(--text2); }
+.editor {
+  flex: 1;
+  margin: 0 auto;
+  max-width: 820px;
+  overflow: auto;
+  padding: 32px 24px;
+  width: 100%;
+}
