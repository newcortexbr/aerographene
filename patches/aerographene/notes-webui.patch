+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+// Skeleton of chrome://notes: only the resizable vault sidebar. No network,
+// no Mojo, no innerHTML (Trusted Types is enforced by the WebUI CSP).
+
+const MIN_W = 160;
+const MAX_W = 560;
+
+function setVaultWidth(px) {
+  const w = Math.max(MIN_W, Math.min(MAX_W, Math.round(px)));
+  document.documentElement.style.setProperty('--vault-w', `${w}px`);
+  return w;
+}
+
+function initSplitter() {
+  const splitter = document.getElementById('splitter');
+  const vault = document.getElementById('vault');
+  let startX = 0;
+  let startW = 0;
+
+  splitter.addEventListener('pointerdown', (e) => {
+    startX = e.clientX;
+    startW = vault.getBoundingClientRect().width;
+    splitter.setPointerCapture(e.pointerId);
+    splitter.classList.add('dragging');
+  });
+  splitter.addEventListener('pointermove', (e) => {
+    if (splitter.hasPointerCapture(e.pointerId)) {
+      setVaultWidth(startW + e.clientX - startX);
+    }
+  });
+  const stop = (e) => {
+    if (splitter.hasPointerCapture(e.pointerId)) {
+      splitter.releasePointerCapture(e.pointerId);
+    }
+    splitter.classList.remove('dragging');
+  };
+  splitter.addEventListener('pointerup', stop);
+  splitter.addEventListener('pointercancel', stop);
+  splitter.addEventListener('keydown', (e) => {
+    const step = e.shiftKey ? 48 : 16;
+    const w = vault.getBoundingClientRect().width;
+    if (e.key === 'ArrowLeft') {
+      setVaultWidth(w - step);
+      e.preventDefault();
+    } else if (e.key === 'ArrowRight') {
+      setVaultWidth(w + step);
+      e.preventDefault();
+    }
+  });
+}
+
+initSplitter();
