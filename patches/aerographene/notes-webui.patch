+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_NOTES_AERO_NOTES_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_NOTES_AERO_NOTES_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class BrowserContext;
+}
+
+inline constexpr char kAeroNotesHost[] = "notes";
+
+class AeroNotesUI;
+
+// chrome://notes (shown as aerographene://notes). Only the config lives in
+// the WebUIConfigMap; the controller and its data source are created when a
+// tab navigates to the page, so nothing runs at startup.
+class AeroNotesUIConfig : public content::DefaultWebUIConfig<AeroNotesUI> {
+ public:
+  AeroNotesUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kAeroNotesHost) {}
+
+  // Off the record (incognito and guest) profiles do not get the page.
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+};
+
+// Static skeleton: no Mojo, no WebUI message handlers, no network.
+class AeroNotesUI : public content::WebUIController {
+ public:
+  explicit AeroNotesUI(content::WebUI* web_ui);
+
+  AeroNotesUI(const AeroNotesUI&) = delete;
+  AeroNotesUI& operator=(const AeroNotesUI&) = delete;
+
+  ~AeroNotesUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_NOTES_AERO_NOTES_UI_H_
