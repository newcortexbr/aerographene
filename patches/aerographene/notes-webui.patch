+<!doctype html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8">
+<title>o: notas</title>
+<meta name="color-scheme" content="dark light">
+<link rel="stylesheet" href="notes.css">
+<script type="module" src="notes.js"></script>
+</head>
+<body>
+<div class="app" id="app">
+  <aside class="vault" id="vault" aria-label="vault">
+    <header class="vault-head">
+      <span class="vault-name" id="vaultName">vault</span>
+      <button class="vault-pick" id="vaultPick" type="button" disabled
+          title="escolher pasta (ainda não disponível)">escolher pasta</button>
+    </header>
+    <nav class="tree" id="tree" role="tree" aria-label="arquivos da vault">
+      <p class="empty">nenhuma vault escolhida</p>
+    </nav>
+  </aside>
+  <div class="splitter" id="splitter" role="separator"
+      aria-orientation="vertical" aria-label="redimensionar vault" tabindex="0"></div>
+  <main class="note" id="note">
+    <header class="note-head">
+      <span class="note-title" id="noteTitle">sem nota aberta</span>
+    </header>
+    <div class="editor" id="editor" aria-readonly="true">
+      <p class="hint">esqueleto da página de notas: leitura e edição da vault
+        chegam nas próximas fatias.</p>
+    </div>
+  </main>
+</div>
+</body>
+</html>
