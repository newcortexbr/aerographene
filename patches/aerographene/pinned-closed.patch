+
+// Closed pinned placeholder look: dimmed favicon in an outlined cell.
+constexpr uint8_t kClosedPinnedIconAlpha = 0x73;
+constexpr SkAlpha kClosedPinnedOutlineAlpha = 0x40;
+constexpr int kClosedPinnedCornerRadius = 8;
+constexpr int kClosedPinnedDotRadius = 3;
 }  // namespace
 
+// Grid cell of a closed pinned entry (pinned without a live tab). Clicking it
+// reopens the entry. Draws the bookmark favicon dimmed inside an outline, or a
+// dot while there is no favicon. No layer of its own: the animating layout
+// manager destroys layers of direct children.
+class AerographeneClosedPinnedView : public views::Button {
+  METADATA_HEADER(AerographeneClosedPinnedView, views::Button)
+
+ public:
+  explicit AerographeneClosedPinnedView(PressedCallback callback)
+      : views::Button(std::move(callback)) {}
+  AerographeneClosedPinnedView(const AerographeneClosedPinnedView&) = delete;
+  AerographeneClosedPinnedView& operator=(
+      const AerographeneClosedPinnedView&) = delete;
+  ~AerographeneClosedPinnedView() override = default;
+
+  void Update(const aerographene::PinnedItem& item,
+              int model_index,
+              const gfx::Image& favicon) {
+    uuid_ = item.uuid;
+    model_index_ = model_index;
+    span_ = std::max(item.span, 1);
+    favicon_ = favicon.IsEmpty() ? gfx::ImageSkia() : favicon.AsImageSkia();
+    const std::u16string name =
+        item.title.empty() ? base::UTF8ToUTF16(item.url.spec()) : item.title;
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    SchedulePaint();
+  }
+
+  const base::Uuid& uuid() const { return uuid_; }
+  int model_index() const { return model_index_; }
+  int span() const { return span_; }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+                     GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor color = color_provider->GetColor(ui::kColorIcon);
+    const gfx::Rect bounds = GetLocalBounds();
+
+    cc::PaintFlags outline;
+    outline.setAntiAlias(true);
+    outline.setStyle(cc::PaintFlags::kStroke_Style);
+    outline.setStrokeWidth(1);
+    outline.setColor(SkColorSetA(color, kClosedPinnedOutlineAlpha));
+    gfx::Rect outline_bounds = bounds;
+    outline_bounds.Inset(1);
+    canvas->DrawRoundRect(outline_bounds, kClosedPinnedCornerRadius, outline);
+
+    if (!favicon_.isNull()) {
+      canvas->DrawImageInt(
+          favicon_, bounds.x() + (bounds.width() - favicon_.width()) / 2,
+          bounds.y() + (bounds.height() - favicon_.height()) / 2,
+          kClosedPinnedIconAlpha);
+      return;
+    }
+    cc::PaintFlags dot;
+    dot.setAntiAlias(true);
+    dot.setColor(SkColorSetA(color, kClosedPinnedIconAlpha));
+    canvas->DrawCircle(bounds.CenterPoint(), kClosedPinnedDotRadius, dot);
+  }
+
+ private:
+  base::Uuid uuid_;
+  int model_index_ = 0;
+  int span_ = 1;
+  gfx::ImageSkia favicon_;
+};
