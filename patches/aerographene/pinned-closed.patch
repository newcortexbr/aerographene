+void PinnedTabContainerView::RefreshClosedPinned() {
+  aerographene::PinnedModel* model = GetWindowPinnedModel();
+  std::vector<aerographene::PinnedItem> items;
+  if (model && model->IsLoaded() && collection_node_ &&
+      collection_node_->orientation() == TabStripOrientation::kVertical) {
+    items = model->GetPinned();
+  }
+  // Layout reads model order from here instead of copying the model per frame.
+  model_index_.clear();
+  for (size_t i = 0; i < items.size(); ++i) {
+    model_index_[items[i].uuid] = static_cast<int>(i);
+  }
+
+  std::map<base::Uuid, AerographeneClosedPinnedView*> previous;
+  for (AerographeneClosedPinnedView* view : closed_views_) {
+    previous[view->uuid()] = view;
+  }
+  std::vector<raw_ptr<AerographeneClosedPinnedView>> next;
+  for (size_t i = 0; i < items.size(); ++i) {
+    const aerographene::PinnedItem& item = items[i];
+    // Top-level URL entries only; drawer folders and their children are F6.
+    if (item.is_folder || item.open || !item.url.is_valid()) {
+      continue;
+    }
+    AerographeneClosedPinnedView* view = nullptr;
+    if (auto it = previous.find(item.uuid); it != previous.end()) {
+      view = it->second;
+      previous.erase(it);
+    } else {
+      view = AddChildView(std::make_unique<AerographeneClosedPinnedView>(
+          base::BindRepeating(&PinnedTabContainerView::OpenClosedPinned,
+                              base::Unretained(this), item.uuid)));
+    }
+    view->Update(item, static_cast<int>(i), model->GetFavicon(item.uuid));
+    next.push_back(view);
+  }
+  closed_views_ = std::move(next);
+  // Out of the grid now; the layout manager deletes them on a later layout
+  // (one of them may be the sender of the click that reopened its entry).
+  for (auto& [uuid, view] : previous) {
+    layout_manager_->AnimateAndDestroyChildView(view);
+  }
+  InvalidateLayout();
+}
+
+std::vector<views::View*> PinnedTabContainerView::GetGridChildren() const {
+  if (!collection_node_) {
+    return {};
+  }
+  std::vector<views::View*> live = collection_node_->GetDirectChildren();
+  if (closed_views_.empty()) {
+    return live;
+  }
+  std::vector<views::View*> result;
+  result.reserve(live.size() + closed_views_.size());
+  size_t next_closed = 0;
+  for (views::View* child : live) {
+    const tabs::TabInterface* tab = GetPinnedTab(child);
+    const aerographene::PinnedTabMirror* mirror =
+        tab ? GetPinnedTabMirror(tab) : nullptr;
+    const std::optional<base::Uuid> uuid =
+        mirror ? mirror->GetEntryForTab(tab) : std::nullopt;
+    if (uuid) {
+      if (auto it = model_index_.find(*uuid); it != model_index_.end()) {
+        while (next_closed < closed_views_.size() &&
+               closed_views_[next_closed]->model_index() < it->second) {
+          result.push_back(closed_views_[next_closed++].get());
+        }
+      }
+    }
+    result.push_back(child);
+  }
+  while (next_closed < closed_views_.size()) {
+    result.push_back(closed_views_[next_closed++].get());
+  }
+  return result;
+}
+
+void PinnedTabContainerView::OpenClosedPinned(const base::Uuid& uuid) {
+  aerographene::PinnedModel* model = GetWindowPinnedModel();
+  aerographene::PinnedTabMirror* mirror = model ? model->tab_mirror() : nullptr;
+  if (!mirror) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  mirror->OpenClosedEntry(browser_view->browser(), uuid);
+}
