+bool PinnedTabMirror::OpenClosedEntry(BrowserWindowInterface* browser,
+                                      const base::Uuid& uuid) {
+  if (!browser || browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !model_->IsLoaded()) {
+    return false;
+  }
+  const std::vector<PinnedItem> items = model_->GetPinned();
+  const int target = TopLevelIndex(items, uuid);
+  if (target < 0) {
+    // Missing or inside a drawer (F6).
+    return false;
+  }
+  const PinnedItem& item = items[target];
+  if (item.is_folder || item.open || !item.url.is_valid()) {
+    return false;
+  }
+  for (const auto& [handle, mapped] : tab_nodes_) {
+    if (mapped == uuid) {
+      return false;
+    }
+  }
+  // Before the first pinned tab mapped to a later entry, so AlignOrder()
+  // finds the order already right and does not move the entry.
+  TabStripModel* strip = browser->GetTabStripModel();
+  const int pinned_count = strip->IndexOfFirstNonPinnedTab();
+  int index = pinned_count;
+  for (int i = 0; i < pinned_count; ++i) {
+    const std::optional<base::Uuid> entry =
+        GetEntryForTab(strip->GetTabAtIndex(i));
+    if (entry && TopLevelIndex(items, *entry) > target) {
+      index = i;
+      break;
+    }
+  }
+  const GURL url = item.url;
+  next_entry_ = uuid;
+  // Inserted already pinned: Associate() runs from the insertion.
+  chrome::AddTabAt(browser, url, index, /*foreground=*/true,
+                   /*group=*/std::nullopt, /*pinned=*/true);
+  next_entry_.reset();
+  return true;
+}
