+// aerographene: a startup URL (command line, "open specific pages") that
+// matches an entry of the pinned model must open as that pinned tab, not as a
+// duplicate ordinary tab next to the pinned grid. Matching is exact URL first,
+// then origin + path (the same rule PinnedTabMirror uses to map tabs to
+// entries). A match not yet claimed by a pinned startup tab becomes kPinned
+// (PinnedTabMirror maps the new pinned tab to the entry by URL); a match whose
+// entry is already claimed is dropped, since the pinned tab opens that page.
+void AdoptStartupTabsIntoPinned(Profile* profile, StartupTabs* tabs) {
+  aerographene::PinnedModel* model =
+      aerographene::PinnedModelFactory::GetForProfile(profile);
+  if (!model || !model->IsLoaded()) {
+    return;
+  }
+  std::vector<GURL> entries;
+  for (const aerographene::PinnedItem& item : model->GetPinned()) {
+    if (!item.is_folder && item.url.is_valid()) {
+      entries.push_back(item.url);
+    }
+    for (const aerographene::PinnedItem& child : item.children) {
+      if (child.url.is_valid()) {
+        entries.push_back(child.url);
+      }
+    }
+  }
+  if (entries.empty()) {
+    return;
+  }
+  std::vector<bool> claimed(entries.size(), false);
+  // Index of the best entry for `url`: unclaimed before claimed, exact before
+  // origin + path. -1 if none.
+  auto find_entry = [&](const GURL& url) {
+    int best = -1;
+    int best_rank = 0;
+    for (size_t i = 0; i < entries.size(); ++i) {
+      const bool exact = entries[i] == url;
+      if (!exact && !(url::Origin::Create(entries[i]).IsSameOriginWith(url) &&
+                      entries[i].path() == url.path())) {
+        continue;
+      }
+      const int rank = (claimed[i] ? 0 : 2) + (exact ? 1 : 0) + 1;
+      if (rank > best_rank) {
+        best_rank = rank;
+        best = static_cast<int>(i);
+      }
+    }
+    return best;
+  };
+  // Pinned tabs from the model open first and claim their entries.
+  for (const StartupTab& tab : *tabs) {
+    if (tab.type == StartupTab::Type::kPinned) {
+      const int index = find_entry(tab.url);
+      if (index >= 0) {
+        claimed[index] = true;
+      }
+    }
+  }
+  std::erase_if(*tabs, [&](StartupTab& tab) {
+    if (tab.type == StartupTab::Type::kPinned || tab.is_untrusted_launch ||
+        !tab.url.SchemeIsHTTPOrHTTPS()) {
+      return false;
+    }
+    const int index = find_entry(tab.url);
+    if (index < 0) {
+      return false;
+    }
+    if (claimed[index]) {
+      return true;
+    }
+    claimed[index] = true;
+    tab.type = StartupTab::Type::kPinned;
+    return false;
+  });
+}
+
