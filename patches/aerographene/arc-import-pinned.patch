+// aerographene: writes entries imported from the pinned container of another
+// browser (ImportedBookmarkEntry::is_pinned) into the PinnedModel of the
+// profile (= space). `path` is relative to the container: no path = direct
+// pinned; path[0] = drawer folder (aerographene.folder=1) that holds the
+// entry. The model has a single drawer level, so deeper folders are flattened
+// into the drawer of path[0]. Importing twice adds nothing: an entry is
+// skipped when its URL already exists in the same place (top level, or the
+// drawer with the same title). Entries with an invalid URL and folder entries
+// are ignored.
+void WritePinnedEntries(
+    aerographene::PinnedModel* model,
+    BookmarkModel* bookmark_model,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries) {
+  struct Drawer {
+    base::Uuid uuid;
+    std::set<GURL> urls;
+  };
+  std::set<GURL> top_level_urls;
+  std::map<std::u16string, Drawer> drawers;
+  for (const aerographene::PinnedItem& item : model->GetPinned()) {
+    if (item.is_folder) {
+      // With drawers of equal title the first one wins.
+      auto [it, inserted] = drawers.try_emplace(item.title);
+      if (inserted) {
+        it->second.uuid = item.uuid;
+        for (const aerographene::PinnedItem& child : item.children) {
+          it->second.urls.insert(child.url);
+        }
+      }
+    } else {
+      top_level_urls.insert(item.url);
+    }
+  }
+
+  // One extensive-changes batch around the whole import (same pattern as the
+  // bookmarks importer below).
+  if (bookmark_model) {
+    bookmark_model->BeginExtensiveChanges();
+  }
+  constexpr size_t kAtEnd = std::numeric_limits<size_t>::max();
+  for (const user_data_importer::ImportedBookmarkEntry& entry : entries) {
+    if (entry.is_folder || !entry.url.is_valid()) {
+      continue;
+    }
+    base::Uuid parent;  // Invalid = top level.
+    std::set<GURL>* urls = &top_level_urls;
+    if (!entry.path.empty()) {
+      auto it = drawers.find(entry.path.front());
+      if (it == drawers.end()) {
+        std::optional<base::Uuid> uuid =
+            model->AddFolder(entry.path.front(), kAtEnd);
+        if (!uuid) {
+          continue;
+        }
+        it = drawers.emplace(entry.path.front(), Drawer{*uuid, {}}).first;
+      }
+      parent = it->second.uuid;
+      urls = &it->second.urls;
+    }
+    if (urls->insert(entry.url).second) {
+      model->AddPinned(entry.url, entry.title, parent, kAtEnd);
+    }
+  }
+  if (bookmark_model) {
+    bookmark_model->EndExtensiveChanges();
+  }
+}
+
+// Waits until the PinnedModel has its space folder (IsLoaded()), writes the
+// entries once and deletes itself. It also observes the Profile: if the
+// profile is destroyed first (shutdown) nothing is written and the object
+// deletes itself in OnProfileWillBeDestroyed, which runs before the keyed
+// services (PinnedModel, BookmarkModel) shut down, so the PinnedModel
+// observation is dropped while the model is still alive.
+class PendingPinnedWrite : public aerographene::PinnedModel::Observer,
+                           public ProfileObserver {
+ public:
+  PendingPinnedWrite(
+      Profile* profile,
+      aerographene::PinnedModel* model,
+      std::vector<user_data_importer::ImportedBookmarkEntry> entries)
+      : profile_(profile), model_(model), entries_(std::move(entries)) {
+    profile_observation_.Observe(profile_);
+    observation_.Observe(model_);
+  }
+
+  PendingPinnedWrite(const PendingPinnedWrite&) = delete;
+  PendingPinnedWrite& operator=(const PendingPinnedWrite&) = delete;
+
+  // aerographene::PinnedModel::Observer:
+  void OnPinnedModelLoaded() override { WriteIfLoaded(); }
+  // The folder can also come back (recreated or adopted from Sync) without
+  // OnPinnedModelLoaded.
+  void OnPinnedChanged() override { WriteIfLoaded(); }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    observation_.Reset();
+    profile_observation_.Reset();
+    delete this;
+  }
+
+ private:
+  void WriteIfLoaded() {
+    if (!model_->IsLoaded()) {
+      return;
+    }
+    // Stop observing first: writing notifies this observer again.
+    observation_.Reset();
+    profile_observation_.Reset();
+    WritePinnedEntries(model_,
+                       BookmarkModelFactory::GetForBrowserContext(profile_),
+                       entries_);
+    delete this;
+  }
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<aerographene::PinnedModel> model_;
+  std::vector<user_data_importer::ImportedBookmarkEntry> entries_;
+  base::ScopedObservation<aerographene::PinnedModel,
+                          aerographene::PinnedModel::Observer>
+      observation_{this};
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+};
+
 }  // namespace
 
 ProfileWriter::ProfileWriter(Profile* profile) : profile_(profile) {}
