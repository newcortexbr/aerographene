+// aerographene: static home page (aero_newtab.html), no Mojo, no JS bundle.
+// Replaces NewTabPageThirdPartyUI as the controller behind
+// chrome://new-tab-page-third-party/, the URL that ungoogled-chromium (inox
+// restore-classic-ntp) always maps chrome://newtab to outside incognito, so
+// omnibox display, focus and NTP detection keep working unchanged.
+
+// The only message the page sends: the search field hands focus to the
+// omnibox, the same "fakebox" handoff the upstream NTP uses
+// (search::FocusOmnibox). The page has no search logic of its own.
+class AeroNewTabHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "focusOmnibox",
+        base::BindRepeating(&AeroNewTabHandler::HandleFocusOmnibox,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void HandleFocusOmnibox(const base::ListValue&) {
+    search::FocusOmnibox(/*focus=*/true, web_ui()->GetWebContents());
+  }
+};
