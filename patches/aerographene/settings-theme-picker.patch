+void AppearanceHandler::HandleGetAerographeneThemes(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  aerographene::ListThemes(
+      base::BindOnce(&AppearanceHandler::OnAerographeneThemesListed,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AppearanceHandler::OnAerographeneThemesListed(
+    base::Value callback_id,
+    std::vector<aerographene::ThemeInfo> themes) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  const std::string pref =
+      profile_->GetPrefs()->GetString(aerographene::kThemePref);
+  // A name without a valid folder runs as "default" (ResolveTheme), so the
+  // picker shows "default" for it.
+  std::string active = aerographene::kThemeDefault;
+  base::ListValue list;
+  for (const aerographene::ThemeInfo& info : themes) {
+    if (info.theme.name == pref) {
+      active = pref;
+    }
+    base::DictValue entry;
+    entry.Set("name", info.theme.name);
+    entry.Set("builtin", info.builtin);
+    entry.Set("dark", info.theme.scheme == aerographene::ThemeScheme::kDark);
+    list.Append(std::move(entry));
+  }
+  base::DictValue result;
+  result.Set("themes", std::move(list));
+  result.Set("active", active);
+  ResolveJavascriptCallback(callback_id, result);
+}
+
+void AppearanceHandler::HandleSetAerographeneTheme(
+    const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  // Only names that ListThemes reports (built-ins and valid repository
+  // folders) are accepted; the page never sends a raw path.
+  aerographene::ListThemes(
+      base::BindOnce(&AppearanceHandler::OnAerographeneThemeValidated,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone(),
+                     args[1].GetString()));
+}
+
+void AppearanceHandler::OnAerographeneThemeValidated(
+    base::Value callback_id,
+    std::string name,
+    std::vector<aerographene::ThemeInfo> themes) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  bool found = false;
+  for (const aerographene::ThemeInfo& info : themes) {
+    if (info.theme.name == name) {
+      found = true;
+      break;
+    }
+  }
+  if (found) {
+    // Read once in ThemeService::Init: applies on the next browser start.
+    profile_->GetPrefs()->SetString(aerographene::kThemePref, name);
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(found));
+}
+
 }  // namespace settings
