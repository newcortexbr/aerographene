+// Pinned entry: 30x30 button with the favicon. Live = accent marker on the top
+// right corner; closed = opacity .62 and dashed outline; active tab = accent
+// outline.
+class TopbarPinButton : public views::Button,
+                        public views::ContextMenuController {
+  METADATA_HEADER(TopbarPinButton, views::Button)
+
+ public:
+  using MenuCallback =
+      base::RepeatingCallback<void(const gfx::Point&,
+                                   ui::mojom::MenuSourceType)>;
+
+  TopbarPinButton(PressedCallback callback, MenuCallback menu_callback)
+      : views::Button(std::move(callback)),
+        menu_callback_(std::move(menu_callback)) {
+    set_context_menu_controller(this);
+  }
+  TopbarPinButton(const TopbarPinButton&) = delete;
+  TopbarPinButton& operator=(const TopbarPinButton&) = delete;
+  ~TopbarPinButton() override = default;
+
+  void Update(const aerographene::PinnedItem& item,
+              const gfx::Image& favicon,
+              bool active) {
+    uuid_ = item.uuid;
+    open_ = item.open;
+    active_ = active;
+    favicon_ = favicon.IsEmpty() ? gfx::ImageSkia() : favicon.AsImageSkia();
+    const std::u16string name = GetDisplayName(item);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    SchedulePaint();
+  }
+
+  const base::Uuid& uuid() const { return uuid_; }
+
+  void SetActive(bool active) {
+    if (active_ != active) {
+      active_ = active;
+      SchedulePaint();
+    }
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPinSize, kPinSize);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const gfx::Rect bounds = GetLocalBounds();
+    const int radius = GetRadius();
+    const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+    const SkColor line = colors->GetColor(kColorToolbarSeparator);
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+      flags.setColor(colors->GetColor(kColorToolbarInkDropHover));
+      canvas->DrawRoundRect(bounds, radius, flags);
+    }
+
+    gfx::RectF outline_bounds(bounds);
+    outline_bounds.Inset(0.5f);
+    if (active_) {
+      cc::PaintFlags stroke;
+      stroke.setAntiAlias(true);
+      stroke.setStyle(cc::PaintFlags::kStroke_Style);
+      stroke.setStrokeWidth(1);
+      stroke.setColor(accent);
+      canvas->DrawRoundRect(outline_bounds, radius, stroke);
+    } else if (!open_) {
+      cc::PaintFlags stroke;
+      stroke.setAntiAlias(true);
+      stroke.setStyle(cc::PaintFlags::kStroke_Style);
+      stroke.setStrokeWidth(1);
+      stroke.setColor(SkColorSetA(line, kClosedAlpha));
+      const float dashes[] = {kDash, kDash};
+      stroke.setPathEffect(cc::PathEffect::MakeDash(dashes, 2, 0));
+      canvas->DrawRoundRect(outline_bounds, radius, stroke);
+    }
+
+    const uint8_t alpha = open_ ? SK_AlphaOPAQUE : kClosedAlpha;
+    const gfx::Point center = bounds.CenterPoint();
+    if (!favicon_.isNull()) {
+      canvas->DrawImageInt(favicon_, center.x() - favicon_.width() / 2,
+                           center.y() - favicon_.height() / 2, alpha);
+    } else {
+      cc::PaintFlags dot;
+      dot.setAntiAlias(true);
+      dot.setColor(SkColorSetA(colors->GetColor(ui::kColorIcon), alpha));
+      canvas->DrawCircle(center, kFaviconSize / 4, dot);
+    }
+
+    if (open_) {
+      // Live marker: 6x6 accent square at the top right corner.
+      flags.setColor(accent);
+      canvas->DrawRoundRect(
+          gfx::Rect(bounds.width() - kMarkerInset - kMarkerSize, kMarkerInset,
+                    kMarkerSize, kMarkerSize),
+          IsPixelized() ? 0 : 1, flags);
+    }
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    menu_callback_.Run(point, source_type);
+  }
+
+ private:
+  base::Uuid uuid_;
+  bool open_ = false;
+  bool active_ = false;
+  gfx::ImageSkia favicon_;
+  MenuCallback menu_callback_;
+};
