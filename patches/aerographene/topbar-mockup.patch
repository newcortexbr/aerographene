+AerographeneTopbarRow::AerographeneTopbarRow(
+    BrowserWindowInterface* browser,
+    TabStrip* tab_strip,
+    base::RepeatingClosure on_content_changed)
+    : browser_(browser),
+      tab_strip_(tab_strip),
+      on_content_changed_(std::move(on_content_changed)) {
+  space_row_ = AddChildView(std::make_unique<AerographeneSpaceRow>(browser));
+  model_ = aerographene::PinnedModelFactory::GetForProfile(
+      browser->GetProfile());
+  if (model_) {
+    model_observation_.Observe(model_);
+  }
+  if (TabStripModel* const tab_strip_model = browser->GetTabStripModel()) {
+    tab_strip_model_observation_.Observe(tab_strip_model);
+  }
+  // The owner reads has_content() after construction; no notification yet.
+  Rebuild(/*notify=*/false);
+}
+
+AerographeneTopbarRow::~AerographeneTopbarRow() = default;
+
+bool AerographeneTopbarRow::IsInteractiveAt(const gfx::Point& point) const {
+  for (const views::View* child : children()) {
+    if (child->GetVisible() && child->bounds().Contains(point)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+gfx::Size AerographeneTopbarRow::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, has_content_ ? kHeight : 0);
+}
+
+void AerographeneTopbarRow::Layout(PassKey) {
+  const int height = this->height();
+  int x = kLeadingPadding;
+  if (space_row_->GetVisible()) {
+    const int width = std::min(kSpaceRowWidth, std::max(0, this->width() - x));
+    space_row_->SetBounds(x, (height - kSpaceRowHeight) / 2, width,
+                          kSpaceRowHeight);
+    x += width + kGroupGap;
+  }
+  for (size_t i = 0; i < item_views_.size(); ++i) {
+    views::View* const view = item_views_[i];
+    const gfx::Size size = view->GetPreferredSize();
+    if (i == pin_count_ && i > 0) {
+      x += kGroupGap - kPinGap;
+    }
+    // Entries that do not fit stay reachable through the sidebar mode.
+    const bool fits = x + size.width() <= this->width();
+    view->SetVisible(fits);
+    if (fits) {
+      view->SetBounds(x, (height - size.height()) / 2, size.width(),
+                      size.height());
+    }
+    x += size.width() + kPinGap;
+  }
+  LayoutSuperclass<views::View>(this);
+}
+
+void AerographeneTopbarRow::OnPinnedModelLoaded() {
+  OnPinnedChanged();
+}
+
+void AerographeneTopbarRow::OnPinnedChanged() {
+  // Deferred: a click on an entry can itself change the model, and the button
+  // being pressed must not be destroyed under its own callback.
+  if (rebuild_pending_) {
+    return;
+  }
+  rebuild_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AerographeneTopbarRow::RebuildDeferred,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void AerographeneTopbarRow::RebuildDeferred() {
+  rebuild_pending_ = false;
+  Rebuild(/*notify=*/true);
+}
+
+void AerographeneTopbarRow::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  RefreshActive();
+}
+
+void AerographeneTopbarRow::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  tab_strip_model_observation_.Reset();
+}
+
+void AerographeneTopbarRow::ExecuteCommand(int command_id, int event_flags) {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  if (index < menu_entries_.size()) {
+    ActivateEntry(menu_entries_[index]);
+  }
+}
+
+void AerographeneTopbarRow::Rebuild(bool notify) {
+  for (views::View* view : item_views_) {
+    RemoveChildViewT(view);
+  }
+  item_views_.clear();
+
+  std::vector<aerographene::PinnedItem> items;
+  if (model_ && model_->IsLoaded()) {
+    items = model_->GetPinned();
+  }
+  const base::Uuid active = GetActiveEntry();
+  for (const aerographene::PinnedItem& item : items) {
+    if (item.is_folder || !item.url.is_valid()) {
+      continue;
+    }
+    auto* const pin = AddChildView(std::make_unique<TopbarPinButton>(
+        base::BindRepeating(
+            [](AerographeneTopbarRow* row, base::Uuid uuid,
+               const ui::Event&) { row->ActivateEntry(uuid); },
+            base::Unretained(this), item.uuid),
+        base::BindRepeating(&AerographeneTopbarRow::ShowPinContextMenu,
+                            base::Unretained(this), item.uuid)));
+    pin->Update(item, model_->GetFavicon(item.uuid), item.uuid == active);
+    item_views_.push_back(pin);
+  }
+  pin_count_ = item_views_.size();
+  for (const aerographene::PinnedItem& item : items) {
+    if (!item.is_folder) {
+      continue;
+    }
+    auto* const folder = AddChildView(std::make_unique<TopbarFolderButton>(
+        views::Button::PressedCallback()));
+    folder->SetCallback(base::BindRepeating(
+        [](AerographeneTopbarRow* row, base::Uuid uuid, views::View* anchor,
+           const ui::Event&) { row->ShowFolderMenu(uuid, anchor); },
+        base::Unretained(this), item.uuid, base::Unretained(folder)));
+    folder->Update(item);
+    item_views_.push_back(folder);
+  }
+
+  const bool has_content = !items.empty();
+  SetVisible(has_content);
+  InvalidateLayout();
+  if (has_content != has_content_) {
+    has_content_ = has_content;
+    if (notify && on_content_changed_) {
+      on_content_changed_.Run();
+    }
+  }
+}
