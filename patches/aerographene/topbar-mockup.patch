+namespace {
+
+// aerographene: horizontal (topbar) tab look of the mockup R-r01b, default and
+// pixelized themes. Same vocabulary as the sidebar tab (tab_view.cc): painted
+// with a few rects and one cached bitmap, nothing allocated per frame.
+constexpr int kAeroExtension = 4;  // Same as the detached tab path.
+constexpr int kAeroIndicatorHeight = 2;
+constexpr int kAeroIndicatorInset = 8;
+constexpr int kAeroSeparatorInset = 8;
+constexpr int kAeroRampWidth = 96;
+constexpr int kAeroRampHeight = 32;
+constexpr int kAeroDotSize = 2;
+constexpr int kAeroChipPaddingH = 6;
+constexpr int kAeroChipPaddingV = 2;
+
+bool IsAeroPixelized() {
+  return aerographene::GetBuiltinTheme() ==
+         aerographene::BuiltinTheme::kPixelized;
+}
+
+int GetAeroRadius() {
+  const int radius = views::LayoutProvider::GetAerographeneControlRadius();
+  return radius >= 0 ? radius : 4;
+}
+
+// Bayer 4x4 ordered dither with 2px dots; density grows to the right.
+const gfx::ImageSkia& GetAeroRamp() {
+  static const base::NoDestructor<gfx::ImageSkia> ramp([] {
+    static constexpr uint8_t kBayer[4][4] = {
+        {0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5}};
+    constexpr int kCols = kAeroRampWidth / kAeroDotSize;
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(kAeroRampWidth, kAeroRampHeight);
+    bitmap.eraseColor(SK_ColorTRANSPARENT);
+    for (int y = 0; y < kAeroRampHeight; ++y) {
+      for (int x = 0; x < kAeroRampWidth; ++x) {
+        const int cx = x / kAeroDotSize;
+        const int cy = y / kAeroDotSize;
+        const float density = (cx + 1.0f) / kCols;
+        const float threshold = (kBayer[cy & 3][cx & 3] + 0.5f) / 16.0f;
+        if (threshold < density) {
+          *bitmap.getAddr32(x, y) = SkColorSetRGB(0xF2, 0xF2, 0xF2);
+        }
+      }
+    }
+    return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+  }());
+  return *ramp;
+}
+
+// Draws a topbar tab: inactive has no fill (hover: theme hover color) and a
+// 1px separator in the gap after it; active default = tenuous gradient, 1px
+// outline on top and sides (no bottom line) and a 2px accent bar on top;
+// active pixelized = black block, 1px outline, Bayer ramp at the end and chips
+// behind the name and buttons.
+void PaintAeroHorizontalTab(gfx::Canvas* canvas,
+                            const TabStyleViewDelegate* delegate) {
+  const views::View* const view = delegate->GetView();
+  const ui::ColorProvider* const colors = view->GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const bool pixelized = IsAeroPixelized();
+  const bool active = delegate->IsActive();
+  const bool hovered = delegate->IsHovering();
+  const int radius = GetAeroRadius();
+  const SkColor line = colors->GetColor(kColorToolbarSeparator);
+  const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+
+  // Visible tab: 196x30 inside the view (see TabStyle).
+  const int top = GetLayoutConstant(LayoutConstant::kTabStripPadding);
+  const int height = GetLayoutConstant(LayoutConstant::kTabHeight) - top -
+                     GetLayoutConstant(LayoutConstant::kTabstripToolbarOverlap);
+  const gfx::Rect bounds(kAeroExtension, top,
+                         std::max(0, view->width() - 2 * kAeroExtension),
+                         height);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+
+  if (active) {
+    if (pixelized) {
+      flags.setColor(colors->GetColor(ui::kColorFrameActive));
+      canvas->DrawRoundRect(bounds, radius, flags);
+      canvas->DrawImageInt(
+          GetAeroRamp(), 0, 0, std::min(bounds.width(), kAeroRampWidth),
+          bounds.height(),
+          bounds.x() + std::max(0, bounds.width() - kAeroRampWidth),
+          bounds.y(), std::min(bounds.width(), kAeroRampWidth),
+          bounds.height(), /*filter=*/false);
+      // Chips: name and buttons never sit on the texture.
+      flags.setColor(colors->GetColor(ui::kColorFrameActive));
+      for (const views::View* child : view->children()) {
+        if (!child->GetVisible()) {
+          continue;
+        }
+        gfx::Rect chip;
+        if (const auto* label = views::AsViewClass<views::Label>(child)) {
+          chip = label->bounds();
+          chip.set_width(
+              std::min(chip.width(), label->GetPreferredSize().width()));
+          chip.Outset(gfx::Outsets::VH(kAeroChipPaddingV, kAeroChipPaddingH));
+        } else if (views::Button::AsButton(child)) {
+          chip = child->bounds();
+        } else {
+          continue;
+        }
+        chip.Intersect(bounds);
+        canvas->DrawRect(chip, flags);
+      }
+      cc::PaintFlags stroke;
+      stroke.setAntiAlias(true);
+      stroke.setStyle(cc::PaintFlags::kStroke_Style);
+      stroke.setStrokeWidth(1);
+      stroke.setColor(accent);
+      gfx::RectF outline(bounds);
+      outline.Inset(0.5f);
+      canvas->DrawRoundRect(outline, radius, stroke);
+    } else {
+      flags.setShader(gfx::CreateGradientShader(
+          gfx::Point(0, bounds.y()), gfx::Point(0, bounds.bottom()),
+          SkColorSetARGB(0x24, 0x6C, 0xB6, 0xFF),
+          SkColorSetARGB(0xC7, 0x0A, 0x10, 0x20)));
+      canvas->DrawRoundRect(bounds, radius, flags);
+      flags.setShader(nullptr);
+      // 1px outline on top and sides only.
+      flags.setColor(line);
+      canvas->DrawRect(gfx::Rect(bounds.x(), bounds.y(), bounds.width(), 1),
+                       flags);
+      canvas->DrawRect(gfx::Rect(bounds.x(), bounds.y(), 1, bounds.height()),
+                       flags);
+      canvas->DrawRect(
+          gfx::Rect(bounds.right() - 1, bounds.y(), 1, bounds.height()),
+          flags);
+      // Accent bar on top, inset 8px.
+      flags.setColor(accent);
+      canvas->DrawRect(
+          gfx::Rect(bounds.x() + kAeroIndicatorInset, bounds.y(),
+                    std::max(0, bounds.width() - 2 * kAeroIndicatorInset),
+                    kAeroIndicatorHeight),
+          flags);
+    }
+    return;
+  }
+
+  if (hovered || delegate->IsSelected()) {
+    flags.setColor(
+        colors->GetColor(kColorTabBackgroundInactiveHoverFrameActive));
+    canvas->DrawRoundRect(bounds, radius, flags);
+    return;
+  }
+
+  // Separator in the gap after the tab, hidden next to the active or hovered
+  // tab (mockup: `.tab.sel::after`, `.tab:has(+.tab.sel)::after`, hover).
+  const TabStyleViewDelegate* const next = delegate->GetAdjacentTab(false);
+  if (next && (next->IsActive() || next->IsHovering() || next->IsSelected())) {
+    return;
+  }
+  flags.setColor(line);
+  canvas->DrawRect(
+      gfx::Rect(bounds.right() + 1, bounds.y() + kAeroSeparatorInset, 1,
+                std::max(0, bounds.height() - 2 * kAeroSeparatorInset)),
+      flags);
+}
+
+}  // namespace
+
