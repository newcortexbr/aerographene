+void AerographeneTopbarRow::RefreshActive() {
+  const base::Uuid active = GetActiveEntry();
+  for (views::View* view : item_views_) {
+    if (auto* const pin = views::AsViewClass<TopbarPinButton>(view)) {
+      pin->SetActive(pin->uuid() == active);
+    }
+  }
+}
+
+base::Uuid AerographeneTopbarRow::GetActiveEntry() const {
+  TabStripModel* const tab_strip_model = browser_->GetTabStripModel();
+  aerographene::PinnedTabMirror* const mirror =
+      model_ ? model_->tab_mirror() : nullptr;
+  if (!tab_strip_model || !mirror) {
+    return base::Uuid();
+  }
+  const tabs::TabInterface* const tab = tab_strip_model->GetActiveTab();
+  const std::optional<base::Uuid> entry =
+      tab ? mirror->GetEntryForTab(tab) : std::nullopt;
+  return entry ? *entry : base::Uuid();
+}
+
+void AerographeneTopbarRow::ActivateEntry(const base::Uuid& uuid) {
+  TabStripModel* const tab_strip_model = browser_->GetTabStripModel();
+  aerographene::PinnedTabMirror* const mirror =
+      model_ ? model_->tab_mirror() : nullptr;
+  if (!tab_strip_model || !mirror) {
+    return;
+  }
+  for (int i = 0; i < tab_strip_model->count(); ++i) {
+    const std::optional<base::Uuid> entry =
+        mirror->GetEntryForTab(tab_strip_model->GetTabAtIndex(i));
+    if (entry && *entry == uuid) {
+      tab_strip_model->ActivateTabAt(i);
+      return;
+    }
+  }
+  // Closed entry (no-op when it is open in another window).
+  mirror->OpenClosedEntry(browser_, uuid);
+}
+
+void AerographeneTopbarRow::ShowPinContextMenu(
+    const base::Uuid& uuid,
+    const gfx::Point& screen_point,
+    ui::mojom::MenuSourceType source_type) {
+  TabStripModel* const tab_strip_model = browser_->GetTabStripModel();
+  aerographene::PinnedTabMirror* const mirror =
+      model_ ? model_->tab_mirror() : nullptr;
+  if (!tab_strip_model || !mirror || !tab_strip_) {
+    return;
+  }
+  // Open entries only: the regular tab menu (unpin, rename, close...) of the
+  // hidden pinned tab. Closed entries have no menu in this row.
+  for (int i = 0; i < tab_strip_model->count(); ++i) {
+    const std::optional<base::Uuid> entry =
+        mirror->GetEntryForTab(tab_strip_model->GetTabAtIndex(i));
+    if (entry && *entry == uuid) {
+      if (Tab* const tab = tab_strip_->tab_at(i)) {
+        tab_strip_->ShowContextMenuForTab(tab, screen_point, source_type);
+      }
+      return;
+    }
+  }
+}
+
+void AerographeneTopbarRow::ShowFolderMenu(const base::Uuid& uuid,
+                                           views::View* anchor) {
+  if (!model_ || !anchor || !GetWidget()) {
+    return;
+  }
+  const std::optional<aerographene::PinnedItem> folder = model_->Find(uuid);
+  if (!folder || folder->children.empty()) {
+    return;
+  }
+  menu_entries_.clear();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (const aerographene::PinnedItem& child : folder->children) {
+    menu_model_->AddItem(static_cast<int>(menu_entries_.size()) + 1,
+                         GetDisplayName(child));
+    const gfx::Image favicon = model_->GetFavicon(child.uuid);
+    if (!favicon.IsEmpty()) {
+      menu_model_->SetIcon(menu_model_->GetItemCount() - 1,
+                           ui::ImageModel::FromImage(favicon));
+    }
+    menu_entries_.push_back(child.uuid);
+  }
+  // Below the folder button.
+  const gfx::Rect anchor_rect = anchor->GetBoundsInScreen();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::NO_FLAGS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor_rect,
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kMouse);
+}
