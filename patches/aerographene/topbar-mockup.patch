+// Drawer folder: theme folder glyph in the accent, name, chevron › at the end.
+class TopbarFolderButton : public views::Button {
+  METADATA_HEADER(TopbarFolderButton, views::Button)
+
+ public:
+  explicit TopbarFolderButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {}
+  TopbarFolderButton(const TopbarFolderButton&) = delete;
+  TopbarFolderButton& operator=(const TopbarFolderButton&) = delete;
+  ~TopbarFolderButton() override = default;
+
+  void Update(const aerographene::PinnedItem& item) {
+    text_ = GetDisplayName(item);
+    text_width_ = std::min(kFolderMaxTextWidth,
+                           gfx::GetStringWidth(text_, gfx::FontList()));
+    SetTooltipText(text_);
+    GetViewAccessibility().SetName(text_);
+    GetViewAccessibility().SetIsCollapsed();
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(2 * kFolderPadding + 2 * kFolderIconSize +
+                         2 * kFolderIconGap + text_width_,
+                     kFolderHeight);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const gfx::Rect bounds = GetLocalBounds();
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    if (hovered) {
+      cc::PaintFlags fill;
+      fill.setAntiAlias(true);
+      fill.setColor(colors->GetColor(kColorToolbarInkDropHover));
+      canvas->DrawRoundRect(bounds, GetRadius(), fill);
+    }
+    const SkColor text_color = colors->GetColor(
+        hovered ? kColorTabForegroundActiveFrameActive
+                : kColorTabForegroundInactiveFrameActive);
+    const int icon_y = bounds.y() + (bounds.height() - kFolderIconSize) / 2;
+    const int icon_x = bounds.x() + kFolderPadding;
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(vector_icons::kFolderFlippableIcon,
+                              kFolderIconSize,
+                              colors->GetColor(ui::kColorSysPrimary)),
+        GetMirroredXWithWidthInView(icon_x, kFolderIconSize), icon_y);
+    const int chevron_x = bounds.right() - kFolderPadding - kFolderIconSize;
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(vector_icons::kKeyboardArrowRightFlippableIcon,
+                              kFolderIconSize, text_color),
+        GetMirroredXWithWidthInView(chevron_x, kFolderIconSize), icon_y);
+    const int text_x = icon_x + kFolderIconSize + kFolderIconGap;
+    canvas->DrawStringRect(
+        text_, gfx::FontList(), text_color,
+        GetMirroredRect(gfx::Rect(
+            text_x, bounds.y(),
+            std::max(0, chevron_x - kFolderIconGap - text_x),
+            bounds.height())));
+  }
+
+ private:
+  std::u16string text_;
+  int text_width_ = 0;
+};
