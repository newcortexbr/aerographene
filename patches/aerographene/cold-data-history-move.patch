   DeleteEffects deleted_effects;
   DeleteVisitRelatedInfo(deleted_visits, &deleted_effects);
   ExpireURLsForVisits(deleted_visits, &deleted_effects);
   DeleteFaviconsIfPossible(&deleted_effects);
 
+  // aerographene: url rows that stayed hot (visits left, pinned) are dropped
+  // from the cold copy, so each URL lives in one place.
+  if (!deleted_effects.modified_urls.empty()) {
+    if (ColdHistoryDatabase* cold = GetColdDatabase(/*create=*/false)) {
+      std::set<URLID> kept_hot;
+      for (const URLRow& row : deleted_effects.modified_urls) {
