+
+void ExpireHistoryBackend::SetColdDatabasePath(const base::FilePath& path) {
+  cold_db_.reset();
+  cold_db_path_ = path;
+}
+
+ColdHistoryDatabase* ExpireHistoryBackend::GetColdDatabase(bool create) {
+  if (cold_db_path_.empty()) {
+    return nullptr;
+  }
+  if (!cold_db_) {
+    cold_db_ = std::make_unique<ColdHistoryDatabase>(cold_db_path_);
+  }
+  return cold_db_->Open(create) ? cold_db_.get() : nullptr;
+}
+
+void ExpireHistoryBackend::DeleteColdDatabase() {
+  if (cold_db_path_.empty()) {
+    return;
+  }
+  if (!cold_db_) {
+    cold_db_ = std::make_unique<ColdHistoryDatabase>(cold_db_path_);
+  }
+  cold_db_->CloseAndDelete();
+  cold_db_.reset();
+}
+
+bool ExpireHistoryBackend::CopyToCold(const VisitVector& visits,
+                                      std::set<URLID>* copied_url_ids) {
+  ColdHistoryDatabase* cold = GetColdDatabase(/*create=*/true);
+  if (!cold || !cold->BeginTransaction()) {
+    return false;
+  }
+  bool ok = true;
+  for (const VisitRow& visit : visits) {
+    ok = ok && cold->AddVisitRowKeepingID(visit);
+    if (!ok || !copied_url_ids->insert(visit.url_id).second) {
+      continue;
+    }
+    // Every url row is copied here; the ones that stay hot (other visits
+    // left, pinned) are removed from the cold copy after the hot pass.
+    URLRow url_row;
+    if (main_db_->GetURLRow(visit.url_id, &url_row)) {
+      ok = cold->AddURLRowKeepingID(url_row);
+    }
+    KeywordSearchTermRow term;
+    if (ok && main_db_->GetKeywordSearchTermRow(visit.url_id, &term)) {
+      ok = cold->AddKeywordSearchTerm(term);
+    }
+  }
+  if (!ok || !cold->CommitTransaction()) {
+    cold->RollbackTransaction();
+    return false;
+  }
+  return true;
 }
 
