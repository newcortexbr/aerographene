aerographene: perf-pinned-small. Sem mudança de comportamento.
1) AerographenePinnedFolderView::Update só reaplica tooltip, nome de
acessibilidade, estado expandido e SchedulePaint quando texto ou expanded
mudam (ou na primeira chamada).
2) IsPinnedFolder (bookmark_bar_view.cc, bookmark_menu_delegate.cc) lê a meta
info sem copiar a string: GetMetaInfoMap() + find, comparando string_view.
Depende de pinned-folder, pinned-barskip, perf-startup-layout.

--- a/chrome/browser/ui/views/bookmarks/bookmark_bar_view.cc
+++ b/chrome/browser/ui/views/bookmarks/bookmark_bar_view.cc
@@ -301,9 +301,16 @@
 // aerographene::kPinnedMetaKey (pinned_model.h), duplicated to avoid a
 // dependency from views/bookmarks on ui/tabs.
 bool IsPinnedFolder(const BookmarkNode* node) {
-  std::string value;
-  return node->is_folder() &&
-         node->GetMetaInfo("aerographene.pinned", &value) && value == "1";
+  if (!node->is_folder()) {
+    return false;
+  }
+  // No-copy read: GetMetaInfo() would copy the value string on every call.
+  const BookmarkNode::MetaInfoMap* map = node->GetMetaInfoMap();
+  if (!map) {
+    return false;
+  }
+  const auto it = map->find("aerographene.pinned");
+  return it != map->end() && std::string_view(it->second) == "1";
 }
 }  // namespace
 
