+html {
+  /* aerographene (settings-oneui): One UI look. Surfaces come from the
+   * theme tokens, so light and dark follow the browser theme. */
+  --oneui-page: var(--color-settings-webui-page-background,
+      var(--color-webui-page-background, Canvas));
+  --oneui-card: color-mix(in srgb, var(--cr-primary-text-color) 7%,
+      var(--oneui-page));
+  --oneui-field: color-mix(in srgb, var(--cr-primary-text-color) 13%,
+      var(--oneui-page));
+  --oneui-line: color-mix(in srgb, var(--cr-primary-text-color) 9%,
+      transparent);
+  --oneui-card-radius: 28px;
+  --oneui-pill-radius: 20px;
+  --oneui-toggle-zoom: 1.8;
+  --oneui-toggle-bar-width: 29px;
+  --oneui-toggle-knob: 12px;
+  --oneui-select-bg: var(--oneui-field);
+  --oneui-select-border: none;
+  --oneui-select-height: 40px;
+  --oneui-select-font-size: 14px;
+  --oneui-select-pad: 18px;
+  --oneui-button-bg: var(--oneui-field);
+  --oneui-swatch-radius: 18px;
+  --oneui-avatar-radius: 24px;
+  --cr-button-border: none;
+  --cr-button-height: 38px;
+  --cr-icon-button-hover-background-color: var(--oneui-field);
+  --cr-section-min-height: 56px;
+  --cr-section-two-line-min-height: 68px;
+  --cr-section-padding: 22px;
+  --cr-section-vertical-padding: 12px;
+  --cr-section-vertical-margin: 20px;
+  --cr-section-indent-width: 26px;
+  --cr-separator-color: var(--oneui-line);
+  --cr-toolbar-search-field-background: var(--oneui-card);
+}
+
+/* The theme block of colors.css is html:not(#z); two :not() win over it. */
+html:not(#a):not(#b) {
+  --cr-card-background-color: var(--oneui-card);
+  --cr-card-border-radius: var(--oneui-card-radius);
+  --cr-card-shadow: none;
+}
