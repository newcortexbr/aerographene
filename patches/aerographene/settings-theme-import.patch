--- /dev/null
+++ b/chrome/browser/themes/aerographene_theme_archive.cc
@@ -0,0 +1,203 @@
+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/themes/aerographene_theme_archive.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "build/build_config.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include "base/win/scoped_handle.h"
+#else
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "base/files/scoped_file.h"
+#include "base/posix/eintr_wrapper.h"
+#endif  // BUILDFLAG(IS_WIN)
+
+namespace aerographene {
+
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+// Reads a small disk file (pool task, MayBlock). GetFileType keeps a pipe,
+// console or other device from blocking the task (the O_NONBLOCK + S_ISREG of
+// the POSIX branch). The link itself is opened (FILE_FLAG_OPEN_REPARSE_POINT)
+// and a reparse point or directory is refused, stricter than the POSIX
+// branch; the size is checked before and while reading.
+std::optional<std::string> ReadArchiveBytes(const base::FilePath& path) {
+  base::win::ScopedHandle file(::CreateFileW(
+      path.value().c_str(), GENERIC_READ,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+      OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT,
+      nullptr));
+  if (!file.is_valid() || ::GetFileType(file.get()) != FILE_TYPE_DISK) {
+    return std::nullopt;
+  }
+  BY_HANDLE_FILE_INFORMATION info;
+  if (!::GetFileInformationByHandle(file.get(), &info) ||
+      (info.dwFileAttributes &
+       (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) ||
+      info.nFileSizeHigh != 0 || info.nFileSizeLow == 0 ||
+      info.nFileSizeLow > kMaxThemeArchiveBytes) {
+    return std::nullopt;
+  }
+  std::string data;
+  char buf[4096];
+  while (true) {
+    DWORD n = 0;
+    if (!::ReadFile(file.get(), buf, sizeof(buf), &n, nullptr)) {
+      return std::nullopt;
+    }
+    if (n == 0) {
+      break;
+    }
+    data.append(buf, n);
+    if (data.size() > kMaxThemeArchiveBytes) {
+      return std::nullopt;
+    }
+  }
+  return data;
+}
+#else
+// Reads a small regular file. O_NONBLOCK + fstat keep a FIFO or device from
+// blocking the task; the size is checked before and while reading.
+std::optional<std::string> ReadArchiveBytes(const base::FilePath& path) {
+  base::ScopedFD fd(
+      open(path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK));
+  if (!fd.is_valid()) {
+    return std::nullopt;
+  }
+  struct stat st;
+  if (fstat(fd.get(), &st) != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0 ||
+      static_cast<size_t>(st.st_size) > kMaxThemeArchiveBytes) {
+    return std::nullopt;
+  }
+  std::string data;
+  char buf[4096];
+  while (true) {
+    const ssize_t n = HANDLE_EINTR(read(fd.get(), buf, sizeof(buf)));
+    if (n < 0) {
+      return std::nullopt;
+    }
+    if (n == 0) {
+      break;
+    }
+    data.append(buf, static_cast<size_t>(n));
+    if (data.size() > kMaxThemeArchiveBytes) {
+      return std::nullopt;
+    }
+  }
+  return data;
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+struct ArchiveRead {
+  ThemeArchiveResult result = ThemeArchiveResult::kUnreadable;
+  std::string json;
+};
+
+ArchiveRead ReadOnPool(base::FilePath path) {
+  ArchiveRead read;
+  read.result = ReadThemeArchive(path, &read.json);
+  return read;
+}
+
+ImportResult ToImportResult(InstallResult result) {
+  switch (result) {
+    case InstallResult::kInstalled:
+      return ImportResult::kInstalled;
+    case InstallResult::kInvalid:
+      return ImportResult::kInvalid;
+    case InstallResult::kReserved:
+      return ImportResult::kReserved;
+    case InstallResult::kConflict:
+      return ImportResult::kConflict;
+    case InstallResult::kIoError:
+      return ImportResult::kIoError;
+  }
+  return ImportResult::kIoError;
+}
+
+void OnArchiveRead(bool replace, ImportCallback callback, ArchiveRead read) {
+  if (read.result != ThemeArchiveResult::kOk) {
+    std::move(callback).Run(ImportResult::kBadArchive, std::string(),
+                            std::string());
+    return;
+  }
+  InstallThemeJson(std::move(read.json), replace, std::move(callback));
+}
+
+}  // namespace
+
+ThemeArchiveResult ReadThemeArchive(const base::FilePath& path,
+                                    std::string* json) {
+  const std::optional<std::string> data = ReadArchiveBytes(path);
+  if (!data) {
+    return ThemeArchiveResult::kUnreadable;
+  }
+  zip::ZipReader reader;
+  // `data` outlives `reader` (weak reference).
+  if (!reader.OpenFromString(*data)) {
+    return ThemeArchiveResult::kNotZip;
+  }
+  if (reader.num_entries() != 1) {
+    return ThemeArchiveResult::kBadLayout;
+  }
+  const zip::ZipReader::Entry* entry = reader.Next();
+  if (!entry) {
+    return ThemeArchiveResult::kNotZip;
+  }
+  if (entry->is_directory || entry->is_unsafe || entry->is_encrypted ||
+      entry->is_symbolic_link || entry->path != base::FilePath::FromASCII(kThemeFileName)) {
+    return ThemeArchiveResult::kBadLayout;
+  }
+  // The declared size cannot be trusted; extraction stops at the cap, so a
+  // zip bomb costs at most kMaxThemeFileBytes + 1 of memory.
+  std::string out;
+  if (!reader.ExtractCurrentEntryToString(kMaxThemeFileBytes, &out)) {
+    return out.size() >= kMaxThemeFileBytes ? ThemeArchiveResult::kTooLarge
+                                            : ThemeArchiveResult::kNotZip;
+  }
+  if (reader.Next() || !reader.ok()) {
+    return ThemeArchiveResult::kBadLayout;
+  }
+  *json = std::move(out);
+  return ThemeArchiveResult::kOk;
+}
+
+void InstallThemeJson(std::string json, bool replace, ImportCallback callback) {
+  std::string copy = json;
+  InstallTheme(std::move(copy), replace,
+               base::BindOnce(
+                   [](ImportCallback callback, std::string json,
+                      InstallResult result, std::string name) {
+                     std::move(callback).Run(ToImportResult(result),
+                                             std::move(name), std::move(json));
+                   },
+                   std::move(callback), std::move(json)));
+}
+
+void ImportThemeArchive(const base::FilePath& path,
+                        bool replace,
+                        ImportCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadOnPool, path),
+      base::BindOnce(&OnArchiveRead, replace, std::move(callback)));
+}
+
+}  // namespace aerographene
diff --git a/chrome/browser/themes/aerographene_theme_archive.h b/chrome/browser/themes/aerographene_theme_archive.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/themes/aerographene_theme_archive.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_ARCHIVE_H_
+#define CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_ARCHIVE_H_
+
+#include <stddef.h>
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "chrome/browser/themes/aerographene_theme_repo.h"
+
+namespace aerographene {
+
+// A .aerotheme file is a zip with exactly one entry, "theme.json" at the root.
+inline constexpr char kThemeArchiveExtension[] = "aerotheme";
+// Cap on the .aerotheme file itself: a stored (uncompressed) theme.json of
+// kMaxThemeFileBytes plus zip headers fits; anything bigger is rejected
+// before it is parsed.
+inline constexpr size_t kMaxThemeArchiveBytes = kMaxThemeFileBytes + 4 * 1024;
+
+enum class ThemeArchiveResult {
+  kOk,
+  kUnreadable,  // missing, not a regular file, or larger than the cap
+  kNotZip,      // not a zip that minizip can open
+  kBadLayout,   // not exactly one plain "theme.json" entry at the root
+                // (extra entries, directories, paths, symlinks, encryption)
+  kTooLarge,    // theme.json inflates past kMaxThemeFileBytes (zip bomb)
+};
+
+// Blocking: reads `path` and extracts theme.json into `json` (unchanged
+// unless kOk). Does not validate the JSON. Never call on the UI thread.
+ThemeArchiveResult ReadThemeArchive(const base::FilePath& path,
+                                    std::string* json);
+
+enum class ImportResult {
+  kInstalled,
+  kBadArchive,  // ReadThemeArchive failed
+  kInvalid,     // theme.json fails ParseThemeJson
+  kReserved,    // name is default/pixelized
+  kConflict,    // same name (case-insensitive) exists and replace == false
+  kIoError,
+};
+
+// Imports a .aerotheme into the global repository: reads the archive on a
+// thread-pool task (MayBlock), then InstallTheme(json, replace). `callback`
+// gets the result, the theme name ("" when unknown) and the extracted
+// theme.json ("" on kBadArchive), on the calling sequence. On kConflict the
+// caller asks the user and calls InstallThemeJson(json, true, ...) with the
+// json it got, so the file is not read again. Shared by the settings page
+// and --import-theme.
+using ImportCallback =
+    base::OnceCallback<void(ImportResult, std::string name, std::string json)>;
+void ImportThemeArchive(const base::FilePath& path,
+                        bool replace,
+                        ImportCallback callback);
+
+// InstallTheme(json, replace) with ImportResult values; `callback` gets the
+// json back as well.
+void InstallThemeJson(std::string json, bool replace, ImportCallback callback);
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_ARCHIVE_H_
diff --git a/chrome/browser/themes/aerographene_theme_archive_unittest.cc b/chrome/browser/themes/aerographene_theme_archive_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/themes/aerographene_theme_archive_unittest.cc
@@ -0,0 +1,166 @@
+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/themes/aerographene_theme_archive.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "chrome/browser/themes/aerographene_theme_repo.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zlib/google/zip.h"
+
+namespace aerographene {
+namespace {
+
+constexpr char kTheme[] = R"({"name": "Meu Tema", "radius": 0})";
+
+class AerographeneThemeArchiveTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_.CreateUniqueTempDir());
+    repo_ = temp_.GetPath().AppendASCII("repo");
+    SetThemeRepoDirForTesting(repo_);
+  }
+  void TearDown() override { SetThemeRepoDirForTesting(base::FilePath()); }
+
+  // Zips the contents of a fresh folder filled by `fill` into `name`.
+  base::FilePath MakeZip(const std::string& name,
+                         void (*fill)(const base::FilePath& dir)) {
+    const base::FilePath src = temp_.GetPath().AppendASCII(name + ".src");
+    EXPECT_TRUE(base::CreateDirectory(src));
+    fill(src);
+    const base::FilePath zip = temp_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(zip::Zip(src, zip, /*include_hidden_files=*/true));
+    return zip;
+  }
+
+  static void WriteTheme(const base::FilePath& dir) {
+    ASSERT_TRUE(base::WriteFile(dir.AppendASCII("theme.json"), kTheme));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir temp_;
+  base::FilePath repo_;
+};
+
+TEST_F(AerographeneThemeArchiveTest, ReadsSingleThemeJson) {
+  std::string json;
+  EXPECT_EQ(ReadThemeArchive(MakeZip("ok.aerotheme", &WriteTheme), &json),
+            ThemeArchiveResult::kOk);
+  EXPECT_EQ(json, kTheme);
+}
+
+TEST_F(AerographeneThemeArchiveTest, RejectsExtraEntries) {
+  std::string json = "unchanged";
+  const base::FilePath zip =
+      MakeZip("extra.aerotheme", [](const base::FilePath& dir) {
+        WriteTheme(dir);
+        ASSERT_TRUE(base::WriteFile(dir.AppendASCII("icon.png"), "x"));
+      });
+  EXPECT_EQ(ReadThemeArchive(zip, &json), ThemeArchiveResult::kBadLayout);
+  EXPECT_EQ(json, "unchanged");
+}
+
+TEST_F(AerographeneThemeArchiveTest, RejectsNestedOrRenamedEntry) {
+  std::string json;
+  EXPECT_EQ(ReadThemeArchive(
+                MakeZip("nested.aerotheme",
+                        [](const base::FilePath& dir) {
+                          const base::FilePath sub = dir.AppendASCII("t");
+                          ASSERT_TRUE(base::CreateDirectory(sub));
+                          WriteTheme(sub);
+                        }),
+                &json),
+            ThemeArchiveResult::kBadLayout);
+  EXPECT_EQ(ReadThemeArchive(
+                MakeZip("renamed.aerotheme",
+                        [](const base::FilePath& dir) {
+                          ASSERT_TRUE(base::WriteFile(
+                              dir.AppendASCII("Theme.json"), kTheme));
+                        }),
+                &json),
+            ThemeArchiveResult::kBadLayout);
+}
+
+TEST_F(AerographeneThemeArchiveTest, RejectsInflatedTooLarge) {
+  // Highly compressible: tiny archive, theme.json above the cap once inflated.
+  std::string json;
+  EXPECT_EQ(ReadThemeArchive(
+                MakeZip("bomb.aerotheme",
+                        [](const base::FilePath& dir) {
+                          ASSERT_TRUE(base::WriteFile(
+                              dir.AppendASCII("theme.json"),
+                              std::string(kMaxThemeFileBytes + 1, ' ')));
+                        }),
+                &json),
+            ThemeArchiveResult::kTooLarge);
+}
+
+TEST_F(AerographeneThemeArchiveTest, RejectsNotZipMissingAndOversized) {
+  std::string json;
+  const base::FilePath junk = temp_.GetPath().AppendASCII("junk.aerotheme");
+  ASSERT_TRUE(base::WriteFile(junk, "not a zip"));
+  EXPECT_EQ(ReadThemeArchive(junk, &json), ThemeArchiveResult::kNotZip);
+
+  EXPECT_EQ(ReadThemeArchive(temp_.GetPath().AppendASCII("none"), &json),
+            ThemeArchiveResult::kUnreadable);
+  EXPECT_EQ(ReadThemeArchive(temp_.GetPath(), &json),
+            ThemeArchiveResult::kUnreadable);
+
+  const base::FilePath big = temp_.GetPath().AppendASCII("big.aerotheme");
+  ASSERT_TRUE(base::WriteFile(big, std::string(kMaxThemeArchiveBytes + 1, 0)));
+  EXPECT_EQ(ReadThemeArchive(big, &json), ThemeArchiveResult::kUnreadable);
+}
+
+TEST_F(AerographeneThemeArchiveTest, ImportInstallsThenConflicts) {
+  const base::FilePath zip = MakeZip("ok.aerotheme", &WriteTheme);
+  {
+    base::test::TestFuture<ImportResult, std::string, std::string> future;
+    ImportThemeArchive(zip, false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), ImportResult::kInstalled);
+    EXPECT_EQ(future.Get<1>(), "Meu Tema");
+  }
+  EXPECT_TRUE(
+      base::PathExists(repo_.AppendASCII("Meu Tema").AppendASCII("theme.json")));
+  std::string json;
+  {
+    base::test::TestFuture<ImportResult, std::string, std::string> future;
+    ImportThemeArchive(zip, false, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), ImportResult::kConflict);
+    json = future.Get<2>();
+  }
+  EXPECT_EQ(json, kTheme);
+  // Replace uses the json already read: the archive may be gone by then.
+  ASSERT_TRUE(base::DeleteFile(zip));
+  {
+    base::test::TestFuture<ImportResult, std::string, std::string> future;
+    InstallThemeJson(json, true, future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), ImportResult::kInstalled);
+    EXPECT_EQ(future.Get<1>(), "Meu Tema");
+  }
+  {
+    base::test::TestFuture<ImportResult, std::string, std::string> future;
+    ImportThemeArchive(temp_.GetPath().AppendASCII("none"), false,
+                       future.GetCallback());
+    EXPECT_EQ(future.Get<0>(), ImportResult::kBadArchive);
+  }
+}
+
+TEST_F(AerographeneThemeArchiveTest, ImportRejectsReservedName) {
+  const base::FilePath zip =
+      MakeZip("reserved.aerotheme", [](const base::FilePath& dir) {
+        ASSERT_TRUE(base::WriteFile(dir.AppendASCII("theme.json"),
+                                    R"({"name": "Default"})"));
+      });
+  base::test::TestFuture<ImportResult, std::string, std::string> future;
+  ImportThemeArchive(zip, true, future.GetCallback());
+  EXPECT_EQ(future.Get<0>(), ImportResult::kReserved);
+}
+
+}  // namespace
+}  // namespace aerographene
