+void AppearanceHandler::HandleImportAerographeneTheme(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (select_file_dialog_) {
+    // A picker is already open; this call does nothing.
+    ResolveAerographeneImport(args[0], "canceled", std::string());
+    return;
+  }
+  conflict_json_.clear();
+  import_callback_id_ = args[0].Clone();
+  content::WebContents* web_contents = web_ui()->GetWebContents();
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents));
+  ui::SelectFileDialog::FileTypeInfo file_type_info;
+  file_type_info.extensions.resize(1);
+  file_type_info.extensions[0].push_back(
+      base::FilePath::FromASCII(aerographene::kThemeArchiveExtension)
+          .value());
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+      base::FilePath(), &file_type_info, 1, base::FilePath::StringType(),
+      web_contents->GetTopLevelNativeWindow(), nullptr);
+}
+
+void AppearanceHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                     int /*index*/) {
+  select_file_dialog_ = nullptr;
+  // Reading and validation run off the UI thread (thread pool, MayBlock).
+  aerographene::ImportThemeArchive(
+      file.path(), /*replace=*/false,
+      base::BindOnce(&AppearanceHandler::OnAerographeneThemeImported,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     std::move(import_callback_id_)));
+  import_callback_id_ = base::Value();
+}
+
+void AppearanceHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  if (IsJavascriptAllowed() && !import_callback_id_.is_none()) {
+    ResolveAerographeneImport(import_callback_id_, "canceled", std::string());
+  }
+  import_callback_id_ = base::Value();
+}
+
+void AppearanceHandler::HandleReplaceAerographeneTheme(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (conflict_json_.empty()) {
+    ResolveAerographeneImport(args[0], "canceled", std::string());
+    return;
+  }
+  std::string json = std::move(conflict_json_);
+  conflict_json_.clear();
+  // The json validated before the conflict, not a second read of the file.
+  aerographene::InstallThemeJson(
+      std::move(json), /*replace=*/true,
+      base::BindOnce(&AppearanceHandler::OnAerographeneThemeImported,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AppearanceHandler::OnAerographeneThemeImported(
+    base::Value callback_id,
+    aerographene::ImportResult result,
+    std::string name,
+    std::string json) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  std::string_view status = "ioError";
+  switch (result) {
+    case aerographene::ImportResult::kInstalled:
+      status = "installed";
+      break;
+    case aerographene::ImportResult::kConflict:
+      status = "conflict";
+      conflict_json_ = std::move(json);
+      break;
+    case aerographene::ImportResult::kBadArchive:
+      status = "badArchive";
+      break;
+    case aerographene::ImportResult::kInvalid:
+      status = "invalid";
+      break;
+    case aerographene::ImportResult::kReserved:
+      status = "reserved";
+      break;
+    case aerographene::ImportResult::kIoError:
+      status = "ioError";
+      break;
+  }
+  ResolveAerographeneImport(callback_id, status, name);
+}
+
+void AppearanceHandler::ResolveAerographeneImport(
+    const base::Value& callback_id,
+    std::string_view result,
+    const std::string& name) {
+  base::DictValue response;
+  response.Set("result", result);
+  response.Set("name", name);
+  ResolveJavascriptCallback(callback_id, response);
+}
+
 }  // namespace settings
