+base::OnceCallback<void(BrowserWindowInterface*)>
+AerographeneWrapSwitchInPlace(
+    const base::FilePath& target_path,
+    base::OnceCallback<void(BrowserWindowInterface*)> callback) {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  BrowserWindowInterface* source =
+      GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  if (source && source->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+      source->GetProfile()->GetPath() != target_path) {
+    return base::BindOnce(&AerographeneSwitchInPlace, source->GetWeakPtr(),
+                          std::move(callback));
+  }
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  return callback;
+}
