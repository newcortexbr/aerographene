+void PinnedTabContainerView::SetTabSpan(const views::View* child, int span) {
+  if (span <= 1) {
+    tab_spans_.erase(child);
+  } else {
+    tab_spans_[child] = span;
+  }
+  InvalidateLayout();
+}
+
+int PinnedTabContainerView::GetTabSpan(const views::View* child) const {
+  const auto it = tab_spans_.find(child);
+  return it == tab_spans_.end() ? 1 : it->second;
+}
