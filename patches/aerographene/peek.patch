--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -4261,6 +4261,55 @@ void BrowserView::OnWidgetActivationChan
   browser_->GetFeatures()
       .extension_keybinding_registry()
       ->OnHostActivationChanged(active);
+
+  // aerographene: peek. A popup aberta pelo peek (marcada em
+  // BrowserWebContentsDelegate::AddNewContents) fecha quando outra janela do
+  // próprio navegador ganha a ativação. Perder a ativação para outro app
+  // (Alt+Tab, gerenciador de senhas, 2FA) não fecha. Também não fecha se o
+  // foco foi para um widget dela (diálogo, bolha, menu). A checagem é adiada
+  // para a ativação do novo widget já ter sido aplicada.
+  if (!active &&
+      browser_->GetType() == BrowserWindowInterface::Type::TYPE_POPUP &&
+      base::FeatureList::IsEnabled(features::kAerographenePeek) &&
+      GetActiveWebContents() &&
+      GetActiveWebContents()->GetUserData(&features::kAerographenePeek)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<BrowserView> view) {
+                         if (!view || !view->GetWidget()) {
+                           return;
+                         }
+                         views::Widget* widget = view->GetWidget();
+                         if (widget->IsActive() ||
+                             WidgetHasChildModalDialog(widget)) {
+                           return;
+                         }
+                         for (views::Widget* owned :
+                              views::Widget::GetAllOwnedWidgets(
+                                  widget->GetNativeView())) {
+                           if (owned != widget && owned->IsActive()) {
+                             return;
+                           }
+                         }
+                         // Só fecha se outra janela deste navegador está
+                         // ativa; se a ativação foi para outro app, mantém.
+                         bool other_browser_active = false;
+                         GlobalBrowserCollection::GetInstance()->ForEach(
+                             [&](BrowserWindowInterface* other) {
+                               if (other != view->browser() &&
+                                   other->GetWindow() &&
+                                   other->GetWindow()->IsActive()) {
+                                 other_browser_active = true;
+                                 return false;
+                               }
+                               return true;
+                             });
+                         if (other_browser_active) {
+                           widget->Close();
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
 }
 
