+  // aerographene: peek. Uma nova janela pedida pela página com gesto do
+  // usuário (target=_blank, window.open sem features) abre como popup leve,
+  // sem criar aba. Ctrl/meio-clique chegam por OpenURLFromTab como
+  // NEW_BACKGROUND_TAB e continuam abrindo aba. Ctrl+Shift+Y ou "Show as
+  // tab" promovem; perder o foco fecha (BrowserView).
+  if (base::FeatureList::IsEnabled(features::kAerographenePeek) &&
+      !app_browser_controller_ && user_gesture &&
+      // window.open mantém opener (OAuth/postMessage precisa dele) e link
+      // target=_blank sem opener é o caso do peek; com opener abre normal.
+      !new_contents->HasOpener() &&
+      disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+      browser_->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL) {
+    disposition = WindowOpenDisposition::NEW_POPUP;
+    // Marca o conteúdo para BrowserView fechar a popup ao perder o foco.
+    new_contents->SetUserData(
+        &features::kAerographenePeek,
+        std::make_unique<base::SupportsUserData::Data>());
+    // Tamanho próprio: 70% x 85% da janela de origem, centrada nela. Sem
+    // isso a popup herdaria o tamanho padrão do WindowSizer. Em Wayland o
+    // compositor pode ignorar a posição; o tamanho vale.
+    const gfx::Rect parent = window_->GetBounds();
+    if (!parent.IsEmpty()) {
+      gfx::Rect peek(parent.width() * 7 / 10, parent.height() * 85 / 100);
+      peek.set_origin(parent.CenterPoint() -
+                      gfx::Vector2d(peek.width() / 2, peek.height() / 2));
+      window_features.bounds = peek;
+      window_features.has_x = window_features.has_y = true;
+      window_features.has_width = window_features.has_height = true;
+    }
+  }
