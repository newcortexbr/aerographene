+void RegisterBundledFonts() {
+  static bool registered = false;
+  if (registered) {
+    return;
+  }
+  registered = true;
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return;
+  }
+  const base::FilePath fonts_dir = exe_dir.Append(FILE_PATH_LITERAL("fonts"));
+  for (const wchar_t* name :
+       {L"JetBrainsMono-Regular.ttf", L"JetBrainsMono-Bold.ttf"}) {
+    // FR_PRIVATE: visible only to this process, removed when it exits.
+    ::AddFontResourceExW(fonts_dir.Append(name).value().c_str(), FR_PRIVATE,
+                         nullptr);
+  }
+}
+
+}  // namespace aerographene
+
 bool ThemeHelperWin::ShouldUseNativeFrame(
     const CustomThemeSupplier* theme_supplier) const {
   return true;
