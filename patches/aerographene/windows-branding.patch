+// The theme glyphs are drawn on a 16-unit grid; the caption symbol box is 10
+// units, so the glyph is scaled by 1.6 and centered on it. |canvas| is in
+// device pixels here (the caller undid the device scale factor).
+void PaintThemeGlyph(gfx::Canvas* canvas,
+                     const gfx::VectorIcon& icon,
+                     const gfx::Rect& symbol_rect,
+                     const cc::PaintFlags& flags) {
+  const int size = base::ClampRound(symbol_rect.width() * 1.6f);
+  const gfx::Point origin(symbol_rect.CenterPoint().x() - size / 2,
+                          symbol_rect.CenterPoint().y() - size / 2);
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->Translate(origin.OffsetFromOrigin());
+  gfx::PaintVectorIcon(canvas, icon, size, flags.getColor());
+}
+
