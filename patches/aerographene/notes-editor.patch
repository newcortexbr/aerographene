+void NotesHandler::HandleWriteNote(const base::ListValue& args) {
+  base::FilePath root;
+  if (args.size() == 4 && !args[3].is_none() && !args[3].is_int() &&
+      !args[3].is_double()) {
+    return;
+  }
+  if (!PrepareWrite(args, 4, &root)) {
+    return;
+  }
+  std::optional<int64_t> expected;
+  if (args[3].is_int()) {
+    expected = args[3].GetInt();
+  } else if (args[3].is_double()) {
+    expected = static_cast<int64_t>(args[3].GetDouble());
+  }
+  RunWrite(args[0],
+           base::BindOnce(
+               [](base::FilePath root, std::string rel, std::string text,
+                  std::optional<int64_t> expected) {
+                 return WriteVaultNote(root, rel, text, expected);
+               },
+               root, args[1].GetString(), args[2].GetString(), expected));
