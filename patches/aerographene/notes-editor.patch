+  std::optional<RealRef> from_ref = ResolveParentRef(root, from);
+  std::optional<RealRef> to_ref = ResolveParentRef(root, to);
+  if (!from_ref || !to_ref) {
+    return Fail(WriteStatus::kNotFound);
+  }
+  std::optional<Parent> from_parent = OpenParent(from_ref->root, from_ref->rel);
+  std::optional<Parent> to_parent = OpenParent(to_ref->root, to_ref->rel);
+  if (!from_parent || !to_parent) {
+    return Fail(WriteStatus::kNotFound);
+  }
+  std::optional<struct stat> st =
