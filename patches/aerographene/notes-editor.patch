+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+// Live-preview editor for chrome://notes (fatia B4). One view: the line that
+// has the caret is shown as raw Markdown (a textarea), every other line is
+// rendered by markdown.js. No split, no second pane. The note is kept as an
+// array of source lines; rendering works on chunks (runs of non-blank lines,
+// a fenced block, or a blank line) so only the chunks that change are
+// rebuilt. Only DOM nodes are created (no innerHTML: Trusted Types).
+//
+// Limits: selection across several lines is not supported while editing
+// (copy from the rendered text still works); the line has to be activated
+// with a click or the arrow keys.
+
+import {renderMarkdown} from './markdown.js';
+
+const RE_FENCE = /^\s*(```|~~~)/;
+const RE_LIST = /^(\s*)([-*+]|\d{1,9}[.)])(\s+)(\[[ xX]\]\s+)?/;
+const RE_QUOTE = /^(\s*>\s?)/;
+const HISTORY_MAX = 200;
+const BURST_MS = 800;
+
+// --- pure model (also run under Node in the checks) -----------------------
+
+// Splits lines into chunks: {s, e, kind} with kind 'blank' | 'fence' | 'text'.
+export function computeChunks(lines) {
+  const chunks = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    if (line.trim() === '') {
+      chunks.push({s: i, e: i + 1, kind: 'blank'});
+      i++;
+    } else if (RE_FENCE.test(line)) {
+      const marker = RE_FENCE.exec(line)[1];
+      let j = i + 1;
+      while (j < lines.length && !lines[j].trimStart().startsWith(marker)) {
+        j++;
+      }
+      const e = Math.min(j + 1, lines.length);
+      chunks.push({s: i, e, kind: 'fence'});
+      i = e;
+    } else {
+      let j = i + 1;
+      while (j < lines.length && lines[j].trim() !== '' &&
+             !RE_FENCE.test(lines[j])) {
+        j++;
+      }
+      chunks.push({s: i, e: j, kind: 'text'});
+      i = j;
+    }
+  }
+  return chunks;
+}
+
+export function chunkSignature(chunks) {
+  return chunks.map((c) => `${c.s}-${c.e}${c.kind[0]}`).join(',');
+}
+
+// What Enter does at `col` in `line`: returns {before, after} (the two
+// lines). Continues lists and quotes; Enter on an empty item removes the
+// marker and ends the list.
+export function splitLine(line, col) {
+  const before = line.slice(0, col);
+  const after = line.slice(col);
+  const list = RE_LIST.exec(line);
+  if (list && col >= list[0].length) {
+    if (line.slice(list[0].length).trim() === '' && after === '') {
+      return {before: '', after: '', ended: true};
+    }
+    let marker = list[2];
+    const n = /^(\d+)([.)])$/.exec(marker);
+    if (n) {
+      marker = `${Number(n[1]) + 1}${n[2]}`;
+    }
+    const task = list[4] ? '[ ] ' : '';
+    return {before, after:
+        `${list[1]}${marker}${list[3]}${task}${after.replace(/^\s+/, '')}`};
+  }
+  const quote = RE_QUOTE.exec(line);
+  if (quote && col >= quote[0].length) {
+    if (line.slice(quote[0].length).trim() === '' && after === '') {
+      return {before: '', after: '', ended: true};
+    }
+    return {before, after: quote[1] + after};
+  }
+  return {before, after};
+}
+
+// Normalises a text for editing: '\n' lines and whether to restore CRLF.
+export function splitText(text) {
+  const crlf = text.includes('\r\n');
+  return {lines: text.replace(/\r\n?/g, '\n').split('\n'), crlf};
+}
+
+export function joinLines(lines, crlf) {
+  const text = lines.join('\n');
+  return crlf ? text.replace(/\n/g, '\r\n') : text;
+}
+
+// --- view ------------------------------------------------------------------
+
+export function createEditor(root, opts = {}) {
+  let lines = [''];
+  let crlf = false;
+  let active = -1;
+  let chunks = computeChunks(lines);
+  let sig = chunkSignature(chunks);
+  let wrappers = [];
+  let dirty = false;
+  let undo = [];
+  let redo = [];
+  let lastPush = 0;
+  let input = null;
+
+  const snapshot = () => ({lines: lines.slice(), active,
+                           caret: input ? input.selectionStart : 0});
+
+  function pushHistory() {
+    undo.push(snapshot());
+    if (undo.length > HISTORY_MAX) {
+      undo.shift();
+    }
+    redo = [];
+    lastPush = Date.now();
+  }
+
+  function changed() {
+    dirty = true;
+    if (opts.onChange) {
+      opts.onChange();
+    }
+  }
+
+  function chunkOf(index) {
+    return chunks.findIndex((c) => index >= c.s && index < c.e);
+  }
+
+  function piece(start, end) {
+    const div = document.createElement('div');
+    div.className = 'piece';
+    div.dataset.s = String(start);
+    div.dataset.n = String(end - start);
+    div.append(renderMarkdown(lines.slice(start, end).join('\n'),
+                              {onWikilink: opts.onWikilink}));
+    return div;
+  }
+
+  function rawLine(index) {
+    const div = document.createElement('div');
+    div.className = 'ln raw';
+    div.dataset.s = String(index);
+    div.dataset.n = '1';
+    div.textContent = lines[index];
+    return div;
+  }
+
+  function makeInput() {
+    const ta = document.createElement('textarea');
+    ta.className = 'ln-input';
+    ta.rows = 1;
+    ta.spellcheck = false;
+    ta.setAttribute('aria-label', 'linha em edição (Markdown)');
+    ta.value = lines[active];
+    ta.addEventListener('input', onInput);
+    ta.addEventListener('beforeinput', () => {
+      if (Date.now() - lastPush > BURST_MS) {
+        pushHistory();
+      }
+    });
+    ta.addEventListener('keydown', onKeydown);
+    ta.addEventListener('paste', onPaste);
+    return ta;
+  }
+
+  function buildChunk(ci) {
+    const c = chunks[ci];
+    const wrap = document.createElement('div');
+    wrap.className = `chunk ${c.kind}`;
+    const isActive = active >= c.s && active < c.e;
+    if (!isActive) {
+      if (c.kind === 'blank') {
+        const div = document.createElement('div');
+        div.className = 'ln blank';
+        div.dataset.s = String(c.s);
+        div.dataset.n = '1';
+        wrap.append(div);
+      } else {
+        wrap.append(piece(c.s, c.e));
+      }
+      return wrap;
+    }
+    input = makeInput();
+    wrap.classList.add('editing');
+    if (c.kind === 'fence') {
+      for (let k = c.s; k < c.e; k++) {
+        wrap.append(k === active ? input : rawLine(k));
+      }
+    } else {
+      if (active > c.s) {
+        wrap.append(piece(c.s, active));
+      }
+      wrap.append(input);
+      if (active + 1 < c.e) {
+        wrap.append(piece(active + 1, c.e));
+      }
+    }
+    return wrap;
+  }
+
+  function resize() {
+    if (input) {
+      input.style.height = 'auto';
+      input.style.height = `${input.scrollHeight}px`;
+    }
+  }
+
+  function renderAll() {
+    input = null;
+    chunks = computeChunks(lines);
+    sig = chunkSignature(chunks);
+    wrappers = chunks.map((_, ci) => buildChunk(ci));
+    root.replaceChildren(...wrappers);
+    resize();
+  }
+
+  function focusInput(caret) {
+    if (!input) {
+      return;
+    }
+    input.focus();
+    const pos = caret === 'end' ? input.value.length :
+        Math.max(0, Math.min(caret, input.value.length));
+    input.setSelectionRange(pos, pos);
+    resize();
+    input.scrollIntoView({block: 'nearest'});
+  }
+
+  // Moves the caret line to `index`; only the old and the new chunk are
+  // rebuilt unless the typed text changed how the lines group.
+  function activate(index, caret) {
+    index = Math.max(0, Math.min(lines.length - 1, index));
+    const prev = active;
+    if (prev === index && input) {
+      focusInput(caret);
+      return;
+    }
+    const prevChunk = prev >= 0 ? chunkOf(prev) : -1;
+    active = index;
+    const next = computeChunks(lines);
+    if (chunkSignature(next) !== sig) {
+      renderAll();
+    } else {
+      const touched = new Set([prevChunk, chunkOf(index)]);
+      input = null;
+      for (const ci of touched) {
+        if (ci >= 0) {
+          const fresh = buildChunk(ci);
+          wrappers[ci].replaceWith(fresh);
+          wrappers[ci] = fresh;
+        }
+      }
+      resize();
+    }
+    focusInput(caret);
+  }
+
+  function restructure(newActive, caret) {
+    active = newActive;
+    renderAll();
+    focusInput(caret);
+    changed();
+  }
+
+  function onInput() {
+    lines[active] = input.value;
+    resize();
+    changed();
+  }
+
+  function insertLines(text, col, end) {
+    const parts = text.replace(/\r\n?/g, '\n').split('\n');
+    const line = lines[active];
+    const head = line.slice(0, col);
+    const tail = line.slice(end);
+    const last = parts.length - 1;
+    const caret = last === 0 ? head.length + parts[0].length :
+                               parts[last].length;
+    parts[0] = head + parts[0];
+    parts[last] += tail;
+    lines.splice(active, 1, ...parts);
+    return {index: active + last, caret};
+  }
+
+  function onPaste(e) {
+    const text = e.clipboardData ? e.clipboardData.getData('text/plain') : '';
+    if (!/[\r\n]/.test(text)) {
+      return;  // single line: the textarea pastes it itself
+    }
+    e.preventDefault();
+    pushHistory();
+    const r = insertLines(text, input.selectionStart, input.selectionEnd);
+    restructure(r.index, r.caret);
+  }
+
+  function singleRow() {
+    return input.scrollHeight <= parseFloat(getComputedStyle(input).lineHeight) *
+        1.6;
+  }
+
+  function doUndo(from, to) {
+    if (!from.length) {
+      return;
+    }
+    to.push(snapshot());
+    const s = from.pop();
+    lines = s.lines;
+    restructure(Math.min(s.active, lines.length - 1), s.caret);
+  }
+
+  function onKeydown(e) {
+    if (e.isComposing) {
+      return;
+    }
+    const mod = e.ctrlKey || e.metaKey;
+    if (mod && e.key.toLowerCase() === 's') {
+      e.preventDefault();
+      if (opts.onSave) {
+        opts.onSave();
+      }
+      return;
+    }
+    if (mod && !e.shiftKey && e.key.toLowerCase() === 'z') {
+      e.preventDefault();
+      doUndo(undo, redo);
+      return;
+    }
+    if (mod && (e.key.toLowerCase() === 'y' ||
+                (e.shiftKey && e.key.toLowerCase() === 'z'))) {
+      e.preventDefault();
+      doUndo(redo, undo);
+      return;
+    }
+    const start = input.selectionStart;
+    const end = input.selectionEnd;
+    if (e.key === 'Enter' && !e.shiftKey && !mod) {
+      e.preventDefault();
+      pushHistory();
+      const line = lines[active];
+      const r = splitLine(line.slice(0, start) + line.slice(end), start);
+      if (r.ended) {
+        lines[active] = '';
+        restructure(active, 0);
+        return;
+      }
+      lines.splice(active, 1, r.before, r.after);
+      const rest = lines[active + 1];
+      const tailLen = line.length - end;
+      restructure(active + 1, rest.length - tailLen);
+    } else if (e.key === 'Backspace' && start === 0 && end === 0 &&
+               active > 0) {
+      e.preventDefault();
+      pushHistory();
+      const joinAt = lines[active - 1].length;
+      lines.splice(active - 1, 2, lines[active - 1] + lines[active]);
+      restructure(active - 1, joinAt);
+    } else if (e.key === 'Delete' && start === input.value.length &&
+               end === start && active < lines.length - 1) {
+      e.preventDefault();
+      pushHistory();
+      const joinAt = lines[active].length;
+      lines.splice(active, 2, lines[active] + lines[active + 1]);
+      restructure(active, joinAt);
+    } else if (e.key === 'ArrowUp' && !e.shiftKey && !mod && active > 0 &&
+               (start === 0 || singleRow())) {
+      e.preventDefault();
+      activate(active - 1, Math.min(start, lines[active - 1].length));
+    } else if (e.key === 'ArrowDown' && !e.shiftKey && !mod &&
+               active < lines.length - 1 &&
+               (end === input.value.length || singleRow())) {
+      e.preventDefault();
+      activate(active + 1, Math.min(end, lines[active + 1].length));
+    } else if (e.key === 'Escape') {
+      input.blur();
+    }
+  }
+
+  // Click on a rendered piece: pick the line by the vertical position.
+  root.addEventListener('click', (e) => {
+    if (e.target.closest('a')) {
+      return;  // links keep working; they do not enter edit mode
+    }
+    const el = e.target.closest('[data-s]');
+    if (!el) {
+      if (e.target === root && lines.length) {
+        activate(lines.length - 1, 'end');
+      }
+      return;
+    }
+    const s = Number(el.dataset.s);
+    const n = Math.max(1, Number(el.dataset.n));
+    const rect = el.getBoundingClientRect();
+    const frac = rect.height > 0 ? (e.clientY - rect.top) / rect.height : 0;
+    const k = Math.max(0, Math.min(n - 1, Math.floor(frac * n)));
+    activate(s + k, 'end');
+  });
+
+  return {
+    load(text) {
+      const parsed = splitText(text);
+      lines = parsed.lines;
+      crlf = parsed.crlf;
+      active = -1;
+      undo = [];
+      redo = [];
+      dirty = false;
+      renderAll();
+    },
+    getText: () => joinLines(lines, crlf),
+    isDirty: () => dirty,
+    markSaved() {
+      dirty = false;
+    },
+    focus() {
+      activate(active >= 0 ? active : 0, 'end');
+    },
+  };
+}
