+class VaultWriterTest : public VaultReaderTest {
+ protected:
+  std::string Disk(const char* name) {
+    std::string out;
+    EXPECT_TRUE(base::ReadFileToString(root_.AppendASCII(name), &out));
+    return out;
+  }
+
+  int64_t MtimeOf(const char* name) {
+    auto note = ReadVaultNoteWithMtime(root_, name);
+    EXPECT_TRUE(note);
+    return note ? note->mtime_us : 0;
+  }
+
+  // Changes the file behind the vault's back and gives it another mtime
+  // (filesystem timestamps can be coarser than two quick writes).
+  void ExternalEdit(const char* name, const std::string& text) {
+    ASSERT_TRUE(base::WriteFile(root_.AppendASCII(name), text));
+    const base::Time t = base::Time::Now() + base::Hours(1);
+    ASSERT_TRUE(base::TouchFile(root_.AppendASCII(name), t, t));
+  }
+
+  bool HasTemp() {
+    base::FileEnumerator e(root_, true, base::FileEnumerator::FILES);
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      if (p.BaseName().value().find(".aero-") == 0) {
+        return true;
+      }
+    }
+    return false;
+  }
+};
+
+TEST_F(VaultWriterTest, ReadReturnsMtime) {
+  auto note = ReadVaultNoteWithMtime(root_, "a.md");
+  ASSERT_TRUE(note);
+  EXPECT_EQ(note->text, "# a");
+  base::File::Info info;
+  ASSERT_TRUE(base::GetFileInfo(root_.Append("a.md"), &info));
+  EXPECT_EQ(note->mtime_us,
+            (info.last_modified - base::Time::UnixEpoch()).InMicroseconds());
+}
+
+TEST_F(VaultWriterTest, SaveReplacesAtomicallyAndKeepsMode) {
+  ASSERT_EQ(chmod(root_.Append("a.md").value().c_str(), 0640), 0);
+  const int64_t mtime = MtimeOf("a.md");
+  WriteResult r = WriteVaultNote(root_, "a.md", "# novo\n", mtime);
+  EXPECT_EQ(r.status, WriteStatus::kOk);
+  EXPECT_EQ(Disk("a.md"), "# novo\n");
+  EXPECT_EQ(r.mtime_us, MtimeOf("a.md"));
+  EXPECT_FALSE(HasTemp());
+  struct stat st = {};
+  ASSERT_EQ(stat(root_.Append("a.md").value().c_str(), &st), 0);
+  EXPECT_EQ(st.st_mode & 0777, 0640u);
+  // The new mtime is the token for the next save.
+  EXPECT_EQ(WriteVaultNote(root_, "a.md", "# 3", r.mtime_us).status,
+            WriteStatus::kOk);
+  EXPECT_EQ(Disk("a.md"), "# 3");
+}
+
+TEST_F(VaultWriterTest, ConflictKeepsDiskAndReportsMtime) {
+  const int64_t opened = MtimeOf("a.md");
+  ExternalEdit("a.md", "externo");
+  const int64_t on_disk = MtimeOf("a.md");
+  ASSERT_NE(opened, on_disk);
+  WriteResult r = WriteVaultNote(root_, "a.md", "meu texto", opened);
+  EXPECT_EQ(r.status, WriteStatus::kConflict);
+  EXPECT_EQ(r.mtime_us, on_disk);
+  EXPECT_EQ(Disk("a.md"), "externo");  // untouched; the page keeps its text
+  EXPECT_FALSE(HasTemp());
+  // Overwrite on purpose (expected = nullopt) after the user chose it.
+  EXPECT_EQ(WriteVaultNote(root_, "a.md", "meu texto", std::nullopt).status,
+            WriteStatus::kOk);
+  EXPECT_EQ(Disk("a.md"), "meu texto");
+}
+
+TEST_F(VaultWriterTest, SaveRefusesBadTargets) {
+  EXPECT_EQ(WriteVaultNote(root_, "missing.md", "x", 0).status,
+            WriteStatus::kNotFound);
+  EXPECT_EQ(WriteVaultNote(root_, "x.txt", "x", std::nullopt).status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(Disk("x.txt"), "txt");
+  EXPECT_EQ(WriteVaultNote(root_, "../secret.md", "x", std::nullopt).status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(WriteVaultNote(root_, "/etc/passwd.md", "x", std::nullopt).status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(WriteVaultNote(root_, "sub.md", "x", std::nullopt).status,
+            WriteStatus::kNotFound);
+  ASSERT_TRUE(base::CreateDirectory(root_.Append("dir.md")));
+  EXPECT_EQ(WriteVaultNote(root_, "dir.md", "x", std::nullopt).status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(WriteVaultNote(root_, "a.md", std::string(kMaxNoteBytes + 1, 'x'),
+                           std::nullopt)
+                .status,
+            WriteStatus::kTooLarge);
+  EXPECT_EQ(Disk("a.md"), "# a");
+}
+
+TEST_F(VaultWriterTest, SaveNeverWritesThroughSymlinkOutside) {
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("secret.md"),
+                                       root_.Append("link.md")));
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("outdir"),
+                                       root_.Append("linkdir")));
+  ASSERT_TRUE(base::WriteFile(outer_.GetPath().Append("outdir/o.md"), "o"));
+  EXPECT_NE(WriteVaultNote(root_, "link.md", "pwn", std::nullopt).status,
+            WriteStatus::kOk);
+  EXPECT_NE(WriteVaultNote(root_, "linkdir/o.md", "pwn", std::nullopt).status,
+            WriteStatus::kOk);
+  EXPECT_NE(CreateVaultNote(root_, "linkdir/new.md", "pwn").status,
+            WriteStatus::kOk);
+  EXPECT_NE(RenameVaultNote(root_, "a.md", "linkdir/a.md").status,
+            WriteStatus::kOk);
+  EXPECT_NE(DeleteVaultNote(root_, "linkdir/o.md").status, WriteStatus::kOk);
+  std::string s;
+  ASSERT_TRUE(base::ReadFileToString(outer_.GetPath().Append("secret.md"), &s));
+  EXPECT_EQ(s, "s");
+  ASSERT_TRUE(base::ReadFileToString(outer_.GetPath().Append("outdir/o.md"), &s));
+  EXPECT_EQ(s, "o");
+  EXPECT_FALSE(base::PathExists(outer_.GetPath().Append("outdir/new.md")));
+  EXPECT_FALSE(base::PathExists(outer_.GetPath().Append("outdir/a.md")));
+  EXPECT_TRUE(base::PathExists(root_.Append("a.md")));
+}
+
+TEST_F(VaultWriterTest, SaveThroughSymlinkInsideWritesTargetKeepsLink) {
+  ASSERT_TRUE(base::CreateSymbolicLink(root_.Append("sub/b.md"),
+                                       root_.Append("alias.md")));
+  EXPECT_EQ(WriteVaultNote(root_, "alias.md", "via alias", std::nullopt).status,
+            WriteStatus::kOk);
+  EXPECT_EQ(Disk("sub/b.md"), "via alias");
+  base::FilePath target;
+  EXPECT_TRUE(base::ReadSymbolicLink(root_.Append("alias.md"), &target));
+}
+
+TEST_F(VaultWriterTest, OpenNoFollowRefusesAnySymlinkComponent) {
+  // The primitive behind every open, which is what a component swapped for a
+  // symlink after the check runs into.
+  const base::FilePath real_root = base::MakeAbsoluteFilePath(root_);
+  ASSERT_TRUE(base::CreateDirectory(outer_.GetPath().Append("outdir")));
+  ASSERT_TRUE(base::WriteFile(outer_.GetPath().Append("outdir/o.md"), "o"));
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("outdir"),
+                                       root_.Append("linkdir")));
+  ASSERT_TRUE(base::CreateSymbolicLink(root_.Append("sub"),
+                                       root_.Append("linkin")));
+  ASSERT_TRUE(base::CreateSymbolicLink(root_.Append("a.md"),
+                                       root_.Append("alias.md")));
+  EXPECT_TRUE(OpenVaultFileNoFollow(real_root, "a.md", O_RDONLY).is_valid());
+  EXPECT_TRUE(OpenVaultFileNoFollow(real_root, "sub/b.md", O_RDONLY).is_valid());
+  EXPECT_FALSE(OpenVaultFileNoFollow(real_root, "linkdir/o.md", O_RDONLY)
+                   .is_valid());  // symlink to outside, middle component
+  EXPECT_FALSE(OpenVaultFileNoFollow(real_root, "linkin/b.md", O_RDONLY)
+                   .is_valid());  // symlink to inside, middle component
+  EXPECT_FALSE(OpenVaultFileNoFollow(real_root, "alias.md", O_RDONLY)
+                   .is_valid());  // symlink as the last component
+  EXPECT_FALSE(OpenVaultFileNoFollow(real_root, "../secret.md", O_RDONLY)
+                   .is_valid());
+  // The tree resolves inside links once, then opens without following: the
+  // read of an inside alias still works through ReadVaultNote.
+  EXPECT_EQ(ReadVaultNote(root_, "alias.md"), "# a");
+  EXPECT_EQ(ReadVaultNote(root_, "linkin/b.md"), "b");
+}
+
+TEST_F(VaultWriterTest, CreateNewNote) {
+  WriteResult r = CreateVaultNote(root_, "sub/nova.md", "# nova");
+  EXPECT_EQ(r.status, WriteStatus::kOk);
+  EXPECT_EQ(Disk("sub/nova.md"), "# nova");
+  EXPECT_EQ(r.mtime_us, MtimeOf("sub/nova.md"));
+  EXPECT_EQ(CreateVaultNote(root_, "sub/nova.md", "x").status,
+            WriteStatus::kExists);
+  EXPECT_EQ(Disk("sub/nova.md"), "# nova");
+  EXPECT_EQ(CreateVaultNote(root_, "a.md", "x").status, WriteStatus::kExists);
+  EXPECT_EQ(Disk("a.md"), "# a");
+  EXPECT_EQ(CreateVaultNote(root_, "nodir/n.md", "x").status,
+            WriteStatus::kNotFound);
+  for (const char* bad : {"n.txt", ".oculta.md", "../n.md", "/n.md", "sub/",
+                          "sub//n.md", "n"}) {
+    EXPECT_EQ(CreateVaultNote(root_, bad, "x").status, WriteStatus::kInvalid)
+        << bad;
+  }
+  EXPECT_EQ(CreateVaultNote(root_, std::string(256, 'a') + ".md", "x").status,
+            WriteStatus::kInvalid);
+  EXPECT_FALSE(base::PathExists(outer_.GetPath().Append("n.md")));
+}
+
+TEST_F(VaultWriterTest, CreateDoesNotFollowDanglingSymlink) {
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("novo.md"),
+                                       root_.Append("dangling.md")));
+  EXPECT_NE(CreateVaultNote(root_, "dangling.md", "pwn").status,
+            WriteStatus::kOk);
+  EXPECT_FALSE(base::PathExists(outer_.GetPath().Append("novo.md")));
+}
+
+TEST_F(VaultWriterTest, RenameMovesAndNeverOverwrites) {
+  EXPECT_EQ(RenameVaultNote(root_, "a.md", "c.md").status, WriteStatus::kOk);
+  EXPECT_FALSE(base::PathExists(root_.Append("a.md")));
+  EXPECT_EQ(Disk("c.md"), "# a");
+  EXPECT_EQ(RenameVaultNote(root_, "c.md", "sub/c.md").status,
+            WriteStatus::kOk);
+  EXPECT_EQ(Disk("sub/c.md"), "# a");
+  // Destination exists: refused, both files intact.
+  EXPECT_EQ(RenameVaultNote(root_, "sub/c.md", "sub/b.md").status,
+            WriteStatus::kExists);
+  EXPECT_EQ(Disk("sub/c.md"), "# a");
+  EXPECT_EQ(Disk("sub/b.md"), "b");
+  EXPECT_EQ(RenameVaultNote(root_, "missing.md", "z.md").status,
+            WriteStatus::kNotFound);
+  EXPECT_EQ(RenameVaultNote(root_, "sub/c.md", "nodir/c.md").status,
+            WriteStatus::kNotFound);
+  EXPECT_EQ(RenameVaultNote(root_, "sub/c.md", "c.txt").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(RenameVaultNote(root_, "sub/c.md", "../c.md").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(RenameVaultNote(root_, "x.txt", "x.md").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(RenameVaultNote(root_, "sub", "sub2.md").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(RenameVaultNote(root_, "sub/c.md", ".h.md").status,
+            WriteStatus::kInvalid);
+}
+
+TEST_F(VaultWriterTest, RenameRefusesSymlinkEntry) {
+  ASSERT_TRUE(base::CreateSymbolicLink(root_.Append("a.md"),
+                                       root_.Append("alias.md")));
+  EXPECT_EQ(RenameVaultNote(root_, "alias.md", "alias2.md").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(DeleteVaultNote(root_, "alias.md").status, WriteStatus::kInvalid);
+  EXPECT_EQ(Disk("a.md"), "# a");
+}
+
+TEST_F(VaultWriterTest, DeleteOnlyNotes) {
+  EXPECT_EQ(DeleteVaultNote(root_, "sub/b.md").status, WriteStatus::kOk);
+  EXPECT_FALSE(base::PathExists(root_.Append("sub/b.md")));
+  EXPECT_EQ(DeleteVaultNote(root_, "sub/b.md").status, WriteStatus::kNotFound);
+  EXPECT_EQ(DeleteVaultNote(root_, "x.txt").status, WriteStatus::kInvalid);
+  EXPECT_TRUE(base::PathExists(root_.Append("x.txt")));
+  ASSERT_TRUE(base::CreateDirectory(root_.Append("dir.md")));
+  EXPECT_EQ(DeleteVaultNote(root_, "dir.md").status, WriteStatus::kInvalid);
+  EXPECT_EQ(DeleteVaultNote(root_, "../secret.md").status,
+            WriteStatus::kInvalid);
+  EXPECT_EQ(DeleteVaultNote(root_, "").status, WriteStatus::kInvalid);
+  EXPECT_TRUE(base::PathExists(outer_.GetPath().Append("secret.md")));
+}
+
+TEST_F(VaultWriterTest, StatusNames) {
+  EXPECT_EQ(WriteStatusName(WriteStatus::kOk), "ok");
+  EXPECT_EQ(WriteStatusName(WriteStatus::kConflict), "conflict");
+  EXPECT_EQ(WriteStatusName(WriteStatus::kExists), "exists");
+}
