+void LocationBarView::RefreshAerographeneButtonIcons() {
+  // The Link icon is themed by the theme icon maps (theme-icons-*); Tune
+  // (sliders) keeps the upstream shape.
+  const std::pair<views::ImageButton*, const gfx::VectorIcon*> buttons[] = {
+      {site_settings_button_.get(), &vector_icons::kTuneIcon},
+      {copy_link_button_.get(), &vector_icons::kLinkIcon},
+  };
+  for (const auto& [button, icon] : buttons) {
+    if (!button) {
+      continue;
+    }
+    SetImageFromVectorIconWithColor(
+        button, *icon, kAerographeneButtonIconSize,
+        views::IconColors(kColorToolbarButtonIcon,
+                          kColorToolbarButtonIconInactive));
+    button->SetBorder(views::CreateEmptyBorder(gfx::Insets(
+        (kAerographeneButtonSize - kAerographeneButtonIconSize) / 2)));
+  }
+}
+
+void LocationBarView::OnCopyLinkPressed() {
+  content::WebContents* contents = GetWebContents();
+  if (!contents) {
+    return;
+  }
+  content::NavigationEntry* entry = contents->GetController().GetVisibleEntry();
+  const GURL& url = entry ? entry->GetVirtualURL() : contents->GetVisibleURL();
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  writer.WriteText(base::UTF8ToUTF16(url.spec()));
+}
+
 bool LocationBarView::ShouldShowKeywordBubble() const {
   return GetOmniboxController()->edit_model()->is_keyword_selected();
 }
