+TEST_F(PinnedModelTest, CheapAccessorsMatchSnapshots) {
+  auto a = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 0);
+  auto folder = model_->AddFolder(u"F", 1);
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(folder);
+  auto b = model_->AddPinned(GURL("https://b.test/"), u"B", *folder, 0);
+  ASSERT_TRUE(b);
+  EXPECT_TRUE(model_->SetLabel(*a, "label"));
+
+  EXPECT_EQ(0, model_->GetTopLevelIndex(*a));
+  EXPECT_EQ(1, model_->GetTopLevelIndex(*folder));
+  EXPECT_EQ(-1, model_->GetTopLevelIndex(*b));
+  EXPECT_EQ(-1, model_->GetTopLevelIndex(base::Uuid::GenerateRandomV4()));
+
+  EXPECT_EQ("label", model_->GetLabel(*a));
+  EXPECT_TRUE(model_->GetLabel(*b).empty());
+  EXPECT_TRUE(model_->GetLabel(base::Uuid::GenerateRandomV4()).empty());
+
+  EXPECT_EQ(GURL("https://a.test/"), model_->GetURL(*a));
+  EXPECT_TRUE(model_->GetURL(*folder).is_empty());
+  ASSERT_TRUE(model_->FindURL(*folder));
+  EXPECT_FALSE(model_->FindURL(base::Uuid::GenerateRandomV4()));
+
+  EXPECT_FALSE(model_->IsOpen(*a));
+  EXPECT_TRUE(model_->SetOpen(*a, true));
+  EXPECT_TRUE(model_->IsOpen(*a));
+  EXPECT_FALSE(model_->IsOpen(*folder));
+}
