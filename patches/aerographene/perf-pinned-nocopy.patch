-GURL PinnedModel::GetURL(const base::Uuid& uuid) const {
+const GURL& PinnedModel::GetURL(const base::Uuid& uuid) const {
+  const GURL* url = FindURL(uuid);
+  return url ? *url : GURL::EmptyGURL();
+}
+
+const GURL* PinnedModel::FindURL(const base::Uuid& uuid) const {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node) {
+    return nullptr;
+  }
+  return node->is_url() ? &node->url() : &GURL::EmptyGURL();
+}
+
+int PinnedModel::GetTopLevelIndex(const base::Uuid& uuid) const {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || node->parent() != root_) {
+    return -1;
+  }
+  int index = 0;
+  for (const auto& child : root_->children()) {
+    if (child.get() == node) {
+      return index;
+    }
+    if (child->is_url() || IsDrawer(child.get())) {
+      ++index;
+    }
+  }
+  return -1;
+}
+
+std::string PinnedModel::GetLabel(const base::Uuid& uuid) const {
+  std::string label;
+  if (const BookmarkNode* node = Resolve(uuid)) {
+    node->GetMetaInfo(kPinnedLabelMetaKey, &label);
+  }
+  return label;
+}
+
+bool PinnedModel::IsOpen(const base::Uuid& uuid) const {
   const BookmarkNode* node = Resolve(uuid);
-  return node && node->is_url() ? node->url() : GURL();
+  return node && node->is_url() && HasFlag(node, kPinnedOpenMetaKey);
 }
 
