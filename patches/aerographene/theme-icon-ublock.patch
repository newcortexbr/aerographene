+namespace {
+
+// aerographene: o uBlock troca o ícone com setIcon(path: icon_*-off.png) e o
+// navegador só recebe o ImageData, sem o caminho. O ícone ligado é vermelho e
+// o desligado é cinza, então "off" = nenhum pixel opaco avermelhado. Ícone
+// ainda não carregado conta como ligado.
+bool IsUBlockOffIcon(const gfx::Image& image) {
+  if (image.IsEmpty()) {
+    return false;
+  }
+  const SkBitmap* bitmap = image.ToSkBitmap();
+  if (!bitmap || bitmap->drawsNothing()) {
+    return false;
+  }
+  for (int y = 0; y < bitmap->height(); ++y) {
+    for (int x = 0; x < bitmap->width(); ++x) {
+      const SkColor c = bitmap->getColor(x, y);
+      if (SkColorGetA(c) < 128) {
+        continue;
+      }
+      const int r = SkColorGetR(c);
+      const int gb = std::max(SkColorGetG(c), SkColorGetB(c));
+      if (r - gb > 48) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
