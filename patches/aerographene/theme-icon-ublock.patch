+++ b/chrome/browser/ui/aerographene_theme_icons/aerographene_theme_icons.cc
@@ -281,4 +281,11 @@ Theme GetActiveTheme() {
   return g_theme;
 }
 
+const gfx::VectorIcon& GetUBlockIcon(bool off) {
+  if (g_theme == Theme::kPixelized) {
+    return off ? kPixelizedUblockOffIcon : kPixelizedUblockIcon;
+  }
+  return off ? kDefaultUblockOffIcon : kDefaultUblockIcon;
+}
+
 }  // namespace aerographene_theme_icons
