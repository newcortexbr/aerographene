+void TabStripView::SetNewTabRow(std::unique_ptr<views::View> row) {
+  new_tab_row_ = AddChildView(std::move(row));
+}
+
+std::unique_ptr<views::View> TabStripView::ReleaseNewTabRow() {
+  if (!new_tab_row_) {
+    return nullptr;
+  }
+  views::View* const row = new_tab_row_.get();
+  new_tab_row_ = nullptr;
+  return RemoveChildViewT(row);
+}
