+// OSC 8 links (C5). xterm.js' default opens an empty window (about:blank,
+// which inherits the chrome://terminal origin) and then sets its location;
+// instead only http(s) links open, in a new tab with no opener and no
+// referrer, so the WebUI itself is never navigated.
+const LINK_HANDLER = {
+  allowNonHttpProtocols: false,
+  activate(event, uri) {
+    let url;
+    try {
+      url = new URL(uri);
+    } catch {
+      return;
+    }
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+      return;
+    }
+    if (confirm(`Open ${url.href}?`)) {
+      window.open(url.href, '_blank', 'noopener,noreferrer');
+    }
+  },
+};
