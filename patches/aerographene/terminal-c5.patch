+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_ACCESS_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_ACCESS_H_
+
+namespace base {
+class SupportsUserData;
+}
+
+namespace url {
+class Origin;
+}
+
+namespace aerographene {
+
+// chrome://terminal only exists for regular profiles: never incognito,
+// guest, system, other off-the-record or enterprise-isolated profiles
+// (item 3 of the terminal security list in docs/PLANO-V0.3.md).
+bool TerminalAllowedForContext(const base::SupportsUserData* browser_context);
+
+// A pty message is accepted only from the primary main frame whose committed
+// origin is exactly chrome://terminal (not aerographene://, chrome-untrusted://
+// or any other host).
+bool IsTerminalFrame(bool is_primary_main_frame, const url::Origin& origin);
+
+}  // namespace aerographene
