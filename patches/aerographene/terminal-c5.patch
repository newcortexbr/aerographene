+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_access.h"
+
+#include "base/supports_user_data.h"
+#include "components/profile_metrics/browser_profile_type.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+#include "url/url_util.h"
+
+namespace aerographene {
+namespace {
+
+using profile_metrics::BrowserProfileType;
+
+// Stands in for a BrowserContext: the profile type is user data on it.
+class FakeContext : public base::SupportsUserData {};
+
+bool AllowedFor(BrowserProfileType type) {
+  FakeContext context;
+  profile_metrics::SetBrowserProfileType(&context, type);
+  return TerminalAllowedForContext(&context);
+}
+
+TEST(TerminalAccessTest, OnlyRegularProfile) {
+  EXPECT_TRUE(AllowedFor(BrowserProfileType::kRegular));
+  EXPECT_FALSE(AllowedFor(BrowserProfileType::kIncognito));
+  EXPECT_FALSE(AllowedFor(BrowserProfileType::kGuest));
+  EXPECT_FALSE(AllowedFor(BrowserProfileType::kSystem));
+  EXPECT_FALSE(AllowedFor(BrowserProfileType::kOtherOffTheRecordProfile));
+  EXPECT_FALSE(AllowedFor(BrowserProfileType::kEnterpriseIsolated));
+  EXPECT_FALSE(TerminalAllowedForContext(nullptr));
+}
+
+url::Origin O(const char* url) {
+  return url::Origin::Create(GURL(url));
+}
+
+TEST(TerminalAccessTest, OnlyChromeTerminalMainFrame) {
+  // As registered by content in the browser (aerographene comes from the
+  // Helium override-chrome-protocol patch).
+  url::ScopedSchemeRegistryForTests registry;
+  url::AddStandardScheme("chrome", url::SCHEME_WITH_HOST);
+  url::AddStandardScheme("chrome-untrusted", url::SCHEME_WITH_HOST);
+  url::AddStandardScheme("aerographene", url::SCHEME_WITH_HOST);
+  url::AddStandardScheme("chrome-extension", url::SCHEME_WITH_HOST);
+  EXPECT_TRUE(IsTerminalFrame(true, O("chrome://terminal/")));
+  EXPECT_TRUE(IsTerminalFrame(true, O("chrome://terminal/?w=3")));
+  // Subframe or non-primary frame (prerender, fenced frame, bfcache).
+  EXPECT_FALSE(IsTerminalFrame(false, O("chrome://terminal/")));
+  // Web pages, other WebUIs and look-alike schemes/hosts.
+  EXPECT_FALSE(IsTerminalFrame(true, O("https://example.com/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("http://terminal/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("chrome://notes/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("chrome://terminal.evil/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("chrome-untrusted://terminal/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("aerographene://terminal/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("chrome-extension://abc/")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("file:///")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("data:text/html,x")));
+  EXPECT_FALSE(IsTerminalFrame(true, O("about:blank")));
+  EXPECT_FALSE(IsTerminalFrame(true, url::Origin()));
+}
+
+}  // namespace
+}  // namespace aerographene
