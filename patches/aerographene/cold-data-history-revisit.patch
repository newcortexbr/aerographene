+bool ColdHistoryDatabase::ChangeURLID(URLID old_id, URLID new_id) {
+  sql::Statement visits(db_.GetCachedStatement(
+      SQL_FROM_HERE, "UPDATE visits SET url = ? WHERE url = ?"));
+  visits.BindInt64(0, new_id);
+  visits.BindInt64(1, old_id);
+  sql::Statement terms(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "UPDATE OR IGNORE keyword_search_terms SET url_id = ? WHERE url_id = ?"));
+  terms.BindInt64(0, new_id);
+  terms.BindInt64(1, old_id);
+  sql::Statement row(
+      db_.GetCachedStatement(SQL_FROM_HERE, "DELETE FROM urls WHERE id = ?"));
+  row.BindInt64(0, old_id);
+  return visits.Run() && terms.Run() && row.Run();
+}
+
+bool ColdHistoryDatabase::MoveURLRowOut(URLID cold_id, URLID hot_id) {
+  if (!open_ || !BeginTransaction()) {
+    return false;
+  }
+  bool ok = true;
+  if (cold_id != hot_id) {
+    sql::Statement visits(db_.GetCachedStatement(
+        SQL_FROM_HERE, "UPDATE visits SET url = ? WHERE url = ?"));
+    visits.BindInt64(0, hot_id);
+    visits.BindInt64(1, cold_id);
+    ok = visits.Run();
+  }
+  ok = ok && DeleteURLRowsByID({cold_id});
+  if (!ok) {
+    RollbackTransaction();
+    return false;
+  }
+  return CommitTransaction();
+}
