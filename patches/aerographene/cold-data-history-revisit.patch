+URLID HistoryBackend::RestoreURLFromCold(const GURL& url, URLRow* row) {
+  ColdHistoryDatabase* cold = expirer_.GetColdDatabaseIfExists();
+  if (!cold) {
+    return 0;
+  }
+  URLRow cold_row(url);
+  const URLID cold_id = cold->GetRowForURL(url, &cold_row);
+  if (!cold_id) {
+    return 0;
+  }
+  URLID hot_id = 0;
+  URLRow taken;
+  if (!db_->GetURLRow(cold_id, &taken)) {
+    // urls.id is AUTOINCREMENT, so the id freed by the move is normally still
+    // free: keep it and the cold visits keep pointing at it.
+    if (db_->InsertOrUpdateURLRowByID(cold_row)) {
+      hot_id = cold_id;
+    }
+  }
+  if (!hot_id) {
+    hot_id = db_->AddURL(cold_row);
+    if (!hot_id) {
+      return 0;
+    }
+  }
+  KeywordSearchTermRow term;
+  if (cold->GetKeywordSearchTermRow(cold_id, &term)) {
+    db_->SetKeywordSearchTermsForURL(hot_id, term.keyword_id, term.term);
+  }
+  pending_cold_url_moves_[cold_id] = hot_id;
+  cold_row.set_id(hot_id);
+  *row = cold_row;
+  ScheduleCommit();
+  return hot_id;
+}
+
+void HistoryBackend::FlushColdURLMoves() {
+  if (pending_cold_url_moves_.empty()) {
+    return;
+  }
+  std::map<URLID, URLID> moves;
+  moves.swap(pending_cold_url_moves_);
+  ColdHistoryDatabase* cold = expirer_.GetColdDatabaseIfExists();
+  if (!cold) {
+    return;
+  }
+  for (const auto& [cold_id, hot_id] : moves) {
+    // On failure the cold row stays; the URL then exists in both stores until
+    // the expirer copies it again (duplicates are ignored there).
+    cold->MoveURLRowOut(cold_id, hot_id);
+  }
+}
+
 bool HistoryBackend::CanAddURL(const GURL& url) const {
