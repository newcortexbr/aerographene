+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_host.h"
+
+#include <errno.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/posix/eintr_wrapper.h"
+
+namespace aerographene {
+
+namespace {
+
+// Sessions of every TerminalHost in the process; hosts live on different
+// sequences.
+std::atomic<size_t> g_live_sessions{0};
+
+bool TakeGlobalSlot() {
+  if (g_live_sessions.fetch_add(1) >= TerminalHost::kMaxSessionsGlobal) {
+    g_live_sessions.fetch_sub(1);
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+TerminalHost::Entry::Entry() = default;
+TerminalHost::Entry::~Entry() {
+  // Stop watching before the session closes the fd.
+  read_watch.reset();
+  write_watch.reset();
+  session.reset();
+  if (counted) {
+    g_live_sessions.fetch_sub(1);
+  }
+}
+
+TerminalHost::TerminalHost(OutputCallback on_output, ExitCallback on_exit)
+    : on_output_(std::move(on_output)), on_exit_(std::move(on_exit)) {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+TerminalHost::~TerminalHost() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Each Entry kills its process group (TerminalSession destructor).
+  sessions_.clear();
+}
+
+// static
+size_t TerminalHost::LiveSessionsForTesting() {
+  return g_live_sessions.load();
+}
+
+bool TerminalHost::Open(int32_t id, uint16_t cols, uint16_t rows) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (sessions_.size() >= kMaxSessions || sessions_.contains(id)) {
+    return false;
+  }
+  auto entry = std::make_unique<Entry>();
+  if (!TakeGlobalSlot()) {
+    return false;
+  }
+  entry->counted = true;
+  TerminalSession::Options options;  // argv empty = login shell, cwd = HOME
+  options.cols = cols;
+  options.rows = rows;
+  entry->session = TerminalSession::Start(options);
+  if (!entry->session) {
+    return false;  // ~Entry gives the slot back
+  }
+  WatchReadable(id, *entry);
+  sessions_[id] = std::move(entry);
+  return true;
+}
+
+void TerminalHost::WatchReadable(int32_t id, Entry& entry) {
+  entry.read_watch = base::FileDescriptorWatcher::WatchReadable(
+      entry.session->master_fd(),
+      base::BindRepeating(&TerminalHost::OnReadable, base::Unretained(this),
+                          id));
+}
+
+bool TerminalHost::Write(int32_t id, std::string bytes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return false;
+  }
+  Entry& entry = *it->second;
+  if (bytes.size() > kMaxPendingInput - entry.pending.size()) {
+    return false;  // the program is not reading its input; drop, never block
+  }
+  entry.pending += bytes;
+  Flush(id, entry);
+  return true;
+}
+
+void TerminalHost::Flush(int32_t id, Entry& entry) {
+  std::optional<size_t> n = entry.session->WriteSome(entry.pending);
+  if (!n) {
+    // Write error (slave gone): the reader sees EIO and reports the exit.
+    entry.pending.clear();
+    entry.write_watch.reset();
+    return;
+  }
+  entry.pending.erase(0, *n);
+  if (entry.pending.empty()) {
+    entry.write_watch.reset();
+  } else if (!entry.write_watch) {
+    entry.write_watch = base::FileDescriptorWatcher::WatchWritable(
+        entry.session->master_fd(),
+        base::BindRepeating(&TerminalHost::OnWritable, base::Unretained(this),
+                            id));
+  }
+}
+
+void TerminalHost::OnWritable(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it != sessions_.end()) {
+    Flush(id, *it->second);
+  }
+}
+
+void TerminalHost::Resize(int32_t id, uint16_t cols, uint16_t rows) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it != sessions_.end()) {
+    it->second->session->Resize(cols, rows);
+  }
+}
+
+void TerminalHost::Close(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  sessions_.erase(id);
+}
+
+void TerminalHost::Ack(int32_t id, size_t bytes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  Entry& entry = *it->second;
+  entry.unacked -= std::min(bytes, entry.unacked);
+  if (!entry.read_watch && entry.unacked < kMaxUnackedOutput) {
+    WatchReadable(id, entry);
+  }
+}
+
+void TerminalHost::OnReadable(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  Entry& entry = *it->second;
+  std::string buf(kReadChunk, '\0');
+  const ssize_t n = HANDLE_EINTR(
+      read(entry.session->master_fd(), buf.data(), buf.size()));
+  if (n > 0) {
+    buf.resize(static_cast<size_t>(n));
+    entry.unacked += static_cast<size_t>(n);
+    if (entry.unacked >= kMaxUnackedOutput) {
+      // The page is behind: stop reading until it acknowledges.
+      entry.read_watch.reset();
+    }
+    on_output_.Run(id, std::move(buf));
+    return;
+  }
+  if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+    return;
+  }
+  // EOF or EIO: every holder of the slave side is gone.
+  entry.read_watch.reset();
+  entry.write_watch.reset();
+  const int code =
+      entry.session->Terminate(base::Milliseconds(200)).value_or(-1);
+  sessions_.erase(it);
+  on_exit_.Run(id, code);
+}
+
+}  // namespace aerographene
