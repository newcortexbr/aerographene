+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_host.h"
+
+#include <signal.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/run_loop.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/single_thread_task_executor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+namespace {
+
+// IO loop with a FileDescriptorWatcher, using only //base (no TaskEnvironment).
+class TerminalHostTest : public testing::Test {
+ protected:
+  TerminalHostTest()
+      : executor_(base::MessagePumpType::IO),
+        watcher_(executor_.task_runner()) {}
+
+  void SetUp() override {
+    host_ = std::make_unique<TerminalHost>(
+        base::BindRepeating(&TerminalHostTest::OnOutput,
+                            base::Unretained(this)),
+        base::BindRepeating(&TerminalHostTest::OnExit,
+                            base::Unretained(this)));
+  }
+
+  void OnOutput(int32_t id, std::string bytes) {
+    output_[id] += bytes;
+    if (auto_ack_) {
+      host_->Ack(id, bytes.size());
+    }
+    if (quit_ && !needle_.empty() &&
+        output_[id].find(needle_) != std::string::npos) {
+      std::move(quit_).Run();
+    }
+  }
+  void OnExit(int32_t id, int code) {
+    exits_[id] = code;
+    if (quit_ && needle_.empty()) {
+      std::move(quit_).Run();
+    }
+  }
+
+  // Runs until `needle` shows up in any output (or, when empty, an exit).
+  bool RunUntil(std::string needle) {
+    needle_ = std::move(needle);
+    base::RunLoop loop;
+    quit_ = loop.QuitClosure();
+    base::OneShotTimer timeout;
+    timed_out_ = false;
+    timeout.Start(FROM_HERE, base::Seconds(10),
+                  base::BindOnce(&TerminalHostTest::OnTimeout,
+                                 base::Unretained(this), loop.QuitClosure()));
+    loop.Run();
+    quit_.Reset();
+    return !timed_out_;
+  }
+
+  // Spins the loop for `delay` (the pty and the child make progress).
+  void RunFor(base::TimeDelta delay) {
+    base::RunLoop loop;
+    base::OneShotTimer t;
+    t.Start(FROM_HERE, delay, loop.QuitClosure());
+    loop.Run();
+  }
+
+  void OnTimeout(base::OnceClosure quit) {
+    timed_out_ = true;
+    std::move(quit).Run();
+  }
+
+  base::SingleThreadTaskExecutor executor_;
+  base::FileDescriptorWatcher watcher_;
+  std::unique_ptr<TerminalHost> host_;
+  std::map<int32_t, std::string> output_;
+  std::map<int32_t, int> exits_;
+  std::string needle_;
+  base::OnceClosure quit_;
+  bool timed_out_ = false;
+  bool auto_ack_ = true;
+};
+
+TEST_F(TerminalHostTest, EchoesThroughShell) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1, "echo aero-$((40+2))\n");
+  ASSERT_TRUE(RunUntil("aero-42"));
+  host_->Write(1, "exit 3\n");
+  ASSERT_TRUE(RunUntil(""));
+  ASSERT_TRUE(exits_.contains(1)) << output_[1];
+  EXPECT_EQ(exits_[1], 3) << output_[1];
+}
+
+TEST_F(TerminalHostTest, ResizeReachesShell) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Resize(1, 120, 40);
+  host_->Write(1, "stty size\n");
+  ASSERT_TRUE(RunUntil("40 120"));
+}
+
+TEST_F(TerminalHostTest, LimitsAndDuplicates) {
+  for (int32_t i = 0; i < static_cast<int32_t>(TerminalHost::kMaxSessions);
+       ++i) {
+    ASSERT_TRUE(host_->Open(i, 80, 24)) << i;
+  }
+  EXPECT_FALSE(host_->Open(100, 80, 24));
+  host_->Close(0);
+  EXPECT_FALSE(host_->Open(1, 80, 24));  // id in use
+  EXPECT_TRUE(host_->Open(0, 80, 24));
+  EXPECT_FALSE(host_->Open(200, 0, 24));
+}
+
+TEST_F(TerminalHostTest, DestructionKillsSessions) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  // The pty echoes the typed line; the quotes keep "pid=" and "done" out of
+  // the echo so only the real output matches.
+  host_->Write(1, "echo p\"\"id=$$:; echo d\"\"one\n");
+  ASSERT_TRUE(RunUntil("done"));
+  const std::string& out = output_[1];
+  const size_t at = out.rfind("pid=");
+  ASSERT_NE(at, std::string::npos) << out;
+  int pid = 0;
+  ASSERT_TRUE(base::StringToInt(
+      out.substr(at + 4, out.find(':', at) - at - 4), &pid))
+      << out;
+  ASSERT_GT(pid, 0);
+  host_.reset();
+  EXPECT_NE(kill(pid, 0), 0);
+}
+
+TEST_F(TerminalHostTest, PasteIntoProgramThatDoesNotReadNeverBlocks) {
+  // `sleep` never reads stdin and nobody acks output: pasting more than the
+  // pty buffer must queue, then refuse, and never block this sequence.
+  auto_ack_ = false;
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  ASSERT_TRUE(host_->Write(1, "exec sleep 100\n"));
+  RunFor(base::Milliseconds(300));
+  const std::string chunk(64 * 1024, 'x');
+  const base::TimeTicks start = base::TimeTicks::Now();
+  size_t accepted = 0;
+  bool refused = false;
+  for (int i = 0; i < 64 && !refused; ++i) {
+    if (host_->Write(1, chunk)) {
+      accepted += chunk.size();
+    } else {
+      refused = true;
+    }
+  }
+  EXPECT_TRUE(refused);
+  EXPECT_GE(accepted, TerminalHost::kMaxPendingInput - chunk.size());
+  EXPECT_FALSE(host_->Write(1, std::string(TerminalHost::kMaxPendingInput + 1,
+                                           'y')));
+  RunFor(base::Milliseconds(200));
+  host_->Close(1);
+  host_.reset();
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(5));
+}
+
+TEST_F(TerminalHostTest, PasteMiBIntoCatThenClose) {
+  // `cat` echoes everything back; the page never acks, so output stops at
+  // the credit limit and the paste stays queued. Close must still finish.
+  auto_ack_ = false;
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  ASSERT_TRUE(host_->Write(1, "exec cat\n"));
+  RunFor(base::Milliseconds(300));
+  const std::string chunk(64 * 1024, 'z');
+  for (int i = 0; i < 16; ++i) {
+    host_->Write(1, chunk);
+  }
+  RunFor(base::Seconds(1));
+  EXPECT_LE(output_[1].size(),
+            TerminalHost::kMaxUnackedOutput + TerminalHost::kReadChunk);
+  const base::TimeTicks start = base::TimeTicks::Now();
+  host_->Close(1);
+  host_.reset();
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(5));
+}
+
+TEST_F(TerminalHostTest, OutputPausesUntilAck) {
+  auto_ack_ = false;
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1,
+               "head -c 800000 /dev/zero | tr '\\0' a; echo; echo E\"\"ND\n");
+  RunFor(base::Seconds(1));
+  const size_t paused = output_[1].size();
+  EXPECT_GE(paused, TerminalHost::kMaxUnackedOutput);
+  EXPECT_LE(paused, TerminalHost::kMaxUnackedOutput + TerminalHost::kReadChunk);
+  EXPECT_EQ(output_[1].find("END"), std::string::npos);
+  // Acknowledge everything so far; from now on ack as it arrives.
+  auto_ack_ = true;
+  host_->Ack(1, paused);
+  ASSERT_TRUE(RunUntil("END"));
+  EXPECT_GE(output_[1].size(), 800000u);
+}
+
+TEST_F(TerminalHostTest, GlobalSessionLimit) {
+  ASSERT_EQ(TerminalHost::LiveSessionsForTesting(), 0u);
+  const size_t per_tab = TerminalHost::kMaxSessions;
+  const size_t tabs = TerminalHost::kMaxSessionsGlobal / per_tab;
+  std::vector<std::unique_ptr<TerminalHost>> others;
+  for (size_t t = 0; t < tabs; ++t) {
+    others.push_back(std::make_unique<TerminalHost>(base::DoNothing(),
+                                                    base::DoNothing()));
+    for (size_t i = 0; i < per_tab; ++i) {
+      ASSERT_TRUE(others.back()->Open(static_cast<int32_t>(i), 10, 10))
+          << t << " " << i;
+    }
+  }
+  EXPECT_EQ(TerminalHost::LiveSessionsForTesting(),
+            TerminalHost::kMaxSessionsGlobal);
+  EXPECT_FALSE(host_->Open(1, 80, 24));
+  others.back()->Close(0);
+  EXPECT_TRUE(host_->Open(1, 80, 24));
+  others.clear();
+  host_.reset();
+  EXPECT_EQ(TerminalHost::LiveSessionsForTesting(), 0u);
+}
+
