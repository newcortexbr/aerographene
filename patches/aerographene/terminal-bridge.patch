+namespace aerographene {
+
+// Bridge between chrome://terminal and the tab's TerminalHost. Registered
+// only by AeroTerminalUI, so the messages exist only in that page's renderer
+// (WebUI bindings); every message also checks that the sender is the primary
+// main frame committed at chrome://terminal. The page never chooses the
+// program, arguments or directory: open(cols, rows) starts the user's shell
+// in $HOME. Limits: TerminalHost::kMaxSessions per tab and
+// kMaxSessionsGlobal per process, kMaxWriteBytes per write,
+// kMaxPendingInput queued, kMaxUnackedOutput in flight, sizes 1..1000.
+// Malformed messages are dropped.
+//
+// Messages (args[0] is the callback id when a reply is expected):
+//   open(cb, cols, rows) -> id or null; write(id, text); resize(id, c, r);
+//   close(id); ack(id, bytes) after the page rendered `bytes` of output (at
+//   most one read chunk per ack). Events: "output"(id, base64 bytes),
+//   "exit"(id, code), "writeDropped"(id) when the input queue is full.
+class TerminalHandler : public content::WebUIMessageHandler {
+ public:
+  static constexpr size_t kMaxWriteBytes = 64 * 1024;
+
+  TerminalHandler();
+  TerminalHandler(const TerminalHandler&) = delete;
+  TerminalHandler& operator=(const TerminalHandler&) = delete;
+  ~TerminalHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void CreateHost();
+  bool FromTerminalPage();
+  void HandleOpen(const base::ListValue& args);
+  void HandleWrite(const base::ListValue& args);
+  void HandleResize(const base::ListValue& args);
+  void HandleClose(const base::ListValue& args);
+  void HandleAck(const base::ListValue& args);
+
+  void OnOpened(base::Value callback_id, int32_t id, bool ok);
+  void OnWritten(int32_t id, bool accepted);
+  void OnOutput(int32_t id, std::string bytes);
+  void OnExit(int32_t id, int code);
+
+  base::SequenceBound<TerminalHost> host_;
+  std::set<int32_t> open_ids_;
+  int32_t next_id_ = 1;
+  base::WeakPtrFactory<TerminalHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace aerographene
