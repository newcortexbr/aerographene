+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "chrome/browser/ui/webui/aero_terminal/terminal_session.h"
+
+namespace aerographene {
+
+// Owns the pty sessions of one chrome://terminal tab. Lives on a blocking
+// sequence (MayBlock + WithBaseSyncPrimitives, via base::SequenceBound) and
+// is destroyed with the tab, which kills every process group. Nothing here
+// blocks on the pty: the master is O_NONBLOCK, input waits in a per-session
+// queue drained when the fd is writable, and output is read with
+// base::FileDescriptorWatcher in chunks of at most kReadChunk bytes and
+// handed to `on_output`. Output flow control: once kMaxUnackedOutput bytes
+// were handed out without Ack(), the host stops reading that pty (the child
+// then blocks on its own writes) until the page acknowledges. `on_exit` runs
+// once per session when the slave side closes. Both callbacks must post to
+// the UI sequence themselves.
+class TerminalHost {
+ public:
+  using OutputCallback =
+      base::RepeatingCallback<void(int32_t id, std::string bytes)>;
+  using ExitCallback = base::RepeatingCallback<void(int32_t id, int code)>;
+
+  // Per tab, and for the whole browser process (all tabs and profiles).
+  static constexpr size_t kMaxSessions = 16;
+  static constexpr size_t kMaxSessionsGlobal = 64;
+  static constexpr size_t kReadChunk = 16 * 1024;
+  // Input not yet accepted by the pty; a Write() beyond it is refused whole.
+  static constexpr size_t kMaxPendingInput = 1024 * 1024;
+  static constexpr size_t kMaxUnackedOutput = 256 * 1024;
+
+  TerminalHost(OutputCallback on_output, ExitCallback on_exit);
+  TerminalHost(const TerminalHost&) = delete;
+  TerminalHost& operator=(const TerminalHost&) = delete;
+  ~TerminalHost();
+
+  // Starts the user's shell (chosen here, never by the page) in $HOME.
+  // Returns false when a limit is reached or the pty cannot be created.
+  bool Open(int32_t id, uint16_t cols, uint16_t rows);
+  // Queues `bytes` for the pty and returns at once. False (bytes dropped)
+  // when the session is unknown or the queue would exceed kMaxPendingInput.
+  bool Write(int32_t id, std::string bytes);
+  void Resize(int32_t id, uint16_t cols, uint16_t rows);
+  void Close(int32_t id);
+  // The page consumed `bytes` of output of session `id`.
+  void Ack(int32_t id, size_t bytes);
+
+  // Sessions alive in the whole process (all hosts).
+  static size_t LiveSessionsForTesting();
+
+ private:
+  struct Entry {
+    Entry();
+    ~Entry();
+    std::unique_ptr<TerminalSession> session;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> read_watch;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> write_watch;
+    std::string pending;  // input not yet written to the pty
+    size_t unacked = 0;   // output handed out and not acknowledged
+    bool counted = false;  // holds a slot of kMaxSessionsGlobal
+  };
+
+  void WatchReadable(int32_t id, Entry& entry);
+  void OnReadable(int32_t id);
+  void OnWritable(int32_t id);
+  void Flush(int32_t id, Entry& entry);
+
+  OutputCallback on_output_;
+  ExitCallback on_exit_;
+  std::map<int32_t, std::unique_ptr<Entry>> sessions_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
