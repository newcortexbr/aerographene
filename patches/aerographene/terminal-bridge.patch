+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_handler.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/common/url_constants.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace aerographene {
+
+namespace {
+
+std::optional<uint16_t> SizeArg(const base::Value& v, uint16_t max) {
+  std::optional<int> i = v.GetIfInt();
+  if (!i || *i < 1 || *i > max) {
+    return std::nullopt;
+  }
+  return static_cast<uint16_t>(*i);
+}
+
+}  // namespace
+
+TerminalHandler::TerminalHandler() {
+  CreateHost();
+}
+
+void TerminalHandler::CreateHost() {
+  // Blocking sequence for the ptys. BLOCK_SHUTDOWN so closing the browser
+  // still runs ~TerminalHost and kills every process group.
+  host_ = base::SequenceBound<TerminalHost>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::WithBaseSyncPrimitives(),
+           base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}),
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &TerminalHandler::OnOutput, weak_ptr_factory_.GetWeakPtr())),
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &TerminalHandler::OnExit, weak_ptr_factory_.GetWeakPtr())));
+}
+
+// Destroying host_ posts ~TerminalHost to its sequence, which kills the
+// process groups of every session of this tab.
+TerminalHandler::~TerminalHandler() = default;
+
+void TerminalHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "open", base::BindRepeating(&TerminalHandler::HandleOpen,
+                                  base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "write", base::BindRepeating(&TerminalHandler::HandleWrite,
+                                   base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "resize", base::BindRepeating(&TerminalHandler::HandleResize,
+                                    base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "close", base::BindRepeating(&TerminalHandler::HandleClose,
+                                   base::Unretained(this)));
+}
+
+void TerminalHandler::OnJavascriptDisallowed() {
+  // Page reloaded or navigated away: its sessions must not outlive it.
+  open_ids_.clear();
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  host_.Reset();  // ~TerminalHost kills what is left
+  CreateHost();
+}
+
+bool TerminalHandler::FromTerminalPage() {
+  content::RenderFrameHost* rfh = web_ui()->GetRenderFrameHost();
+  static const char kTerminalUrl[] = "chrome://terminal/";
+  return rfh && rfh->IsInPrimaryMainFrame() &&
+         rfh->GetLastCommittedOrigin().IsSameOriginWith(GURL(kTerminalUrl));
+}
+
+void TerminalHandler::HandleOpen(const base::ListValue& args) {
+  if (args.size() != 3 || !FromTerminalPage()) {
+    return;
+  }
+  std::optional<uint16_t> cols = SizeArg(args[1], TerminalSession::kMaxCols);
+  std::optional<uint16_t> rows = SizeArg(args[2], TerminalSession::kMaxRows);
+  AllowJavascript();
+  if (!cols || !rows || open_ids_.size() >= TerminalHost::kMaxSessions) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  const int32_t id = next_id_++;
+  open_ids_.insert(id);
+  host_.AsyncCall(&TerminalHost::Open)
+      .WithArgs(id, *cols, *rows)
+      .Then(base::BindOnce(&TerminalHandler::OnOpened,
+                           weak_ptr_factory_.GetWeakPtr(), args[0].Clone(),
+                           id));
+}
+
+void TerminalHandler::OnOpened(base::Value callback_id, int32_t id, bool ok) {
+  if (!ok) {
+    open_ids_.erase(id);
+  }
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, ok ? base::Value(id)
+                                              : base::Value());
+  }
+}
+
+void TerminalHandler::HandleWrite(const base::ListValue& args) {
+  if (args.size() != 2 || !FromTerminalPage() || !args[1].is_string()) {
+    return;
+  }
+  std::optional<int> id = args[0].GetIfInt();
+  const std::string& text = args[1].GetString();
+  if (!id || !open_ids_.contains(*id) || text.empty() ||
+      text.size() > kMaxWriteBytes) {
+    return;
+  }
+  host_.AsyncCall(&TerminalHost::Write).WithArgs(*id, text);
+}
+
+void TerminalHandler::HandleResize(const base::ListValue& args) {
+  if (args.size() != 3 || !FromTerminalPage()) {
+    return;
+  }
+  std::optional<int> id = args[0].GetIfInt();
+  std::optional<uint16_t> cols = SizeArg(args[1], TerminalSession::kMaxCols);
+  std::optional<uint16_t> rows = SizeArg(args[2], TerminalSession::kMaxRows);
+  if (!id || !open_ids_.contains(*id) || !cols || !rows) {
+    return;
+  }
+  host_.AsyncCall(&TerminalHost::Resize).WithArgs(*id, *cols, *rows);
+}
+
+void TerminalHandler::HandleClose(const base::ListValue& args) {
+  if (args.size() != 1 || !FromTerminalPage()) {
+    return;
+  }
+  std::optional<int> id = args[0].GetIfInt();
+  if (!id || !open_ids_.erase(*id)) {
+    return;
+  }
+  host_.AsyncCall(&TerminalHost::Close).WithArgs(*id);
+}
+
+void TerminalHandler::OnOutput(int32_t id, std::string bytes) {
+  if (!IsJavascriptAllowed() || !open_ids_.contains(id)) {
+    return;
+  }
+  // Raw pty bytes are not always UTF-8; the page decodes base64 and feeds
+  // the bytes to xterm.js.
+  FireWebUIListener("output", base::Value(id),
+                    base::Value(base::Base64Encode(bytes)));
+}
+
+void TerminalHandler::OnExit(int32_t id, int code) {
+  if (!open_ids_.erase(id) || !IsJavascriptAllowed()) {
+    return;
+  }
+  FireWebUIListener("exit", base::Value(id), base::Value(code));
+}
+
+}  // namespace aerographene
