+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_host.h"
+
+#include <signal.h>
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/functional/bind.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/run_loop.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/single_thread_task_executor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+namespace {
+
+// IO loop with a FileDescriptorWatcher, using only //base (no TaskEnvironment).
+class TerminalHostTest : public testing::Test {
+ protected:
+  TerminalHostTest()
+      : executor_(base::MessagePumpType::IO),
+        watcher_(executor_.task_runner()) {}
+
+  void SetUp() override {
+    host_ = std::make_unique<TerminalHost>(
+        base::BindRepeating(&TerminalHostTest::OnOutput,
+                            base::Unretained(this)),
+        base::BindRepeating(&TerminalHostTest::OnExit,
+                            base::Unretained(this)));
+  }
+
+  void OnOutput(int32_t id, std::string bytes) {
+    output_[id] += bytes;
+    if (quit_ && !needle_.empty() &&
+        output_[id].find(needle_) != std::string::npos) {
+      std::move(quit_).Run();
+    }
+  }
+  void OnExit(int32_t id, int code) {
+    exits_[id] = code;
+    if (quit_ && needle_.empty()) {
+      std::move(quit_).Run();
+    }
+  }
+
+  // Runs until `needle` shows up in any output (or, when empty, an exit).
+  bool RunUntil(std::string needle) {
+    needle_ = std::move(needle);
+    base::RunLoop loop;
+    quit_ = loop.QuitClosure();
+    base::OneShotTimer timeout;
+    timed_out_ = false;
+    timeout.Start(FROM_HERE, base::Seconds(10),
+                  base::BindOnce(&TerminalHostTest::OnTimeout,
+                                 base::Unretained(this), loop.QuitClosure()));
+    loop.Run();
+    quit_.Reset();
+    return !timed_out_;
+  }
+
+  void OnTimeout(base::OnceClosure quit) {
+    timed_out_ = true;
+    std::move(quit).Run();
+  }
+
+  base::SingleThreadTaskExecutor executor_;
+  base::FileDescriptorWatcher watcher_;
+  std::unique_ptr<TerminalHost> host_;
+  std::map<int32_t, std::string> output_;
+  std::map<int32_t, int> exits_;
+  std::string needle_;
+  base::OnceClosure quit_;
+  bool timed_out_ = false;
+};
+
+TEST_F(TerminalHostTest, EchoesThroughShell) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1, "echo aero-$((40+2))\n");
+  ASSERT_TRUE(RunUntil("aero-42"));
+  host_->Write(1, "exit 3\n");
+  ASSERT_TRUE(RunUntil(""));
+  ASSERT_TRUE(exits_.contains(1)) << output_[1];
+  EXPECT_EQ(exits_[1], 3) << output_[1];
+}
+
+TEST_F(TerminalHostTest, ResizeReachesShell) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Resize(1, 120, 40);
+  host_->Write(1, "stty size\n");
+  ASSERT_TRUE(RunUntil("40 120"));
+}
+
+TEST_F(TerminalHostTest, LimitsAndDuplicates) {
+  for (int32_t i = 0; i < static_cast<int32_t>(TerminalHost::kMaxSessions);
+       ++i) {
+    ASSERT_TRUE(host_->Open(i, 80, 24)) << i;
+  }
+  EXPECT_FALSE(host_->Open(100, 80, 24));
+  host_->Close(0);
+  EXPECT_FALSE(host_->Open(1, 80, 24));  // id in use
+  EXPECT_TRUE(host_->Open(0, 80, 24));
+  EXPECT_FALSE(host_->Open(200, 0, 24));
+}
+
+TEST_F(TerminalHostTest, DestructionKillsSessions) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  // The pty echoes the typed line; the quotes keep "pid=" and "done" out of
+  // the echo so only the real output matches.
+  host_->Write(1, "echo p\"\"id=$$:; echo d\"\"one\n");
+  ASSERT_TRUE(RunUntil("done"));
+  const std::string& out = output_[1];
+  const size_t at = out.rfind("pid=");
+  ASSERT_NE(at, std::string::npos) << out;
+  int pid = 0;
+  ASSERT_TRUE(base::StringToInt(
+      out.substr(at + 4, out.find(':', at) - at - 4), &pid))
+      << out;
+  ASSERT_GT(pid, 0);
+  host_.reset();
+  EXPECT_NE(kill(pid, 0), 0);
+}
+
