+// chrome://terminal: a board of terminal windows (drag, resize, focus,
+// close), each an xterm.js (vendored, MIT) attached to a local pty owned by
+// the browser (TerminalHandler/TerminalHost). The page only sends keystrokes
+// and sizes; the browser picks the program (the user's shell). No network,
+// no innerHTML (Trusted Types is enforced by the WebUI CSP).
+
+import {Terminal} from './xterm.mjs';
+
+const WRITE_CHUNK = 16 * 1024;  // below TerminalHandler::kMaxWriteBytes
+
+// Minimal cr.sendWithPromise / addWebUIListener: the browser calls
+// cr.webUIResponse(id, ok, value) and cr.webUIListenerCallback(name, ...).
+const pending = new Map();
+const listeners = new Map();
+let nextCall = 0;
+window.cr = window.cr || {};
+window.cr.webUIResponse = (id, ok, value) => {
+  const p = pending.get(id);
+  if (p) {
+    pending.delete(id);
+    (ok ? p.resolve : p.reject)(value);
+  }
+};
+window.cr.webUIListenerCallback = (name, ...args) => {
+  const fn = listeners.get(name);
+  if (fn) {
+    fn(...args);
+  }
+};
+function call(name, ...args) {
+  const id = `term${nextCall++}`;
+  return new Promise((resolve, reject) => {
+    pending.set(id, {resolve, reject});
+    chrome.send(name, [id, ...args]);
+  });
+}
+
+const sessions = new Map();  // session id -> {term, setTitle}
+listeners.set('output', (id, b64) => {
+  const s = sessions.get(id);
+  if (s) {
+    const bytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+    // Flow control: the browser stops reading the pty while too much output
+    // is unacknowledged; ack once xterm.js has parsed this chunk.
+    s.term.write(bytes, () => chrome.send('ack', [id, bytes.length]));
+  }
+});
+listeners.set('writeDropped', (id) => {
+  const s = sessions.get(id);
+  if (s) {
+    s.term.write('\r\n[entrada descartada: o programa não está lendo]\r\n');
+  }
+});
+listeners.set('exit', (id, code) => {
+  const s = sessions.get(id);
+  if (s) {
+    sessions.delete(id);
+    s.term.write(`\r\n[processo terminou: ${code}]\r\n`);
+    s.setTitle('encerrado');
+  }
+});
+
+// Cell size of the rendered font; xterm 6 has no public API for it.
+function fitSize(term, el) {
+  const dims = term._core?._renderService?.dimensions?.css?.cell;
+  const cw = dims?.width || 7.8;
+  const ch = dims?.height || 17;
+  return {
+    cols: Math.max(2, Math.min(1000, Math.floor((el.clientWidth - 8) / cw))),
+    rows: Math.max(1, Math.min(1000, Math.floor((el.clientHeight - 4) / ch))),
+  };
+}
 
