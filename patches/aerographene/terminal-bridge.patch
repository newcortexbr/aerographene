+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "chrome/browser/ui/webui/aero_terminal/terminal_session.h"
+
+namespace aerographene {
+
+// Owns the pty sessions of one chrome://terminal tab. Lives on a blocking
+// sequence (MayBlock + WithBaseSyncPrimitives, via base::SequenceBound) and
+// is destroyed with the tab, which kills every process group. Output is read
+// with base::FileDescriptorWatcher in chunks of at most kReadChunk bytes and
+// handed to `on_output`; `on_exit` runs once per session when the slave
+// side closes. Both callbacks must post to the UI sequence themselves.
+class TerminalHost {
+ public:
+  using OutputCallback =
+      base::RepeatingCallback<void(int32_t id, std::string bytes)>;
+  using ExitCallback = base::RepeatingCallback<void(int32_t id, int code)>;
+
+  static constexpr size_t kMaxSessions = 16;
+  static constexpr size_t kReadChunk = 16 * 1024;
+
+  TerminalHost(OutputCallback on_output, ExitCallback on_exit);
+  TerminalHost(const TerminalHost&) = delete;
+  TerminalHost& operator=(const TerminalHost&) = delete;
+  ~TerminalHost();
+
+  // Starts the user's shell (chosen here, never by the page) in $HOME.
+  // Returns false when the limit is reached or the pty cannot be created.
+  bool Open(int32_t id, uint16_t cols, uint16_t rows);
+  void Write(int32_t id, std::string bytes);
+  void Resize(int32_t id, uint16_t cols, uint16_t rows);
+  void Close(int32_t id);
+
+ private:
+  struct Entry {
+    Entry();
+    ~Entry();
+    std::unique_ptr<TerminalSession> session;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> watch;
+  };
+
+  void OnReadable(int32_t id);
+
+  OutputCallback on_output_;
+  ExitCallback on_exit_;
+  std::map<int32_t, std::unique_ptr<Entry>> sessions_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_HOST_H_
