+  }
+  std::optional<int> id = args[1].GetIfInt();
+  AllowJavascript();
+  if (!id || !open_ids_.contains(*id)) {
+    ResolveJavascriptCallback(args[0], base::Value(std::string()));
+    return;
+  }
+  host_.AsyncCall(&TerminalHost::Foreground)
+      .WithArgs(*id)
+      .Then(base::BindOnce(&TerminalHandler::OnForeground,
+                           weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void TerminalHandler::OnForeground(base::Value callback_id,
+                                   std::string name) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, base::Value(std::move(name)));
+  }
+}
