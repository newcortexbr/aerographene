+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace aerographene {
+
+// Command bar entry `-t` (terminal workspace). Accepts "-t" or "-t N" with N
+// in [1, kMaxTerminalWorkspace], case-insensitive, surrounded by optional
+// whitespace, and returns the workspace number (1 for a bare "-t"). Anything
+// else (including "-t0", "-tx", "-t 1 2") returns nullopt.
+inline constexpr int kMaxTerminalWorkspace = 99;
+std::optional<int> ParseTerminalCommand(std::u16string_view text);
+
+// The page the command opens: "chrome://terminal/?w=N".
+std::string TerminalCommandUrl(int workspace);
+
+}  // namespace aerographene
