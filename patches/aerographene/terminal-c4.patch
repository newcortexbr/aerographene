+std::string TerminalSession::ForegroundProcessName() const {
+  if (terminated_) {
+    return std::string();
+  }
+  const pid_t pgid = tcgetpgrp(master_.get());
+  if (pgid <= 0) {
+    return std::string();
+  }
+  std::string comm;
+  if (!base::ReadFileToStringWithMaxSize(
+          base::FilePath("/proc/" + base::NumberToString(pgid) + "/comm"),
+          &comm, 64) &&
+      comm.empty()) {
+    return std::string();
+  }
+  std::string out;
+  for (char c : comm) {
+    if (c == '\n') {
+      break;
+    }
+    out.push_back(c >= 0x20 && c <= 0x7e ? c : '?');
+  }
+  return out;
+}
