+// Pan: drag on the empty board; wheel pans, Ctrl+wheel zooms at the pointer.
+// Anything inside a window (terminal scrollback, selection) is left alone.
+const onBackground = (e) => e.target === board || e.target === world;
+let pan = null;
+board.addEventListener('pointerdown', (e) => {
+  if ((e.button !== 0 && e.button !== 1) || !onBackground(e)) {
+    return;
+  }
+  pan = {x: e.clientX, y: e.clientY, vx: view.x, vy: view.y};
+  board.setPointerCapture(e.pointerId);
+  board.classList.add('panning');
+  e.preventDefault();
+});
+board.addEventListener('pointermove', (e) => {
+  if (pan && board.hasPointerCapture(e.pointerId)) {
+    view.x = pan.vx + e.clientX - pan.x;
+    view.y = pan.vy + e.clientY - pan.y;
+    applyView();
+  }
+});
+const endPan = (e) => {
+  if (pan) {
+    pan = null;
+    board.classList.remove('panning');
+    if (board.hasPointerCapture(e.pointerId)) {
+      board.releasePointerCapture(e.pointerId);
+    }
+    scheduleSave();
+  }
+};
+board.addEventListener('pointerup', endPan);
+board.addEventListener('pointercancel', endPan);
+board.addEventListener('wheel', (e) => {
+  if (e.ctrlKey) {
+    const r = board.getBoundingClientRect();
+    zoomAt(view.k * Math.exp(-e.deltaY * 0.002), e.clientX - r.left,
+           e.clientY - r.top);
+    e.preventDefault();
+  } else if (onBackground(e)) {
+    view.x -= e.deltaX;
+    view.y -= e.deltaY;
+    applyView();
+    scheduleSave();
+    e.preventDefault();
+  }
+}, {passive: false});
+
+document.getElementById('zoomIn').addEventListener(
+    'click', () => zoomCentered(1.25));
+document.getElementById('zoomOut').addEventListener(
+    'click', () => zoomCentered(0.8));
+document.getElementById('zoomReset').addEventListener('click', () => {
+  view.x = 0;
+  view.y = 0;
+  view.k = 1;
+  applyView();
+  scheduleSave();
+});
+document.getElementById('add').addEventListener('click', () => addWindow());
+
+const restored = loadLayout();
+if (restored) {
+  Object.assign(view, restored.view);
+}
+applyView();
+if (restored && restored.wins.length > 0) {
+  for (const w of restored.wins) {
+    addWindow(w);
+  }
+} else {
+  addWindow();
+}
