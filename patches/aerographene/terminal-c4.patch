+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "components/omnibox/browser/aero_terminal_command.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+
+TEST(AeroTerminalCommandTest, Accepts) {
+  EXPECT_EQ(ParseTerminalCommand(u"-t"), 1);
+  EXPECT_EQ(ParseTerminalCommand(u"  -T  "), 1);
+  EXPECT_EQ(ParseTerminalCommand(u"-t 2"), 2);
+  EXPECT_EQ(ParseTerminalCommand(u"-t   99 "), 99);
+  EXPECT_EQ(ParseTerminalCommand(u"-t 07"), 7);
+}
+
+TEST(AeroTerminalCommandTest, Rejects) {
+  for (const char16_t* s :
+       {u"", u"-", u"t", u"-tx", u"-t2", u"-t 0", u"-t 100", u"-t -1",
+        u"-t 1 2", u"-t x", u"- t", u"--t", u"-tt", u"a -t", u"-t 1x"}) {
+    EXPECT_FALSE(ParseTerminalCommand(s)) << base::UTF16ToUTF8(s);
+  }
+}
+
+TEST(AeroTerminalCommandTest, Url) {
+  EXPECT_EQ(TerminalCommandUrl(3), "chrome://terminal/?w=3");
+}
