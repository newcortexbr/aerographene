+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "components/omnibox/browser/aero_terminal_command.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace aerographene {
+
+std::optional<int> ParseTerminalCommand(std::u16string_view text) {
+  std::u16string_view t = base::TrimWhitespace(text, base::TRIM_ALL);
+  if (t.size() < 2 || t[0] != u'-' || (t[1] != u't' && t[1] != u'T')) {
+    return std::nullopt;
+  }
+  std::u16string_view rest = t.substr(2);
+  if (rest.empty()) {
+    return 1;
+  }
+  // The number must come after whitespace: "-t2" and "-tx" are rejected.
+  if (!base::IsUnicodeWhitespace(rest[0])) {
+    return std::nullopt;
+  }
+  rest = base::TrimWhitespace(rest, base::TRIM_ALL);
+  if (rest.empty() || rest.size() > 2) {
+    return std::nullopt;
+  }
+  for (char16_t c : rest) {
+    if (c < u'0' || c > u'9') {
+      return std::nullopt;
+    }
+  }
+  int n = 0;
+  if (!base::StringToInt(base::UTF16ToUTF8(rest), &n) || n < 1 ||
+      n > kMaxTerminalWorkspace) {
+    return std::nullopt;
+  }
+  return n;
+}
+
+std::string TerminalCommandUrl(int workspace) {
+  return "chrome://terminal/?w=" + base::NumberToString(workspace);
+}
+
+}  // namespace aerographene
