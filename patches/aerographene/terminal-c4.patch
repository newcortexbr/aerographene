+  // exec may not have happened yet: poll briefly.
+  std::string name;
+  for (int i = 0; i < 100 && name != "sleep"; ++i) {
+    name = s->ForegroundProcessName();
+    if (name != "sleep") {
+      base::PlatformThread::Sleep(base::Milliseconds(50));
+    }
+  }
+  EXPECT_EQ(name, "sleep");
+  s->Terminate(base::Milliseconds(50));
+  EXPECT_EQ(s->ForegroundProcessName(), "");
+}
