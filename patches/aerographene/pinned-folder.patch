+void PinnedTabContainerView::MoveClosedPinnedFolder(const base::Uuid& uuid) {
+  aerographene::PinnedModel* model = GetWindowPinnedModel();
+  if (!model || !model->IsLoaded()) {
+    return;
+  }
+  if (model->GetParentFolder(uuid).is_valid()) {
+    model->MoveToTopLevel(uuid);
+  } else {
+    model->MoveIntoNewFolder(
+        uuid, l10n_util::GetStringUTF16(
+                  IDS_AEROGRAPHENE_PINNED_FOLDER_DEFAULT_TITLE));
+  }
+}
+
+void PinnedTabContainerView::ToggleFolder(const base::Uuid& uuid) {
+  aerographene::PinnedModel* model = GetWindowPinnedModel();
+  const std::optional<aerographene::PinnedItem> item =
+      model ? model->Find(uuid) : std::nullopt;
+  if (item && item->is_folder) {
+    model->SetExpanded(uuid, !item->expanded);
+  }
+}
