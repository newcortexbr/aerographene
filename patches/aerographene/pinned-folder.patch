+// Full-width row of a drawer folder in the vertical pinned grid. Clicking it
+// opens or closes the drawer. Painted with the canvas only (chevron, folder
+// glyph, text); no layer of its own, like the placeholders.
+class AerographenePinnedFolderView : public views::Button {
+  METADATA_HEADER(AerographenePinnedFolderView, views::Button)
+
+ public:
+  explicit AerographenePinnedFolderView(PressedCallback callback)
+      : views::Button(std::move(callback)) {}
+  AerographenePinnedFolderView(const AerographenePinnedFolderView&) = delete;
+  AerographenePinnedFolderView& operator=(
+      const AerographenePinnedFolderView&) = delete;
+  ~AerographenePinnedFolderView() override = default;
+
+  void Update(const aerographene::PinnedItem& item, int model_index) {
+    uuid_ = item.uuid;
+    model_index_ = model_index;
+    expanded_ = item.expanded;
+    text_ = item.label.empty() ? item.title : base::UTF8ToUTF16(item.label);
+    SetTooltipText(text_);
+    GetViewAccessibility().SetName(text_);
+    if (expanded_) {
+      GetViewAccessibility().SetIsExpanded();
+    } else {
+      GetViewAccessibility().SetIsCollapsed();
+    }
+    SchedulePaint();
+  }
+
+  const base::Uuid& uuid() const { return uuid_; }
+  int model_index() const { return model_index_; }
+  bool expanded() const { return expanded_; }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+                     GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor color = color_provider->GetColor(ui::kColorIcon);
+    const gfx::Rect bounds = GetLocalBounds();
+    const float cy = bounds.y() + bounds.height() / 2.0f;
+    auto point = [&](float logical_x, float y) {
+      return gfx::PointF(base::i18n::IsRTL() ? bounds.width() - logical_x
+                                             : logical_x,
+                         y);
+    };
+
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(kFolderStrokeWidth);
+    stroke.setColor(color);
+
+    // Chevron: pointing down when open, towards the text when closed.
+    const float cx = bounds.x() + kFolderRowPadding + kFolderChevronSize / 2.0f;
+    const float half = kFolderChevronSize / 2.0f;
+    if (expanded_) {
+      canvas->DrawLine(point(cx - half, cy - half / 2),
+                       point(cx, cy + half / 2), stroke);
+      canvas->DrawLine(point(cx, cy + half / 2),
+                       point(cx + half, cy - half / 2), stroke);
+    } else {
+      canvas->DrawLine(point(cx - half / 2, cy - half),
+                       point(cx + half / 2, cy), stroke);
+      canvas->DrawLine(point(cx + half / 2, cy),
+                       point(cx - half / 2, cy + half), stroke);
+    }
+
+    // Folder glyph: a tab on top of an outlined body.
+    const int icon_x =
+        bounds.x() + kFolderRowPadding + kFolderChevronSize + kFolderIconGap;
+    const int icon_y = bounds.y() + (bounds.height() - kFolderIconHeight) / 2;
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(color);
+    canvas->DrawRoundRect(GetMirroredRect(gfx::Rect(icon_x, icon_y,
+                                                    kFolderIconTabWidth, 4)),
+                          1, fill);
+    canvas->DrawRoundRect(
+        gfx::RectF(GetMirroredRect(gfx::Rect(icon_x, icon_y + 2,
+                                             kFolderIconWidth,
+                                             kFolderIconHeight - 2))),
+        2, stroke);
+
+    const int text_x = icon_x + kFolderIconWidth + kFolderIconGap;
+    const gfx::Rect text_bounds(
+        text_x, bounds.y(),
+        std::max(0, bounds.right() - kFolderRowPadding - text_x),
+        bounds.height());
+    canvas->DrawStringRect(
+        text_, gfx::FontList(),
+        color_provider->GetColor(ui::kColorLabelForeground),
+        GetMirroredRect(text_bounds));
+  }
+
+ private:
+  base::Uuid uuid_;
+  int model_index_ = 0;
+  bool expanded_ = false;
+  std::u16string text_;
+};
