+bool PinnedModel::SetExpanded(const base::Uuid& uuid, bool expanded) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || !IsDrawer(node) || node->parent() != root_) {
+    return false;
+  }
+  if (expanded == HasFlag(node, kPinnedExpandedMetaKey)) {
+    return true;
+  }
+  if (expanded) {
+    model_->SetNodeMetaInfo(node, kPinnedExpandedMetaKey, "1");
+  } else {
+    model_->DeleteNodeMetaInfo(node, kPinnedExpandedMetaKey);
+  }
+  return true;
+}
+
+base::Uuid PinnedModel::GetParentFolder(const base::Uuid& uuid) const {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || node->parent() == root_ || !IsDrawer(node->parent())) {
+    return base::Uuid();
+  }
+  return node->parent()->uuid();
+}
+
+std::optional<base::Uuid> PinnedModel::MoveIntoNewFolder(
+    const base::Uuid& uuid,
+    const std::u16string& title) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || !node->is_url() || node->parent() != root_) {
+    return std::nullopt;
+  }
+  const std::optional<size_t> index = root_->GetIndexOf(node);
+  if (!index) {
+    return std::nullopt;
+  }
+  const std::optional<base::Uuid> folder = AddFolder(title, *index);
+  if (!folder) {
+    return std::nullopt;
+  }
+  Move(uuid, *folder, 0);
+  SetExpanded(*folder, true);
+  return folder;
+}
+
+bool PinnedModel::MoveToTopLevel(const base::Uuid& uuid) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || node->parent() == root_) {
+    return false;
+  }
+  const std::optional<size_t> index = root_->GetIndexOf(node->parent());
+  return index && Move(uuid, base::Uuid(), *index + 1);
+}
