+// aerographene: first letter or digit of the name, upper case. "A" when the
+// name has none.
+std::u16string SpaceGlyphText(const std::u16string& name) {
+  for (char16_t c : name) {
+    if (u_isalnum(c)) {
+      return std::u16string(1, static_cast<char16_t>(u_toupper(c)));
+    }
+  }
+  return u"A";
+}
+
+// aerographene: glyph shown in place of the avatar image, the initial of the
+// space name in a thin-bordered square. Colours come from the theme tokens.
+class SpaceGlyphView : public views::Label {
+  METADATA_HEADER(SpaceGlyphView, views::Label)
+
+ public:
+  SpaceGlyphView(const std::u16string& name, int size)
+      : views::Label(SpaceGlyphText(name),
+                     views::style::CONTEXT_LABEL,
+                     views::style::STYLE_BODY_3_MEDIUM) {
+    SetFontList(
+        font_list().Derive(10, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetVerticalAlignment(gfx::ALIGN_MIDDLE);
+    SetAutoColorReadabilityEnabled(false);
+    SetEnabledColor(ui::kColorSysPrimary);
+    SetBorder(views::CreateSolidBorder(1, ui::kColorSysPrimary));
+    SetBackground(views::CreateSolidBackground(
+        kColorProfileMenuIdentityInfoBackground));
+    SetPreferredSize(gfx::Size(size, size));
+  }
+};
+
+BEGIN_METADATA(SpaceGlyphView)
+END_METADATA
