 using content::BrowserContext;
 using content::WebContents;
 
+namespace {
+
+// aerographene: static home page (aero_newtab.html), no Mojo, no WebUI
+// bindings, no JS bundle. Replaces NewTabPageThirdPartyUI as the controller
+// behind chrome://new-tab-page-third-party/, the URL that ungoogled-chromium
+// (inox restore-classic-ntp) always maps chrome://newtab to outside incognito,
+// so omnibox display, focus and NTP detection keep working unchanged.
+class AeroNewTabUI : public content::WebUIController {
+ public:
+  explicit AeroNewTabUI(content::WebUI* web_ui)
+      : content::WebUIController(web_ui) {
+    Profile* profile = Profile::FromWebUI(web_ui);
+    content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+        profile, chrome::kChromeUINewTabPageThirdPartyHost);
+    source->SetDefaultResource(IDR_AERO_NEWTAB_HTML);
+    source->UseStringsJs();
+    source->AddString("searchUrl", GetSearchUrl(profile));
+    // The page is static and ships one inline script; it loads nothing from
+    // the network (strings.js and chrome://theme/colors.css are local).
+    source->OverrideContentSecurityPolicy(
+        network::mojom::CSPDirectiveName::ScriptSrc,
+        "script-src 'self' 'unsafe-inline';");
+    content::URLDataSource::Add(profile,
+                                std::make_unique<ThemeSource>(profile));
+  }
+
+  AeroNewTabUI(const AeroNewTabUI&) = delete;
+  AeroNewTabUI& operator=(const AeroNewTabUI&) = delete;
+
+ private:
+  // Default search engine URL with a marker where the query goes. Empty when
+  // there is no usable engine (ungoogled "No Search", POST-only, non-http).
+  static std::string GetSearchUrl(Profile* profile) {
+    constexpr char kMarker[] = "aeroq9x";
+    TemplateURLService* service =
+        TemplateURLServiceFactory::GetForProfile(profile);
+    const TemplateURL* provider =
+        service ? service->GetDefaultSearchProvider() : nullptr;
+    if (!provider || !provider->search_url_post_params().empty()) {
+      return std::string();
+    }
+    UIThreadSearchTermsData search_terms_data;
+    if (!provider->SupportsReplacement(search_terms_data)) {
+      return std::string();
+    }
+    GURL url(provider->url_ref().ReplaceSearchTerms(
+        TemplateURLRef::SearchTermsArgs(base::UTF8ToUTF16(kMarker)),
+        search_terms_data));
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+        url.host().find(kMarker) != std::string::npos) {
+      return std::string();
+    }
+    return url.spec();
+  }
+};
+
+}  // namespace
+
 bool NewTabPageThirdPartyUIConfig::IsWebUIEnabled(
     content::BrowserContext* browser_context) {
   Profile* profile = Profile::FromBrowserContext(browser_context);
