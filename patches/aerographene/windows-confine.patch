+namespace {
+
+// Walks the visible tree depth first (ListVaultDir order). `visit` gets each
+// entry; returning false stops the walk. Stops by itself at kMaxSearchFiles
+// entries or kMaxSearchDepth levels (returns true when a limit cut it off).
+bool WalkVault(const base::FilePath& root,
+               const base::RepeatingCallback<bool(const VaultEntry&)>& visit) {
+  size_t visited = 0;
+  bool cut = false;
+  bool stop = false;
+  std::vector<std::pair<std::string, size_t>> stack;
+  stack.emplace_back(std::string(), 0);
+  while (!stack.empty() && !stop) {
+    auto [dir, depth] = std::move(stack.back());
+    stack.pop_back();
+    std::optional<std::vector<VaultEntry>> entries = ListVaultDir(root, dir);
+    if (!entries) {
+      continue;
+    }
+    // Pushed in reverse so the walk keeps the listing order.
+    std::vector<std::string> subdirs;
+    for (const VaultEntry& e : *entries) {
+      if (++visited > kMaxSearchFiles) {
+        cut = true;
+        stop = true;
+        break;
+      }
+      if (!visit.Run(e)) {
+        stop = true;
+        break;
+      }
+      if (e.is_dir) {
+        if (depth + 1 >= kMaxSearchDepth) {
+          cut = true;
+        } else {
+          subdirs.push_back(e.path);
+        }
+      }
+    }
+    for (auto it = subdirs.rbegin(); it != subdirs.rend(); ++it) {
+      stack.emplace_back(std::move(*it), depth + 1);
+    }
+  }
+  return cut;
+}
+
+// Valid-UTF-8 excerpt of `line` around byte offset `at`.
+std::string Snippet(std::string_view line, size_t at) {
+  size_t begin = at > 40 ? at - 40 : 0;
+  while (begin < line.size() &&
+         (static_cast<unsigned char>(line[begin]) & 0xC0) == 0x80) {
+    ++begin;  // do not start inside a multi-byte character
+  }
+  std::string out(line.substr(begin));
+  if (out.size() > kMaxSnippetBytes) {
+    out = std::string(base::TruncateUTF8ToByteSize(out, kMaxSnippetBytes));
+  }
+  if (!base::IsStringUTF8(out)) {
+    return std::string();  // invalid note text: no excerpt
+  }
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+}  // namespace
+
+SearchResult SearchVault(const base::FilePath& root, std::string_view query) {
+  SearchResult result;
+  if (query.empty() || query.size() > kMaxSearchQueryBytes ||
+      !base::IsStringUTF8(query)) {
+    return result;
+  }
+  const std::string needle = base::ToLowerASCII(query);
+  std::vector<SearchHit> name_hits;
+  std::vector<SearchHit> content_hits;
+  size_t bytes_read = 0;
+  bool full = false;
+  result.truncated = WalkVault(
+      root, base::BindRepeating(
+                [](const base::FilePath& root, const std::string& needle,
+                   std::vector<SearchHit>* name_hits,
+                   std::vector<SearchHit>* content_hits, size_t* bytes_read,
+                   bool* full, const VaultEntry& e) {
+                  if (e.is_dir || !base::IsStringUTF8(e.path)) {
+                    return true;
+                  }
+                  const std::string leaf =
+                      base::ToLowerASCII(e.path.substr(e.path.rfind('/') + 1));
+                  const bool by_name = leaf.find(needle) != std::string::npos;
+                  SearchHit hit;
+                  hit.path = e.path;
+                  hit.name_match = by_name;
+                  if (IsNote(base::FilePath::FromUTF8Unsafe(e.path)) &&
+                      e.size <= static_cast<int64_t>(kMaxNoteBytes) &&
+                      *bytes_read + static_cast<size_t>(e.size) <=
+                          kMaxSearchBytes) {
+                    std::optional<std::string> text =
+                        ReadVaultNote(root, e.path);
+                    if (text) {
+                      *bytes_read += text->size();
+                      const std::string lower = base::ToLowerASCII(*text);
+                      const size_t at = lower.find(needle);
+                      if (at != std::string::npos) {
+                        const size_t b = lower.rfind('\n', at);
+                        const size_t start = b == std::string::npos ? 0 : b + 1;
+                        size_t end = lower.find('\n', at);
+                        if (end == std::string::npos) {
+                          end = lower.size();
+                        }
+                        hit.snippet = Snippet(
+                            std::string_view(*text).substr(start, end - start),
+                            at - start);
+                        if (hit.snippet.empty()) {
+                          hit.snippet = " ";  // matched; excerpt unavailable
+                        }
+                      }
+                    }
+                  } else if (IsNote(base::FilePath::FromUTF8Unsafe(e.path))) {
+                    *full = true;  // skipped for size or byte budget
+                  }
+                  if (by_name) {
+                    name_hits->push_back(std::move(hit));
+                  } else if (!hit.snippet.empty()) {
+                    content_hits->push_back(std::move(hit));
+                  }
+                  return name_hits->size() + content_hits->size() <
+                         kMaxSearchHits;
+                },
+                root, needle, &name_hits, &content_hits, &bytes_read, &full));
+  for (SearchHit& h : content_hits) {
+    name_hits.push_back(std::move(h));
+  }
+  if (name_hits.size() >= kMaxSearchHits) {
+    name_hits.resize(kMaxSearchHits);
+    result.truncated = true;
+  }
+  result.truncated = result.truncated || full;
+  result.hits = std::move(name_hits);
+  return result;
+}
+
+std::optional<std::string> FindVaultFileByName(const base::FilePath& root,
+                                               std::string_view name) {
+  if (name.empty() || name.size() > kMaxNameBytes ||
+      name.find('/') != std::string_view::npos || name[0] == '.' ||
+      !IsValidRelative(name)) {
+    return std::nullopt;
+  }
+  const std::string want = base::ToLowerASCII(name);
+  std::optional<std::string> found;
+  WalkVault(root,
+            base::BindRepeating(
+                [](const std::string& want, std::optional<std::string>* found,
+                   const VaultEntry& e) {
+                  if (!e.is_dir &&
+                      base::ToLowerASCII(e.path.substr(
+                          e.path.rfind('/') + 1)) == want) {
+                    *found = e.path;
+                    return false;
+                  }
+                  return true;
+                },
+                want, &found));
+  return found;
+}
