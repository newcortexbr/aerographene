+// D3c: confined Win32 access, read only.
+//
+// Every access opens the path one component at a time from a handle of the
+// root, holding each directory handle open WITHOUT FILE_SHARE_DELETE: while
+// held, no component already checked can be renamed, deleted or swapped for a
+// junction or symlink. Each component is opened with
+// FILE_FLAG_OPEN_REPARSE_POINT and refused when it is a name-surrogate
+// reparse point (symlink, junction, mount point), so the walk never leaves
+// the vault; stricter than POSIX, which follows symlinks that stay inside.
+// Cloud placeholders (OneDrive, Dropbox) are accepted. The final path of
+// each opened component (GetFinalPathNameByHandleW, normalized) must equal
+// the final path of the held parent + '\\' + the requested name without
+// case: a component reached through a junction swapped meanwhile, an 8.3
+// short name ("NOTAS~1") or any other alias is refused. Names with ':'
+// (alternate data streams), the characters Win32 forbids, a trailing dot or
+// space (Win32 strips them), or a reserved device name (CON, NUL, COM1,
+// LPT1...) are refused before any open. The root must be a local drive
+// path ("X:\..."): UNC ("\\server\share"), "\\?\" and "\\.\" roots are refused.
+// Writes (B4) are not supported on Windows (kVaultWriteSupported).
+
+namespace {
+
+// Windows rules for one path component (UTF-16), on top of IsValidRelative.
+bool IsSafeWinComponent(std::wstring_view name) {
+  if (name.empty() || name.size() > 255 || name == L"." || name == L"..") {
+    return false;
+  }
+  for (wchar_t c : name) {
+    if (c < 0x20 || c == L'<' || c == L'>' || c == L':' || c == L'"' ||
+        c == L'/' || c == L'\\' || c == L'|' || c == L'?' || c == L'*') {
+      return false;
+    }
+  }
+  if (name.back() == L'.' || name.back() == L' ') {
+    return false;
+  }
+  // Reserved device names, alone or with any extension ("nul.md"), also with
+  // spaces before the dot ("CON .md").
+  std::wstring_view stem = name.substr(0, name.find(L'.'));
+  while (!stem.empty() && stem.back() == L' ') {
+    stem.remove_suffix(1);
+  }
+  static constexpr const wchar_t* kReserved[] = {
+      L"CON", L"PRN", L"AUX", L"NUL", L"CONIN$", L"CONOUT$", L"CLOCK$"};
+  for (const wchar_t* r : kReserved) {
+    if (base::EqualsCaseInsensitiveASCII(stem, r)) {
+      return false;
+    }
+  }
+  if (stem.size() == 4) {
+    const std::wstring_view head = stem.substr(0, 3);
+    const wchar_t d = stem[3];
+    if ((base::EqualsCaseInsensitiveASCII(head, L"COM") ||
+         base::EqualsCaseInsensitiveASCII(head, L"LPT")) &&
+        ((d >= L'0' && d <= L'9') || d == 0x00B9 || d == 0x00B2 ||
+         d == 0x00B3)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Local drive root only: "X:\...". No UNC, no "\\?\" or "\\.\" prefix.
+bool IsLocalDriveRoot(const base::FilePath& root) {
+  const std::wstring& v = root.value();
+  return v.size() >= 3 && base::IsAsciiAlpha(v[0]) && v[1] == L':' &&
+         v[2] == L'\\' && root.IsAbsolute();
+}
+
+// Normalized final path of `h` ("\\?\X:\...", long names, case on disk),
+// without a trailing separator.
+std::optional<std::wstring> FinalPath(HANDLE h) {
+  wchar_t buf[MAX_PATH + 1];
+  std::wstring path;
+  DWORD n = ::GetFinalPathNameByHandleW(
+      h, buf, static_cast<DWORD>(std::size(buf)),
+      FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+  if (n == 0) {
+    return std::nullopt;
+  }
+  if (n >= std::size(buf)) {
+    path.resize(n);
+    n = ::GetFinalPathNameByHandleW(h, path.data(), n,
+                                    FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+    if (n == 0 || n >= path.size()) {
+      return std::nullopt;
+    }
+    path.resize(n);
+  } else {
+    path.assign(buf, n);
+  }
+  while (!path.empty() && path.back() == L'\\') {
+    path.pop_back();  // drive root "\\?\X:\"
+  }
+  return path;
+}
+
+bool SameNameNoCase(std::wstring_view a, std::wstring_view b) {
+  return ::CompareStringOrdinal(a.data(), static_cast<int>(a.size()), b.data(),
+                                static_cast<int>(b.size()),
+                                /*bIgnoreCase=*/TRUE) == CSTR_EQUAL;
+}
+
+// Handles of the root and of every directory below it, kept open (no
+// FILE_SHARE_DELETE) while the caller works on the last one.
+struct WinChain {
+  std::vector<base::win::ScopedHandle> dirs;
+  base::FilePath path;  // root + components, '\\'-separated
+  HANDLE dir() const { return dirs.back().get(); }
+};
+
+base::win::ScopedHandle OpenComponent(const base::FilePath& path,
+                                      bool directory) {
+  const DWORD share = directory ? (FILE_SHARE_READ | FILE_SHARE_WRITE)
+                                : (FILE_SHARE_READ | FILE_SHARE_WRITE |
+                                   FILE_SHARE_DELETE);
+  return base::win::ScopedHandle(::CreateFileW(
+      path.value().c_str(), GENERIC_READ, share, nullptr, OPEN_EXISTING,
+      FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
+}
+
+// Attributes of an open handle; nullopt unless it is a local disk object.
+std::optional<BY_HANDLE_FILE_INFORMATION> DiskInfo(HANDLE h) {
+  BY_HANDLE_FILE_INFORMATION info;
+  if (::GetFileType(h) != FILE_TYPE_DISK ||
+      !::GetFileInformationByHandle(h, &info)) {
+    return std::nullopt;
+  }
+  return info;
+}
+
+// True for reparse points that redirect the name (symlink, junction, mount
+// point). Cloud placeholders (OneDrive, Dropbox) are not name surrogates and
+// stay readable like regular files.
+bool IsNameSurrogate(HANDLE h, DWORD attrs) {
+  if (!(attrs & FILE_ATTRIBUTE_REPARSE_POINT)) {
+    return false;
+  }
+  FILE_ATTRIBUTE_TAG_INFO tag;
+  if (!::GetFileInformationByHandleEx(h, FileAttributeTagInfo, &tag,
+                                      sizeof(tag))) {
+    return true;  // unknown: refuse
+  }
+  return IsReparseTagNameSurrogate(tag.ReparseTag);
+}
+
+// Checks the component just opened below the held directory `parent`: not a
+// name-surrogate reparse point, the expected kind, and its final path equal
+// to the final path of `parent` + '\' + `want` without case. This proves the
+// object really is the entry of `parent` (a path re-resolved through a
+// swapped junction lands elsewhere) and refuses 8.3 aliases.
+bool CheckComponent(HANDLE parent,
+                    HANDLE h,
+                    std::wstring_view want,
+                    bool directory,
+                    BY_HANDLE_FILE_INFORMATION* out = nullptr) {
+  std::optional<BY_HANDLE_FILE_INFORMATION> info = DiskInfo(h);
+  if (!info || (info->dwFileAttributes & FILE_ATTRIBUTE_DEVICE) ||
+      IsNameSurrogate(h, info->dwFileAttributes)) {
+    return false;
+  }
+  if (!!(info->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != directory) {
+    return false;
+  }
+  std::optional<std::wstring> base = FinalPath(parent);
+  std::optional<std::wstring> path = FinalPath(h);
+  if (!base || !path || path->size() <= base->size() + 1 ||
+      (*path)[base->size()] != L'\\' ||
+      !SameNameNoCase(std::wstring_view(*path).substr(0, base->size()),
+                      *base)) {
+    return false;
+  }
+  const std::wstring_view leaf =
+      std::wstring_view(*path).substr(base->size() + 1);
+  if (leaf.find(L'\\') != std::wstring_view::npos ||
+      !SameNameNoCase(leaf, want)) {
+    return false;
+  }
+  if (out) {
+    *out = *info;
+  }
+  return true;
+}
+
+// Splits `relative` (already IsValidRelative) into UTF-16 components that
+// pass IsSafeWinComponent.
+std::optional<std::vector<std::wstring>> WinComponents(
+    std::string_view relative) {
+  std::vector<std::wstring> parts;
+  if (relative.empty()) {
+    return parts;
+  }
+  for (std::string_view part : base::SplitStringPiece(
+           relative, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::wstring wide;
+    if (!base::UTF8ToWide(part.data(), part.size(), &wide) ||
+        !IsSafeWinComponent(wide)) {
+      return std::nullopt;
+    }
+    parts.push_back(std::move(wide));
+  }
+  return parts;
+}
+
+// Opens the root (it may itself be a link the user chose: followed once) and
+// then each of `dirs` as a confined directory.
+std::optional<WinChain> OpenChain(const base::FilePath& root,
+                                  const std::vector<std::wstring>& dirs) {
+  if (!IsLocalDriveRoot(root)) {
+    return std::nullopt;
+  }
+  WinChain chain;
+  chain.path = root.StripTrailingSeparators();
+  base::win::ScopedHandle h(::CreateFileW(
+      chain.path.value().c_str(), GENERIC_READ,
+      FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+      FILE_FLAG_BACKUP_SEMANTICS, nullptr));
+  if (!h.is_valid()) {
+    return std::nullopt;
+  }
+  std::optional<BY_HANDLE_FILE_INFORMATION> info = DiskInfo(h.get());
+  if (!info || !(info->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
+    return std::nullopt;
+  }
+  chain.dirs.push_back(std::move(h));
+  for (const std::wstring& name : dirs) {
+    chain.path = chain.path.Append(name);
+    base::win::ScopedHandle next = OpenComponent(chain.path, true);
+    if (!next.is_valid() ||
+        !CheckComponent(chain.dir(), next.get(), name, true)) {
+      return std::nullopt;
+    }
+    chain.dirs.push_back(std::move(next));
+  }
+  return chain;
+}
+
+int64_t MtimeUs(const FILETIME& ft) {
+  return (base::Time::FromFileTime(ft) - base::Time::UnixEpoch())
+      .InMicroseconds();
+}
+
+struct WinFile {
+  std::string bytes;
+  int64_t mtime_us = 0;
+};
+
+// Regular file `relative` (not a reparse point, no alias), up to `max` bytes.
+std::optional<WinFile> ReadConfined(const base::FilePath& root,
+                                    std::string_view relative,
+                                    size_t max) {
+  if (relative.empty() || !IsValidRelative(relative)) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<std::wstring>> parts = WinComponents(relative);
+  if (!parts || parts->empty()) {
+    return std::nullopt;
+  }
+  const std::wstring leaf = parts->back();
+  parts->pop_back();
+  std::optional<WinChain> chain = OpenChain(root, *parts);
+  if (!chain) {
+    return std::nullopt;
+  }
+  base::win::ScopedHandle file =
+      OpenComponent(chain->path.Append(leaf), /*directory=*/false);
+  BY_HANDLE_FILE_INFORMATION info;
+  if (!file.is_valid() ||
+      !CheckComponent(chain->dir(), file.get(), leaf, false, &info)) {
+    return std::nullopt;
+  }
+  const uint64_t size =
+      (static_cast<uint64_t>(info.nFileSizeHigh) << 32) | info.nFileSizeLow;
+  if (size > max) {
+    return std::nullopt;
+  }
+  WinFile out;
+  out.mtime_us = MtimeUs(info.ftLastWriteTime);
+  char buf[64 * 1024];
+  while (true) {
+    DWORD n = 0;
+    if (!::ReadFile(file.get(), buf, sizeof(buf), &n, nullptr)) {
+      return std::nullopt;
+    }
+    if (n == 0) {
+      break;
+    }
+    out.bytes.append(buf, n);
+    if (out.bytes.size() > max) {
+      return std::nullopt;  // grew while reading
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+std::optional<base::FilePath> ResolveInVault(const base::FilePath& root,
+                                             std::string_view relative) {
+  if (!IsValidRelative(relative)) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<std::wstring>> parts = WinComponents(relative);
+  if (!parts) {
+    return std::nullopt;
+  }
+  std::optional<std::wstring> leaf;
+  if (!parts->empty()) {
+    leaf = parts->back();
+    parts->pop_back();
+  }
+  std::optional<WinChain> chain = OpenChain(root, *parts);
+  if (!chain) {
+    return std::nullopt;
+  }
+  if (!leaf) {
+    return chain->path;
+  }
+  const base::FilePath path = chain->path.Append(*leaf);
+  base::win::ScopedHandle h = OpenComponent(path, /*directory=*/false);
+  if (!h.is_valid()) {
+    return std::nullopt;
+  }
+  std::optional<BY_HANDLE_FILE_INFORMATION> info = DiskInfo(h.get());
+  if (!info || !CheckComponent(chain->dir(), h.get(), *leaf,
+                               !!(info->dwFileAttributes &
+                                  FILE_ATTRIBUTE_DIRECTORY))) {
+    return std::nullopt;
+  }
+  return path;
+}
+
+std::optional<std::vector<VaultEntry>> ListVaultDir(
+    const base::FilePath& root,
+    std::string_view relative) {
+  if (!IsValidRelative(relative)) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<std::wstring>> parts = WinComponents(relative);
+  if (!parts) {
+    return std::nullopt;
+  }
+  std::optional<WinChain> chain = OpenChain(root, *parts);
+  if (!chain) {
+    return std::nullopt;
+  }
+  const std::string prefix =
+      relative.empty() ? std::string() : std::string(relative) + "/";
+  std::vector<VaultEntry> entries;
+  // Enumerated from the held handle itself, not by path.
+  alignas(8) char buf[64 * 1024];
+  FILE_INFO_BY_HANDLE_CLASS cls = FileIdBothDirectoryRestartInfo;
+  bool full = false;
+  while (!full && ::GetFileInformationByHandleEx(chain->dir(), cls, buf,
+                                                 sizeof(buf))) {
+    cls = FileIdBothDirectoryInfo;
+    for (size_t off = 0;;) {
+      const auto* e =
+          reinterpret_cast<const FILE_ID_BOTH_DIR_INFO*>(buf + off);
+      const std::wstring_view name(e->FileName,
+                                   e->FileNameLength / sizeof(wchar_t));
+      const DWORD attrs = e->FileAttributes;
+      std::string utf8;
+      // With FILE_ATTRIBUTE_REPARSE_POINT, EaSize holds the reparse tag.
+      const bool surrogate = (attrs & FILE_ATTRIBUTE_REPARSE_POINT) &&
+                             IsReparseTagNameSurrogate(e->EaSize);
+      // Hidden ('.'), name surrogates (symlink, junction, mount point),
+      // devices and names Win32 cannot open back as given are skipped, like
+      // symlinks leaving the vault on POSIX. Cloud placeholders are listed.
+      if (!name.empty() && name[0] != L'.' && !surrogate &&
+          !(attrs & FILE_ATTRIBUTE_DEVICE) &&
+          IsSafeWinComponent(name) &&
+          base::WideToUTF8(name.data(), name.size(), &utf8)) {
+        VaultEntry entry;
+        entry.path = prefix + utf8;
+        entry.is_dir = !!(attrs & FILE_ATTRIBUTE_DIRECTORY);
+        if (entry.is_dir || IsListable(base::FilePath(name))) {
+          if (!entry.is_dir) {
+            entry.size = e->EndOfFile.QuadPart;
+          }
+          entries.push_back(std::move(entry));
+          if (entries.size() >= kMaxListEntries) {
+            full = true;
+            break;
+          }
+        }
+      }
+      if (e->NextEntryOffset == 0) {
+        break;
+      }
+      off += e->NextEntryOffset;
+    }
+  }
+  // A failure other than the end of the directory is an error, not a
+  // partial list.
+  if (!full && ::GetLastError() != ERROR_NO_MORE_FILES) {
+    return std::nullopt;
+  }
+  std::ranges::sort(entries, [](const VaultEntry& a, const VaultEntry& b) {
+    if (a.is_dir != b.is_dir) {
+      return a.is_dir;
+    }
+    return a.path < b.path;
+  });
+  return entries;
+}
+
+std::optional<NoteContent> ReadVaultNoteWithMtime(const base::FilePath& root,
+                                                  std::string_view relative) {
+  if (!IsNote(base::FilePath::FromUTF8Unsafe(relative))) {
+    return std::nullopt;
+  }
+  std::optional<WinFile> file = ReadConfined(root, relative, kMaxNoteBytes);
+  if (!file) {
+    return std::nullopt;
+  }
+  NoteContent note;
+  note.text = std::move(file->bytes);
+  note.mtime_us = file->mtime_us;
+  return note;
+}
+
+std::optional<std::string> ReadVaultNote(const base::FilePath& root,
+                                         std::string_view relative) {
+  std::optional<NoteContent> note = ReadVaultNoteWithMtime(root, relative);
+  if (!note) {
+    return std::nullopt;
+  }
+  return std::move(note->text);
+}
+
+std::optional<ImageContent> ReadVaultImage(const base::FilePath& root,
+                                           std::string_view relative) {
+  const std::string ext = base::ToLowerASCII(base::WideToUTF8(
+      base::FilePath::FromUTF8Unsafe(relative).FinalExtension()));
+  ImageContent image;
+  if (ext == ".png") {
+    image.mime = "image/png";
+  } else if (ext == ".jpg" || ext == ".jpeg") {
+    image.mime = "image/jpeg";
+  } else if (ext == ".gif") {
+    image.mime = "image/gif";
+  } else if (ext == ".webp") {
+    image.mime = "image/webp";
+  } else {
+    return std::nullopt;
+  }
+  std::optional<WinFile> file = ReadConfined(root, relative, kMaxImageBytes);
+  if (!file) {
+    return std::nullopt;
+  }
+  image.bytes = std::move(file->bytes);
+  return image;
+}
