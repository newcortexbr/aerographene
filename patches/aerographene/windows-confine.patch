+// D3c: confinement of the repository on Windows.
+//
+// A theme folder name must also be a name Win32 opens back unchanged: no
+// ':' (alternate data streams), none of <>:"/\|?*, no trailing dot or space
+// (Win32 strips them) and no reserved device name (CON, NUL, COM1, LPT1...,
+// with or without extension). Same rules as the notes vault reader.
+bool IsSafeWinComponent(std::wstring_view name) {
+  if (name.empty() || name == L"." || name == L"..") {
+    return false;
+  }
+  for (wchar_t c : name) {
+    if (c < 0x20 || c == L'<' || c == L'>' || c == L':' || c == L'"' ||
+        c == L'/' || c == L'\\' || c == L'|' || c == L'?' || c == L'*') {
+      return false;
+    }
+  }
+  if (name.back() == L'.' || name.back() == L' ') {
+    return false;
+  }
+  std::wstring_view stem = name.substr(0, name.find(L'.'));
+  while (!stem.empty() && stem.back() == L' ') {
+    stem.remove_suffix(1);
+  }
+  for (const wchar_t* r :
+       {L"CON", L"PRN", L"AUX", L"NUL", L"CONIN$", L"CONOUT$", L"CLOCK$"}) {
+    if (base::EqualsCaseInsensitiveASCII(stem, r)) {
+      return false;
+    }
+  }
+  if (stem.size() == 4) {
+    const std::wstring_view head = stem.substr(0, 3);
+    const wchar_t d = stem[3];
+    if ((base::EqualsCaseInsensitiveASCII(head, L"COM") ||
+         base::EqualsCaseInsensitiveASCII(head, L"LPT")) &&
+        ((d >= L'0' && d <= L'9') || d == 0x00B9 || d == 0x00B2 ||
+         d == 0x00B3)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The repository must be on a local drive path ("X:\..."): no UNC share,
+// no "\\?\" or "\\.\" prefix.
+bool IsLocalDrivePath(const base::FilePath& path) {
+  const std::wstring& v = path.value();
+  return v.size() >= 3 && base::IsAsciiAlpha(v[0]) && v[1] == L':' &&
+         v[2] == L'\\';
+}
+
+// Last component of the normalized final path of `h`: long name, case on
+// disk. An 8.3 alias opened as "THEME~1" comes back as its long name.
+std::optional<std::wstring> FinalLeaf(HANDLE h) {
+  std::wstring path(MAX_PATH, L'\0');
+  DWORD n = ::GetFinalPathNameByHandleW(
+      h, path.data(), static_cast<DWORD>(path.size()),
+      FILE_NAME_NORMALIZED | VOLUME_NAME_NONE);
+  if (n >= path.size()) {
+    path.resize(n);
+    n = ::GetFinalPathNameByHandleW(h, path.data(),
+                                    static_cast<DWORD>(path.size()),
+                                    FILE_NAME_NORMALIZED | VOLUME_NAME_NONE);
+  }
+  if (n == 0 || n >= path.size()) {
+    return std::nullopt;
+  }
+  path.resize(n);
+  const size_t slash = path.rfind(L'\\');
+  return slash == std::wstring::npos ? path : path.substr(slash + 1);
+}
+
+// Opens `path` itself (FILE_FLAG_OPEN_REPARSE_POINT: a symlink or junction
+// is opened, not followed) and checks it is a local disk object of the given
+// kind, not a reparse point, whose name on disk equals `want` without case
+// (`want` empty: name not checked, for the repository directory). Directory
+// handles are kept without FILE_SHARE_DELETE, so while held nothing checked
+// can be renamed, deleted or swapped for a link.
+base::win::ScopedHandle OpenConfined(const base::FilePath& path,
+                                     std::wstring_view want,
+                                     bool directory) {
+  const DWORD share =
+      FILE_SHARE_READ | FILE_SHARE_WRITE | (directory ? 0 : FILE_SHARE_DELETE);
+  base::win::ScopedHandle h(::CreateFileW(
+      path.value().c_str(), GENERIC_READ, share, nullptr, OPEN_EXISTING,
+      FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
+  BY_HANDLE_FILE_INFORMATION info;
+  if (!h.is_valid() || ::GetFileType(h.get()) != FILE_TYPE_DISK ||
+      !::GetFileInformationByHandle(h.get(), &info) ||
+      (info.dwFileAttributes &
+       (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DEVICE)) ||
+      !!(info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != directory) {
+    return base::win::ScopedHandle();
+  }
+  if (!want.empty()) {
+    std::optional<std::wstring> leaf = FinalLeaf(h.get());
+    if (!leaf ||
+        ::CompareStringOrdinal(leaf->data(), static_cast<int>(leaf->size()),
+                               want.data(), static_cast<int>(want.size()),
+                               /*bIgnoreCase=*/TRUE) != CSTR_EQUAL) {
+      return base::win::ScopedHandle();
+    }
+  }
+  return h;
+}
+
+// The repository directory itself: local drive path, not a reparse point.
+base::win::ScopedHandle OpenRepoDir(const base::FilePath& dir) {
+  if (!IsLocalDrivePath(dir)) {
+    return base::win::ScopedHandle();
+  }
+  return OpenConfined(dir, std::wstring_view(), /*directory=*/true);
+}
