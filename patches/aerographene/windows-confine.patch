+namespace aerographene::notes {
+namespace {
+
+class VaultReaderWinTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(outer_.CreateUniqueTempDir());
+    root_ = outer_.GetPath().Append(L"vault");
+    ASSERT_TRUE(base::CreateDirectory(root_.Append(L"sub")));
+    ASSERT_TRUE(base::WriteFile(root_.Append(L"a.md"), "# a"));
+    ASSERT_TRUE(base::WriteFile(root_.Append(L"sub").Append(L"b.md"), "b"));
+    ASSERT_TRUE(base::WriteFile(root_.Append(L"img.png"), "png"));
+    ASSERT_TRUE(base::WriteFile(root_.Append(L"x.txt"), "txt"));
+    ASSERT_TRUE(base::WriteFile(root_.Append(L".hidden.md"), "h"));
+    ASSERT_TRUE(base::CreateDirectory(outer_.GetPath().Append(L"outdir")));
+    ASSERT_TRUE(base::WriteFile(
+        outer_.GetPath().Append(L"outdir").Append(L"secret.md"), "s"));
+  }
+
+  base::ScopedTempDir outer_;
+  base::FilePath root_;
+};
+
+TEST_F(VaultReaderWinTest, ReadSupportedWriteNot) {
+  EXPECT_TRUE(kVaultReadSupported);
+  EXPECT_FALSE(kVaultWriteSupported);
+  EXPECT_EQ(WriteVaultNote(root_, "a.md", "x", std::nullopt).status,
+            WriteStatus::kUnsupported);
+  EXPECT_EQ(CreateVaultNote(root_, "n.md", "x").status,
+            WriteStatus::kUnsupported);
+  EXPECT_EQ(RenameVaultNote(root_, "a.md", "c.md").status,
+            WriteStatus::kUnsupported);
+  EXPECT_EQ(DeleteVaultNote(root_, "a.md").status, WriteStatus::kUnsupported);
+  EXPECT_EQ(ReadVaultNote(root_, "a.md"), "# a");  // untouched
+}
+
+TEST_F(VaultReaderWinTest, ReadsAndListsInside) {
+  EXPECT_EQ(ReadVaultNote(root_, "a.md"), "# a");
+  EXPECT_EQ(ReadVaultNote(root_, "sub/b.md"), "b");
+  std::optional<NoteContent> note = ReadVaultNoteWithMtime(root_, "a.md");
+  ASSERT_TRUE(note);
+  EXPECT_GT(note->mtime_us, 0);
+
+  std::optional<std::vector<VaultEntry>> list = ListVaultDir(root_, "");
+  ASSERT_TRUE(list);
+  ASSERT_EQ(list->size(), 3u);  // sub/, a.md, img.png (no .hidden, no .txt)
+  EXPECT_EQ((*list)[0].path, "sub");
+  EXPECT_TRUE((*list)[0].is_dir);
+  EXPECT_EQ((*list)[1].path, "a.md");
+  EXPECT_EQ((*list)[1].size, 3);
+  EXPECT_EQ((*list)[2].path, "img.png");
+  list = ListVaultDir(root_, "sub");
+  ASSERT_TRUE(list);
+  ASSERT_EQ(list->size(), 1u);
+  EXPECT_EQ((*list)[0].path, "sub/b.md");
+  EXPECT_FALSE(ListVaultDir(root_, "a.md"));
+  EXPECT_FALSE(ListVaultDir(root_, "missing"));
+}
+
+TEST_F(VaultReaderWinTest, RejectsMalformedAndWindowsOnlyNames) {
+  for (const char* p :
+       {"../outdir/secret.md", "sub/../a.md", "/a.md", "sub\\b.md",
+        "..\\outdir\\secret.md", "C:/a.md", "a.md:ads", "a.md::$DATA",
+        "sub:x/b.md", "a.md.", "a.md ", "sub./b.md", "sub /b.md", "CON",
+        "con.md", "NUL.md", "nul .md", "Aux.md", "prn.md", "COM1.md",
+        "lpt9.md", "COM\xC2\xB9.md", "conin$.md", "a<b.md", "a|b.md",
+        "a?.md", "a*.md", "a\"b.md", "a\x01.md"}) {
+    EXPECT_FALSE(ResolveInVault(root_, p)) << p;
+    EXPECT_FALSE(ReadVaultNote(root_, p)) << p;
+    EXPECT_FALSE(ListVaultDir(root_, p)) << p;
+  }
+  // Names that only look reserved are fine.
+  ASSERT_TRUE(base::WriteFile(root_.Append(L"console.md"), "c"));
+  ASSERT_TRUE(base::WriteFile(root_.Append(L"com10.md"), "c"));
+  EXPECT_EQ(ReadVaultNote(root_, "console.md"), "c");
+  EXPECT_EQ(ReadVaultNote(root_, "com10.md"), "c");
+}
+
+TEST_F(VaultReaderWinTest, RootMustBeALocalDrivePath) {
+  EXPECT_FALSE(ListVaultDir(base::FilePath(L"relative"), ""));
+  EXPECT_FALSE(
+      ListVaultDir(base::FilePath(L"\\\\?\\" + root_.value()), ""));
+  EXPECT_FALSE(ListVaultDir(base::FilePath(L"\\\\.\\" + root_.value()), ""));
+  // Administrative share of the same folder: UNC is refused.
+  const std::wstring& v = root_.value();
+  ASSERT_GE(v.size(), 3u);
+  const base::FilePath unc(std::wstring(L"\\\\localhost\\") + v[0] + L"$" +
+                           v.substr(2));
+  EXPECT_FALSE(ListVaultDir(unc, ""));
