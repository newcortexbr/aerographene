+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_launch.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/supports_user_data.h"
+
+namespace aerographene {
+
+namespace {
+
+const char kPendingCommandKey[] = "aero_terminal_pending_command";
+
+struct PendingCommand : public base::SupportsUserData::Data {
+  PendingCommand(std::string c, base::TimeTicks t)
+      : command(std::move(c)), set_at(t) {}
+  std::string command;
+  base::TimeTicks set_at;
+};
+
+}  // namespace
+
+bool SetPendingTerminalCommand(base::SupportsUserData* tab,
+                               std::string command,
+                               base::TimeTicks now) {
+  if (!tab || command.empty() || command.size() > kMaxLaunchCommandBytes) {
+    return false;
+  }
+  tab->SetUserData(kPendingCommandKey,
+                   std::make_unique<PendingCommand>(std::move(command), now));
+  return true;
+}
+
+std::optional<std::string> TakePendingTerminalCommand(
+    base::SupportsUserData* tab,
+    base::TimeTicks now) {
+  if (!tab) {
+    return std::nullopt;
+  }
+  std::unique_ptr<base::SupportsUserData::Data> data =
+      tab->TakeUserData(kPendingCommandKey);
+  if (!data) {
+    return std::nullopt;
+  }
+  auto* pending = static_cast<PendingCommand*>(data.get());
+  if (now < pending->set_at || now - pending->set_at > kLaunchCommandLifetime) {
+    return std::nullopt;
+  }
+  return std::move(pending->command);
+}
+
+WorkspaceRegistry::WorkspaceRegistry() = default;
+WorkspaceRegistry::~WorkspaceRegistry() = default;
+
+// static
+WorkspaceRegistry& WorkspaceRegistry::Get() {
+  static base::NoDestructor<WorkspaceRegistry> registry;
+  return *registry;
+}
+
+int WorkspaceRegistry::Claim(const void* key, int wanted) {
+  if (!key || wanted < 0 || wanted > kMaxWorkspace) {
+    return 0;
+  }
+  std::multiset<int>& used = used_[key];
+  int n = wanted;
+  if (n == 0) {
+    for (int i = 1; i <= kMaxWorkspace && n == 0; ++i) {
+      if (!used.contains(i)) {
+        n = i;
+      }
+    }
+    if (n == 0) {
+      if (used.empty()) {
+        used_.erase(key);
+      }
+      return 0;
+    }
+  }
+  used.insert(n);
+  return n;
+}
+
+void WorkspaceRegistry::Release(const void* key, int workspace) {
+  auto it = used_.find(key);
+  if (it == used_.end()) {
+    return;
+  }
+  auto one = it->second.find(workspace);
+  if (one != it->second.end()) {
+    it->second.erase(one);
+  }
+  if (it->second.empty()) {
+    used_.erase(it);
+  }
+}
+
+}  // namespace aerographene
