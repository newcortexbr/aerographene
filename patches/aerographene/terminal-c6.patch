+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_LAUNCH_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_LAUNCH_H_
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/time/time.h"
+
+namespace base {
+class SupportsUserData;
+}
+
+namespace aerographene {
+
+// One-shot channel for the "t: <command>" command bar entry (fatia C6). The
+// command never travels in the URL or in anything another origin could
+// forge: ChromeOmniboxClient attaches it to the WebContents (a
+// base::SupportsUserData) of the tab it just opened at chrome://terminal, and
+// the TerminalHandler of that same tab takes it once. The page then types it
+// into the first terminal like the user would (no exec, no argv).
+//
+// SetPendingTerminalCommand refuses a null tab, an empty command and
+// anything longer than kMaxLaunchCommandBytes; a newer command replaces an
+// older one. TakePendingTerminalCommand returns the command at most once and
+// only within kLaunchCommandLifetime of being set (a tab that navigated
+// elsewhere and came back later must not run a stale command); taking always
+// clears it.
+inline constexpr size_t kMaxLaunchCommandBytes = 4096;
+inline constexpr base::TimeDelta kLaunchCommandLifetime = base::Seconds(60);
+
+bool SetPendingTerminalCommand(base::SupportsUserData* tab,
+                               std::string command,
+                               base::TimeTicks now = base::TimeTicks::Now());
+std::optional<std::string> TakePendingTerminalCommand(
+    base::SupportsUserData* tab,
+    base::TimeTicks now = base::TimeTicks::Now());
+
+// Workspace numbers in use, per profile (key: any stable per-profile
+// pointer). Claim(key, n) with n in [1, kMaxWorkspace] registers that
+// workspace (several tabs may show the same one); Claim(key, 0) picks the
+// smallest number no tab of that profile uses, or returns 0 when all are in
+// use. Anything else returns 0. Release undoes one Claim. UI thread only.
+class WorkspaceRegistry {
+ public:
+  static constexpr int kMaxWorkspace = 99;
+
+  WorkspaceRegistry();
+  WorkspaceRegistry(const WorkspaceRegistry&) = delete;
+  WorkspaceRegistry& operator=(const WorkspaceRegistry&) = delete;
+  ~WorkspaceRegistry();
+
+  static WorkspaceRegistry& Get();
+
+  int Claim(const void* key, int wanted);
+  void Release(const void* key, int workspace);
+
+ private:
+  std::map<const void*, std::multiset<int>> used_;
+};
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_LAUNCH_H_
