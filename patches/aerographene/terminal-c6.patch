+// Summary printed at the top of every terminal (fatia C6, fastfetch style).
+// Local only: nothing leaves the machine. Runs on a MayBlock task (disks).
+base::DictValue CollectSystemInfo() {
+  base::DictValue info;
+  info.Set("chromium", std::string(version_info::GetVersionNumber()));
+  info.Set("aerographene", std::string(aero::kVersion));
+  info.Set("cpu", base::SysInfo::CPUModelName());
+  info.Set("cores", base::SysInfo::NumberOfProcessors());
+  info.Set("ram", static_cast<double>(
+                      base::SysInfo::AmountOfTotalPhysicalMemory().InBytes()));
+  base::ListValue disks;
+  for (const base::FilePath& path :
+       {base::FilePath("/"), base::GetHomeDir()}) {
+    std::optional<int64_t> total = base::SysInfo::AmountOfTotalDiskSpace(path);
+    std::optional<int64_t> free = base::SysInfo::AmountOfFreeDiskSpace(path);
+    if (!total || !free || *total <= 0) {
+      continue;
+    }
+    base::DictValue disk;
+    disk.Set("path", path.value());
+    disk.Set("total", static_cast<double>(*total));
+    disk.Set("free", static_cast<double>(*free));
+    disks.Append(std::move(disk));
+  }
+  info.Set("disks", std::move(disks));
+  return info;
+}
