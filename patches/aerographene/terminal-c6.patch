+void TerminalHandler::HandleStart(const base::ListValue& args) {
+  if (args.size() != 2 || !FromTerminalPage()) {
+    return;
+  }
+  std::optional<int> wanted = args[1].GetIfInt();
+  AllowJavascript();
+  // One workspace per page load; later calls just report it.
+  if (!workspace_ && wanted) {
+    workspace_key_ = web_ui()->GetWebContents()->GetBrowserContext();
+    workspace_ = WorkspaceRegistry::Get().Claim(workspace_key_, *wanted);
+    if (!workspace_) {
+      workspace_key_ = nullptr;
+    }
+  }
+  // One-shot: only the tab ChromeOmniboxClient opened for "t: <command>"
+  // has one, and only the first start() of that tab gets it.
+  std::optional<std::string> command =
+      TakePendingTerminalCommand(web_ui()->GetWebContents());
+  // GPU info lives on the UI thread; the rest may block (disks).
+  const gpu::GPUInfo gpu_info =
+      content::GpuDataManager::GetInstance()->GetGPUInfo();
+  std::string gpu = gpu_info.gl_renderer;
+  if (gpu.empty()) {
+    gpu = gpu_info.active_gpu().device_string;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&CollectSystemInfo),
+      base::BindOnce(
+          [](std::string gpu, base::DictValue info) {
+            info.Set("gpu", std::move(gpu));
+            return info;
+          },
+          std::move(gpu))
+          .Then(base::BindOnce(
+              &TerminalHandler::OnStart, weak_ptr_factory_.GetWeakPtr(),
+              args[0].Clone(),
+              command ? base::Value(std::move(*command)) : base::Value())));
+}
+
+void TerminalHandler::OnStart(base::Value callback_id,
+                              base::Value command,
+                              base::DictValue info) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue reply;
+  reply.Set("workspace", workspace_);
+  reply.Set("command", std::move(command));
+  reply.Set("info", std::move(info));
+  ResolveJavascriptCallback(callback_id, reply);
+}
