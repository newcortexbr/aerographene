+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_launch.h"
+
+#include <string>
+
+#include "base/supports_user_data.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+
+namespace {
+
+// Stands in for the WebContents of a tab (a base::SupportsUserData too).
+class FakeTab : public base::SupportsUserData {};
+
+}  // namespace
+
+TEST(TerminalLaunchTest, RefusesWithoutTab) {
+  EXPECT_FALSE(SetPendingTerminalCommand(nullptr, "ls"));
+  EXPECT_FALSE(TakePendingTerminalCommand(nullptr));
+}
+
+TEST(TerminalLaunchTest, RefusesEmptyOrHuge) {
+  FakeTab tab;
+  EXPECT_FALSE(SetPendingTerminalCommand(&tab, ""));
+  EXPECT_FALSE(SetPendingTerminalCommand(
+      &tab, std::string(kMaxLaunchCommandBytes + 1, 'x')));
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab));
+  EXPECT_TRUE(SetPendingTerminalCommand(
+      &tab, std::string(kMaxLaunchCommandBytes, 'x')));
+}
+
+TEST(TerminalLaunchTest, OneShot) {
+  FakeTab tab;
+  ASSERT_TRUE(SetPendingTerminalCommand(&tab, "htop"));
+  EXPECT_EQ(TakePendingTerminalCommand(&tab), "htop");
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab));
+}
+
+TEST(TerminalLaunchTest, BoundToItsTab) {
+  FakeTab opened;
+  FakeTab other;
+  ASSERT_TRUE(SetPendingTerminalCommand(&opened, "ls"));
+  EXPECT_FALSE(TakePendingTerminalCommand(&other));
+  EXPECT_EQ(TakePendingTerminalCommand(&opened), "ls");
+}
+
+TEST(TerminalLaunchTest, NewerReplacesOlder) {
+  FakeTab tab;
+  ASSERT_TRUE(SetPendingTerminalCommand(&tab, "a"));
+  ASSERT_TRUE(SetPendingTerminalCommand(&tab, "b"));
+  EXPECT_EQ(TakePendingTerminalCommand(&tab), "b");
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab));
+}
+
+TEST(TerminalLaunchTest, ExpiresAndIsClearedAnyway) {
+  FakeTab tab;
+  const base::TimeTicks t0 = base::TimeTicks() + base::Seconds(100);
+  ASSERT_TRUE(SetPendingTerminalCommand(&tab, "ls", t0));
+  EXPECT_FALSE(TakePendingTerminalCommand(
+      &tab, t0 + kLaunchCommandLifetime + base::Seconds(1)));
+  // Expired take still consumed it.
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab, t0));
+  ASSERT_TRUE(SetPendingTerminalCommand(&tab, "ls", t0));
+  EXPECT_EQ(TakePendingTerminalCommand(&tab, t0 + kLaunchCommandLifetime),
+            "ls");
+}
+
+TEST(TerminalLaunchTest, WorkspaceRegistry) {
+  WorkspaceRegistry r;
+  int p1 = 0;
+  int p2 = 0;
+  EXPECT_EQ(r.Claim(&p1, 0), 1);
+  EXPECT_EQ(r.Claim(&p1, 0), 2);
+  EXPECT_EQ(r.Claim(&p2, 0), 1);  // per profile
+  EXPECT_EQ(r.Claim(&p1, 5), 5);
+  EXPECT_EQ(r.Claim(&p1, 5), 5);  // same workspace twice is fine
+  r.Release(&p1, 1);
+  EXPECT_EQ(r.Claim(&p1, 0), 1);
+  EXPECT_EQ(r.Claim(&p1, 100), 0);
+  EXPECT_EQ(r.Claim(&p1, -1), 0);
+  EXPECT_EQ(r.Claim(nullptr, 0), 0);
+  r.Release(&p1, 42);  // unknown: no-op
+  int p3 = 0;
+  for (int i = 1; i <= WorkspaceRegistry::kMaxWorkspace; ++i) {
+    EXPECT_EQ(r.Claim(&p3, 0), i);
+  }
+  EXPECT_EQ(r.Claim(&p3, 0), 0);
+}
