+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+
+  // PinnedModel::Observer:
+  void OnPinnedModelLoaded() override;
+  void OnPinnedChanged() override;
+
+ private:
+  void OnClosingAllBrowsersChanged(bool closing);
+  void AssociateAllPinnedTabs();
+  // Maps a pinned `tab` to an entry (reusing or adding one) and aligns order.
+  void Associate(tabs::TabInterface* tab);
+  // Moves the entry of `tab` so that it keeps the relative order of the
+  // pinned tabs around it in its tab strip. Top-level entries only.
+  void AlignOrder(tabs::TabInterface* tab);
