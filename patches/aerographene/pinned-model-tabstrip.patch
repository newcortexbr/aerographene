+  // Entry mapped to `tab`, if any and still present in the model.
+  std::optional<base::Uuid> GetEntryForTab(const tabs::TabInterface* tab) const;
+  // Persisted span of the entry mapped to `tab`; nullopt if unmapped.
+  std::optional<int> GetSpanForTab(const tabs::TabInterface* tab) const;
