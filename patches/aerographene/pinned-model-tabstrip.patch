+bool PinnedModel::SetURL(const base::Uuid& uuid, const GURL& url) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || !node->is_url() || !url.is_valid()) {
+    return false;
+  }
+  if (node->url() != url) {
+    model_->SetURL(node, url, bookmarks::metrics::BookmarkEditSource::kOther);
+  }
+  return true;
+}
+
+bool PinnedModel::SetOpen(const base::Uuid& uuid, bool open) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || !node->is_url()) {
+    return false;
+  }
+  if (open == HasFlag(node, kPinnedOpenMetaKey)) {
+    return true;
+  }
+  if (open) {
+    model_->SetNodeMetaInfo(node, kPinnedOpenMetaKey, "1");
+  } else {
+    model_->DeleteNodeMetaInfo(node, kPinnedOpenMetaKey);
+  }
+  return true;
+}
+
+void PinnedModel::StartTabMirror(Profile* profile) {
+  if (!tab_mirror_ && model_) {
+    tab_mirror_ = std::make_unique<PinnedTabMirror>(profile, this);
+  }
+}
+
 void PinnedModel::Shutdown() {
+  // The mirror observes this model; drop it first.
+  tab_mirror_.reset();
   model_observation_.Reset();
   weak_factory_.InvalidateWeakPtrs();
   root_ = nullptr;
