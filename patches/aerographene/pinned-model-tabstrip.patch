+  raw_ptr<Profile> profile_;
+  raw_ptr<PinnedModel> model_;
+  std::map<tabs::TabHandle, base::Uuid> tab_nodes_;
+  bool closing_all_browsers_ = false;
+  // Guards against re-entrant OnPinnedChanged() from our own writes.
+  bool writing_ = false;
