+  // aerographene: the pinned model is the source of truth. Reopen its entries
+  // marked open; the kPinnedTabs pref is only a fallback while the model is
+  // not loaded yet or still empty (first run after the upgrade), so pinned
+  // tabs are never dropped and only one source is used per startup.
+  StartupTabs pinned_tabs;
+  aerographene::PinnedModel* pinned_model =
+      aerographene::PinnedModelFactory::GetForProfile(profile);
+  bool model_has_entries = false;
+  if (pinned_model && pinned_model->IsLoaded()) {
+    for (const aerographene::PinnedItem& item : pinned_model->GetPinned()) {
+      model_has_entries |= !item.is_folder || !item.children.empty();
+      if (!item.is_folder && item.open && item.url.is_valid()) {
+        pinned_tabs.emplace_back(item.url, StartupTab::Type::kPinned);
+      }
+      for (const aerographene::PinnedItem& child : item.children) {
+        if (child.open && child.url.is_valid()) {
+          pinned_tabs.emplace_back(child.url, StartupTab::Type::kPinned);
+        }
+      }
+    }
+  }
+  if (!model_has_entries) {
+    pinned_tabs = PinnedTabCodec::ReadPinnedTabs(profile);
+  }
