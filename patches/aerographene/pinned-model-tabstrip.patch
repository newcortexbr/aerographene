+#include "chrome/browser/ui/tabs/aerographene/pinned_tab_mirror.h"
+
+#include <set>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/lifetime/application_lifetime_desktop.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace aerographene {
+
+namespace {
+
+GURL GetTabURL(const tabs::TabInterface* tab) {
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return GURL();
+  }
+  GURL url = contents->GetLastCommittedURL();
+  if (url.is_empty()) {
+    // Restored tabs that have not loaded yet (lazy restore).
+    url = contents->GetVisibleURL();
+  }
+  return url;
+}
+
+TabStripModel* GetTabStrip(tabs::TabInterface* tab) {
+  BrowserWindowInterface* browser = tab->GetBrowserWindowInterface();
+  return browser ? browser->GetTabStripModel() : nullptr;
+}
+
+// Index of `uuid` among the top-level entries, or -1.
+int TopLevelIndex(const std::vector<PinnedItem>& items, const base::Uuid& uuid) {
+  for (size_t i = 0; i < items.size(); ++i) {
+    if (items[i].uuid == uuid) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+}  // namespace
+
+PinnedTabMirror::PinnedTabMirror(Profile* profile, PinnedModel* model)
+    : profile_(profile), model_(model) {
+  closing_all_browsers_subscription_ = chrome::AddClosingAllBrowsersCallback(
+      base::BindRepeating(&PinnedTabMirror::OnClosingAllBrowsersChanged,
+                          base::Unretained(this)));
+  model_observation_.Observe(model_);
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this](BrowserWindowInterface* browser) {
+        OnBrowserCreated(browser);
+        return true;
+      });
+  browser_collection_observation_.Observe(
+      GlobalBrowserCollection::GetInstance());
+  AssociateAllPinnedTabs();
+}
+
+PinnedTabMirror::~PinnedTabMirror() = default;
+
+std::optional<base::Uuid> PinnedTabMirror::GetEntryForTab(
+    const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return std::nullopt;
+  }
+  const auto it = tab_nodes_.find(tab->GetHandle());
+  if (it == tab_nodes_.end() || !model_->Find(it->second)) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+std::optional<int> PinnedTabMirror::GetSpanForTab(
+    const tabs::TabInterface* tab) const {
+  const std::optional<base::Uuid> uuid = GetEntryForTab(tab);
+  if (!uuid) {
+    return std::nullopt;
+  }
+  const std::optional<PinnedItem> item = model_->Find(*uuid);
+  return item ? std::optional<int>(item->span) : std::nullopt;
+}
+
+bool PinnedTabMirror::SetSpanForTab(const tabs::TabInterface* tab, int span) {
+  const std::optional<base::Uuid> uuid = GetEntryForTab(tab);
+  return uuid && model_->SetSpan(*uuid, span);
+}
+
+void PinnedTabMirror::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  // Auto-unregistered by the TabStripModelObserver destructor.
+  browser->GetTabStripModel()->AddObserver(this);
+}
+
+void PinnedTabMirror::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& inserted : change.GetInsert()->contents) {
+        if (inserted.tab && inserted.tab->IsPinned()) {
+          Associate(inserted.tab);
+        }
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const auto& removed : change.GetRemove()->contents) {
+        if (!removed.tab ||
+            (removed.remove_reason != TabRemovedReason::kDeleted &&
+             removed.remove_reason !=
+                 TabRemovedReason::kDeletedAndExpandSidePanel)) {
+          // Moving to another window keeps the mapping.
+          continue;
+        }
+        const auto it = tab_nodes_.find(removed.tab->GetHandle());
+        if (it == tab_nodes_.end()) {
+          continue;
+        }
+        const base::Uuid uuid = it->second;
+        tab_nodes_.erase(it);
+        // Closing the window or quitting keeps the entry open for the next
+        // startup; a close by the user makes it a closed pinned.
+        if (!closing_all_browsers_ && !tab_strip_model->closing_all()) {
+          base::AutoReset<bool> writing(&writing_, true);
+          model_->SetOpen(uuid, false);
+        }
+      }
+      break;
+    case TabStripModelChange::kMoved: {
+      tabs::TabInterface* tab = change.GetMove()->tab;
+      if (tab && tab->IsPinned()) {
+        AlignOrder(tab);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+void PinnedTabMirror::OnTabChangedAt(tabs::TabInterface* tab,
+                                     TabChangeType change_type) {
+  if (change_type != TabChangeType::kAll || !tab || !tab->IsPinned() ||
+      !model_->IsLoaded()) {
+    return;
+  }
+  const std::optional<base::Uuid> uuid = GetEntryForTab(tab);
+  if (!uuid) {
+    Associate(tab);
+    return;
+  }
+  const GURL url = GetTabURL(tab);
+  const std::optional<PinnedItem> item = model_->Find(*uuid);
+  if (item && url.is_valid() && item->url != url) {
+    base::AutoReset<bool> writing(&writing_, true);
+    model_->SetURL(*uuid, url);
+  }
+}
+
+void PinnedTabMirror::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                              int index) {
+  if (!tab || !model_->IsLoaded()) {
+    return;
+  }
+  if (tab->IsPinned()) {
+    Associate(tab);
+    return;
+  }
+  const auto it = tab_nodes_.find(tab->GetHandle());
+  if (it == tab_nodes_.end()) {
+    return;
+  }
+  const base::Uuid uuid = it->second;
+  tab_nodes_.erase(it);
+  base::AutoReset<bool> writing(&writing_, true);
+  model_->Remove(uuid);
+}
+
+void PinnedTabMirror::OnPinnedModelLoaded() {
+  AssociateAllPinnedTabs();
+}
+
+void PinnedTabMirror::OnPinnedChanged() {
+  if (writing_) {
+    return;
+  }
+  // Drop mappings whose entry is gone (removed in the bookmark manager or by
+  // Sync). The tabs stay pinned; nothing is recreated here.
+  std::erase_if(tab_nodes_, [this](const auto& entry) {
+    return !model_->Find(entry.second);
+  });
+}
+
+void PinnedTabMirror::OnClosingAllBrowsersChanged(bool closing) {
+  closing_all_browsers_ = closing;
+}
+
+void PinnedTabMirror::AssociateAllPinnedTabs() {
+  if (!model_->IsLoaded()) {
+    return;
+  }
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != profile_ ||
+            browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        TabStripModel* strip = browser->GetTabStripModel();
+        const int pinned_count = strip->IndexOfFirstNonPinnedTab();
+        for (int i = 0; i < pinned_count; ++i) {
+          Associate(strip->GetTabAtIndex(i));
+        }
+        return true;
+      });
+}
+
+void PinnedTabMirror::Associate(tabs::TabInterface* tab) {
+  if (!tab || !tab->IsPinned() || !model_->IsLoaded()) {
+    return;
+  }
+  if (GetEntryForTab(tab)) {
+    // Already mapped (e.g. moved in from another window).
+    AlignOrder(tab);
+    return;
+  }
+  const GURL url = GetTabURL(tab);
+  if (!url.is_valid()) {
+    // Retried from OnTabChangedAt() once the tab has a URL.
+    return;
+  }
+
+  std::set<base::Uuid> taken;
+  for (const auto& [handle, uuid] : tab_nodes_) {
+    taken.insert(uuid);
+  }
+  std::optional<base::Uuid> match;
+  bool match_open = false;
+  auto consider = [&](const PinnedItem& item) {
+    if (item.is_folder || item.url != url || taken.contains(item.uuid)) {
+      return;
+    }
+    if (!match || (item.open && !match_open)) {
+      match = item.uuid;
+      match_open = item.open;
+    }
+  };
+  for (const PinnedItem& item : model_->GetPinned()) {
+    consider(item);
+    for (const PinnedItem& child : item.children) {
+      consider(child);
+    }
+  }
+
+  base::AutoReset<bool> writing(&writing_, true);
+  if (!match) {
+    content::WebContents* contents = tab->GetContents();
+    match = model_->AddPinned(url, contents ? contents->GetTitle() : u"",
+                              base::Uuid(), static_cast<size_t>(-1));
+    if (!match) {
+      return;
+    }
+  }
+  tab_nodes_[tab->GetHandle()] = *match;
+  model_->SetOpen(*match, true);
+  AlignOrder(tab);
+  // Let views re-read spans of the newly mapped tab.
+  model_->NotifyTabMappingChanged();
+}
+
+void PinnedTabMirror::AlignOrder(tabs::TabInterface* tab) {
+  const std::optional<base::Uuid> uuid = GetEntryForTab(tab);
+  TabStripModel* strip = GetTabStrip(tab);
+  if (!uuid || !strip) {
+    return;
+  }
+  const int index = strip->GetIndexOfTab(tab);
+  const int pinned_count = strip->IndexOfFirstNonPinnedTab();
+  if (index < 0 || index >= pinned_count) {
+    return;
+  }
+  const std::vector<PinnedItem> items = model_->GetPinned();
+  const int self = TopLevelIndex(items, *uuid);
+  if (self < 0) {
+    // Entries inside a drawer keep their place.
+    return;
+  }
+  // Nearest mapped top-level neighbours in the tab strip.
+  auto neighbour = [&](int step) {
+    for (int i = index + step; i >= 0 && i < pinned_count; i += step) {
+      if (const std::optional<base::Uuid> other =
+              GetEntryForTab(strip->GetTabAtIndex(i))) {
+        const int pos = TopLevelIndex(items, *other);
+        if (pos >= 0) {
+          return pos;
+        }
+      }
+    }
+    return -1;
+  };
+  const int prev = neighbour(-1);
+  const int next = neighbour(+1);
+  // Move only when the relative order is wrong, so closed entries between
+  // live ones keep their place. BookmarkModel::Move uses insert-before
+  // indices counted before the removal.
+  base::AutoReset<bool> writing(&writing_, true);
+  if (prev >= 0 && prev > self) {
+    model_->Move(*uuid, base::Uuid(), prev + 1);
+  } else if (next >= 0 && next < self) {
+    model_->Move(*uuid, base::Uuid(), next);
+  }
+}
+
+}  // namespace aerographene
