+
+#include "chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_footer.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/ui_base_features.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/border.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kBorderThickness = 1;
+constexpr int kHorizontalPadding = 6;
+constexpr int kButtonSpacing = 2;
+
+}  // namespace
+
+VerticalTabStripFooter::VerticalTabStripFooter(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetBorder(views::CreateSolidSidedBorder(
+      gfx::Insets::TLBR(kBorderThickness, 0, 0, 0), kColorToolbarSeparator));
+
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::VH(0, kHorizontalPadding), kButtonSpacing));
+  layout->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kStart);
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // Same icons as DownloadToolbarUIController / ExtensionsToolbarViewModel.
+  AddCommandButton(IDC_SHOW_DOWNLOADS,
+                   features::IsRoundedIconsEnabled()
+                       ? kDownloadIcon
+                       : kDownloadToolbarButtonChromeRefreshOldIcon,
+                   IDS_TOOLTIP_DOWNLOAD_ICON);
+  AddCommandButton(IDC_MANAGE_EXTENSIONS,
+                   features::IsRoundedIconsEnabled()
+                       ? vector_icons::kChromeExtensionIcon
+                       : vector_icons::kExtensionChromeRefreshOldIcon,
+                   IDS_TOOLTIP_EXTENSIONS_BUTTON);
+}
+
+VerticalTabStripFooter::~VerticalTabStripFooter() = default;
+
+bool VerticalTabStripFooter::IsPositionInWindowCaption(
+    const gfx::Point& point) {
+  for (views::View* child : children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    gfx::Point point_in_child = point;
+    views::View::ConvertPointToTarget(this, child, &point_in_child);
+    if (child->HitTestPoint(point_in_child)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+gfx::Size VerticalTabStripFooter::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  gfx::Size size = views::View::CalculatePreferredSize(available_size);
+  size.set_height(kHeight);
+  return size;
+}
+
+ToolbarButton* VerticalTabStripFooter::AddCommandButton(
+    int command_id,
+    const gfx::VectorIcon& icon,
+    int tooltip_id) {
+  auto* const button = AddChildView(std::make_unique<ToolbarButton>(
+      base::BindRepeating(&VerticalTabStripFooter::RunCommand,
+                          base::Unretained(this), command_id)));
+  button->SetVectorIcon(icon);
+  const std::u16string tooltip = l10n_util::GetStringUTF16(tooltip_id);
+  button->SetTooltipText(tooltip);
+  button->GetViewAccessibility().SetName(tooltip);
+  return button;
+}
+
+void VerticalTabStripFooter::RunCommand(int command_id) {
+  chrome::ExecuteCommand(browser_, command_id);
+}
