+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+class ToolbarButton;
+
+// aerographene: fixed footer of the expanded vertical tab strip (mockup
+// A-r06). A 40 px row with a 1 px top border and small buttons on the left
+// that run existing browser commands (downloads, extensions).
+class VerticalTabStripFooter : public views::View {
+  METADATA_HEADER(VerticalTabStripFooter, views::View)
+
+ public:
+  static constexpr int kHeight = 40;
+
+  explicit VerticalTabStripFooter(BrowserWindowInterface* browser);
+  VerticalTabStripFooter(const VerticalTabStripFooter&) = delete;
+  VerticalTabStripFooter& operator=(const VerticalTabStripFooter&) = delete;
+  ~VerticalTabStripFooter() override;
+
+  // True if `point` (in this view's coordinates) is not over a button, so the
+  // empty part of the row can act as window caption.
+  bool IsPositionInWindowCaption(const gfx::Point& point);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+
+ private:
+  ToolbarButton* AddCommandButton(int command_id,
+                                  const gfx::VectorIcon& icon,
+                                  int tooltip_id);
+  void RunCommand(int command_id);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_STRIP_FOOTER_H_
