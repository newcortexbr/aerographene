 void PinnedTabMirror::OnPinnedModelLoaded() {
+  LOG(ERROR) << "AERODIAG OnPinnedModelLoaded";
   AssociateAllPinnedTabs();
+  // The BookmarkModel loads asynchronously, usually after the startup tabs
+  // were decided with the model still unloaded (see StartupBrowserCreatorImpl
+  // and StartupTabProviderImpl::GetPinnedTabs). Finish the job once it is
+  // loaded, outside the bookmark observer call.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PinnedTabMirror::AdoptStartupTabs,
+                                weak_factory_.GetWeakPtr()));
+}
+
+static bool IsNewTabPageURL(const GURL& url) {
+  return (url.SchemeIs("chrome") || url.SchemeIs("chrome-untrusted")) &&
+         (url.host() == "newtab" || url.host() == "new-tab-page");
+}
+
+// True for a new tab page the user has not touched: it is the only history
+// entry, and neither a pending navigation nor the last committed entry points
+// to a URL other than the new tab page. The startup NTP may still be
+// navigating when the model loads, so a pending NTP navigation is allowed.
+static bool IsUntouchedNewTab(const tabs::TabInterface* tab) {
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  content::NavigationController& controller = contents->GetController();
+  if (controller.GetEntryCount() > 1) {
+    return false;
+  }
+  const content::NavigationEntry* pending = controller.GetPendingEntry();
+  if (pending && !IsNewTabPageURL(pending->GetURL())) {
+    return false;
+  }
+  const content::NavigationEntry* committed =
+      controller.GetLastCommittedEntry();
+  if (committed && !committed->IsInitialEntry() &&
+      !IsNewTabPageURL(committed->GetURL())) {
+    return false;
+  }
+  return IsNewTabPageURL(contents->GetVisibleURL());
+}
+
+static void DiagDumpStrip(const char* where, TabStripModel* strip) {
+  LOG(ERROR) << "AERODIAG " << where << " strip=" << strip
+             << " count=" << strip->count()
+             << " first_non_pinned=" << strip->IndexOfFirstNonPinnedTab();
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* tab = strip->GetTabAtIndex(i);
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    if (!contents) {
+      LOG(ERROR) << "AERODIAG   tab[" << i << "] no contents";
+      continue;
+    }
+    content::NavigationController& controller = contents->GetController();
+    const content::NavigationEntry* pending = controller.GetPendingEntry();
+    const content::NavigationEntry* committed =
+        controller.GetLastCommittedEntry();
+    LOG(ERROR) << "AERODIAG   tab[" << i << "] pinned=" << tab->IsPinned()
+               << " GetTabURL=" << GetTabURL(tab).spec()
+               << " visible=" << contents->GetVisibleURL().spec()
+               << " entries=" << controller.GetEntryCount()
+               << " pending=" << (pending ? pending->GetURL().spec() : "<none>")
+               << " committed="
+               << (committed ? committed->GetURL().spec() : "<none>")
+               << " committed_initial="
+               << (committed ? committed->IsInitialEntry() : -1)
+               << " is_loading=" << contents->IsLoading();
+  }
+}
+
+void PinnedTabMirror::AdoptStartupTabs() {
+  LOG(ERROR) << "AERODIAG AdoptStartupTabs enter loaded=" << model_->IsLoaded();
+  if (!model_->IsLoaded()) {
+    return;
+  }
+  BrowserWindowInterface* target = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() == profile_ &&
+            browser->GetType() == BrowserWindowInterface::TYPE_NORMAL) {
+          target = browser;
+          return false;
+        }
+        return true;
+      });
+  LOG(ERROR) << "AERODIAG AdoptStartupTabs target=" << target;
+  if (!target) {
+    return;
+  }
+  TabStripModel* strip = target->GetTabStripModel();
+  DiagDumpStrip("before", strip);
+
+  struct Candidate {
+    base::Uuid uuid;
+    GURL url;
+    bool open;
+  };
+  bool reopened = false;
+  std::vector<Candidate> candidates;
+  auto add = [&](const PinnedItem& item) {
+    if (!item.is_folder && item.url.is_valid() &&
+        item.url.SchemeIsHTTPOrHTTPS()) {
+      candidates.push_back({item.uuid, item.url, item.open});
+    }
+  };
+  for (const PinnedItem& item : model_->GetPinned()) {
+    add(item);
+    for (const PinnedItem& child : item.children) {
+      add(child);
+    }
+  }
+
+  for (const Candidate& candidate : candidates) {
+    const bool mapped = std::ranges::any_of(
+        tab_nodes_,
+        [&](const auto& entry) { return entry.second == candidate.uuid; });
+    if (mapped) {
+      continue;
+    }
+    // An ordinary tab already showing the entry (startup URL, command line):
+    // pin it instead of opening a duplicate. Exact URL first, then origin +
+    // path. Associate() maps it from OnTabPinnedStateChanged().
+    int found = -1;
+    for (int pass = 0; pass < 2 && found < 0; ++pass) {
+      for (int i = strip->IndexOfFirstNonPinnedTab(); i < strip->count();
+           ++i) {
+        const GURL url = GetTabURL(strip->GetTabAtIndex(i));
+        if (pass == 0 ? url == candidate.url
+                      : (url.is_valid() &&
+                         SameOriginAndPath(candidate.url, url))) {
+          found = i;
+          break;
+        }
+      }
+    }
+    if (found >= 0) {
+      strip->SetTabPinned(found, true);
+    } else if (candidate.open) {
+      // Reopen what was open at the last quit, as a pinned tab mapped to
+      // this very entry.
+      next_entry_ = candidate.uuid;
+      chrome::AddTabAt(target, candidate.url, strip->IndexOfFirstNonPinnedTab(),
+                       /*foreground=*/false, /*group=*/std::nullopt,
+                       /*pinned=*/true);
+      next_entry_.reset();
+      reopened = true;
+    }
+  }
+  DiagDumpStrip("after-candidates", strip);
+  LOG(ERROR) << "AERODIAG reopened=" << reopened << " non_pinned="
+             << (strip->count() - strip->IndexOfFirstNonPinnedTab());
+  if (!reopened || strip->count() - strip->IndexOfFirstNonPinnedTab() != 1) {
+    return;
+  }
+  // The startup already opened the default new tab (no start URL) and it is
+  // now the lone ordinary tab next to the reopened pinned ones: drop it, but
+  // only while untouched.
+  const int ntp_index = strip->IndexOfFirstNonPinnedTab();
+  const bool untouched = IsUntouchedNewTab(strip->GetTabAtIndex(ntp_index));
+  LOG(ERROR) << "AERODIAG IsUntouchedNewTab=" << untouched
+             << " ntp_index=" << ntp_index;
+  if (!untouched) {
+    return;
+  }
+  strip->ActivateTabAt(ntp_index - 1);
+  strip->CloseWebContentsAt(ntp_index, TabCloseTypes::CLOSE_NONE);
 }
 
