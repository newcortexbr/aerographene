Aerographene topbar fidelity fix (GPL-3.0): pinned open in the topbar get the
1px outline and a globe when there is no favicon.
Depends on: aerographene/topbar-mockup.patch, aerographene/pixelized-type.patch.

--- a/chrome/browser/ui/views/frame/aerographene_topbar_row.cc
+++ b/chrome/browser/ui/views/frame/aerographene_topbar_row.cc
@@ -153,7 +153,15 @@
       stroke.setStrokeWidth(1);
       stroke.setColor(accent);
       canvas->DrawRoundRect(outline_bounds, radius, stroke);
-    } else if (!open_) {
+    } else if (open_) {
+      // Live pinned: 1px solid outline in the line color.
+      cc::PaintFlags stroke;
+      stroke.setAntiAlias(true);
+      stroke.setStyle(cc::PaintFlags::kStroke_Style);
+      stroke.setStrokeWidth(1);
+      stroke.setColor(line);
+      canvas->DrawRoundRect(outline_bounds, radius, stroke);
+    } else {
       cc::PaintFlags stroke;
       stroke.setAntiAlias(true);
       stroke.setStyle(cc::PaintFlags::kStroke_Style);
@@ -170,10 +178,12 @@
       canvas->DrawImageInt(favicon_, center.x() - favicon_.width() / 2,
                            center.y() - favicon_.height() / 2, alpha);
     } else {
-      cc::PaintFlags dot;
-      dot.setAntiAlias(true);
-      dot.setColor(SkColorSetA(colors->GetColor(ui::kColorIcon), alpha));
-      canvas->DrawCircle(center, kFaviconSize / 4, dot);
+      // No favicon yet: globe glyph.
+      canvas->DrawImageInt(
+          gfx::CreateVectorIcon(
+              vector_icons::kGlobeIcon, kFaviconSize,
+              SkColorSetA(colors->GetColor(ui::kColorIcon), alpha)),
+          center.x() - kFaviconSize / 2, center.y() - kFaviconSize / 2);
     }
 
     if (open_) {
