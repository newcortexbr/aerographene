 constexpr int kSpaceRowWidth = 148;
 constexpr int kSpaceRowHeight = 32;
+// Space row: padding 8 + icon 16 + gap 8 + text + gap 8 + chevron 16 + 8.
+constexpr int kSpaceRowChrome = 64;
+constexpr int kSpaceNameMaxWidth = 160;
 constexpr int kPinSize = 30;
 constexpr int kPinGap = 2;
 constexpr int kGroupGap = 8;
