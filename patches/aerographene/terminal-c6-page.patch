+// has loaded and at least COMMAND_DELAY_MS after navigation start, like the
+// user typing it plus Enter (the parser refused control characters).
+async function typeCommand(command, opened) {
+  if (typeof command !== 'string' || !command) {
+    return;
+  }
+  if (document.readyState !== 'complete') {
+    await new Promise((r) => window.addEventListener('load', r, {once: true}));
+  }
+  const wait = COMMAND_DELAY_MS - performance.now();
+  if (wait > 0) {
+    await new Promise((r) => setTimeout(r, wait));
+  }
+  const sid = await opened;
+  if (typeof sid === 'number' && sessions.has(sid)) {
+    chrome.send('write', [sid, `${command}\r`]);
+  }
