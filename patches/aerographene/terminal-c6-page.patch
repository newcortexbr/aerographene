+
+const ESC = '\x1b[';
+const LABEL = `${ESC}1;34m`;
+const RESET = `${ESC}0m`;
+
+function gib(bytes) {
+  return `${(bytes / 1024 ** 3).toFixed(1)} GiB`;
+}
+
+function text(v) {
+  // Only printable text from the browser: no escape sequences.
+  return typeof v === 'string' ? v.replace(/[\u0000-\u001f\u007f-\u009f]/g, '') : '';
+}
+
+// info: {chromium, aerographene, cpu, cores, gpu, ram, disks: [{path, total,
+// free}]}; anything missing or malformed is shown as "?".
+export function infoLines(info) {
+  const i = info && typeof info === 'object' ? info : {};
+  const rows = [
+    ['aerographene', i.aerographene ? `v${text(i.aerographene)}` : '?'],
+    ['chromium', text(i.chromium) || '?'],
+    ['cpu', (text(i.cpu) || '?') +
+         (Number.isInteger(i.cores) && i.cores > 0 ? ` (${i.cores} threads)` : '')],
+    ['gpu', text(i.gpu) || '?'],
+    ['ram', typeof i.ram === 'number' && i.ram > 0 ? gib(i.ram) : '?'],
+  ];
+  const seen = new Set();
+  for (const d of Array.isArray(i.disks) ? i.disks.slice(0, 4) : []) {
+    if (!d || typeof d.total !== 'number' || typeof d.free !== 'number') {
+      continue;
+    }
+    const key = `${d.total}/${d.free}`;  // "/" and $HOME on one disk
+    if (seen.has(key)) {
+      continue;
+    }
+    seen.add(key);
+    rows.push([`disco ${text(d.path)}`,
+               `${gib(d.total - d.free)} / ${gib(d.total)}`]);
+  }
+  const out = [`${LABEL}aerographene${RESET}`, '-'.repeat(12)];
+  for (const [k, v] of rows) {
+    out.push(`${LABEL}${k}${RESET}: ${v}`);
+  }
+  return out;
+}
+
+// The cat on the left, the info on the right (from its third line).
+export function banner(info) {
+  const right = infoLines(info);
+  const lines = [];
+  const n = Math.max(CAT.length, right.length + 2);
+  for (let k = 0; k < n; k++) {
+    const left = CAT[k] ?? ' '.repeat(CAT[0].length);
+    const r = right[k - 2] ?? '';
+    lines.push(r ? `${left}   ${r}` : left);
+  }
+  return lines.join('\r\n') + '\r\n\r\n';
+}
