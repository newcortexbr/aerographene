+// --- vault (B2/B3): read-only access through the page's WebUI handler. ---
+
+import {renderMarkdown} from './markdown.js';
+
+// Minimal replacement for cr.sendWithPromise: the browser answers with
+// cr.webUIResponse(id, ok, value) (WebUIMessageHandler::Resolve/Reject).
+const pending = new Map();
+let nextId = 0;
+window.cr = window.cr || {};
+window.cr.webUIResponse = (id, ok, value) => {
+  const p = pending.get(id);
+  if (p) {
+    pending.delete(id);
+    (ok ? p.resolve : p.reject)(value);
+  }
+};
+function send(name, ...args) {
+  const id = `notes${nextId++}`;
+  return new Promise((resolve, reject) => {
+    pending.set(id, {resolve, reject});
+    chrome.send(name, [id, ...args]);
+  });
+}
+
+const tree = document.getElementById('tree');
+const editor = document.getElementById('editor');
+const noteTitle = document.getElementById('noteTitle');
+const vaultName = document.getElementById('vaultName');
+const vaultPick = document.getElementById('vaultPick');
+let current = '';
+
+function message(parent, text) {
+  parent.replaceChildren();
+  const p = document.createElement('p');
+  p.className = 'empty';
+  p.textContent = text;
+  parent.append(p);
+}
+
+function baseName(path) {
+  return path.slice(path.lastIndexOf('/') + 1);
+}
+
+async function fillDir(container, path, depth) {
+  let entries;
+  try {
+    entries = await send('listDir', path);
+  } catch (e) {
+    message(container, 'pasta indisponível');
+    return;
+  }
+  container.replaceChildren();
+  for (const entry of entries) {
+    const row = document.createElement('div');
+    row.className = entry.dir ? 'node dir' : 'node file';
+    row.setAttribute('role', 'treeitem');
+    row.tabIndex = 0;
+    row.style.paddingLeft = `${12 + depth * 14}px`;
+    row.textContent = baseName(entry.path);
+    row.dataset.path = entry.path;
+    container.append(row);
+    if (entry.dir) {
+      const kids = document.createElement('div');
+      kids.setAttribute('role', 'group');
+      kids.hidden = true;
+      container.append(kids);
+      row.setAttribute('aria-expanded', 'false');
+      row.addEventListener('click', () => {
+        const open = kids.hidden;
+        kids.hidden = !open;
+        row.setAttribute('aria-expanded', String(open));
+        if (open && !kids.childElementCount) {
+          fillDir(kids, entry.path, depth + 1);
+        }
+      });
+    } else if (entry.path.toLowerCase().endsWith('.md')) {
+      row.addEventListener('click', () => openNote(entry.path));
+    } else {
+      row.classList.add('muted');
+    }
+    row.addEventListener('keydown', (e) => {
+      if (e.key === 'Enter' || e.key === ' ') {
+        e.preventDefault();
+        row.click();
+      }
+    });
+  }
+  if (!entries.length) {
+    message(container, 'vazio');
+  }
+}
+
+async function openNote(path) {
+  let text;
+  try {
+    text = await send('readNote', path);
+  } catch (e) {
+    noteTitle.textContent = `${baseName(path)} (não foi possível ler)`;
+    return;
+  }
+  current = path;
+  noteTitle.textContent = baseName(path);
+  document.title = `o: ${baseName(path)}`;
+  for (const n of tree.querySelectorAll('.node.active')) {
+    n.classList.remove('active');
+  }
+  const row = [...tree.querySelectorAll('.node')].find(
+      (n) => n.dataset.path === path);
+  if (row) {
+    row.classList.add('active');
+  }
+  const article = document.createElement('article');
+  article.className = 'md';
+  article.append(renderMarkdown(text, {onWikilink: openWikilink}));
+  editor.replaceChildren(article);
+  editor.scrollTop = 0;
+}
+
+// [[name]] resolves next to the current note, then at the vault root.
+function openWikilink(target) {
+  let name = target.split('#')[0].trim();
+  if (!name || name.includes('..')) {
+    return;
+  }
+  if (!name.toLowerCase().endsWith('.md')) {
+    name += '.md';
+  }
+  const dir = current.includes('/') ?
+      current.slice(0, current.lastIndexOf('/') + 1) : '';
+  if (!dir) {
+    openNote(name);
+    return;
+  }
+  send('readNote', dir + name)
+      .then(() => openNote(dir + name), () => openNote(name));
+}
+
+function showVault(info) {
+  if (!info || !info.path) {
+    vaultName.textContent = 'vault';
+    message(tree, 'nenhuma vault escolhida');
+    return;
+  }
+  vaultName.textContent = info.name || info.path;
+  vaultName.title = info.path;
+  fillDir(tree, '', 0);
+}
+
+vaultPick.disabled = false;
+vaultPick.title = 'escolher a pasta da vault';
+vaultPick.addEventListener('click', async () => {
+  const info = await send('pickVault');
+  if (info) {
+    current = '';
+    showVault(info);
+  }
+});
+
+send('getVault').then(showVault);
