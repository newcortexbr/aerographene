+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_notes/notes_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace aerographene::notes {
+
+namespace {
+
+constexpr base::TaskTraits kIoTraits = {
+    base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+    base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN};
+
+// args = [callback_id, relative_path]; the path must be a string.
+const std::string* RelativeArg(const base::ListValue& args) {
+  if (args.size() != 2 || !args[1].is_string()) {
+    return nullptr;
+  }
+  return &args[1].GetString();
+}
+
+}  // namespace
+
+NotesHandler::NotesHandler(PrefService* prefs) : prefs_(prefs) {}
+
+NotesHandler::~NotesHandler() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
+
+void NotesHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getVault", base::BindRepeating(&NotesHandler::HandleGetVault,
+                                      base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "pickVault", base::BindRepeating(&NotesHandler::HandlePickVault,
+                                       base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "listDir", base::BindRepeating(&NotesHandler::HandleListDir,
+                                     base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "readNote", base::BindRepeating(&NotesHandler::HandleReadNote,
+                                      base::Unretained(this)));
+}
+
+void NotesHandler::OnJavascriptDisallowed() {
+  // Late replies are dropped: callbacks check IsJavascriptAllowed().
+  pick_callback_id_ = base::Value();
+}
+
+base::Value NotesHandler::VaultInfo() const {
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  base::DictValue info;
+  info.Set("path", root.value());
+  info.Set("name", root.BaseName().value());
+  return base::Value(std::move(info));
+}
+
+void NotesHandler::HandleGetVault(const base::ListValue& args) {
+  if (args.size() != 1) {
+    return;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], VaultInfo());
+}
+
+void NotesHandler::HandlePickVault(const base::ListValue& args) {
+  if (args.size() != 1) {
+    return;
+  }
+  AllowJavascript();
+  if (select_file_dialog_) {
+    // One picker at a time.
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  pick_callback_id_ = args[0].Clone();
+  content::WebContents* web_contents = web_ui()->GetWebContents();
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents));
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+      prefs_->GetFilePath(kVaultPathPref), nullptr, 0,
+      base::FilePath::StringType(), web_contents->GetTopLevelNativeWindow(),
+      nullptr);
+}
+
+void NotesHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                int /*index*/) {
+  select_file_dialog_ = nullptr;
+  if (file.path().IsAbsolute()) {
+    prefs_->SetFilePath(kVaultPathPref, file.path());
+  }
+  if (IsJavascriptAllowed() && !pick_callback_id_.is_none()) {
+    ResolveJavascriptCallback(pick_callback_id_, VaultInfo());
+  }
+  pick_callback_id_ = base::Value();
+}
+
+void NotesHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  if (IsJavascriptAllowed() && !pick_callback_id_.is_none()) {
+    ResolveJavascriptCallback(pick_callback_id_, base::Value());
+  }
+  pick_callback_id_ = base::Value();
+}
+
+void NotesHandler::HandleListDir(const base::ListValue& args) {
+  const std::string* rel = RelativeArg(args);
+  if (!rel) {
+    return;
+  }
+  AllowJavascript();
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  if (root.empty()) {
+    RejectJavascriptCallback(args[0], base::Value("noVault"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kIoTraits,
+      base::BindOnce(
+          [](base::FilePath root, std::string rel) {
+            return ListVaultDir(root, rel);
+          },
+          root, *rel),
+      base::BindOnce(&NotesHandler::OnListed, weak_ptr_factory_.GetWeakPtr(),
+                     args[0].Clone()));
+}
+
+void NotesHandler::OnListed(base::Value callback_id,
+                            std::optional<std::vector<VaultEntry>> entries) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!entries) {
+    RejectJavascriptCallback(callback_id, base::Value("notFound"));
+    return;
+  }
+  base::ListValue list;
+  for (const VaultEntry& e : *entries) {
+    base::DictValue item;
+    item.Set("path", e.path);
+    item.Set("dir", e.is_dir);
+    item.Set("size", static_cast<double>(e.size));
+    list.Append(std::move(item));
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(list)));
+}
+
+void NotesHandler::HandleReadNote(const base::ListValue& args) {
+  const std::string* rel = RelativeArg(args);
+  if (!rel) {
+    return;
+  }
+  AllowJavascript();
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  if (root.empty()) {
+    RejectJavascriptCallback(args[0], base::Value("noVault"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kIoTraits,
+      base::BindOnce(
+          [](base::FilePath root, std::string rel) {
+            return ReadVaultNote(root, rel);
+          },
+          root, *rel),
+      base::BindOnce(&NotesHandler::OnRead, weak_ptr_factory_.GetWeakPtr(),
+                     args[0].Clone()));
+}
+
+void NotesHandler::OnRead(base::Value callback_id,
+                          std::optional<std::string> text) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!text) {
+    RejectJavascriptCallback(callback_id, base::Value("notFound"));
+    return;
+  }
+  // base::Value strings must be UTF-8; invalid notes are refused.
+  if (!base::IsStringUTF8(*text)) {
+    RejectJavascriptCallback(callback_id, base::Value("notUtf8"));
+    return;
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(*text)));
+}
