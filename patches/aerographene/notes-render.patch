+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+// Minimal Markdown renderer for chrome://notes (fatia B3). It never parses
+// HTML: the note is turned into DOM nodes with createElement/textContent
+// only, so raw HTML in a note (<script>, onerror=, <iframe>) is shown as
+// text. No Trusted Types sink (innerHTML, insertAdjacentHTML, srcdoc...) is
+// used. Links: http(s) and mailto only; anything else (javascript:, data:,
+// chrome:) stays plain text. [[wikilinks]] call opts.onWikilink(target).
+// Images are not loaded yet (no remote fetch; vault images come later):
+// ![alt](src) renders as "[imagem: alt]".
+// Subset: ATX headings, paragraphs, blank-line separation, fenced code
+// (```), blockquote (>), unordered (-, *, +) and ordered (1.) lists, one
+// level, horizontal rule, **bold**, *em*/_em_, `code`, ~~strike~~, links,
+// wikilinks, hard break with two trailing spaces.
+
+const SAFE_URL = /^(https?:\/\/|mailto:)/i;
+const MAX_INPUT = 4 * 1024 * 1024;
+
+function el(tag, text) {
+  const e = document.createElement(tag);
+  if (text !== undefined) {
+    e.textContent = text;
+  }
+  return e;
+}
+
+// Inline tokens, earliest match wins.
+const INLINE = [
+  {re: /`([^`]+)`/, make: (m) => el('code', m[1])},
+  {re: /\[\[([^\]\n|]+)(?:\|([^\]\n]+))?\]\]/, make: (m, o) => wikilink(m, o)},
+  {re: /!\[([^\]\n]*)\]\(([^)\s]*)\)/, make: (m) => el('span', `[imagem: ${m[1] || m[2]}]`)},
+  {re: /\[([^\]\n]+)\]\(([^)\s]+)\)/, make: (m, o) => link(m, o)},
+  {re: /\*\*([^*\n]+)\*\*/, make: (m, o) => wrap('strong', m[1], o)},
+  {re: /~~([^~\n]+)~~/, make: (m, o) => wrap('s', m[1], o)},
+  {re: /\*([^*\n]+)\*/, make: (m, o) => wrap('em', m[1], o)},
+  {re: /(?<![\w])_([^_\n]+)_(?![\w])/, make: (m, o) => wrap('em', m[1], o)},
+  {re: /<?(https?:\/\/[^\s<>()]+[^\s<>().,;:!?'"])>?/, make: (m) => anchor(m[1], m[1])},
+];
+
+function wrap(tag, text, opts) {
+  const e = el(tag);
+  appendInline(e, text, opts);
+  return e;
+}
+
+function anchor(href, text) {
+  const a = el('a', text);
+  a.href = href;
+  a.target = '_blank';
+  a.rel = 'noopener noreferrer';
+  return a;
+}
+
+function link(m, opts) {
+  if (!SAFE_URL.test(m[2])) {
+    return document.createTextNode(m[0]);
+  }
+  const a = anchor(m[2], '');
+  appendInline(a, m[1], opts);
+  return a;
+}
+
+function wikilink(m, opts) {
+  const target = m[1].trim();
+  const a = el('a', (m[2] || m[1]).trim());
+  a.className = 'wikilink';
+  a.href = '#';
+  a.dataset.target = target;
+  a.addEventListener('click', (e) => {
+    e.preventDefault();
+    if (opts && opts.onWikilink) {
+      opts.onWikilink(target);
+    }
+  });
+  return a;
+}
+
+function appendInline(parent, text, opts) {
+  while (text) {
+    let best = null;
+    for (const rule of INLINE) {
+      const m = rule.re.exec(text);
+      if (m && (!best || m.index < best.m.index)) {
+        best = {m, rule};
+      }
+    }
+    if (!best) {
+      parent.append(text);
+      return;
+    }
+    if (best.m.index > 0) {
+      parent.append(text.slice(0, best.m.index));
+    }
+    parent.append(best.rule.make(best.m, opts));
+    text = text.slice(best.m.index + best.m[0].length);
+  }
+}
+
+function paragraph(lines, opts) {
+  const p = el('p');
+  lines.forEach((line, i) => {
+    const hard = / {2,}$/.test(line);
+    appendInline(p, i < lines.length - 1 ? line.trimEnd() : line.trim(), opts);
+    if (i < lines.length - 1) {
+      p.append(hard ? el('br') : ' ');
+    }
+  });
+  return p;
+}
+
+const RE_FENCE = /^\s*(```|~~~)(.*)$/;
+const RE_HEADING = /^(#{1,6})\s+(.*?)\s*#*\s*$/;
+const RE_HR = /^\s*([-*_])(\s*\1){2,}\s*$/;
+const RE_QUOTE = /^\s*>\s?(.*)$/;
+const RE_UL = /^\s*[-*+]\s+(.*)$/;
+const RE_OL = /^\s*(\d{1,9})[.)]\s+(.*)$/;
+const RE_TASK = /^\[([ xX])\]\s+(.*)$/;
+
+function isBlockStart(line) {
+  return RE_FENCE.test(line) || RE_HEADING.test(line) || RE_HR.test(line) ||
+      RE_QUOTE.test(line) || RE_UL.test(line) || RE_OL.test(line);
+}
+
+function renderBlocks(lines, opts, depth) {
+  const frag = document.createDocumentFragment();
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    if (!line.trim()) {
+      i++;
+      continue;
+    }
+    let m;
+    if ((m = RE_FENCE.exec(line))) {
+      const fence = m[1];
+      const code = [];
+      i++;
+      while (i < lines.length && !lines[i].trim().startsWith(fence)) {
+        code.push(lines[i++]);
+      }
+      i++;
+      const pre = el('pre');
+      const c = el('code', code.join('\n'));
+      const lang = m[2].trim();
+      if (/^[\w-]{1,32}$/.test(lang)) {
+        c.dataset.lang = lang;
+      }
+      pre.append(c);
+      frag.append(pre);
+    } else if ((m = RE_HEADING.exec(line))) {
+      frag.append(wrap(`h${m[1].length}`, m[2], opts));
+      i++;
+    } else if (RE_HR.test(line)) {
+      frag.append(el('hr'));
+      i++;
+    } else if (RE_QUOTE.test(line)) {
+      const inner = [];
+      while (i < lines.length && (m = RE_QUOTE.exec(lines[i]))) {
+        inner.push(m[1]);
+        i++;
+      }
+      const q = el('blockquote');
+      q.append(depth < 8 ? renderBlocks(inner, opts, depth + 1) :
+                           paragraph(inner, opts));
+      frag.append(q);
+    } else if (RE_UL.test(line) || RE_OL.test(line)) {
+      const ordered = !RE_UL.test(line);
+      const re = ordered ? RE_OL : RE_UL;
+      const list = el(ordered ? 'ol' : 'ul');
+      if (ordered) {
+        const start = parseInt(RE_OL.exec(line)[1], 10);
+        if (start !== 1) {
+          list.start = start;
+        }
+      }
+      while (i < lines.length && (m = re.exec(lines[i]))) {
+        const li = el('li');
+        let text = ordered ? m[2] : m[1];
+        const t = RE_TASK.exec(text);
+        if (t) {
+          const box = el('input');
+          box.type = 'checkbox';
+          box.disabled = true;
+          box.checked = t[1] !== ' ';
+          li.append(box, ' ');
+          text = t[2];
+        }
+        appendInline(li, text, opts);
+        list.append(li);
+        i++;
+      }
+      frag.append(list);
+    } else {
+      const para = [];
+      while (i < lines.length && lines[i].trim() &&
+             (para.length === 0 || !isBlockStart(lines[i]))) {
+        para.push(lines[i++]);
+      }
+      frag.append(paragraph(para, opts));
+    }
+  }
+  return frag;
+}
+
+// Returns a DocumentFragment; never throws on any input string.
+export function renderMarkdown(text, opts = {}) {
+  let src = String(text);
+  if (src.length > MAX_INPUT) {
+    src = src.slice(0, MAX_INPUT);
+  }
+  // YAML front matter is not shown.
+  src = src.replace(/^---\n[\s\S]*?\n---\n/, '');
+  return renderBlocks(src.replace(/\r\n?/g, '\n').split('\n'), opts, 0);
+}
