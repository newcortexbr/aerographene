+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+// chrome://setup: first-run page of a new profile (space). Every control
+// below is wired to a setting that exists (theme pref, search engine model,
+// notes vault pref, default browser, import page) through SetupHandler. No
+// network, no innerHTML (Trusted Types is enforced by the WebUI CSP).
+
+// Minimal replacement for cr.sendWithPromise: the browser answers with
+// cr.webUIResponse(id, ok, value) (WebUIMessageHandler::Resolve/Reject).
+const pending = new Map();
+let nextId = 0;
+window.cr = window.cr || {};
+window.cr.webUIResponse = (id, ok, value) => {
+  const p = pending.get(id);
+  if (p) {
+    pending.delete(id);
+    (ok ? p.resolve : p.reject)(value);
+  }
+};
+window.cr.webUIListenerCallback = () => {};
+function send(name, ...args) {
+  const id = `setup${nextId++}`;
+  return new Promise((resolve, reject) => {
+    pending.set(id, {resolve, reject});
+    chrome.send(name, [id, ...args]);
+  });
+}
+
+const $ = (id) => document.getElementById(id);
+const panes = Array.from(document.querySelectorAll('.pane'));
+const links = Array.from(document.querySelectorAll('#idx a'));
+let current = 0;
+
+function el(tag, cls, text) {
+  const e = document.createElement(tag);
+  if (cls) {
+    e.className = cls;
+  }
+  if (text !== undefined) {
+    e.textContent = text;
+  }
+  return e;
+}
+
+// --- steps: rail, j/k, enter ---
+
+function mark(i) {
+  current = i;
+  panes.forEach((p, k) => p.classList.toggle('on', k === i));
+  links.forEach((a, k) => {
+    a.classList.toggle('on', k === i);
+    if (k === i) {
+      a.setAttribute('aria-current', 'step');
+    } else {
+      a.removeAttribute('aria-current');
+    }
+  });
+}
+
+function go(i) {
+  i = Math.max(0, Math.min(panes.length - 1, i));
+  mark(i);
+  panes[i].scrollIntoView({block: 'start'});
+}
+
+links.forEach((a, i) => a.addEventListener('click', (e) => {
+  e.preventDefault();
+  go(i);
+}));
+
+document.addEventListener('keydown', (e) => {
+  if (e.ctrlKey || e.metaKey || e.altKey) {
+    return;
+  }
+  const t = e.target;
+  if (t.closest && t.closest('input, select, textarea')) {
+    return;
+  }
+  const interactive = t.closest && t.closest('button, a');
+  if (e.key === 'j') {
+    go(current + 1);
+  } else if (e.key === 'k') {
+    go(current - 1);
+  } else if (e.key === 'Enter' && !interactive) {
+    go(current + 1);
+  } else {
+    return;
+  }
+  e.preventDefault();
+});
+
+// The current step follows the scroll position too.
+let ticking = false;
+window.addEventListener('scroll', () => {
+  if (ticking) {
+    return;
+  }
+  ticking = true;
+  requestAnimationFrame(() => {
+    ticking = false;
+    const line = window.innerHeight * 0.35;
+    let idx = 0;
+    panes.forEach((p, k) => {
+      if (p.getBoundingClientRect().top <= line) {
+        idx = k;
+      }
+    });
+    if (idx !== current) {
+      mark(idx);
+    }
+  });
+});
+
+// --- finish: marks the profile as onboarded, then the new tab page ---
+
+let finishing = false;
+async function complete() {
+  if (finishing) {
+    return;
+  }
+  finishing = true;
+  for (const id of ['skip', 'finish', 'start']) {
+    $(id).disabled = true;
+  }
+  try {
+    await send('complete');
+  } catch (e) {
+    finishing = false;
+    for (const id of ['skip', 'finish', 'start']) {
+      $(id).disabled = false;
+    }
+  }
+}
+
+$('start').addEventListener('click', () => go(1));
+$('skip').addEventListener('click', complete);
+$('finish').addEventListener('click', complete);
+$('import').addEventListener('click', () => {
+  send('openImport').catch(() => {});
+});
+
+// --- 01 theme ---
+
+const THEME_TEXT = {
+  default: 'soft gradients, dark, system font',
+  pixelized: 'mono greys, square corners, pixel icons',
+};
+
+function themeCard(t, active) {
+  const card = el('button', 'opt');
+  card.type = 'button';
+  card.setAttribute('role', 'radio');
+  card.dataset.name = t.name;
+  const mini = el('div', 'mini');
+  if (t.name === 'default' && t.builtin) {
+    mini.classList.add('d1');
+  } else if (t.name === 'pixelized' && t.builtin) {
+    mini.classList.add('px');
+  } else if (!t.dark) {
+    mini.classList.add('lt');
+  }
+  mini.append(el('i'), el('i'));
+  card.append(mini, el('b', '', t.name));
+  card.append(el('small', '',
+      (t.builtin && THEME_TEXT[t.name]) ||
+      (t.dark ? 'custom theme, dark' : 'custom theme, light')));
+  card.classList.toggle('on', t.name === active);
+  card.setAttribute('aria-checked', String(t.name === active));
+  return card;
+}
+
+async function initThemes() {
+  const box = $('themes');
+  let data;
+  try {
+    data = await send('getThemes');
+  } catch (e) {
+    return;
+  }
+  const render = (active) => {
+    box.replaceChildren(...data.themes.map((t) => themeCard(t, active)));
+  };
+  render(data.active);
+  let active = data.active;
+  box.addEventListener('click', async (e) => {
+    const card = e.target.closest('.opt');
+    if (!card || card.dataset.name === active) {
+      return;
+    }
+    const name = card.dataset.name;
+    let ok = false;
+    try {
+      ok = await send('setTheme', name);
+    } catch (err) {
+      ok = false;
+    }
+    if (ok) {
+      active = name;
+      render(active);
+      $('themeNote').hidden = false;
+    }
+  });
+}
+
+// --- 02 defaults: search engine, default browser ---
+
+async function initSearch() {
+  const sel = $('engine');
+  const sug = $('suggest');
+  let data;
+  try {
+    data = await send('getSearch');
+  } catch (e) {
+    return;
+  }
+  for (const en of data.engines) {
+    const o = el('option', '', en.name);
+    o.value = en.keyword;
+    sel.append(o);
+  }
+  sel.value = data.current;
+  if (!data.engines.some((en) => en.keyword === data.current)) {
+    sel.selectedIndex = -1;
+  }
+  sel.disabled = data.engines.length === 0;
+  let last = sel.value;
+  sel.addEventListener('change', async () => {
+    let ok = false;
+    try {
+      ok = await send('setSearchEngine', sel.value);
+    } catch (e) {
+      ok = false;
+    }
+    if (ok) {
+      last = sel.value;
+    } else {
+      sel.value = last;
+    }
+  });
+
+  // 06 privacy: search suggestions (the existing pref).
+  sug.setAttribute('aria-checked', String(!!data.suggest));
+  sug.disabled = false;
+  sug.addEventListener('click', async () => {
+    const next = sug.getAttribute('aria-checked') !== 'true';
+    sug.disabled = true;
+    try {
+      if (await send('setSuggest', next)) {
+        sug.setAttribute('aria-checked', String(next));
+      }
+    } catch (e) {
+      // keep the old value
+    }
+    sug.disabled = false;
+  });
+}
+
+function showDefaultBrowser(s) {
+  const tog = $('defBrowser');
+  const note = $('defBrowserNote');
+  tog.setAttribute('aria-checked', String(!!s.isDefault));
+  if (s.isDefault) {
+    tog.disabled = true;
+    note.textContent = 'it already is the default browser';
+  } else if (s.canSet) {
+    tog.disabled = false;
+    note.textContent = 'links and html files open here';
+  } else {
+    tog.disabled = true;
+    note.textContent = 'cannot be set from here, use the system settings';
+  }
+}
+
+async function initDefaultBrowser() {
+  const tog = $('defBrowser');
+  try {
+    showDefaultBrowser(await send('getDefaultBrowser'));
+  } catch (e) {
+    $('defBrowserNote').textContent = 'could not read the system setting';
+    return;
+  }
+  tog.addEventListener('click', async () => {
+    tog.disabled = true;
+    try {
+      showDefaultBrowser(await send('setDefaultBrowser'));
+    } catch (e) {
+      tog.disabled = false;
+    }
+  });
+}
+
+// --- 03 notes folder ---
+
+function showVault(v) {
+  const path = v && v.path;
+  $('vaultPath').textContent = path || 'none chosen';
+  $('vaultPath').title = path || '';
+}
+
+async function initVault(info) {
+  showVault(info.vault);
+  $('vaultPick').addEventListener('click', async () => {
+    try {
+      const v = await send('pickVault');
+      if (v) {
+        showVault(v);
+      }
+    } catch (e) {
+      // keep the old folder
+    }
+  });
+}
+
+async function init() {
+  mark(0);
+  let info = {vault: null};
+  try {
+    info = await send('getInfo');
+    $('ver').textContent = `first run · v${info.version} · ${info.platform}`;
+  } catch (e) {
+    // the page still works without the header line
+  }
+  await Promise.all([initThemes(), initSearch(), initDefaultBrowser(), initVault(info)]);
+  window.setupReady = true;
+}
+
+init();
