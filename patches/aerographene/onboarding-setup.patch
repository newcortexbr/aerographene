+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_SETUP_AERO_SETUP_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_SETUP_AERO_SETUP_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class BrowserContext;
+}
+
+inline constexpr char kAeroSetupHost[] = "setup";
+
+class AeroSetupUI;
+
+// chrome://setup (shown as aerographene://setup): first-run page of a new
+// profile (space). Only the config lives in the WebUIConfigMap; the controller
+// and its data source are created when a tab navigates to the page.
+class AeroSetupUIConfig : public content::DefaultWebUIConfig<AeroSetupUI> {
+ public:
+  AeroSetupUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kAeroSetupHost) {}
+
+  // Off the record (incognito and guest) profiles do not get the page.
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+};
+
+class AeroSetupUI : public content::WebUIController {
+ public:
+  explicit AeroSetupUI(content::WebUI* web_ui);
+
+  AeroSetupUI(const AeroSetupUI&) = delete;
+  AeroSetupUI& operator=(const AeroSetupUI&) = delete;
+
+  ~AeroSetupUI() override;
+};
+
