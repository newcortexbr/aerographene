+/* Copyright 2026 The aerographene Authors
+ * Use of this source code is governed by the GPL-3.0 license.
+ *
+ * Style of the aerographene site and of the approved onboarding mockup
+ * (theming/mockups/perfis-onboarding/03-onboarding): mono type, thin borders,
+ * dotted background, titled panes. System fonts only; nothing is loaded from
+ * outside the package. */
+:root {
+  --bg: #05070c;
+  --panel: #0a0e16;
+  --line: #1c2433;
+  --line2: #2c3a52;
+  --text: #e6edf8;
+  --text2: #9aa8bf;
+  --muted: #5e6b82;
+  --accent: #6cb6ff;
+  --notes: #c4a7ff;
+  --term: #58a6ff;
+  --mono: "JetBrains Mono", "JetBrainsMono Nerd Font", ui-monospace,
+      "DejaVu Sans Mono", monospace;
+}
+* { box-sizing: border-box; margin: 0; }
+html {
+  background: var(--bg);
+  color: var(--text);
+  font: 14px/1.7 var(--mono);
+  scroll-behavior: smooth;
+}
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+}
+body {
+  background-image: radial-gradient(circle at 1px 1px, #ffffff0b 1px, transparent 1.5px);
+  background-size: 14px 24px;
+  min-height: 100vh;
+}
+a { color: var(--text); text-decoration: none; }
+b { font-weight: 600; }
+kbd {
+  border: 1px solid var(--line2);
+  color: var(--text2);
+  font: inherit;
+  font-size: 11px;
+  margin-right: 4px;
+  padding: 0 6px;
+}
+:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
+
+.shell {
+  display: grid;
+  gap: 28px;
+  grid-template-columns: 250px minmax(0, 1fr);
+  margin: 0 auto;
+  max-width: 1240px;
+  padding: 28px;
+}
+
+/* left rail, like a TUI side pane */
+.rail {
+  align-self: start;
+  background: var(--bg);
+  border: 1px solid var(--line);
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  padding: 20px 18px;
+  position: sticky;
+  top: 28px;
+}
+.logo { display: block; height: auto; width: 100%; }
+.ver { color: var(--muted); font-size: 11px; margin-top: -8px; }
+.idx { display: flex; flex-direction: column; }
+.idx a {
+  border-left: 2px solid transparent;
+  color: var(--text2);
+  padding: 3px 8px;
+}
+.idx a span { color: var(--muted); margin-right: 8px; }
+.idx a.on {
+  background: var(--text);
+  border-left-color: var(--accent);
+  color: var(--bg);
+}
+.idx a.on span { color: var(--bg); }
+.keys { color: var(--muted); font-size: 11px; }
+
+/* panes with the title in the border */
+main { display: flex; flex-direction: column; gap: 30px; min-width: 0; }
+.pane {
+  background: var(--bg);
+  border: 1px solid var(--line);
+  padding: 36px 36px 30px;
+  position: relative;
+  scroll-margin-top: 28px;
+}
+.pane::before {
+  background: var(--bg);
+  color: var(--muted);
+  content: "─ " attr(data-title) " ─";
+  font-size: 12px;
+  left: 16px;
+  padding: 0 6px;
+  position: absolute;
+  top: -10px;
+}
+.pane.on { border-color: var(--line2); }
+.pane.on::before { color: var(--text); }
+
+h1 { font-size: 38px; letter-spacing: -.5px; line-height: 1.2; margin-bottom: 14px; }
+h1 em { color: var(--text2); font-style: normal; }
+.lede { color: var(--text2); max-width: 640px; }
+.lede + .cmdb, .lede + .term { margin-top: 14px; }
+.dim { color: var(--muted); }
+.c-notes { color: var(--notes); }
+.c-term { color: var(--term); }
+.note-line { color: var(--muted); font-size: 12px; margin-top: 10px; }
+
+.btns { display: flex; gap: 12px; margin-top: 18px; }
+.btn {
+  align-items: center;
+  background: none;
+  border: 1px solid var(--text);
+  color: var(--text);
+  cursor: pointer;
+  display: inline-flex;
+  font: inherit;
+  gap: 8px;
+  padding: 5px 14px;
+  white-space: nowrap;
+}
+.btn.solid { background: var(--text); color: var(--bg); }
+.btn.ghost { border-color: var(--line2); color: var(--text2); }
+.btn.sm { font-size: 12px; padding: 2px 10px; }
+.btn:hover { border-color: var(--text); }
+
+/* theme cards */
+.opts { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
+.opt {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  color: var(--text2);
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  font: inherit;
+  gap: 6px;
+  padding: 14px 16px;
+  text-align: left;
+}
+.opt b { color: var(--text); display: flex; justify-content: space-between; }
+.opt b::after { color: var(--muted); content: "[ ]"; font-weight: 400; }
+.opt.on { border-color: var(--text); }
+.opt.on b::after { color: var(--text); content: "[x]"; }
+.opt small { color: var(--muted); font-size: 11px; }
+.mini {
+  background: #04070e;
+  border: 1px solid var(--line);
+  height: 90px;
+  margin-bottom: 6px;
+  overflow: hidden;
+  position: relative;
+}
+.mini::before {
+  background: #060a14;
+  border-right: 1px solid #ffffff17;
+  bottom: 0;
+  content: "";
+  left: 0;
+  position: absolute;
+  top: 0;
+  width: 26%;
+}
+.mini i { background: #ffffff22; height: 8px; left: 34%; position: absolute; top: 26px; width: 46%; }
+.mini i + i { top: 44px; width: 30%; }
+.mini.px { background: #000; }
+.mini.px::before { background: #141414; }
+.mini.d1 {
+  background:
+      radial-gradient(60% 70% at 40% 40%, #1a3f80aa, transparent),
+      radial-gradient(40% 50% at 85% 30%, #4a2280aa, transparent), #03060d;
+}
+.mini.lt { background: #eceff4; }
+.mini.lt::before { background: #dfe3ea; border-right-color: #00000017; }
+.mini.lt i { background: #00000022; }
+
+/* rows */
+.line {
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+  display: flex;
+  gap: 20px;
+  justify-content: space-between;
+  padding: 9px 0;
+}
+.line:last-child { border: 0; }
+.line small { color: var(--muted); display: block; font-size: 11px; line-height: 1.4; }
+.line label { cursor: pointer; }
+.static { color: var(--text2); flex: none; }
+select {
+  background: var(--bg);
+  border: 1px solid var(--line2);
+  color: var(--text);
+  font: inherit;
+  min-width: 170px;
+  padding: 4px 10px;
+}
+select:disabled, .tog:disabled { opacity: .5; }
+.tog {
+  background: none;
+  border: 1px solid var(--line2);
+  cursor: pointer;
+  flex: none;
+  height: 18px;
+  padding: 0;
+  position: relative;
+  width: 36px;
+}
+.tog::after {
+  background: var(--muted);
+  content: "";
+  height: 10px;
+  left: 3px;
+  position: absolute;
+  top: 3px;
+  width: 10px;
+}
+.tog[aria-checked="true"] { background: var(--text); border-color: var(--text); }
+.tog[aria-checked="true"]::after { background: var(--bg); left: auto; right: 3px; }
+
+.cmdb {
+  background: var(--panel);
+  border: 1px solid var(--line2);
+  color: var(--text);
+  display: flex;
+  gap: 10px;
+  margin: 8px 0 6px;
+  padding: 8px 14px;
+}
+.term {
+  background: #020409;
+  border: 1px solid var(--term);
+  color: var(--text2);
+  font-size: 12px;
+  padding: 12px 16px;
+}
+.term b { color: var(--term); font-weight: 400; }
+.folder {
+  align-items: center;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  color: var(--text2);
+  display: flex;
+  font-size: 12px;
+  gap: 16px;
+  margin-top: 12px;
+  padding: 12px 16px;
+}
+.folder .dim { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+@media (max-width: 820px) {
+  .shell { grid-template-columns: 1fr; }
+  .rail { position: static; }
+  .pane { padding: 30px 20px 24px; }
+}
