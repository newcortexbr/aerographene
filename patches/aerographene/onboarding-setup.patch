+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_SETUP_SETUP_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_SETUP_SETUP_HANDLER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/callback_list.h"
+#include "base/values.h"
+#include "chrome/browser/shell_integration.h"
+#include "chrome/browser/themes/aerographene_theme_repo.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+
+class Profile;
+
+namespace aerographene::setup {
+
+// Messages from chrome://setup only (WebUI bindings exist only in that
+// page's renderer). Every message carries a callback id as first argument and
+// only touches a setting the page really shows:
+//   getInfo()                 -> {version, platform, vault}
+//   getThemes()               -> {themes: [{name, builtin, dark}], active}
+//   setTheme(name)            -> bool (name must be one ListThemes reports)
+//   getSearch()               -> {engines: [{keyword, name}], current, suggest}
+//   setSearchEngine(keyword)  -> bool (keyword must be one getSearch listed)
+//   setSuggest(bool)          -> bool
+//   pickVault()               -> {path} or null (needs a user gesture)
+//   getDefaultBrowser()       -> {canSet, isDefault}
+//   setDefaultBrowser()       -> {canSet, isDefault}
+//   openImport()              -> bool (opens settings, import page, in a tab)
+//   complete()                -> bool (marks the profile as onboarded and
+//                                      goes to the new tab page)
+class SetupHandler : public content::WebUIMessageHandler,
+                     public ui::SelectFileDialog::Listener {
+ public:
+  explicit SetupHandler(Profile* profile);
+  SetupHandler(const SetupHandler&) = delete;
+  SetupHandler& operator=(const SetupHandler&) = delete;
+  ~SetupHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+ private:
+  // Sender is the primary main frame committed at chrome://setup.
+  bool FromSetupPage();
+  // FromSetupPage() plus argument shape: [callback_id] or [callback_id, arg]
+  // with |arg_type| (NONE = no extra argument). Rejects the callback when
+  // the shape is wrong.
+  bool CheckArgs(const base::ListValue& args, base::Value::Type arg_type);
+
+  void HandleGetInfo(const base::ListValue& args);
+  void HandleGetThemes(const base::ListValue& args);
+  void HandleSetTheme(const base::ListValue& args);
+  void HandleGetSearch(const base::ListValue& args);
+  void HandleSetSearchEngine(const base::ListValue& args);
+  void HandleSetSuggest(const base::ListValue& args);
+  void HandlePickVault(const base::ListValue& args);
+  void HandleGetDefaultBrowser(const base::ListValue& args);
+  void HandleSetDefaultBrowser(const base::ListValue& args);
+  void HandleOpenImport(const base::ListValue& args);
+  void HandleComplete(const base::ListValue& args);
+
+  void OnThemesListed(base::Value callback_id,
+                      std::vector<aerographene::ThemeInfo> themes);
+  void OnThemeValidated(base::Value callback_id,
+                        std::string name,
+                        std::vector<aerographene::ThemeInfo> themes);
+  void OnTemplateURLsLoaded();
+  void ResolveSearch(const base::Value& callback_id);
+  void OnDefaultBrowserState(base::Value callback_id,
+                             shell_integration::DefaultWebClientState state);
+
+  base::Value VaultInfo() const;
+  bool CanSetDefaultBrowser() const;
+
+  raw_ptr<Profile> profile_;
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  base::Value pick_callback_id_;
+  std::vector<base::Value> pending_search_ids_;
+  base::CallbackListSubscription template_urls_loaded_subscription_;
+  base::WeakPtrFactory<SetupHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace aerographene::setup
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_SETUP_SETUP_HANDLER_H_
