+namespace aerographene::setup {
+
+namespace {
+
+// A search engine the page may offer and select: a regular entry that comes
+// from the prepopulated list (no extension, no user-typed custom engine).
+bool IsListable(TemplateURLService* service, const TemplateURL* url) {
+  return url->GetType() == TemplateURL::NORMAL && url->prepopulate_id() != 0 &&
+         service->CanMakeDefault(url);
+}
+
+}  // namespace
+
+SetupHandler::SetupHandler(Profile* profile) : profile_(profile) {}
+
+SetupHandler::~SetupHandler() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
+
+void SetupHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getInfo", base::BindRepeating(&SetupHandler::HandleGetInfo,
+                                     base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "getThemes", base::BindRepeating(&SetupHandler::HandleGetThemes,
+                                       base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setTheme", base::BindRepeating(&SetupHandler::HandleSetTheme,
+                                      base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "getSearch", base::BindRepeating(&SetupHandler::HandleGetSearch,
+                                       base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setSearchEngine",
+      base::BindRepeating(&SetupHandler::HandleSetSearchEngine,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setSuggest", base::BindRepeating(&SetupHandler::HandleSetSuggest,
+                                        base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "pickVault", base::BindRepeating(&SetupHandler::HandlePickVault,
+                                       base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "getDefaultBrowser",
+      base::BindRepeating(&SetupHandler::HandleGetDefaultBrowser,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setDefaultBrowser",
+      base::BindRepeating(&SetupHandler::HandleSetDefaultBrowser,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "openImport", base::BindRepeating(&SetupHandler::HandleOpenImport,
+                                        base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "complete", base::BindRepeating(&SetupHandler::HandleComplete,
+                                      base::Unretained(this)));
+}
+
+void SetupHandler::OnJavascriptDisallowed() {
+  // Late replies are dropped: callbacks check IsJavascriptAllowed().
+  pick_callback_id_ = base::Value();
+  pending_search_ids_.clear();
+  template_urls_loaded_subscription_ = {};
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+bool SetupHandler::FromSetupPage() {
+  content::RenderFrameHost* rfh = web_ui()->GetRenderFrameHost();
+  return rfh && rfh->IsInPrimaryMainFrame() &&
+         rfh->GetLastCommittedOrigin().IsSameOriginWith(
+             GURL(chrome::kChromeUISetupURL));
+}
+
+bool SetupHandler::CheckArgs(const base::ListValue& args,
+                             base::Value::Type arg_type) {
+  if (!FromSetupPage()) {
+    return false;
+  }
+  const bool has_arg = arg_type != base::Value::Type::NONE;
+  if (args.size() == (has_arg ? 2u : 1u) && args[0].is_string() &&
+      (!has_arg || args[1].type() == arg_type)) {
+    return true;
+  }
+  // Malformed message from the setup page itself: settle the promise (when
+  // there is a callback id) instead of leaving it pending forever.
+  if (!args.empty() && args[0].is_string()) {
+    AllowJavascript();
+    RejectJavascriptCallback(args[0], base::Value("bad_request"));
+  }
+  return false;
+}
+
+base::Value SetupHandler::VaultInfo() const {
+  const base::FilePath root =
+      profile_->GetPrefs()->GetFilePath(aerographene::notes::kVaultPathPref);
+  base::DictValue info;
+  info.Set("path", root.AsUTF8Unsafe());
+  return base::Value(std::move(info));
+}
+
+void SetupHandler::HandleGetInfo(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  base::DictValue info;
+  info.Set("version", std::string(aero::kVersion));
+#if BUILDFLAG(IS_WIN)
+  info.Set("platform", "windows");
+#else
+  info.Set("platform", "linux");
+#endif
+  info.Set("vault", VaultInfo());
+  ResolveJavascriptCallback(args[0], info);
+}
+
+// --- theme: the same pref and the same validation as settings > appearance ---
+
+void SetupHandler::HandleGetThemes(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  aerographene::ListThemes(
+      base::BindOnce(&SetupHandler::OnThemesListed,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SetupHandler::OnThemesListed(base::Value callback_id,
+                                  std::vector<aerographene::ThemeInfo> themes) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  const std::string pref =
+      profile_->GetPrefs()->GetString(aerographene::kThemePref);
+  // A name without a valid folder runs as "default" (ResolveTheme).
+  std::string active = aerographene::kThemeDefault;
+  base::ListValue list;
+  for (const aerographene::ThemeInfo& info : themes) {
+    if (info.theme.name == pref) {
+      active = pref;
+    }
+    base::DictValue entry;
+    entry.Set("name", info.theme.name);
+    entry.Set("builtin", info.builtin);
+    entry.Set("dark", info.theme.scheme == aerographene::ThemeScheme::kDark);
+    list.Append(std::move(entry));
+  }
+  base::DictValue result;
+  result.Set("themes", std::move(list));
+  result.Set("active", active);
+  ResolveJavascriptCallback(callback_id, result);
+}
+
+void SetupHandler::HandleSetTheme(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::STRING)) {
+    return;
+  }
+  AllowJavascript();
+  aerographene::ListThemes(
+      base::BindOnce(&SetupHandler::OnThemeValidated,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone(),
+                     args[1].GetString()));
+}
+
+void SetupHandler::OnThemeValidated(
+    base::Value callback_id,
+    std::string name,
+    std::vector<aerographene::ThemeInfo> themes) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  bool found = false;
+  for (const aerographene::ThemeInfo& info : themes) {
+    if (info.theme.name == name) {
+      found = true;
+      break;
+    }
+  }
+  if (found) {
+    // Read once in ThemeService::Init: applies on the next browser start.
+    profile_->GetPrefs()->SetString(aerographene::kThemePref, name);
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(found));
+}
+
+// --- search engine: TemplateURLService; suggestions: the existing pref ---
+
+void SetupHandler::HandleGetSearch(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    RejectJavascriptCallback(args[0], base::Value("unavailable"));
+    return;
+  }
+  if (service->loaded()) {
+    ResolveSearch(args[0]);
+    return;
+  }
+  pending_search_ids_.push_back(args[0].Clone());
+  if (!template_urls_loaded_subscription_) {
+    template_urls_loaded_subscription_ = service->RegisterOnLoadedCallback(
+        base::BindOnce(&SetupHandler::OnTemplateURLsLoaded,
+                       weak_ptr_factory_.GetWeakPtr()));
+    service->Load();
+  }
+}
+
+void SetupHandler::OnTemplateURLsLoaded() {
+  template_urls_loaded_subscription_ = {};
+  std::vector<base::Value> ids = std::move(pending_search_ids_);
+  pending_search_ids_.clear();
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  for (const base::Value& id : ids) {
+    ResolveSearch(id);
+  }
+}
+
+void SetupHandler::ResolveSearch(const base::Value& callback_id) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile_);
+  const TemplateURL* current = service->GetDefaultSearchProvider();
+  base::ListValue engines;
+  for (const TemplateURL* url : service->GetTemplateURLs()) {
+    if (!IsListable(service, url) && url != current) {
+      continue;
+    }
+    base::DictValue entry;
+    entry.Set("keyword", base::UTF16ToUTF8(url->keyword()));
+    entry.Set("name", base::UTF16ToUTF8(url->short_name()));
+    engines.Append(std::move(entry));
+  }
+  base::DictValue result;
+  result.Set("engines", std::move(engines));
+  result.Set("current",
+             current ? base::UTF16ToUTF8(current->keyword()) : std::string());
+  result.Set("suggest",
+             profile_->GetPrefs()->GetBoolean(prefs::kSearchSuggestEnabled));
+  ResolveJavascriptCallback(callback_id, result);
+}
+
+void SetupHandler::HandleSetSearchEngine(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::STRING)) {
+    return;
+  }
+  AllowJavascript();
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile_);
+  bool ok = false;
+  if (service && service->loaded()) {
+    TemplateURL* url = service->GetTemplateURLForKeyword(
+        base::UTF8ToUTF16(args[1].GetString()));
+    if (url && url == service->GetDefaultSearchProvider()) {
+      // The engine getSearch listed as current: already selected (no-op).
+      ok = true;
+    } else if (url && IsListable(service, url)) {
+      service->SetUserSelectedDefaultSearchProvider(url);
+      ok = true;
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(ok));
+}
+
+void SetupHandler::HandleSetSuggest(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::BOOLEAN)) {
+    return;
+  }
+  AllowJavascript();
+  profile_->GetPrefs()->SetBoolean(prefs::kSearchSuggestEnabled,
+                                   args[1].GetBool());
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+// --- notes folder: the pref of chrome://notes, picked the same way ---
+
+void SetupHandler::HandlePickVault(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  // The folder picker only opens from a user gesture (click on the button),
+  // and one at a time.
+  if (select_file_dialog_ ||
+      !web_ui()->GetRenderFrameHost()->HasTransientUserActivation()) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  pick_callback_id_ = args[0].Clone();
+  content::WebContents* web_contents = web_ui()->GetWebContents();
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents));
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+      profile_->GetPrefs()->GetFilePath(aerographene::notes::kVaultPathPref),
+      nullptr, 0, base::FilePath::StringType(),
+      web_contents->GetTopLevelNativeWindow(), nullptr);
+}
+
+void SetupHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                int /*index*/) {
+  select_file_dialog_ = nullptr;
+  if (file.path().IsAbsolute()) {
+    profile_->GetPrefs()->SetFilePath(aerographene::notes::kVaultPathPref,
+                                      file.path());
+  }
+  if (IsJavascriptAllowed() && !pick_callback_id_.is_none()) {
+    ResolveJavascriptCallback(pick_callback_id_, VaultInfo());
+  }
+  pick_callback_id_ = base::Value();
+}
+
+void SetupHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  if (IsJavascriptAllowed() && !pick_callback_id_.is_none()) {
+    ResolveJavascriptCallback(pick_callback_id_, base::Value());
+  }
+  pick_callback_id_ = base::Value();
+}
+
+// --- default browser: shell_integration ---
+
+bool SetupHandler::CanSetDefaultBrowser() const {
+  const shell_integration::DefaultWebClientSetPermission permission =
+      shell_integration::GetDefaultBrowserSetPermission();
+  return permission == shell_integration::SET_DEFAULT_UNATTENDED ||
+         permission == shell_integration::SET_DEFAULT_INTERACTIVE;
+}
+
+void SetupHandler::HandleGetDefaultBrowser(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartCheckIsDefault(
+          base::BindOnce(&SetupHandler::OnDefaultBrowserState,
+                         weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SetupHandler::HandleSetDefaultBrowser(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  if (!CanSetDefaultBrowser()) {
+    OnDefaultBrowserState(args[0].Clone(),
+                          shell_integration::UNKNOWN_DEFAULT);
+    return;
+  }
+  // Runs on a blocking sequence; the worker re-checks the state afterwards
+  // and reports it, so the page shows what the system really says.
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartSetAsDefault(
+          base::BindOnce(&SetupHandler::OnDefaultBrowserState,
+                         weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SetupHandler::OnDefaultBrowserState(
+    base::Value callback_id,
+    shell_integration::DefaultWebClientState state) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue result;
+  result.Set("canSet", CanSetDefaultBrowser());
+  result.Set("isDefault", state == shell_integration::IS_DEFAULT);
+  ResolveJavascriptCallback(callback_id, result);
+}
+
+// --- import and finish ---
+
+void SetupHandler::HandleOpenImport(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  // The import page of settings (the existing importer), in a new tab: this
+  // page stays open until the user finishes.
+  const GURL url(std::string(chrome::kChromeUISettingsURL) +
+                 std::string(chrome::kImportDataSubPage));
+  web_ui()->GetWebContents()->OpenURL(
+      content::OpenURLParams(url, content::Referrer(),
+                             WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                             ui::PAGE_TRANSITION_LINK,
+                             /*is_renderer_initiated=*/false),
+      /*navigation_handle_callback=*/{});
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
+
+void SetupHandler::HandleComplete(const base::ListValue& args) {
+  if (!CheckArgs(args, base::Value::Type::NONE)) {
+    return;
+  }
+  AllowJavascript();
+  profile_->GetPrefs()->SetBoolean(prefs::kAerographeneOnboardingCompleted,
+                                   true);
+  ResolveJavascriptCallback(args[0], base::Value(true));
+  // The setup tab becomes the new tab page.
+  web_ui()->GetWebContents()->GetController().LoadURLWithParams(
+      content::NavigationController::LoadURLParams(
+          GURL(chrome::kChromeUINewTabURL)));
+}
+
+}  // namespace aerographene::setup
