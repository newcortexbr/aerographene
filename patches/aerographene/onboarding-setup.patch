+#include "services/network/public/mojom/content_security_policy.mojom.h"
+
+bool AeroSetupUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return !browser_context->IsOffTheRecord();
+}
+
+AeroSetupUI::AeroSetupUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, kAeroSetupHost);
+  source->AddResourcePath("setup.css", IDR_AERO_SETUP_CSS);
+  source->AddResourcePath("setup.js", IDR_AERO_SETUP_JS);
+  source->AddResourcePath("wordmark.svg", IDR_AERO_SETUP_WORDMARK_SVG);
+  source->SetDefaultResource(IDR_AERO_SETUP_HTML);
+
+  // The page reads and writes only the few settings it shows, through this
+  // handler; WebUI bindings (so these messages) exist only in this renderer.
+  web_ui->AddMessageHandler(
+      std::make_unique<aerographene::setup::SetupHandler>(profile));
+
+  // Strict policy on top of the WebUI defaults: nothing outside the page
+  // itself, no network, no inline script or style, no remote font or image.
+  using network::mojom::CSPDirectiveName;
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::DefaultSrc,
+                                        "default-src 'none';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::ScriptSrc,
+                                        "script-src 'self';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::StyleSrc,
+                                        "style-src 'self';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::ImgSrc,
+                                        "img-src 'self';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::ConnectSrc,
+                                        "connect-src 'none';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::FormAction,
+                                        "form-action 'none';");
+  source->OverrideContentSecurityPolicy(CSPDirectiveName::BaseURI,
+                                        "base-uri 'none';");
+}
+
+AeroSetupUI::~AeroSetupUI() = default;
