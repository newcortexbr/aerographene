+class PinnedModel;
+
+// Context menu of a pinned entry or of a drawer folder, shared by the topbar
+// row and the sidebar grid (both read the same PinnedModel).
+//  - pinned: open, move to folder (submenu with the drawers, a new one, or out
+//    of the drawer), rename, unpin;
+//  - folder: rename, new folder, delete (its entries go to the top level).
+// Owned by the view that shows it; one menu at a time.
+class PinnedContextMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  // `open_callback` activates or reopens an entry in the window of `browser`.
+  using OpenCallback = base::RepeatingCallback<void(const base::Uuid&)>;
+
+  PinnedContextMenu(BrowserWindowInterface* browser,
+                    OpenCallback open_callback);
+  PinnedContextMenu(const PinnedContextMenu&) = delete;
+  PinnedContextMenu& operator=(const PinnedContextMenu&) = delete;
+  ~PinnedContextMenu() override;
+
+  // `screen_point` is in screen coordinates. Does nothing if the entry is gone
+  // or the model is not loaded.
+  void Show(views::Widget* parent,
+            const base::Uuid& uuid,
+            const gfx::Point& screen_point,
+            ui::mojom::MenuSourceType source_type);
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  PinnedModel* GetModel() const;
+  // Index in this window's tab strip of the live tab of the entry, or -1.
+  int FindLiveTab(PinnedModel* model) const;
+  void Unpin(PinnedModel* model);
+  void DeleteFolder(PinnedModel* model);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const OpenCallback open_callback_;
+  base::Uuid uuid_;
+  gfx::NativeWindow parent_window_ = gfx::NativeWindow();
