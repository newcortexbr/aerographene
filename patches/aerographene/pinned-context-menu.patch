+}  // namespace
+
+PinnedContextMenu::PinnedContextMenu(BrowserWindowInterface* browser,
+                                     OpenCallback open_callback)
+    : browser_(browser), open_callback_(std::move(open_callback)) {}
+
+PinnedContextMenu::~PinnedContextMenu() = default;
+
+PinnedModel* PinnedContextMenu::GetModel() const {
+  return browser_ ? PinnedModelFactory::GetForProfile(browser_->GetProfile())
+                  : nullptr;
+}
+
+void PinnedContextMenu::Show(views::Widget* parent,
+                             const base::Uuid& uuid,
+                             const gfx::Point& screen_point,
+                             ui::mojom::MenuSourceType source_type) {
+  PinnedModel* const model = GetModel();
+  if (!parent || !model || !model->IsLoaded()) {
+    return;
+  }
+  const std::optional<PinnedItem> item = model->Find(uuid);
+  if (!item) {
+    return;
+  }
+  uuid_ = uuid;
+  parent_window_ = parent->GetNativeWindow();
+  folders_.clear();
+  folder_model_.reset();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+
+  if (item->is_folder) {
+    menu_model_->AddItemWithStringIdAndIcon(
+        kRename, IDS_AEROGRAPHENE_RENAME_FOLDER, Icon(vector_icons::kEditIcon));
+    menu_model_->AddItemWithStringIdAndIcon(
+        kNewFolder, IDS_AEROGRAPHENE_NEW_FOLDER, Icon(vector_icons::kAdd2Icon));
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItemWithStringIdAndIcon(
+        kDeleteFolder, IDS_AEROGRAPHENE_DELETE_FOLDER,
+        Icon(views::kDeleteIcon));
+  } else {
+    menu_model_->AddItemWithStringIdAndIcon(
+        kOpen, IDS_AEROGRAPHENE_OPEN_PINNED, Icon(::kOpenInNewIcon));
+    if (FindLiveTab(model) >= 0) {
+      menu_model_->AddItemWithStringIdAndIcon(
+          kClose, IDS_TAB_CXMENU_CLOSETAB, Icon(vector_icons::kCloseIcon));
+    }
+
+    // Move to folder: the other drawers, a new one, or out of the drawer.
+    folder_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    const base::Uuid current_folder = model->GetParentFolder(uuid);
+    for (const PinnedItem& top : model->GetPinned()) {
+      if (!top.is_folder || top.uuid == current_folder) {
+        continue;
+      }
+      folder_model_->AddItemWithIcon(
+          kFolderBase + static_cast<int>(folders_.size()), GetName(top),
+          Icon(vector_icons::kFolderFlippableIcon));
+      folders_.push_back(top.uuid);
+    }
+    if (!folders_.empty()) {
+      folder_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    }
+    folder_model_->AddItemWithStringIdAndIcon(
+        kMoveToNewFolder, IDS_AEROGRAPHENE_NEW_PINNED_FOLDER,
+        Icon(vector_icons::kAdd2Icon));
+    if (current_folder.is_valid()) {
+      folder_model_->AddItemWithStringIdAndIcon(
+          kMoveOutOfFolder, IDS_AEROGRAPHENE_MOVE_PINNED_TO_ROOT,
+          Icon(vector_icons::kFolderOpenIcon));
+    }
+    menu_model_->AddSubMenuWithStringIdAndIcon(
+        kMoveToFolder, IDS_AEROGRAPHENE_MOVE_PINNED_TO_FOLDER,
+        folder_model_.get(), Icon(vector_icons::kFolderFlippableIcon));
+    menu_model_->AddItemWithStringIdAndIcon(
+        kRename, IDS_AEROGRAPHENE_RENAME_PINNED, Icon(vector_icons::kEditIcon));
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItemWithStringIdAndIcon(
+        kUnpin, IDS_TAB_CXMENU_UNPIN_TAB, Icon(views::kKeepFilledIcon));
+  }
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(parent, nullptr, gfx::Rect(screen_point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void PinnedContextMenu::ExecuteCommand(int command_id, int event_flags) {
+  PinnedModel* const model = GetModel();
+  if (!model || !model->IsLoaded() || !model->Contains(uuid_)) {
+    return;
+  }
+  if (command_id >= kFolderBase) {
+    const size_t position = static_cast<size_t>(command_id - kFolderBase);
+    if (position >= folders_.size()) {
+      return;
+    }
+    const base::Uuid folder = folders_[position];
+    const std::optional<PinnedItem> target = model->Find(folder);
+    if (!target) {
+      return;
+    }
+    PinnedModel::ScopedBatch batch(model);
+    model->Move(uuid_, folder, target->children.size());
+    model->SetExpanded(folder, true);
+    return;
+  }
+  switch (command_id) {
+    case kOpen:
+      open_callback_.Run(uuid_);
+      break;
+    case kMoveToNewFolder:
+      model->MoveIntoNewFolder(
+          uuid_, l10n_util::GetStringUTF16(
+                     IDS_AEROGRAPHENE_PINNED_FOLDER_DEFAULT_TITLE));
+      break;
+    case kMoveOutOfFolder:
+      model->MoveToTopLevel(uuid_);
+      break;
+    case kRename:
+      ShowRenamePinnedDialog(browser_->GetProfile(), uuid_, std::u16string(),
+                             parent_window_);
+      break;
+    case kUnpin:
+      Unpin(model);
+      break;
+    case kClose:
+      if (const int tab_index = FindLiveTab(model); tab_index >= 0) {
+        // Closing the pinned tab keeps the entry, as a closed pinned.
+        browser_->GetTabStripModel()->CloseWebContentsAt(
+            tab_index, CLOSE_USER_GESTURE | CLOSE_CREATE_HISTORICAL_TAB);
+      }
+      break;
+    case kNewFolder:
+      model->AddFolder(l10n_util::GetStringUTF16(
+                           IDS_AEROGRAPHENE_PINNED_FOLDER_DEFAULT_TITLE),
+                       std::numeric_limits<size_t>::max());
+      break;
+    case kDeleteFolder:
+      DeleteFolder(model);
+      break;
+    default:
+      break;
+  }
+}
+
+int PinnedContextMenu::FindLiveTab(PinnedModel* model) const {
+  TabStripModel* const tab_strip_model = browser_->GetTabStripModel();
+  PinnedTabMirror* const mirror = model->tab_mirror();
+  if (!tab_strip_model || !mirror) {
+    return -1;
+  }
+  for (int i = 0; i < tab_strip_model->count(); ++i) {
+    const std::optional<base::Uuid> entry =
+        mirror->GetEntryForTab(tab_strip_model->GetTabAtIndex(i));
+    if (entry && *entry == uuid_) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+void PinnedContextMenu::Unpin(PinnedModel* model) {
+  // Open in this window: unpin the tab, the mirror then removes the entry
+  // (pinned tab and entry are the same element). Otherwise just drop the entry.
+  if (const int tab_index = FindLiveTab(model); tab_index >= 0) {
+    browser_->GetTabStripModel()->SetTabPinned(tab_index, false);
+    return;
+  }
+  model->Remove(uuid_);
+}
+
+void PinnedContextMenu::DeleteFolder(PinnedModel* model) {
+  const std::optional<PinnedItem> folder = model->Find(uuid_);
+  if (!folder || !folder->is_folder) {
+    return;
+  }
+  // The entries are kept: they go to the top level where the folder was.
+  PinnedModel::ScopedBatch batch(model);
+  const int index = model->GetTopLevelIndex(uuid_);
+  size_t at = index >= 0 ? static_cast<size_t>(index) + 1
+                         : std::numeric_limits<size_t>::max();
+  for (const PinnedItem& child : folder->children) {
+    model->Move(child.uuid, base::Uuid(), at);
+    if (at != std::numeric_limits<size_t>::max()) {
+      ++at;
+    }
+  }
+  model->Remove(uuid_);
+}
+
+void WritePinnedDragData(const base::Uuid& uuid, ui::OSExchangeData* data) {
+  data->SetString(base::StrCat(
+      {std::u16string_view(kDragPrefix),
+       base::UTF8ToUTF16(uuid.AsLowercaseString())}));
+}
+
+std::optional<base::Uuid> ReadPinnedDragData(const ui::OSExchangeData& data) {
+  const std::optional<std::u16string> text = data.GetString();
+  const std::u16string_view prefix(kDragPrefix);
+  if (!text || !base::StartsWith(*text, prefix)) {
+    return std::nullopt;
+  }
+  const base::Uuid uuid = base::Uuid::ParseCaseInsensitive(
+      base::UTF16ToUTF8(text->substr(prefix.size())));
+  return uuid.is_valid() ? std::optional<base::Uuid>(uuid) : std::nullopt;
+}
+
+bool CanDropPinnedIntoFolder(PinnedModel* model,
+                             const ui::OSExchangeData& data,
+                             const base::Uuid& folder) {
+  if (!model || !model->IsLoaded()) {
+    return false;
+  }
+  const std::optional<base::Uuid> uuid = ReadPinnedDragData(data);
+  if (!uuid) {
+    return false;
+  }
+  const std::optional<PinnedItem> item = model->Find(*uuid);
+  const std::optional<PinnedItem> target = model->Find(folder);
+  return item && !item->is_folder && target && target->is_folder &&
+         model->GetParentFolder(*uuid) != folder;
+}
+
+bool DropPinnedIntoFolder(PinnedModel* model,
+                          const ui::OSExchangeData& data,
+                          const base::Uuid& folder) {
+  if (!CanDropPinnedIntoFolder(model, data, folder)) {
+    return false;
+  }
+  const std::optional<PinnedItem> target = model->Find(folder);
+  PinnedModel::ScopedBatch batch(model);
+  const bool moved = model->Move(*ReadPinnedDragData(data), folder,
+                                 target->children.size());
+  if (moved) {
+    model->SetExpanded(folder, true);
+  }
+  return moved;
+}
+
+}  // namespace aerographene
