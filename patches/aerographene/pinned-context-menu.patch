+constexpr char16_t kDragPrefix[] = u"aerographene-pinned:";
+
+enum Command {
+  kOpen = 1,
+  kMoveToFolder,
+  kMoveToNewFolder,
+  kMoveOutOfFolder,
+  kRename,
+  kUnpin,
+  kClose,
+  kNewFolder,
+  kDeleteFolder,
+  // Drawers of the "Move to folder" submenu: kFolderBase + position.
+  kFolderBase = 100,
+};
+
+ui::ImageModel Icon(const gfx::VectorIcon& icon) {
+  return ui::ImageModel::FromVectorIcon(icon, ui::kColorMenuIcon,
+                                        ui::SimpleMenuModel::kDefaultIconSize);
+}
+
+std::u16string GetName(const PinnedItem& item) {
+  return item.label.empty() ? item.title : base::UTF8ToUTF16(item.label);
+}
