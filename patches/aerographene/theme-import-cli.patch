+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  // aerographene: --import-theme=<file> only shows the import dialog. No
+  // window, tab or session restore; a running instance gets it through
+  // ProcessSingleton. The dialog's keep-alive ends the process when it closes
+  // and no browser window is open.
+  if (command_line.HasSwitch(aerographene::kImportThemeSwitch)) {
+    base::FilePath file =
+        command_line.GetSwitchValuePath(aerographene::kImportThemeSwitch);
+    if (!file.empty() && !file.IsAbsolute()) {
+      file = cur_dir.Append(file);
+    }
+    // Only a regular profile is offered to apply the theme (guest and
+    // system profiles do not read the theme pref).
+    Profile* profile = privacy_safe_profile
+                           ? privacy_safe_profile->GetOriginalProfile()
+                           : nullptr;
+    if (profile && !profile->IsRegularProfile()) {
+      profile = nullptr;
+    }
+    aerographene::ShowThemeImport(
+        profile ? profile->GetPath() : base::FilePath(), file);
+    if (process_startup == chrome::startup::IsProcessStartup::kYes) {
+      startup_metric_utils::GetBrowser().SetNonBrowserUIDisplayed();
+    }
+    return true;
+  }
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
