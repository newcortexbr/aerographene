+
+#ifndef CHROME_BROWSER_UI_STARTUP_AEROGRAPHENE_THEME_IMPORT_H_
+#define CHROME_BROWSER_UI_STARTUP_AEROGRAPHENE_THEME_IMPORT_H_
+
+#include "base/files/file_path.h"
+
+namespace aerographene {
+
+// aerographene --import-theme=<file.aerotheme>: imports the theme file and
+// shows only the import dialogs (no browser window, tab or session restore).
+inline constexpr char kImportThemeSwitch[] = "import-theme";
+
+// Imports `file` with ImportThemeArchive and shows parentless views dialogs:
+// conflict (replace/cancel), then "use theme" (writes the aerographene.theme
+// pref of the profile at `profile_path`; effect at the next start) or an
+// error. Holds a keep-alive until the last dialog closes, so a process
+// started only for the import exits afterwards. An empty `profile_path`
+// (profile picker at startup, guest or other non-regular profile) imports
+// without offering to apply. A name conflict reinstalls the theme.json read
+// the first time; the file is not read again.
+// Implemented in chrome/browser/ui/views/aerographene_theme_import_dialog.cc.
+void ShowThemeImport(const base::FilePath& profile_path,
+                     const base::FilePath& file);
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_STARTUP_AEROGRAPHENE_THEME_IMPORT_H_
