aerographene: cache HTTP apaga entradas sem uso há mais de 30 dias.

Origem: aerographene (original). Licença: GPL-3.0.
Propósito: ADR 0007, fatia 5 (cold-data-cache-expire). Em
`SimpleIndex::MergeInitializingSet` (index pronto), se `cache_type_` é
`net::DISK_CACHE` (o índice é compartilhado com code cache, APP_CACHE etc.),
agenda uma vez por índice/sessão `ExpireColdEntries` com atraso de 2 min.
Ela percorre `entries_set_`, junta hashes com último uso (não nulo) mais velho
que 30 dias e chama `delegate_->DoomEntries` (mesmo caminho da eviction por
tamanho). Cookies ficam fora (outro armazenamento).
Prazo fixo de 30 dias: a pref `aerographene.cold_after_days` fica no processo
do navegador e o cache simple roda no processo de rede.
Arquivos: net/disk_cache/simple/simple_index.{h,cc}.
Dependências: nenhuma.

--- a/net/disk_cache/simple/simple_index.h
+++ b/net/disk_cache/simple/simple_index.h
@@ -253,6 +253,7 @@
 
   void StartEvictionIfNeeded();
   void EvictionDone(int result);
+  void ExpireColdEntries();
 
   void PostponeWritingToDisk();
 
@@ -286,6 +287,8 @@
   uint64_t low_watermark_ = 0;
   bool eviction_in_progress_ = false;
   base::TimeTicks eviction_start_time_;
+  // aerographene: expiracao de dado frio agendada (1 vez por indice/sessao).
+  bool cold_expire_scheduled_ = false;
 
   // This stores all the entry_hash of entries that are removed during
   // initialization.
--- a/net/disk_cache/simple/simple_index.cc
+++ b/net/disk_cache/simple/simple_index.cc
@@ -49,6 +49,13 @@
 // is left.
 constexpr uint32_t kEvictionMarginDivisor = 20;
 
+// aerographene (ADR 0007, dado frio): entradas do cache de sites sem uso ha
+// mais que isto sao apagadas. Prazo fixo; a pref aerographene.cold_after_days
+// vive no processo do navegador e nao chega aqui.
+constexpr base::TimeDelta kColdEntryMaxAge = base::Days(30);
+// Atraso apos o indice ficar pronto, para ficar fora do caminho de abertura.
+constexpr base::TimeDelta kColdExpireDelay = base::Minutes(2);
+
 constexpr uint32_t kBytesInMiB = 1024 * 1024;
 
 // This is added to the size of each entry before using the size
@@ -697,6 +704,36 @@
                            base::BindOnce(std::move(callback), net::OK));
   }
   to_run_when_initialized_.clear();
+
+  // aerographene: no maximo uma expiracao por sessao, adiada, so no cache HTTP.
+  if (cache_type_ == net::DISK_CACHE && !cold_expire_scheduled_) {
+    cold_expire_scheduled_ = true;
+    task_runner_->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SimpleIndex::ExpireColdEntries,
+                       weak_ptr_factory_.GetWeakPtr()),
+        kColdExpireDelay);
+  }
+}
+
+void SimpleIndex::ExpireColdEntries() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || cache_type_ != net::DISK_CACHE) {
+    return;
+  }
+  const base::Time cutoff = base::Time::Now() - kColdEntryMaxAge;
+  std::vector<uint64_t> entry_hashes;
+  for (const auto& entry : entries_set_) {
+    const base::Time last_used = entry.second.GetLastUsedTime();
+    // Tempo nulo = sem informacao: nao apagar.
+    if (!last_used.is_null() && last_used < cutoff) {
+      entry_hashes.push_back(entry.first);
+    }
+  }
+  if (entry_hashes.empty()) {
+    return;
+  }
+  delegate_->DoomEntries(&entry_hashes, base::DoNothing());
 }
 
