+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/aerographene_theme_icons/aerographene_theme_icons.h"
+
+#include "base/no_destructor.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/aerographene_theme_icons/vector_icons.h"
+#include "components/omnibox/browser/vector_icons.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/gfx/vector_icon_types.h"
+#include "ui/views/vector_icons.h"
+#include "ui/views/window/vector_icons/vector_icons.h"
+
+namespace aerographene_theme_icons {
+
+namespace {
+
+Theme g_theme = Theme::kDefault;
+
+// Mapas id da tabela -> ícone do tema, gerados por
+// theming/design-language/gen_theme_icons.py (modo "map").
+void AddDefaultIcons(gfx::VectorIconOverrideMap* map) {
+  // aerographene: theme-icons-default
+}
+
+void AddPixelizedIcons(gfx::VectorIconOverrideMap* map) {
+  // aerographene: theme-icons-pixelized
+}
+
+}  // namespace
+
+void ApplyTheme(std::string_view theme) {
+  g_theme = theme == "pixelized" ? Theme::kPixelized : Theme::kDefault;
+
+  static base::NoDestructor<gfx::VectorIconOverrideMap> map;
+  map->clear();
+  if (g_theme == Theme::kPixelized) {
+    AddPixelizedIcons(map.get());
+  } else {
+    AddDefaultIcons(map.get());
+  }
+  // Mapa vazio = ícones upstream, sem custo de lookup.
+  gfx::SetVectorIconOverrides(map->empty() ? nullptr : map.get());
+}
+
+Theme GetActiveTheme() {
+  return g_theme;
+}
+
+}  // namespace aerographene_theme_icons
