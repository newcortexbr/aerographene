+// aerographene: icon theme overrides, keyed by pointer. Null = upstream icons.
+const VectorIconOverrideMap* g_icon_overrides = nullptr;
+
+const VectorIcon& ResolveIcon(const VectorIcon& icon) {
+  if (!g_icon_overrides) {
+    return icon;
+  }
+  auto it = g_icon_overrides->find(&icon);
+  return it == g_icon_overrides->end() ? icon : *it->second;
+}
+
 }  // namespace
 
