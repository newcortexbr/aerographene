 }
 
+void SetVectorIconOverrides(const VectorIconOverrideMap* map) {
+  g_icon_overrides = map;
+}
+
 ImageSkia CreateVectorIcon(const IconDescription& params) {
+  if (g_icon_overrides) {
+    const VectorIcon& icon = ResolveIcon(*params.icon);
+    const VectorIcon& badge = ResolveIcon(*params.badge_icon);
+    if (&icon != &*params.icon || &badge != &*params.badge_icon) {
+      return CreateVectorIcon(
+          IconDescription(icon, params.dip_size, params.color, &badge));
+    }
+  }
+
   if (params.icon->is_empty())
     return ImageSkia();
 
