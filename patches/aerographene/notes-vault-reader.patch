+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_notes/vault_reader.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+
+namespace aerographene::notes {
+
+// D3b: the confined reader for Windows (reparse points, reserved names, ADS,
+// 8.3 names, case-insensitive compare) is D3c. Until then every call is
+// refused (kVaultReadSupported is false); there is no unconfined fallback.
+std::optional<base::FilePath> ResolveInVault(const base::FilePath& root,
+                                             std::string_view relative) {
+  return std::nullopt;
+}
+
+std::optional<std::vector<VaultEntry>> ListVaultDir(
+    const base::FilePath& root,
+    std::string_view relative) {
+  return std::nullopt;
+}
+
+std::optional<std::string> ReadVaultNote(const base::FilePath& root,
+                                         std::string_view relative) {
+  return std::nullopt;
+}
+
+}  // namespace aerographene::notes
+
+#else  // BUILDFLAG(IS_WIN)
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace aerographene::notes {
+
+namespace {
+
+bool IsValidRelative(std::string_view relative) {
+  if (relative.size() > kMaxRelativePathLength ||
+      relative.find('\0') != std::string_view::npos) {
+    return false;
+  }
+  if (relative.empty()) {
+    return true;
+  }
+  if (relative.front() == '/') {
+    return false;
+  }
+  for (std::string_view part : base::SplitStringPiece(
+           relative, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part.empty() || part == "." || part == "..") {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool HasExtension(const base::FilePath& path,
+                  std::initializer_list<std::string_view> exts) {
+  const std::string ext = base::ToLowerASCII(path.FinalExtension());
+  return std::ranges::any_of(exts,
+                             [&](std::string_view e) { return ext == e; });
+}
+
+bool IsNote(const base::FilePath& path) {
+  return HasExtension(path, {".md"});
+}
+
+bool IsListable(const base::FilePath& path) {
+  return HasExtension(path, {".md", ".png", ".jpg", ".jpeg", ".gif", ".webp",
+                             ".svg"});
+}
+
+// Type and size of `path` without following a final symlink (the caller
+// already resolved it) and without opening it, so FIFOs and devices never
+// block the worker.
+std::optional<struct stat> LStat(const base::FilePath& path) {
+  struct stat st = {};
+  if (lstat(path.value().c_str(), &st) != 0) {
+    return std::nullopt;
+  }
+  return st;
+}
+
+}  // namespace
+
+std::optional<base::FilePath> ResolveInVault(const base::FilePath& root,
+                                             std::string_view relative) {
+  if (!root.IsAbsolute() || !IsValidRelative(relative)) {
+    return std::nullopt;
+  }
+  const base::FilePath real_root = base::MakeAbsoluteFilePath(root);
+  if (real_root.empty()) {
+    return std::nullopt;
+  }
+  if (relative.empty()) {
+    return real_root;
+  }
+  const base::FilePath real =
+      base::MakeAbsoluteFilePath(real_root.Append(relative));
+  if (real.empty() || !real_root.IsParent(real)) {
+    return std::nullopt;
+  }
+  return real;
+}
+
+std::optional<std::vector<VaultEntry>> ListVaultDir(
+    const base::FilePath& root,
+    std::string_view relative) {
+  std::optional<base::FilePath> dir = ResolveInVault(root, relative);
+  if (!dir || !base::DirectoryExists(*dir)) {
+    return std::nullopt;
+  }
+  const std::string prefix =
+      relative.empty() ? std::string() : std::string(relative) + "/";
+  std::vector<VaultEntry> entries;
+  base::FileEnumerator e(*dir, /*recursive=*/false,
+                         base::FileEnumerator::FILES |
+                             base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    const std::string name = p.BaseName().value();
+    if (name.empty() || name[0] == '.') {
+      continue;
+    }
+    const std::string rel = prefix + name;
+    // Re-resolve so symlinks pointing outside the vault are dropped.
+    std::optional<base::FilePath> real = ResolveInVault(root, rel);
+    if (!real) {
+      continue;
+    }
+    // Only directories and regular files; FIFOs, sockets and devices are
+    // skipped.
+    std::optional<struct stat> st = LStat(*real);
+    if (!st || !(S_ISDIR(st->st_mode) || S_ISREG(st->st_mode))) {
+      continue;
+    }
+    VaultEntry entry;
+    entry.path = rel;
+    entry.is_dir = S_ISDIR(st->st_mode);
+    if (!entry.is_dir) {
+      if (!IsListable(*real)) {
+        continue;
+      }
+      entry.size = st->st_size;
+    }
+    entries.push_back(std::move(entry));
+    if (entries.size() >= kMaxListEntries) {
+      break;
+    }
+  }
+  std::ranges::sort(entries, [](const VaultEntry& a, const VaultEntry& b) {
+    if (a.is_dir != b.is_dir) {
+      return a.is_dir;
+    }
+    return a.path < b.path;
+  });
+  return entries;
+}
+
+std::optional<std::string> ReadVaultNote(const base::FilePath& root,
+                                         std::string_view relative) {
+  std::optional<base::FilePath> path = ResolveInVault(root, relative);
+  if (!path || !IsNote(*path)) {
+    return std::nullopt;
+  }
+  // O_NONBLOCK: opening a FIFO named x.md must not wait for a writer.
+  // O_NOFOLLOW: `path` is already resolved; a symlink swapped in now is
+  // refused. fstat then requires a regular file (TOCTOU of the parents is
+  // tracked for B4).
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(path->value().c_str(),
+           O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC | O_NOCTTY)));
+  if (!fd.is_valid()) {
+    return std::nullopt;
+  }
+  struct stat st = {};
+  if (fstat(fd.get(), &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 0 ||
+      static_cast<uint64_t>(st.st_size) > kMaxNoteBytes) {
+    return std::nullopt;
+  }
+  std::string contents;
+  char buf[64 * 1024];
+  while (true) {
+    const ssize_t n = HANDLE_EINTR(read(fd.get(), buf, sizeof(buf)));
+    if (n < 0) {
+      return std::nullopt;
+    }
+    if (n == 0) {
+      break;
+    }
+    contents.append(buf, static_cast<size_t>(n));
+    if (contents.size() > kMaxNoteBytes) {
+      return std::nullopt;  // grew while reading
+    }
+  }
+  return contents;
+}
+
+}  // namespace aerographene::notes
+
+#endif  // BUILDFLAG(IS_WIN)
