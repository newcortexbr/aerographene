+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_notes/vault_reader.h"
+
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene::notes {
+namespace {
+
+class VaultReaderTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(outer_.CreateUniqueTempDir());
+    root_ = outer_.GetPath().Append("vault");
+    ASSERT_TRUE(base::CreateDirectory(root_.Append("sub")));
+    ASSERT_TRUE(base::WriteFile(root_.Append("a.md"), "# a"));
+    ASSERT_TRUE(base::WriteFile(root_.Append("sub/b.md"), "b"));
+    ASSERT_TRUE(base::WriteFile(root_.Append("img.png"), "png"));
+    ASSERT_TRUE(base::WriteFile(root_.Append("x.txt"), "txt"));
+    ASSERT_TRUE(base::WriteFile(root_.Append(".hidden.md"), "h"));
+    ASSERT_TRUE(base::WriteFile(outer_.GetPath().Append("secret.md"), "s"));
+    ASSERT_TRUE(base::CreateDirectory(outer_.GetPath().Append("outdir")));
+  }
+
+  base::ScopedTempDir outer_;
+  base::FilePath root_;
+};
+
+TEST_F(VaultReaderTest, ReadsNotesInside) {
+  EXPECT_EQ(ReadVaultNote(root_, "a.md"), "# a");
+  EXPECT_EQ(ReadVaultNote(root_, "sub/b.md"), "b");
+}
+
+TEST_F(VaultReaderTest, RejectsMalformedPaths) {
+  for (const char* p : {"/etc/passwd", "../secret.md", "sub/../a.md",
+                        "./a.md", "sub//b.md", "sub/", "..", "."}) {
+    EXPECT_FALSE(ResolveInVault(root_, p)) << p;
+    EXPECT_FALSE(ReadVaultNote(root_, p)) << p;
+  }
+  EXPECT_FALSE(ResolveInVault(root_, std::string("a.md\0x", 6)));
+  EXPECT_FALSE(ResolveInVault(root_, std::string(kMaxRelativePathLength + 1,
+                                                 'a')));
+  EXPECT_FALSE(ResolveInVault(base::FilePath("relative"), "a.md"));
+}
+
+TEST_F(VaultReaderTest, RejectsSymlinkOutside) {
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("secret.md"),
+                                       root_.Append("link.md")));
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("outdir"),
+                                       root_.Append("linkdir")));
+  EXPECT_FALSE(ReadVaultNote(root_, "link.md"));
+  EXPECT_FALSE(ListVaultDir(root_, "linkdir"));
+  auto list = ListVaultDir(root_, "");
+  ASSERT_TRUE(list);
+  for (const auto& e : *list) {
+    EXPECT_NE(e.path, "link.md");
+    EXPECT_NE(e.path, "linkdir");
+  }
+}
+
+TEST_F(VaultReaderTest, AllowsSymlinkInside) {
+  ASSERT_TRUE(base::CreateSymbolicLink(root_.Append("sub/b.md"),
+                                       root_.Append("alias.md")));
+  EXPECT_EQ(ReadVaultNote(root_, "alias.md"), "b");
+}
+
+TEST_F(VaultReaderTest, OnlyMarkdownIsReadable) {
+  EXPECT_FALSE(ReadVaultNote(root_, "img.png"));
+  EXPECT_FALSE(ReadVaultNote(root_, "x.txt"));
+  EXPECT_FALSE(ReadVaultNote(root_, "sub"));
+  EXPECT_FALSE(ReadVaultNote(root_, "missing.md"));
+}
+
+TEST_F(VaultReaderTest, FifoDoesNotBlock) {
+  // A FIFO named like a note must neither block the read nor be listed.
+  ASSERT_EQ(mkfifo(root_.Append("pipe.md").value().c_str(), 0600), 0);
+  EXPECT_FALSE(ReadVaultNote(root_, "pipe.md"));
+  auto list = ListVaultDir(root_, "");
+  ASSERT_TRUE(list);
+  for (const auto& e : *list) {
+    EXPECT_NE(e.path, "pipe.md");
+  }
+}
+
+TEST_F(VaultReaderTest, RejectsHugeNote) {
+  ASSERT_TRUE(base::WriteFile(root_.Append("big.md"),
+                              std::string(kMaxNoteBytes + 1, 'x')));
+  EXPECT_FALSE(ReadVaultNote(root_, "big.md"));
+}
+
+TEST_F(VaultReaderTest, ListsOneLevelFiltered) {
+  auto list = ListVaultDir(root_, "");
+  ASSERT_TRUE(list);
+  ASSERT_EQ(list->size(), 3u);
+  EXPECT_EQ((*list)[0].path, "sub");
+  EXPECT_TRUE((*list)[0].is_dir);
+  EXPECT_EQ((*list)[1].path, "a.md");
+  EXPECT_EQ((*list)[1].size, 3);
+  EXPECT_EQ((*list)[2].path, "img.png");
+  auto sub = ListVaultDir(root_, "sub");
+  ASSERT_TRUE(sub);
+  ASSERT_EQ(sub->size(), 1u);
+  EXPECT_EQ((*sub)[0].path, "sub/b.md");
+  EXPECT_FALSE(ListVaultDir(root_, "a.md"));
+}
+
+}  // namespace
+}  // namespace aerographene::notes
