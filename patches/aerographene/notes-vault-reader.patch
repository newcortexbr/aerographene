+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_READER_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_READER_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "build/build_config.h"
+
+// Read-only access to a notes vault (a local folder of Markdown files),
+// confined to the vault root. Paths coming from the page are untrusted:
+// relative, '/'-separated, no empty, "." or ".." components, no NUL, and
+// after resolving symlinks the result must stay inside the real root.
+// Blocking file I/O: call on a MayBlock sequence. Not wired to Mojo yet.
+namespace aerographene::notes {
+
+inline constexpr size_t kMaxRelativePathLength = 4096;
+inline constexpr size_t kMaxNoteBytes = 4 * 1024 * 1024;
+inline constexpr size_t kMaxListEntries = 5000;
+
+// False on Windows until the confined reader of D3c: there every function
+// below returns nullopt (no unconfined fallback).
+#if BUILDFLAG(IS_WIN)
+inline constexpr bool kVaultReadSupported = false;
+#else
+inline constexpr bool kVaultReadSupported = true;
+#endif
+
+struct VaultEntry {
+  std::string path;  // relative to the vault root, '/'-separated
+  bool is_dir = false;
+  int64_t size = 0;
+};
+
+// Real path of `relative` inside the real path of `root`, or nullopt when
+// the input is malformed, missing, or escapes the root (also via symlink).
+// An empty `relative` means the root itself.
+std::optional<base::FilePath> ResolveInVault(const base::FilePath& root,
+                                             std::string_view relative);
+
+// One level of `relative` (lazy tree): visible directories and files with a
+// note or image extension, directories first, then by name. Hidden entries
+// (leading '.') and symlinks resolving outside the root are skipped. At most
+// kMaxListEntries. nullopt when `relative` is not a directory in the vault.
+std::optional<std::vector<VaultEntry>> ListVaultDir(
+    const base::FilePath& root,
+    std::string_view relative);
+
+// Contents of a ".md" regular file in the vault, up to kMaxNoteBytes.
+std::optional<std::string> ReadVaultNote(const base::FilePath& root,
+                                         std::string_view relative);
+
+}  // namespace aerographene::notes
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_READER_H_
