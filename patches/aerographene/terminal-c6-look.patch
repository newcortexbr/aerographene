+void OmniboxViewViews::AeroApplyCommandLook(const std::u16string& text) {
+  // "t:" reads as a command line (monospace), "o:" as the vault search
+  // (italic); the prefix takes the link accent. Same prefix rule as the
+  // parsers (aero_terminal_command.h, aero_notes_command.h), but only the
+  // look: what Enter does is still decided by BuiltinProvider.
+  const std::u16string_view t = base::TrimWhitespace(
+      std::u16string_view(text), base::TRIM_LEADING);
+  const size_t lead = text.size() - t.size();
+  int mode = 0;
+  if (t.size() >= 2 && t[1] == u':') {
+    if (t[0] == u't' || t[0] == u'T') {
+      mode = 1;
+    } else if (t[0] == u'o' || t[0] == u'O') {
+      mode = 2;
+    }
+  }
+  if (mode != aero_command_mode_) {
+    if (aero_command_mode_ == 0) {
+      aero_base_font_list_ = GetFontList();
+    }
+    if (mode == 1) {
+      SetFontList(gfx::FontList({"monospace"}, gfx::Font::NORMAL,
+                                aero_base_font_list_->GetFontSize(),
+                                gfx::Font::Weight::NORMAL));
+    } else if (aero_base_font_list_) {
+      SetFontList(*aero_base_font_list_);
+    }
+    if (mode == 0) {
+      aero_base_font_list_.reset();
+    }
+    aero_command_mode_ = mode;
+  }
+  SetStyle(gfx::TEXT_STYLE_ITALIC, mode == 2);
+  if (mode != 0 && GetColorProvider()) {
+    ApplyColor(GetColorProvider()->GetColor(kColorOmniboxResultsUrl),
+               gfx::Range(lead, lead + 2));
+  }
 }
 
