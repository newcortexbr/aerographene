aerographene: nomes de processo legíveis no Linux (SCOPE item 9).

Origem: aerographene (original). Licença: GPL-3.0.
Propósito: ps/top mostram `aerographene` (browser), `aerographene: <space>`
(renderer), `aerographene: gpu`, `aerographene: rede`,
`aerographene: utilitário <tipo>`, `aerographene: crash handler`.
cmdline via setproctitle (já usado em base::SetProcessTitleFromCommandLine,
chamado em content_main.cc e no fork do zygote); comm (15 bytes) via
prctl(PR_SET_NAME) como `aerographene` ou `ag: <rótulo>`. O browser passa o
nome do space ao renderer em --aerographene-space. Só exibição: sem fundir
processos, sem mudar sandbox, sem RAM extra.

--- a/base/process/set_process_title.cc
+++ b/base/process/set_process_title.cc
@@ -42,6 +42,52 @@
 
 namespace base {
 
+#if BUILDFLAG(IS_LINUX)
+namespace {
+
+// aerographene: readable process names. Returns the label shown after
+// "aerographene: " for the current process type ("" for the browser).
+// `short_label` is the variant used for the 15-byte comm name.
+std::string AerographeneProcessLabel(const base::CommandLine& cmd,
+                                     std::string* short_label) {
+  const std::string type = cmd.GetSwitchValueASCII("type");
+  std::string label;
+  if (type.empty()) {
+    label = "";
+    *short_label = "";
+  } else if (type == "renderer") {
+    label = cmd.GetSwitchValueNative("aerographene-space");
+    for (char& c : label) {
+      if (static_cast<unsigned char>(c) < 0x20 || c == 0x7f) {
+        c = '?';
+      }
+    }
+    if (label.empty()) {
+      label = "renderer";
+    }
+    *short_label = label;
+  } else if (type == "gpu-process") {
+    label = *short_label = "gpu";
+  } else if (type == "utility") {
+    std::string sub = cmd.GetSwitchValueASCII("utility-sub-type");
+    sub = sub.substr(0, sub.find('.'));
+    if (sub == "network") {
+      label = *short_label = "rede";
+    } else {
+      *short_label = sub.empty() ? "utilitário" : sub;
+      label = sub.empty() ? "utilitário" : "utilitário " + sub;
+    }
+  } else if (type == "crashpad-handler") {
+    label = *short_label = "crash handler";
+  } else {
+    label = *short_label = type;
+  }
+  return label;
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_LINUX)
+
 // TODO(jrg): Find out if setproctitle or equivalent is available on Android.
 #if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_APPLE) && !BUILDFLAG(IS_SOLARIS) && \
     !BUILDFLAG(IS_ANDROID) && !BUILDFLAG(IS_FUCHSIA)
@@ -95,6 +141,22 @@
 
   const base::CommandLine* command_line =
       base::CommandLine::ForCurrentProcess();
+#if BUILDFLAG(IS_LINUX)
+  // aerographene: replace the argv title and the comm name with a readable
+  // label. Only the displayed strings change; the processes are untouched.
+  {
+    std::string short_label;
+    const std::string label =
+        AerographeneProcessLabel(*command_line, &short_label);
+    std::string comm =
+        short_label.empty() ? "aerographene" : "ag: " + short_label;
+    base::TruncateUTF8ToByteSize(comm, 15, &comm);
+    prctl(PR_SET_NAME, comm.c_str());
+    setproctitle("-%s", label.empty() ? "aerographene"
+                                      : ("aerographene: " + label).c_str());
+    return;
+  }
+#endif  // BUILDFLAG(IS_LINUX)
