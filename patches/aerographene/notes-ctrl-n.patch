     case IDC_NEW_WINDOW:
       NewWindow(browser_);
       break;
+    case IDC_AERO_NEW_WINDOW_OR_NOTE: {
+      // aerographene: on the notes page (chrome://notes, normal window) Ctrl+N
+      // calls the page's own aeroNotesNewNote() (the "+ nota" button action)
+      // through the WebUI; the key never reaches the page because Ctrl+N is a
+      // reserved accelerator. Anywhere else it is a plain new window.
+      content::WebContents* active =
+          browser_->tab_strip_model()->GetActiveWebContents();
+      if (browser_->is_type_normal() && active && active->GetWebUI() &&
+          active->GetLastCommittedURL().SchemeIs(content::kChromeUIScheme) &&
+          active->GetLastCommittedURL().host_piece() == "notes") {
+        active->GetWebUI()->CallJavascriptFunctionUnsafe("aeroNotesNewNote");
+        break;
+      }
+      if (IsCommandEnabled(IDC_NEW_WINDOW)) {
+        NewWindow(browser_);
+      }
+      break;
+    }
     case IDC_NEW_INCOGNITO_WINDOW:
       NewIncognitoWindow(profile());
       break;
