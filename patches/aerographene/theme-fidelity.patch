+constexpr int kAeroThemeBarWidth = 3;
+constexpr int kAeroThemeDotSize = 6;
+constexpr int kAeroThemeDotInset = 8;
+constexpr float kAeroThemeLozenge = 4.0f;
+constexpr float kAeroThemeLozengeInset = 5.0f;
+
+void PaintAeroThemedActiveTab(gfx::Canvas* canvas,
+                              const gfx::Rect& bounds,
+                              int radius,
+                              const ui::ColorProvider& colors,
+                              SkColor line,
+                              SkColor accent) {
+  using Marker = aerographene::ActiveTabMarker;
+  const aerographene::ThemeData& theme = aerographene::GetActiveTheme();
+  const Marker kind = theme.active_tab_marker;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(colors.GetColor(ui::kColorTextSelectionBackground));
+  canvas->DrawRoundRect(bounds, radius, flags);
+  if (kind == Marker::kDot || kind == Marker::kDiamond) {
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1);
+    stroke.setColor(line);
+    gfx::RectF outline(bounds);
+    outline.Inset(0.5f);
+    canvas->DrawRoundRect(outline, radius, stroke);
+  }
+  flags.setColor(aerographene::GetThemeTokenColor(theme, "tab_marker", accent));
+  const float cy = bounds.y() + bounds.height() / 2.0f;
+  switch (kind) {
+    case Marker::kBar:
+      canvas->DrawRect(gfx::Rect(bounds.x(), bounds.y(), kAeroThemeBarWidth,
+                                 bounds.height()),
+                       flags);
+      break;
+    case Marker::kDot:
+      canvas->DrawCircle(
+          gfx::PointF(bounds.right() - kAeroThemeDotInset -
+                          kAeroThemeDotSize / 2.0f,
+                      cy),
+          kAeroThemeDotSize / 2.0f, flags);
+      break;
+    case Marker::kDiamond: {
+      const float cx = bounds.x() + kAeroThemeLozengeInset;
+      SkPathBuilder lozenge;
+      lozenge.moveTo(cx, cy - kAeroThemeLozenge);
+      lozenge.lineTo(cx + kAeroThemeLozenge, cy);
+      lozenge.lineTo(cx, cy + kAeroThemeLozenge);
+      lozenge.lineTo(cx - kAeroThemeLozenge, cy);
+      lozenge.close();
+      canvas->DrawPath(lozenge.detach(), flags);
+      break;
+    }
+    case Marker::kGradient:
+    case Marker::kBlock:
+    case Marker::kFill:
+    case Marker::kInvert:
+      break;
+  }
+}
