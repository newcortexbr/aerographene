+// CSS color of a theme token (alpha kept).
+std::string AeroCssColor(const aerographene::ThemeData& theme,
+                         const char* name,
+                         SkColor fallback) {
+  const SkColor color = aerographene::GetThemeTokenColor(theme, name, fallback);
+  return base::StringPrintf("rgba(%d,%d,%d,%.3f)", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color),
+                            SkColorGetA(color) / 255.0);
+}
+
+// Font stack for a theme family: the family (only letters, digits, space,
+// '-' and '_' are kept, so a repository theme cannot break the CSS) and a
+// generic family of its kind; empty family = the page's default stack.
+std::string AeroCssFont(const std::string& family) {
+  std::string clean;
+  for (char c : family) {
+    if (base::IsAsciiAlphaNumeric(c) || c == ' ' || c == '-' || c == '_') {
+      clean.push_back(c);
