+// Active tab marker (tab strip and sidebar), a theme property independent of
+// the drawing variant. kGradient: accent gradient and top bar (default theme
+// only); kBlock: the pixelized block (pixelized style); kFill: selection
+// fill; kBar: fill and a 3px bar on the left; kDot: fill, 1px outline and a
+// 6px dot on the right; kDiamond: fill, 1px outline and a lozenge on the left
+// edge; kInvert: selection fill with the tab text in the inverse color (the
+// theme's "tab_text" token).
+enum class ActiveTabMarker {
+  kGradient,
+  kBlock,
+  kFill,
+  kBar,
+  kDot,
+  kDiamond,
+  kInvert,
+};
