+}  // namespace
+
+struct TerminalSession::Handles {
+  base::win::ScopedHandle job;
+  base::win::ScopedHandle in_pipe;
+  base::win::ScopedHandle out_pipe;
+  HPCON pseudo_console = nullptr;
+  base::Process process;
+};
+
+TerminalSession::Options::Options() = default;
+TerminalSession::Options::Options(const Options&) = default;
+TerminalSession::Options& TerminalSession::Options::operator=(
+    const Options&) = default;
+TerminalSession::Options::~Options() = default;
