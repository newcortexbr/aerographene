+// static
+base::FilePath TerminalSession::DefaultShellPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  // PowerShell 7 from PATH (absolute entries only: never the current
+  // directory), then its default install directory.
+  if (std::optional<std::string> path = env->GetVar("PATH")) {
+    for (const std::string& dir : base::SplitString(
+             *path, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const base::FilePath p =
+          base::FilePath(base::UTF8ToWide(dir)).Append(L"pwsh.exe");
+      if (IsFile(p)) {
+        return p;
+      }
+    }
+  }
+  base::FilePath dir;
+  if (base::PathService::Get(base::DIR_PROGRAM_FILES, &dir)) {
+    const base::FilePath p = dir.Append(L"PowerShell\\7\\pwsh.exe");
+    if (IsFile(p)) {
+      return p;
+    }
+  }
+  base::FilePath system;
+  if (base::PathService::Get(base::DIR_SYSTEM, &system)) {
+    const base::FilePath p =
+        system.Append(L"WindowsPowerShell\\v1.0\\powershell.exe");
+    if (IsFile(p)) {
+      return p;
+    }
+  }
+  if (std::optional<std::string> comspec = env->GetVar("ComSpec")) {
+    const base::FilePath p(base::UTF8ToWide(*comspec));
+    if (IsFile(p)) {
+      return p;
+    }
+  }
+  if (!system.empty() && IsFile(system.Append(L"cmd.exe"))) {
+    return system.Append(L"cmd.exe");
+  }
+  return base::FilePath();
+}
+
+// static
+std::string TerminalSession::DefaultShell() {
+  return DefaultShellPath().AsUTF8Unsafe();
+}
+
+// static
+std::unique_ptr<TerminalSession> TerminalSession::Start(
+    const Options& options) {
+  if (!ValidSize(options.cols, options.rows)) {
+    return nullptr;
+  }
+  const ConPtyApi& api = Api();
+  if (!api.create) {
+    LOG(ERROR) << "ConPTY unavailable (Windows 10 1809+)";
+    return nullptr;
+  }
+
+  std::vector<std::wstring> argv;
+  for (const std::string& a : options.argv) {
+    argv.push_back(base::UTF8ToWide(a));
+  }
+  const base::FilePath shell = DefaultShellPath();
+  if (argv.empty()) {
+    if (shell.empty()) {
+      LOG(ERROR) << "no shell";
+      return nullptr;
+    }
+    argv.push_back(shell.value());
+  }
+  // Quoted the way CreateProcessW/CommandLineToArgvW parse it.
+  base::CommandLine command{base::FilePath(argv[0])};
+  for (size_t i = 1; i < argv.size(); ++i) {
+    command.AppendArgNative(argv[i]);
+  }
+  std::wstring command_line = command.GetCommandLineString();
+
+  base::FilePath home;
+  base::PathService::Get(base::DIR_HOME, &home);  // %USERPROFILE%
+  const base::FilePath cwd = options.cwd.empty() ? home : options.cwd;
+
+  Handles h;
+  // KILL_ON_JOB_CLOSE: closing the job (TerminalSession gone, browser
+  // crashed or killed) kills the shell and everything it started. No
+  // BREAKAWAY_OK, so children cannot leave it.
+  h.job.Set(::CreateJobObjectW(nullptr, nullptr));
+  if (!h.job.is_valid()) {
+    PLOG(ERROR) << "CreateJobObjectW";
+    return nullptr;
+  }
+  JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {};
+  limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+  if (!::SetInformationJobObject(h.job.get(), JobObjectExtendedLimitInformation,
+                                 &limits, sizeof(limits))) {
+    PLOG(ERROR) << "SetInformationJobObject";
+    return nullptr;
+  }
+
+  base::win::ScopedHandle console_in, console_out;
+  if (!CreateOverlappedPipe(/*browser_writes=*/true, &h.in_pipe,
+                            &console_in) ||
+      !CreateOverlappedPipe(/*browser_writes=*/false, &h.out_pipe,
+                            &console_out)) {
+    return nullptr;
+  }
+  HRESULT hr = api.create(Size(options.cols, options.rows), console_in.get(),
+                          console_out.get(), kInheritCursor,
+                          &h.pseudo_console);
+  // conhost duplicated them; ours would keep the pipes open forever.
+  console_in.Close();
+  console_out.Close();
+  if (FAILED(hr)) {
+    LOG(ERROR) << "CreatePseudoConsole: " << std::hex << hr;
+    return nullptr;
+  }
+  // From here the pseudo console must be closed on every failure path.
+  auto close_console = [&h, &api] {
+    h.in_pipe.Close();
+    h.out_pipe.Close();
+    api.close(h.pseudo_console);
+    h.pseudo_console = nullptr;
+  };
+
+  SIZE_T attr_size = 0;
+  ::InitializeProcThreadAttributeList(nullptr, 1, 0, &attr_size);
+  auto attr_storage = base::HeapArray<uint8_t>::WithSize(attr_size);
+  auto* attrs =
+      reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attr_storage.data());
+  if (!::InitializeProcThreadAttributeList(attrs, 1, 0, &attr_size)) {
+    PLOG(ERROR) << "InitializeProcThreadAttributeList";
+    close_console();
+    return nullptr;
+  }
+  if (!::UpdateProcThreadAttribute(attrs, 0, PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE,
+                                   h.pseudo_console, sizeof(HPCON), nullptr,
+                                   nullptr)) {
+    PLOG(ERROR) << "PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE";
+    ::DeleteProcThreadAttributeList(attrs);
+    close_console();
+    return nullptr;
+  }
+
+  STARTUPINFOEXW si = {};
+  si.StartupInfo.cb = sizeof(si);
+  // Zeroed STARTUPINFOEX without STARTF_USESTDHANDLES, as in the Microsoft
+  // "Creating a Pseudoconsole session" sample: the standard handles come from
+  // the pseudo console attribute only.
+  si.lpAttributeList = attrs;
+
+  base::NativeEnvironmentString env = ShellEnvironment(
+      shell.empty() ? base::FilePath(argv[0]) : shell, home);
+  PROCESS_INFORMATION pi = {};
+  // bInheritHandles = FALSE: no browser handle reaches the shell (item 7).
+  // Suspended until it is in the job, so nothing it starts escapes.
+  const BOOL ok = ::CreateProcessW(
+      nullptr, command_line.data(), nullptr, nullptr, /*bInheritHandles=*/FALSE,
+      EXTENDED_STARTUPINFO_PRESENT | CREATE_UNICODE_ENVIRONMENT |
+          CREATE_SUSPENDED,
+      env.data(), cwd.empty() ? nullptr : cwd.value().c_str(),
+      &si.StartupInfo, &pi);
+  ::DeleteProcThreadAttributeList(attrs);
+  if (!ok) {
+    PLOG(ERROR) << "CreateProcessW";
+    close_console();
+    return nullptr;
+  }
+  base::win::ScopedHandle thread(pi.hThread);
+  h.process = base::Process(pi.hProcess);
+  if (!::AssignProcessToJobObject(h.job.get(), pi.hProcess)) {
+    PLOG(ERROR) << "AssignProcessToJobObject";
+    ::TerminateProcess(pi.hProcess, 1);
+    close_console();
+    return nullptr;
+  }
+  ::ResumeThread(thread.get());
+  return base::WrapUnique(new TerminalSession(std::move(h)));
+}
+
+TerminalSession::TerminalSession(Handles handles)
+    : job_(std::move(handles.job)),
+      in_pipe_(std::move(handles.in_pipe)),
+      out_pipe_(std::move(handles.out_pipe)),
+      read_event_(::CreateEventW(nullptr, TRUE, FALSE, nullptr)),
+      write_event_(::CreateEventW(nullptr, TRUE, FALSE, nullptr)),
+      pseudo_console_(handles.pseudo_console),
+      process_(std::move(handles.process)) {
+  read_ov_.hEvent = read_event_.get();
+  write_ov_.hEvent = write_event_.get();
+  read_buf_.resize(kReadChunk);
+}
+
+TerminalSession::~TerminalSession() {
+  Terminate(base::Milliseconds(200));
+}
+
+TerminalSession::ReadResult TerminalSession::ReadSome(std::string* out,
+                                                      size_t max) {
+  if (terminated_) {
+    return ReadResult::kClosed;
+  }
+  if (read_pending_) {
+    DWORD n = 0;
+    if (!::GetOverlappedResult(out_pipe_.get(), &read_ov_, &n, FALSE)) {
+      if (::GetLastError() == ERROR_IO_INCOMPLETE) {
+        return ReadResult::kPending;
+      }
+      read_pending_ = false;
+      return ReadResult::kClosed;  // ERROR_BROKEN_PIPE: console gone
+    }
+    read_pending_ = false;
+    read_have_ = n;
+    read_taken_ = 0;
+  }
+  if (read_taken_ < read_have_) {
+    const size_t n = std::min(max, read_have_ - read_taken_);
+    out->assign(read_buf_.data() + read_taken_, n);
+    read_taken_ += n;
+    return ReadResult::kData;
+  }
+  ::ResetEvent(read_event_.get());
+  read_have_ = read_taken_ = 0;
+  if (!::ReadFile(out_pipe_.get(), read_buf_.data(),
+                  static_cast<DWORD>(read_buf_.size()), nullptr, &read_ov_) &&
+      ::GetLastError() != ERROR_IO_PENDING) {
+    return ReadResult::kClosed;
+  }
+  // Finished at once or not: the event is (or will be) signaled either way.
+  read_pending_ = true;
+  return ReadResult::kPending;
+}
+
+std::optional<size_t> TerminalSession::WriteSome(std::string_view bytes) {
+  if (terminated_) {
+    return std::nullopt;
+  }
+  if (write_pending_) {
+    DWORD n = 0;
+    if (!::GetOverlappedResult(in_pipe_.get(), &write_ov_, &n, FALSE)) {
+      if (::GetLastError() == ERROR_IO_INCOMPLETE) {
+        return 0;
+      }
+      write_pending_ = false;
+      return std::nullopt;
+    }
+    write_pending_ = false;
+  }
+  if (bytes.empty()) {
+    return 0;
+  }
+  // The buffer must outlive the overlapped write.
+  write_buf_.assign(bytes.substr(0, kWriteChunk));
+  ::ResetEvent(write_event_.get());
+  if (!::WriteFile(in_pipe_.get(), write_buf_.data(),
+                   static_cast<DWORD>(write_buf_.size()), nullptr,
+                   &write_ov_) &&
+      ::GetLastError() != ERROR_IO_PENDING) {
+    return std::nullopt;
+  }
+  write_pending_ = true;
+  return write_buf_.size();
+}
+
+bool TerminalSession::Resize(uint16_t cols, uint16_t rows) {
+  if (terminated_ || !ValidSize(cols, rows)) {
+    return false;
+  }
+  return SUCCEEDED(Api().resize(static_cast<HPCON>(pseudo_console_),
+                                Size(cols, rows)));
+}
+
+std::string TerminalSession::ForegroundProcessName() const {
+  if (terminated_) {
+    return std::string();
+  }
+  // Up to 64 pids; the list is in creation order, the last is the newest.
+  struct {
+    JOBOBJECT_BASIC_PROCESS_ID_LIST list;
+    ULONG_PTR more[63];
+  } ids = {};
+  if (!::QueryInformationJobObject(job_.get(), JobObjectBasicProcessIdList,
+                                   &ids, sizeof(ids), nullptr) &&
+      ::GetLastError() != ERROR_MORE_DATA) {
+    return std::string();
+  }
+  const DWORD count = std::min<DWORD>(ids.list.NumberOfProcessIdsInList, 64);
+  if (count == 0) {
+    return std::string();
+  }
+  const ULONG_PTR* pids = ids.list.ProcessIdList;
+  base::win::ScopedHandle p(::OpenProcess(
+      PROCESS_QUERY_LIMITED_INFORMATION, FALSE,
+      static_cast<DWORD>(pids[count - 1])));
+  if (!p.is_valid()) {
+    return std::string();
+  }
+  wchar_t path[MAX_PATH];
+  DWORD size = MAX_PATH;
+  if (!::QueryFullProcessImageNameW(p.get(), 0, path, &size)) {
+    return std::string();
+  }
+  std::wstring name =
+      base::FilePath(std::wstring(path, size)).BaseName().value();
+  if (base::EndsWith(name, L".exe", base::CompareCase::INSENSITIVE_ASCII)) {
+    name.resize(name.size() - 4);
+  }
+  std::string out;
+  for (wchar_t c : name) {
+    if (out.size() == 15) {
+      break;
+    }
+    out.push_back(c >= 0x20 && c <= 0x7e ? static_cast<char>(c) : '?');
+  }
+  return out;
+}
+
+void TerminalSession::CancelIo() {
+  DWORD n = 0;
+  if (read_pending_) {
+    ::CancelIoEx(out_pipe_.get(), &read_ov_);
+    ::GetOverlappedResult(out_pipe_.get(), &read_ov_, &n, TRUE);
+    read_pending_ = false;
+  }
+  if (write_pending_) {
+    ::CancelIoEx(in_pipe_.get(), &write_ov_);
+    ::GetOverlappedResult(in_pipe_.get(), &write_ov_, &n, TRUE);
+    write_pending_ = false;
+  }
+}
+
+std::optional<int> TerminalSession::Terminate(base::TimeDelta grace) {
+  (void)grace;
+  if (terminated_) {
+    return std::nullopt;
+  }
+  terminated_ = true;
+  // No SIGHUP on Windows: the graceful path (ClosePseudoConsole's
+  // CTRL_CLOSE_EVENT) can hold the caller for seconds on Windows 10, so kill
+  // the whole job first; nothing is waited for politely.
+  ::TerminateJobObject(job_.get(), 1);
+  // Bounded: a process stuck in the kernel must not hang shutdown.
+  ::WaitForSingleObject(process_.Handle(), 2000);
+  CancelIo();
+  // Pipes first: with our read end closed, ClosePseudoConsole never waits for
+  // the console to flush into a full output pipe.
+  in_pipe_.Close();
+  out_pipe_.Close();
+  if (pseudo_console_) {
+    Api().close(static_cast<HPCON>(pseudo_console_));
+    pseudo_console_ = nullptr;
+  }
+  std::optional<int> result;
+  DWORD code = 0;
+  if (::WaitForSingleObject(process_.Handle(), 0) == WAIT_OBJECT_0 &&
+      ::GetExitCodeProcess(process_.Handle(), &code)) {
+    result = static_cast<int>(code);
+  }
+  job_.Close();  // KILL_ON_JOB_CLOSE: anything left dies here
+  return result;
+}
+
