+
+// Hands out every finished read, then leaves one read pending and watches
+// its event. Paused (read_watch reset, like on Linux) once
+// kMaxUnackedOutput is reached; Ack() calls this again.
+void TerminalHost::WatchReadable(int32_t id, Entry& entry) {
+  if (!entry.read_watch) {
+    entry.read_watch = std::make_unique<Watch>(base::BindRepeating(
+        &TerminalHost::OnReadable, base::Unretained(this), id));
+  }
+  while (entry.unacked < kMaxUnackedOutput) {
+    std::string buf;
+    switch (entry.session->ReadSome(&buf, kReadChunk)) {
+      case TerminalSession::ReadResult::kData:
+        entry.unacked += buf.size();
+        on_output_.Run(id, std::move(buf));
+        continue;
+      case TerminalSession::ReadResult::kPending:
+        entry.read_watch->Start(entry.session->read_event());
+        return;
+      case TerminalSession::ReadResult::kClosed:
+        // The console is gone; the process watch reports the exit.
+        entry.read_watch.reset();
+        return;
+    }
+  }
+  // The page is behind: stop until it acknowledges.
+  entry.read_watch.reset();
+}
+
+void TerminalHost::OnReadable(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it != sessions_.end()) {
+    WatchReadable(id, *it->second);
+  }
+}
+
+void TerminalHost::OnProcessExited(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it == sessions_.end() || it->second->exiting) {
+    return;
+  }
+  // The console may still be rendering the shell's last output.
+  it->second->exiting = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TerminalHost::FinishExit, weak_factory_.GetWeakPtr(),
+                     id),
+      base::Milliseconds(100));
+}
+
+void TerminalHost::FinishExit(int32_t id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return;  // closed meanwhile
+  }
+  Entry& entry = *it->second;
+  entry.read_watch.reset();
+  entry.write_watch.reset();
+  entry.exit_watch.reset();
+  const int code =
+      entry.session->Terminate(base::Milliseconds(0)).value_or(-1);
+  sessions_.erase(it);
+  on_exit_.Run(id, code);
+}
