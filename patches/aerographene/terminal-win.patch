+// Resolved at run time: the browser must still start on a Windows without
+// ConPTY (the terminal then just fails to open).
+using CreatePseudoConsoleFn = HRESULT(WINAPI*)(COORD, HANDLE, HANDLE, DWORD,
+                                               HPCON*);
+using ResizePseudoConsoleFn = HRESULT(WINAPI*)(HPCON, COORD);
+using ClosePseudoConsoleFn = void(WINAPI*)(HPCON);
+
+struct ConPtyApi {
+  CreatePseudoConsoleFn create = nullptr;
+  ResizePseudoConsoleFn resize = nullptr;
+  ClosePseudoConsoleFn close = nullptr;
+};
+
+const ConPtyApi& Api() {
+  static const ConPtyApi api = [] {
+    ConPtyApi a;
+    if (HMODULE k = ::GetModuleHandleW(L"kernel32.dll")) {
+      a.create = reinterpret_cast<CreatePseudoConsoleFn>(
+          ::GetProcAddress(k, "CreatePseudoConsole"));
+      a.resize = reinterpret_cast<ResizePseudoConsoleFn>(
+          ::GetProcAddress(k, "ResizePseudoConsole"));
+      a.close = reinterpret_cast<ClosePseudoConsoleFn>(
+          ::GetProcAddress(k, "ClosePseudoConsole"));
+    }
+    if (!a.create || !a.resize || !a.close) {
+      a = ConPtyApi();
+    }
+    return a;
+  }();
+  return api;
+}
+
+// The console asks for the cursor position (DSR) and keeps what is already
+// on screen: the page prints the banner before the shell starts.
+constexpr DWORD kInheritCursor = 0x1;  // PSEUDOCONSOLE_INHERIT_CURSOR
+
+bool ValidSize(uint16_t cols, uint16_t rows) {
+  return cols > 0 && rows > 0 && cols <= TerminalSession::kMaxCols &&
+         rows <= TerminalSession::kMaxRows;
+}
+
+COORD Size(uint16_t cols, uint16_t rows) {
+  return {static_cast<SHORT>(cols), static_cast<SHORT>(rows)};
+}
+
+bool IsFile(const base::FilePath& p) {
+  return p.IsAbsolute() && base::PathExists(p) && !base::DirectoryExists(p);
+}
+
+// One overlapped pipe: the browser end (overlapped, never inheritable) and
+// the end handed to CreatePseudoConsole (synchronous, closed right after;
+// conhost keeps its own duplicate). Random name, single instance, local
+// clients only, default DACL (this user, SYSTEM, administrators).
+bool CreateOverlappedPipe(bool browser_writes,
+                          base::win::ScopedHandle* browser_end,
+                          base::win::ScopedHandle* console_end) {
+  const std::wstring name = base::StrCat(
+      {L"\\\\.\\pipe\\aerographene-terminal-",
+       base::NumberToWString(::GetCurrentProcessId()), L"-",
+       base::NumberToWString(base::RandUint64())});
+  const DWORD open_mode =
+      (browser_writes ? PIPE_ACCESS_OUTBOUND : PIPE_ACCESS_INBOUND) |
+      FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE;
+  browser_end->Set(::CreateNamedPipeW(
+      name.c_str(), open_mode,
+      PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT |
+          PIPE_REJECT_REMOTE_CLIENTS,
+      1, 64 * 1024, 64 * 1024, 0, nullptr));
+  if (!browser_end->is_valid()) {
+    PLOG(ERROR) << "CreateNamedPipeW";
+    return false;
+  }
+  console_end->Set(::CreateFileW(
+      name.c_str(), browser_writes ? GENERIC_READ : GENERIC_WRITE, 0, nullptr,
+      OPEN_EXISTING, 0, nullptr));
+  if (!console_end->is_valid()) {
+    PLOG(ERROR) << "CreateFileW pipe";
+    return false;
+  }
+  return true;
+}
+
+// Environment of the shell: what Windows programs need to work, no browser
+// specific variable. Values from the browser's environment.
+base::NativeEnvironmentString ShellEnvironment(const base::FilePath& shell,
+                                               const base::FilePath& home) {
+  static constexpr const wchar_t* kKeep[] = {
+      L"ALLUSERSPROFILE",   L"APPDATA",
+      L"CommonProgramFiles", L"CommonProgramFiles(x86)",
+      L"CommonProgramW6432", L"COMPUTERNAME",
+      L"ComSpec",           L"HOMEDRIVE",
+      L"HOMEPATH",          L"LOCALAPPDATA",
+      L"NUMBER_OF_PROCESSORS", L"OS",
+      L"Path",              L"PATHEXT",
+      L"PROCESSOR_ARCHITECTURE", L"PROCESSOR_IDENTIFIER",
+      L"PROCESSOR_LEVEL",   L"PROCESSOR_REVISION",
+      L"ProgramData",       L"ProgramFiles",
+      L"ProgramFiles(x86)", L"ProgramW6432",
+      L"PUBLIC",            L"SystemDrive",
+      L"SystemRoot",        L"TEMP",
+      L"TMP",               L"USERDOMAIN",
+      L"USERNAME",          L"windir",
+  };
+  base::EnvironmentMap env;
+  for (const wchar_t* name : kKeep) {
+    const DWORD n = ::GetEnvironmentVariableW(name, nullptr, 0);
+    if (n == 0) {
+      continue;
+    }
+    std::wstring value(n, L'\0');
+    const DWORD got = ::GetEnvironmentVariableW(name, value.data(), n);
+    if (got == 0 || got >= n) {
+      continue;
+    }
+    value.resize(got);
+    env[name] = value;
+  }
+  env[L"USERPROFILE"] = home.value();
+  env[L"TERM"] = L"xterm-256color";
+  env[L"COLORTERM"] = L"truecolor";
+  env[L"SHELL"] = shell.value();
+  // AlterEnvironment over an empty block: only `env` remains, sorted, as
+  // CreateProcessW wants it.
+  static constexpr wchar_t kEmpty[] = {L'\0', L'\0'};
+  return base::internal::AlterEnvironment(base::span<const wchar_t>(kEmpty),
+                                          env);
+}
