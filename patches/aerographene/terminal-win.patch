+namespace aerographene {
+namespace {
+
+constexpr char kDsr[] = "\x1b[6n";       // PSEUDOCONSOLE_INHERIT_CURSOR asks
+constexpr char kDsrReply[] = "\x1b[1;1R";  // what xterm.js answers
+
+std::string Cmd() {
+  wchar_t sys[MAX_PATH];
+  const UINT n = ::GetSystemDirectoryW(sys, MAX_PATH);
+  return base::FilePath(std::wstring(sys, n)).Append(L"cmd.exe").AsUTF8Unsafe();
+}
+
+std::unique_ptr<TerminalSession> StartCmd(const std::string& script,
+                                          uint16_t cols = 80,
+                                          uint16_t rows = 24) {
+  TerminalSession::Options o;
+  o.argv = {Cmd(), "/d", "/c", script};
+  o.cols = cols;
+  o.rows = rows;
+  return TerminalSession::Start(o);
+}
+
+// Reads (polling the overlapped read) until `needle` shows up, the console
+// goes away, or timeout. Answers the console's cursor query like xterm.js.
+std::string ReadUntil(TerminalSession& s, std::string_view needle,
+                      base::TimeDelta timeout = base::Seconds(10)) {
+  std::string out;
+  bool answered = false;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + timeout;
+  while (out.find(needle) == std::string::npos &&
+         base::TimeTicks::Now() < deadline) {
+    std::string buf;
+    const TerminalSession::ReadResult r =
+        s.ReadSome(&buf, TerminalSession::kReadChunk);
+    if (r == TerminalSession::ReadResult::kClosed) {
+      break;
+    }
+    if (r == TerminalSession::ReadResult::kPending) {
+      ::WaitForSingleObject(s.read_event(), 50);
+      continue;
+    }
+    out += buf;
+    if (!answered && out.find(kDsr) != std::string::npos) {
+      answered = true;
+      s.WriteSome(kDsrReply);
+    }
+  }
+  return out;
+}
+
+bool ProcessAlive(DWORD pid) {
+  base::win::ScopedHandle p(
+      ::OpenProcess(SYNCHRONIZE, FALSE, pid));
+  return p.is_valid() && ::WaitForSingleObject(p.get(), 0) == WAIT_TIMEOUT;
+}
+
+// Children of `parent` (by the toolhelp snapshot).
+std::vector<DWORD> ChildrenOf(DWORD parent) {
+  std::vector<DWORD> out;
+  base::win::ScopedHandle snap(::CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0));
+  PROCESSENTRY32W e = {sizeof(e)};
+  for (BOOL ok = ::Process32FirstW(snap.get(), &e); ok;
+       ok = ::Process32NextW(snap.get(), &e)) {
+    if (e.th32ParentProcessID == parent) {
+      out.push_back(e.th32ProcessID);
+    }
+  }
+  return out;
+}
+
+TEST(TerminalSessionWinTest, EchoOk) {
+  auto s = StartCmd("echo ok");
+  ASSERT_TRUE(s);
+  EXPECT_NE(ReadUntil(*s, "ok").find("ok"), std::string::npos);
+  ::WaitForSingleObject(s->process_handle(), 5000);
+  EXPECT_EQ(s->Terminate(base::Seconds(1)), 0);
+}
+
+TEST(TerminalSessionWinTest, DefaultShellIsAbsoluteAndExists) {
+  const base::FilePath shell = TerminalSession::DefaultShellPath();
+  ASSERT_FALSE(shell.empty());
+  EXPECT_TRUE(shell.IsAbsolute());
+  const std::wstring name = shell.BaseName().value();
+  EXPECT_TRUE(name == L"pwsh.exe" || name == L"powershell.exe" ||
+              _wcsicmp(name.c_str(), L"cmd.exe") == 0)
+      << shell;
+}
+
+TEST(TerminalSessionWinTest, InitialSizeAndResize) {
+  // `mode con` prints the console size; cmd waits on `pause` meanwhile.
+  auto s = StartCmd("mode con & pause >nul & mode con & echo done", 100, 30);
+  ASSERT_TRUE(s);
+  std::string out = ReadUntil(*s, "Columns");
+  out += ReadUntil(*s, "100");
+  EXPECT_NE(out.find("100"), std::string::npos) << out;
+  EXPECT_TRUE(s->Resize(120, 40));
+  s->WriteSome("x");
+  EXPECT_NE(ReadUntil(*s, "120").find("120"), std::string::npos);
+  s->Terminate();
+}
+
+TEST(TerminalSessionWinTest, RejectsBadSizes) {
+  EXPECT_FALSE(StartCmd("echo", 0, 24));
+  EXPECT_FALSE(StartCmd("echo", 80, 0));
+  EXPECT_FALSE(StartCmd("echo", TerminalSession::kMaxCols + 1, 24));
+  auto s = StartCmd("pause >nul");
+  ASSERT_TRUE(s);
+  EXPECT_FALSE(s->Resize(0, 10));
+  EXPECT_FALSE(s->Resize(10, TerminalSession::kMaxRows + 1));
+  s->Terminate();
+}
+
+TEST(TerminalSessionWinTest, CleanEnvironment) {
+  ::SetEnvironmentVariableW(L"AERO_SECRET_TEST", L"leak");
+  auto s = StartCmd("echo [%AERO_SECRET_TEST%][%TERM%][%USERPROFILE%] & cd");
+  ::SetEnvironmentVariableW(L"AERO_SECRET_TEST", nullptr);
+  ASSERT_TRUE(s);
+  std::string out = ReadUntil(*s, "]");
+  out += ReadUntil(*s, ":\\");
+  // cmd leaves an unset %VAR% as is.
+  EXPECT_NE(out.find("[%AERO_SECRET_TEST%]"), std::string::npos) << out;
+  EXPECT_NE(out.find("[xterm-256color]"), std::string::npos) << out;
+  s->Terminate();
+}
+
+TEST(TerminalSessionWinTest, TerminateKillsWholeJob) {
+  // A grandchild started by the shell (`start /b`) must die with the session.
+  auto s = StartCmd("start /b ping -n 600 127.0.0.1 >nul & pause >nul");
+  ASSERT_TRUE(s);
+  const DWORD shell = s->pid();
+  std::vector<DWORD> kids;
+  for (int i = 0; i < 100 && kids.empty(); ++i) {
+    base::PlatformThread::Sleep(base::Milliseconds(50));
+    kids = ChildrenOf(shell);
+  }
+  ASSERT_FALSE(kids.empty());
+  s->Terminate(base::Milliseconds(100));
+  EXPECT_FALSE(ProcessAlive(shell));
+  for (DWORD k : kids) {
+    EXPECT_FALSE(ProcessAlive(k)) << k;
+  }
+}
+
+TEST(TerminalSessionWinTest, DestructorKillsJob) {
+  auto s = StartCmd("pause >nul");
+  ASSERT_TRUE(s);
+  const DWORD pid = s->pid();
+  s.reset();
+  EXPECT_FALSE(ProcessAlive(pid));
+}
+
+TEST(TerminalSessionWinTest, WriteNeverBlocks) {
+  // Nothing reads the input: WriteSome() must keep returning (0 once a
+  // write is pending), never hang.
+  auto s = StartCmd("ping -n 600 127.0.0.1 >nul");
+  ASSERT_TRUE(s);
+  const std::string chunk(TerminalSession::kWriteChunk, 'x');
+  const base::TimeTicks start = base::TimeTicks::Now();
+  size_t zeros = 0;
+  for (int i = 0; i < 64; ++i) {
+    std::optional<size_t> n = s->WriteSome(chunk);
+    ASSERT_TRUE(n);
+    zeros += *n == 0;
+  }
+  EXPECT_GT(zeros, 0u);
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(2));
+  s->Terminate();
+}
+
+TEST(TerminalSessionWinTest, TerminateIsIdempotentAndBlocksIo) {
+  auto s = StartCmd("pause >nul");
+  ASSERT_TRUE(s);
+  s->Terminate();
+  EXPECT_FALSE(s->Terminate().has_value());
+  EXPECT_FALSE(s->WriteSome("x"));
+  EXPECT_FALSE(s->Resize(80, 24));
+  std::string buf;
+  EXPECT_EQ(s->ReadSome(&buf, 16), TerminalSession::ReadResult::kClosed);
+  EXPECT_TRUE(s->ForegroundProcessName().empty());
+}
+
+TEST(TerminalSessionWinTest, ForegroundProcessName) {
+  auto s = StartCmd("ping -n 600 127.0.0.1 >nul");
+  ASSERT_TRUE(s);
+  std::string name;
+  for (int i = 0; i < 100 && name != "PING"; ++i) {
+    base::PlatformThread::Sleep(base::Milliseconds(50));
+    name = s->ForegroundProcessName();
+    for (char& c : name) {
+      c = static_cast<char>(toupper(c));
+    }
+  }
+  EXPECT_EQ(name, "PING");
+  s->Terminate();
+}
+
+// TerminalHost on a plain loop: ObjectWatcher needs only a sequence.
+class TerminalHostWinTest : public testing::Test {
+ protected:
+  TerminalHostWinTest() : executor_(base::MessagePumpType::IO) {}
+
+  void SetUp() override {
+    host_ = std::make_unique<TerminalHost>(
+        base::BindRepeating(&TerminalHostWinTest::OnOutput,
+                            base::Unretained(this)),
+        base::BindRepeating(&TerminalHostWinTest::OnExit,
+                            base::Unretained(this)));
+  }
+
+  void OnOutput(int32_t id, std::string bytes) {
+    output_[id] += bytes;
+    if (bytes.find(kDsr) != std::string::npos) {
+      host_->Write(id, kDsrReply);
+    }
+    if (auto_ack_) {
+      host_->Ack(id, bytes.size());
+    }
+    if (quit_ && !needle_.empty() &&
+        output_[id].find(needle_) != std::string::npos) {
+      std::move(quit_).Run();
+    }
+  }
+  void OnExit(int32_t id, int code) {
+    exits_[id] = code;
+    if (quit_ && needle_.empty()) {
+      std::move(quit_).Run();
+    }
+  }
+
+  bool RunUntil(std::string needle) {
+    needle_ = std::move(needle);
+    base::RunLoop loop;
+    quit_ = loop.QuitClosure();
+    base::OneShotTimer timeout;
+    timed_out_ = false;
+    timeout.Start(FROM_HERE, base::Seconds(20),
+                  base::BindOnce(
+                      [](bool* t, base::OnceClosure q) {
+                        *t = true;
+                        std::move(q).Run();
+                      },
+                      &timed_out_, loop.QuitClosure()));
+    loop.Run();
+    quit_.Reset();
+    return !timed_out_;
+  }
+
+  void RunFor(base::TimeDelta delay) {
+    base::RunLoop loop;
+    base::OneShotTimer t;
+    t.Start(FROM_HERE, delay, loop.QuitClosure());
+    loop.Run();
+  }
+
+  base::SingleThreadTaskExecutor executor_;
+  std::unique_ptr<TerminalHost> host_;
+  std::map<int32_t, std::string> output_;
+  std::map<int32_t, int> exits_;
+  std::string needle_;
+  base::OnceClosure quit_;
+  bool timed_out_ = false;
+  bool auto_ack_ = true;
+};
+
+TEST_F(TerminalHostWinTest, EchoesThroughShell) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  // Same text in pwsh, powershell and cmd; the quotes keep the echo of the
+  // typed line from matching.
+  host_->Write(1, "echo aero\"\"42\r");
+  EXPECT_TRUE(RunUntil("aero42")) << output_[1];
+}
+
+TEST_F(TerminalHostWinTest, ExitIsReported) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1, "exit\r");
+  EXPECT_TRUE(RunUntil(std::string())) << output_[1];
+  EXPECT_TRUE(exits_.contains(1));
+}
+
+TEST_F(TerminalHostWinTest, LimitsAndDuplicates) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  EXPECT_FALSE(host_->Open(1, 80, 24));
+  EXPECT_FALSE(host_->Open(2, 0, 24));
+  EXPECT_FALSE(host_->Write(99, "x"));
+}
+
+TEST_F(TerminalHostWinTest, PasteIntoBusyShellNeverBlocks) {
+  auto_ack_ = false;
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1, "ping -n 600 127.0.0.1\r");
+  const std::string chunk(256 * 1024, 'x');
+  const base::TimeTicks start = base::TimeTicks::Now();
+  int refused = 0;
+  for (int i = 0; i < 8; ++i) {
+    refused += !host_->Write(1, chunk);
+  }
+  EXPECT_GT(refused, 0);
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(2));
+  host_->Close(1);
+}
+
+TEST_F(TerminalHostWinTest, DestructionKillsSessions) {
+  ASSERT_TRUE(host_->Open(1, 80, 24));
+  host_->Write(1, "ping -n 600 127.0.0.1\r");
+  RunFor(base::Seconds(2));
+  host_.reset();
+  // Nothing of ours may still be running ping.
+  base::win::ScopedHandle snap(::CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0));
+  PROCESSENTRY32W e = {sizeof(e)};
+  for (BOOL ok = ::Process32FirstW(snap.get(), &e); ok;
+       ok = ::Process32NextW(snap.get(), &e)) {
+    if (_wcsicmp(e.szExeFile, L"PING.EXE") == 0) {
+      // Another ping on the machine would be a false failure; ours had
+      // our shell as parent, which is gone.
+      EXPECT_FALSE(ProcessAlive(e.th32ParentProcessID) &&
+                   e.th32ParentProcessID != 0)
+          << e.th32ProcessID;
+    }
+  }
+}
+
+}  // namespace
