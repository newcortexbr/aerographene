+  // group); Windows: ResizePseudoConsole. False for out-of-range sizes or
+  // failure.
   bool Resize(uint16_t cols, uint16_t rows);
 
   // Name of the foreground process of the pty (tcgetpgrp + /proc/<pgid>/comm),
   // printable ASCII only, at most 15 chars; empty when unknown. Shown only in
-  // the window tooltip, never in the tab title.
+  // the window tooltip, never in the tab title. Windows: image name of the
+  // newest process of the job (QueryInformationJobObject), without ".exe".
   std::string ForegroundProcessName() const;
 
   // Sends SIGHUP to the whole process group, waits up to `grace` for the
   // leader, then SIGKILLs the group and reaps the leader. Idempotent.
   // Returns the leader's exit code when it was reaped.
+  // Windows: waits up to `grace` only if the shell is already exiting, then
+  // TerminateJobObject (the whole tree, also what broke out of the console),
+  // cancels and drains the overlapped I/O, closes the pipes and then the
+  // pseudo console (in this order ClosePseudoConsole cannot wait on a full
+  // output pipe), and closes the job.
   std::optional<int> Terminate(base::TimeDelta grace = base::Seconds(1));
 
+#if BUILDFLAG(IS_WIN)
+  static constexpr size_t kReadChunk = 16 * 1024;
+  static constexpr size_t kWriteChunk = 64 * 1024;
+#endif
+
  private:
+#if BUILDFLAG(IS_WIN)
+  struct Handles;
+  explicit TerminalSession(Handles handles);
+  // Waits for (or cancels) the pending overlapped I/O so its buffers can go.
+  void CancelIo();
+
+  base::win::ScopedHandle job_;
+  base::win::ScopedHandle in_pipe_;   // we write the shell's input
+  base::win::ScopedHandle out_pipe_;  // we read the console output
+  base::win::ScopedHandle read_event_;
+  base::win::ScopedHandle write_event_;
+  void* pseudo_console_ = nullptr;  // HPCON
+  OVERLAPPED read_ov_ = {};
+  OVERLAPPED write_ov_ = {};
+  std::string read_buf_;
+  std::string write_buf_;
+  size_t read_have_ = 0;   // bytes of read_buf_ ready to hand out
+  size_t read_taken_ = 0;  // ... of which already handed out
+  bool read_pending_ = false;
+  bool write_pending_ = false;
+#else
   TerminalSession(base::ScopedFD master, base::Process process);
 
   base::ScopedFD master_;
+#endif
   base::Process process_;
   bool terminated_ = false;
 };
