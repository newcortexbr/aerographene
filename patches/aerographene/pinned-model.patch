+// static
+PinnedModel* PinnedModelFactory::GetForProfile(Profile* profile) {
+  return static_cast<PinnedModel*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+PinnedModelFactory* PinnedModelFactory::GetInstance() {
+  static base::NoDestructor<PinnedModelFactory> instance;
+  return instance.get();
+}
+
+PinnedModelFactory::PinnedModelFactory()
+    : ProfileKeyedServiceFactory(
+          "AerographenePinnedModel",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .Build()) {
+  DependsOn(BookmarkModelFactory::GetInstance());
+}
+
+PinnedModelFactory::~PinnedModelFactory() = default;
+
+std::unique_ptr<KeyedService>
+PinnedModelFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  bookmarks::BookmarkModel* bookmark_model =
+      BookmarkModelFactory::GetForBrowserContext(
+          Profile::FromBrowserContext(context));
+  if (!bookmark_model) {
+    return nullptr;
+  }
+  return std::make_unique<PinnedModel>(bookmark_model);
+}
+
+bool PinnedModelFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+bool PinnedModelFactory::ServiceIsNULLWhileTesting() const {
+  return true;
+}
+
