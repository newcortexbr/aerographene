+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/tabs/aerographene/pinned_model.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+
+namespace aerographene {
+
+namespace {
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+
+// Title of the space folder on the bookmark bar.
+constexpr char16_t kSpaceFolderTitle[] = u"aerographene";
+
+bool HasFlag(const BookmarkNode* node, const char* key) {
+  std::string value;
+  return node->GetMetaInfo(key, &value) && value == "1";
+}
+
+bool IsDrawer(const BookmarkNode* node) {
+  return node->is_folder() && HasFlag(node, kPinnedFolderMetaKey);
+}
+
+int ReadSpan(const BookmarkNode* node) {
+  std::string value;
+  int span = 1;
+  if (node->GetMetaInfo(kPinnedSpanMetaKey, &value) &&
+      base::StringToInt(value, &span) && span >= 1) {
+    return span;
+  }
+  return 1;
+}
+
+PinnedItem MakeItem(const BookmarkNode* node, bool with_children) {
+  PinnedItem item;
+  item.uuid = node->uuid();
+  item.url = node->url();
+  item.title = node->GetTitle();
+  node->GetMetaInfo(kPinnedLabelMetaKey, &item.label);
+  item.span = ReadSpan(node);
+  item.is_folder = IsDrawer(node);
+  if (with_children && item.is_folder) {
+    for (const auto& child : node->children()) {
+      if (child->is_url()) {
+        item.children.push_back(MakeItem(child.get(), false));
+      }
+    }
+  }
+  return item;
+}
+
+}  // namespace
+
+PinnedItem::PinnedItem() = default;
+PinnedItem::PinnedItem(const PinnedItem&) = default;
+PinnedItem& PinnedItem::operator=(const PinnedItem&) = default;
+PinnedItem::PinnedItem(PinnedItem&&) = default;
+PinnedItem& PinnedItem::operator=(PinnedItem&&) = default;
+PinnedItem::~PinnedItem() = default;
+
+PinnedModel::PinnedModel(BookmarkModel* bookmark_model)
+    : model_(bookmark_model) {
+  model_observation_.Observe(model_);
+  if (model_->loaded()) {
+    Initialize();
+  }
+}
+
+PinnedModel::~PinnedModel() = default;
+
+void PinnedModel::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PinnedModel::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::vector<PinnedItem> PinnedModel::GetPinned() const {
+  std::vector<PinnedItem> items;
+  if (!root_) {
+    return items;
+  }
+  for (const auto& child : root_->children()) {
+    if (child->is_url() || IsDrawer(child.get())) {
+      items.push_back(MakeItem(child.get(), true));
+    }
+  }
+  return items;
+}
+
+std::optional<PinnedItem> PinnedModel::Find(const base::Uuid& uuid) const {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node) {
+    return std::nullopt;
+  }
+  return MakeItem(node, true);
+}
+
+std::optional<base::Uuid> PinnedModel::AddPinned(const GURL& url,
+                                                 const std::u16string& title,
+                                                 const base::Uuid& parent,
+                                                 size_t index) {
+  const BookmarkNode* parent_node = ResolveParent(parent);
+  if (!parent_node || !url.is_valid()) {
+    return std::nullopt;
+  }
+  index = std::min(index, parent_node->children().size());
+  const BookmarkNode* node = model_->AddNewURL(parent_node, index, title, url);
+  return node ? std::optional<base::Uuid>(node->uuid()) : std::nullopt;
+}
+
+std::optional<base::Uuid> PinnedModel::AddFolder(const std::u16string& title,
+                                                 size_t index) {
+  if (!root_) {
+    return std::nullopt;
+  }
+  index = std::min(index, root_->children().size());
+  BookmarkNode::MetaInfoMap meta = {{kPinnedFolderMetaKey, "1"}};
+  const BookmarkNode* node = model_->AddFolder(root_, index, title, &meta);
+  return node ? std::optional<base::Uuid>(node->uuid()) : std::nullopt;
+}
+
+bool PinnedModel::Remove(const base::Uuid& uuid) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node) {
+    return false;
+  }
+  model_->Remove(node, bookmarks::metrics::BookmarkEditSource::kOther,
+                 FROM_HERE);
+  return true;
+}
+
+bool PinnedModel::Move(const base::Uuid& uuid,
+                       const base::Uuid& new_parent,
+                       size_t index) {
+  const BookmarkNode* node = Resolve(uuid);
+  const BookmarkNode* parent_node = ResolveParent(new_parent);
+  if (!node || !parent_node || node == parent_node ||
+      (node->is_folder() && parent_node != root_)) {
+    return false;
+  }
+  index = std::min(index, parent_node->children().size());
+  model_->Move(node, parent_node, index);
+  return true;
+}
+
+bool PinnedModel::SetSpan(const base::Uuid& uuid, int span) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node || span < 1) {
+    return false;
+  }
+  if (span == 1) {
+    model_->DeleteNodeMetaInfo(node, kPinnedSpanMetaKey);
+  } else {
+    model_->SetNodeMetaInfo(node, kPinnedSpanMetaKey,
+                            base::NumberToString(span));
+  }
+  return true;
+}
+
+bool PinnedModel::SetLabel(const base::Uuid& uuid, const std::string& label) {
+  const BookmarkNode* node = Resolve(uuid);
+  if (!node) {
+    return false;
+  }
+  if (label.empty()) {
+    model_->DeleteNodeMetaInfo(node, kPinnedLabelMetaKey);
+  } else {
+    model_->SetNodeMetaInfo(node, kPinnedLabelMetaKey, label);
+  }
+  return true;
+}
+
+void PinnedModel::Shutdown() {
+  model_observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+  root_ = nullptr;
+  model_ = nullptr;
+}
+
+void PinnedModel::BookmarkModelLoaded(bool ids_reassigned) {
+  Initialize();
+}
+
+void PinnedModel::BookmarkModelBeingDeleted() {
+  model_observation_.Reset();
+  root_ = nullptr;
+  model_ = nullptr;
+}
+
+void PinnedModel::BookmarkNodeMoved(const BookmarkNode* old_parent,
+                                    size_t old_index,
+                                    const BookmarkNode* new_parent,
+                                    size_t new_index) {
+  if (IsUnderRoot(old_parent) || IsUnderRoot(new_parent)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkNodeAdded(const BookmarkNode* parent,
+                                    size_t index,
+                                    bool added_by_user) {
+  if (!root_ && model_->loaded()) {
+    // A marked folder may arrive through Sync; adopt it, never create here.
+    root_ = FindRoot();
+  }
+  if (IsUnderRoot(parent)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkNodeRemoved(
+    const BookmarkNode* parent,
+    size_t old_index,
+    const BookmarkNode* node,
+    const std::set<GURL>& no_longer_bookmarked,
+    const base::Location& location) {
+  if (node == root_) {
+    OnRootGone();
+  } else if (IsUnderRoot(parent)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkNodeChanged(const BookmarkNode* node) {
+  if (IsUnderRoot(node)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkMetaInfoChanged(const BookmarkNode* node) {
+  if (IsUnderRoot(node)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkNodeFaviconChanged(const BookmarkNode* node) {}
+
+void PinnedModel::BookmarkNodeChildrenReordered(const BookmarkNode* node) {
+  if (IsUnderRoot(node)) {
+    NotifyChanged();
+  }
+}
+
+void PinnedModel::BookmarkAllUserNodesRemoved(
+    const std::set<GURL>& removed_urls,
+    const base::Location& location) {
+  OnRootGone();
+}
+
+void PinnedModel::Initialize() {
+  if (root_) {
+    return;
+  }
+  EnsureRoot();
+  for (Observer& observer : observers_) {
+    observer.OnPinnedModelLoaded();
+  }
+}
+
+void PinnedModel::EnsureRoot() {
+  if (root_ || !model_ || !model_->loaded()) {
+    return;
+  }
+  root_ = FindRoot();
+  if (!root_) {
+    const BookmarkNode* bar = model_->bookmark_bar_node();
+    BookmarkNode::MetaInfoMap meta = {{kPinnedMetaKey, "1"}};
+    root_ = model_->AddFolder(bar, bar->children().size(), kSpaceFolderTitle,
+                              &meta);
+  }
+}
+
+const BookmarkNode* PinnedModel::FindRoot() const {
+  for (const auto& child : model_->bookmark_bar_node()->children()) {
+    if (child->is_folder() && HasFlag(child.get(), kPinnedMetaKey)) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+void PinnedModel::OnRootGone() {
+  root_ = model_ ? FindRoot() : nullptr;
+  if (!root_ && model_) {
+    // Recreate outside the observer notification.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PinnedModel> self) {
+                         if (self) {
+                           self->EnsureRoot();
+                           self->NotifyChanged();
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()));
+  }
+  NotifyChanged();
+}
+
+bool PinnedModel::IsUnderRoot(const BookmarkNode* node) const {
+  return root_ && node && node->HasAncestor(root_);
+}
+
+const BookmarkNode* PinnedModel::Resolve(const base::Uuid& uuid) const {
+  if (!root_ || !uuid.is_valid()) {
+    return nullptr;
+  }
+  const BookmarkNode* node = model_->GetNodeByUuid(
+      uuid, BookmarkModel::NodeTypeForUuidLookup::kLocalOrSyncableNodes);
+  if (!node || node == root_ || !node->HasAncestor(root_)) {
+    return nullptr;
+  }
+  // At most one drawer level.
+  return (node->parent() == root_ || node->parent()->parent() == root_)
+             ? node
+             : nullptr;
+}
+
+const BookmarkNode* PinnedModel::ResolveParent(const base::Uuid& uuid) const {
+  if (!root_) {
+    return nullptr;
+  }
+  if (!uuid.is_valid()) {
+    return root_;
+  }
+  const BookmarkNode* node = Resolve(uuid);
+  return (node && node->parent() == root_ && IsDrawer(node)) ? node : nullptr;
+}
+
+void PinnedModel::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnPinnedChanged();
+  }
+}
+
+}  // namespace aerographene
