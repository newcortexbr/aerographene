+#include "chrome/browser/ui/tabs/aerographene/pinned_model.h"
+
+#include <memory>
+
+#include "base/test/task_environment.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/test/test_bookmark_client.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace aerographene {
+
+namespace {
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+
+class CountingObserver : public PinnedModel::Observer {
+ public:
+  void OnPinnedModelLoaded() override { ++loaded; }
+  void OnPinnedChanged() override { ++changed; }
+  int loaded = 0;
+  int changed = 0;
+};
+
+class PinnedModelTest : public testing::Test {
+ protected:
+  PinnedModelTest()
+      : bookmarks_(bookmarks::TestBookmarkClient::CreateModel()),
+        model_(std::make_unique<PinnedModel>(bookmarks_.get())) {}
+
+  const BookmarkNode* SpaceFolder() {
+    const BookmarkNode* found = nullptr;
+    for (const auto& child : bookmarks_->bookmark_bar_node()->children()) {
+      std::string value;
+      if (child->GetMetaInfo(kPinnedMetaKey, &value) && value == "1") {
+        EXPECT_FALSE(found) << "duplicate space folder";
+        found = child.get();
+      }
+    }
+    return found;
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  std::unique_ptr<BookmarkModel> bookmarks_;
+  std::unique_ptr<PinnedModel> model_;
+};
+
+TEST_F(PinnedModelTest, CreatesSpaceFolderOnBookmarkBarOnce) {
+  ASSERT_TRUE(model_->IsLoaded());
+  ASSERT_TRUE(SpaceFolder());
+  EXPECT_TRUE(model_->GetPinned().empty());
+
+  // "Reload": a new service over the same bookmarks reuses the folder.
+  model_->Shutdown();
+  model_ = std::make_unique<PinnedModel>(bookmarks_.get());
+  EXPECT_TRUE(model_->IsLoaded());
+  EXPECT_TRUE(SpaceFolder());
+}
+
+TEST_F(PinnedModelTest, WaitsForBookmarkModelToLoad) {
+  auto unloaded = std::make_unique<BookmarkModel>(
+      std::make_unique<bookmarks::TestBookmarkClient>());
+  PinnedModel model(unloaded.get());
+  CountingObserver observer;
+  model.AddObserver(&observer);
+  EXPECT_FALSE(model.IsLoaded());
+  EXPECT_FALSE(model.AddFolder(u"x", 0));
+
+  unloaded->LoadEmptyForTest();
+  EXPECT_TRUE(model.IsLoaded());
+  EXPECT_EQ(1, observer.loaded);
+  model.RemoveObserver(&observer);
+}
+
+TEST_F(PinnedModelTest, AddListSpanLabelPersistAcrossReload) {
+  auto id = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 0);
+  ASSERT_TRUE(id);
+  EXPECT_TRUE(model_->SetSpan(*id, 3));
+  EXPECT_TRUE(model_->SetLabel(*id, "label a"));
+  EXPECT_FALSE(model_->SetSpan(*id, 0));
+
+  model_->Shutdown();
+  model_ = std::make_unique<PinnedModel>(bookmarks_.get());
+  auto items = model_->GetPinned();
+  ASSERT_EQ(1u, items.size());
+  EXPECT_EQ(*id, items[0].uuid);
+  EXPECT_EQ(GURL("https://a.test/"), items[0].url);
+  EXPECT_EQ(u"A", items[0].title);
+  EXPECT_EQ(3, items[0].span);
+  EXPECT_EQ("label a", items[0].label);
+  EXPECT_FALSE(items[0].is_folder);
+
+  EXPECT_TRUE(model_->SetSpan(*id, 1));
+  EXPECT_TRUE(model_->SetLabel(*id, ""));
+  auto found = model_->Find(*id);
+  ASSERT_TRUE(found);
+  EXPECT_EQ(1, found->span);
+  EXPECT_TRUE(found->label.empty());
+}
+
+TEST_F(PinnedModelTest, FoldersMoveAndRemove) {
+  auto a = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 0);
+  auto folder = model_->AddFolder(u"F", 1);
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(folder);
+  auto b = model_->AddPinned(GURL("https://b.test/"), u"B", *folder, 0);
+  ASSERT_TRUE(b);
+  // A URL cannot be a parent; folders do not nest.
+  EXPECT_FALSE(model_->AddPinned(GURL("https://c.test/"), u"C", *a, 0));
+  EXPECT_FALSE(model_->Move(*folder, *folder, 0));
+
+  auto items = model_->GetPinned();
+  ASSERT_EQ(2u, items.size());
+  EXPECT_TRUE(items[1].is_folder);
+  ASSERT_EQ(1u, items[1].children.size());
+  EXPECT_EQ(*b, items[1].children[0].uuid);
+
+  // Move out of the drawer to the front, then A into the drawer.
+  EXPECT_TRUE(model_->Move(*b, base::Uuid(), 0));
+  EXPECT_TRUE(model_->Move(*a, *folder, 0));
+  items = model_->GetPinned();
+  ASSERT_EQ(2u, items.size());
+  EXPECT_EQ(*b, items[0].uuid);
+  ASSERT_EQ(1u, items[1].children.size());
+  EXPECT_EQ(*a, items[1].children[0].uuid);
+
+  EXPECT_TRUE(model_->Remove(*folder));
+  EXPECT_FALSE(model_->Find(*a));
+  EXPECT_FALSE(model_->Remove(*folder));
+  EXPECT_EQ(1u, model_->GetPinned().size());
+}
+
+TEST_F(PinnedModelTest, IgnoresNodesOutsideSpaceFolder) {
+  const BookmarkNode* outside = bookmarks_->AddNewURL(
+      bookmarks_->bookmark_bar_node(), 0, u"O", GURL("https://o.test/"));
+  EXPECT_FALSE(model_->Remove(outside->uuid()));
+  EXPECT_FALSE(model_->SetSpan(outside->uuid(), 2));
+  EXPECT_TRUE(model_->GetPinned().empty());
+}
+
+TEST_F(PinnedModelTest, NotifiesOnChanges) {
+  CountingObserver observer;
+  model_->AddObserver(&observer);
+  auto a = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 0);
+  ASSERT_TRUE(a);
+  int after_add = observer.changed;
+  EXPECT_GT(after_add, 0);
+  model_->SetSpan(*a, 2);
+  EXPECT_GT(observer.changed, after_add);
+  int before_outside = observer.changed;
+  bookmarks_->AddNewURL(bookmarks_->other_node(), 0, u"O",
+                        GURL("https://o.test/"));
+  EXPECT_EQ(before_outside, observer.changed);
+  model_->RemoveObserver(&observer);
+}
+
+TEST_F(PinnedModelTest, RecreatesSpaceFolderIfRemoved) {
+  bookmarks_->Remove(SpaceFolder(),
+                     bookmarks::metrics::BookmarkEditSource::kOther, FROM_HERE);
+  EXPECT_FALSE(model_->IsLoaded());
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(model_->IsLoaded());
+  EXPECT_TRUE(SpaceFolder());
+}
