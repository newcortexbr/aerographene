+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_TABS_AEROGRAPHENE_PINNED_MODEL_H_
+#define CHROME_BROWSER_UI_TABS_AEROGRAPHENE_PINNED_MODEL_H_
+
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/location.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/scoped_observation.h"
+#include "base/uuid.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_model_observer.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+namespace aerographene {
+
+// Meta info keys stored on BookmarkNodes (synced with the bookmarks).
+// "1" on the space folder.
+inline constexpr char kPinnedMetaKey[] = "aerographene.pinned";
+// Integer >= 1; absent means 1.
+inline constexpr char kPinnedSpanMetaKey[] = "aerographene.span";
+// UTF-8 label.
+inline constexpr char kPinnedLabelMetaKey[] = "aerographene.label";
+// "1" on a drawer folder.
+inline constexpr char kPinnedFolderMetaKey[] = "aerographene.folder";
+
+// Read-only snapshot of one pinned entry. `uuid` is the stable key
+// (BookmarkNode::uuid()); never use numeric bookmark ids.
+struct PinnedItem {
+  PinnedItem();
+  PinnedItem(const PinnedItem&);
+  PinnedItem& operator=(const PinnedItem&);
+  PinnedItem(PinnedItem&&);
+  PinnedItem& operator=(PinnedItem&&);
+  ~PinnedItem();
+
+  base::Uuid uuid;
+  GURL url;  // Empty for drawer folders.
+  std::u16string title;
+  std::string label;  // Empty if unset.
+  int span = 1;       // Horizontal grid cells, >= 1.
+  bool is_folder = false;  // Drawer folder (aerographene.folder=1).
+  std::vector<PinnedItem> children;  // Only filled for folders.
+};
+
+// Per-profile (= per space) pinned model backed by the BookmarkModel. All
+// pinned entries live under one folder of the local bookmark bar marked with
+// `kPinnedMetaKey`; folders (drawers) hold URLs one level deep. The folder is
+// created once the BookmarkModel has loaded.
+class PinnedModel : public KeyedService,
+                    public bookmarks::BookmarkModelObserver {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The space folder is ready; the API below is usable.
+    virtual void OnPinnedModelLoaded() {}
+    // Anything under the space folder changed (add, remove, move, title, URL,
+    // span, label, order), including changes coming from Sync.
+    virtual void OnPinnedChanged() = 0;
+  };
+
+  explicit PinnedModel(bookmarks::BookmarkModel* bookmark_model);
+  PinnedModel(const PinnedModel&) = delete;
+  PinnedModel& operator=(const PinnedModel&) = delete;
+  ~PinnedModel() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // True once the space folder exists. Mutators fail and getters return empty
+  // values before that.
+  bool IsLoaded() const { return root_ != nullptr; }
+
+  // Top-level entries in order; folders include their children.
+  std::vector<PinnedItem> GetPinned() const;
+  std::optional<PinnedItem> Find(const base::Uuid& uuid) const;
+
+  // `parent` invalid = top level; otherwise it must be a drawer folder. `index`
+  // is clamped to the end. Return the new entry's uuid or nullopt on failure.
+  std::optional<base::Uuid> AddPinned(const GURL& url,
+                                      const std::u16string& title,
+                                      const base::Uuid& parent,
+                                      size_t index);
+  std::optional<base::Uuid> AddFolder(const std::u16string& title,
+                                      size_t index);
+  bool Remove(const base::Uuid& uuid);
+  // Insert-before semantics of BookmarkModel::Move. Folders cannot be nested.
+  bool Move(const base::Uuid& uuid, const base::Uuid& new_parent, size_t index);
+
+  // span >= 1 (1 removes the key); label empty removes the key.
+  bool SetSpan(const base::Uuid& uuid, int span);
+  bool SetLabel(const base::Uuid& uuid, const std::string& label);
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // bookmarks::BookmarkModelObserver:
+  void BookmarkModelLoaded(bool ids_reassigned) override;
+  void BookmarkModelBeingDeleted() override;
+  void BookmarkNodeMoved(const bookmarks::BookmarkNode* old_parent,
+                         size_t old_index,
+                         const bookmarks::BookmarkNode* new_parent,
+                         size_t new_index) override;
+  void BookmarkNodeAdded(const bookmarks::BookmarkNode* parent,
+                         size_t index,
+                         bool added_by_user) override;
+  void BookmarkNodeRemoved(const bookmarks::BookmarkNode* parent,
+                           size_t old_index,
+                           const bookmarks::BookmarkNode* node,
+                           const std::set<GURL>& no_longer_bookmarked,
+                           const base::Location& location) override;
+  void BookmarkNodeChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkMetaInfoChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkNodeFaviconChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkNodeChildrenReordered(
+      const bookmarks::BookmarkNode* node) override;
+  void BookmarkAllUserNodesRemoved(const std::set<GURL>& removed_urls,
+                                   const base::Location& location) override;
+
+ private:
+  void Initialize();
+  void EnsureRoot();
+  const bookmarks::BookmarkNode* FindRoot() const;
+  void OnRootGone();
+  bool IsUnderRoot(const bookmarks::BookmarkNode* node) const;
+  // Node for `uuid` strictly under the space folder, or null.
+  const bookmarks::BookmarkNode* Resolve(const base::Uuid& uuid) const;
+  // Space folder (invalid `uuid`) or a drawer folder; null otherwise.
+  const bookmarks::BookmarkNode* ResolveParent(const base::Uuid& uuid) const;
+  void NotifyChanged();
+
+  raw_ptr<bookmarks::BookmarkModel> model_;
+  raw_ptr<const bookmarks::BookmarkNode> root_ = nullptr;
+  base::ObserverList<Observer> observers_;
+  base::ScopedObservation<bookmarks::BookmarkModel,
+                          bookmarks::BookmarkModelObserver>
+      model_observation_{this};
+  base::WeakPtrFactory<PinnedModel> weak_factory_{this};
+};
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_TABS_AEROGRAPHENE_PINNED_MODEL_H_
