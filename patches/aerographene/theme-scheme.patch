--- a/chrome/browser/themes/theme_service.cc
+++ b/chrome/browser/themes/theme_service.cc
@@ -756,10 +756,24 @@
 }
 
 ThemeService::BrowserColorScheme ThemeService::GetBrowserColorScheme() const {
+  if (auto builtin = GetBuiltinThemeColorScheme()) {
+    return *builtin;
+  }
   return static_cast<BrowserColorScheme>(
       profile_->GetPrefs()->GetInteger(prefs::kBrowserColorScheme));
 }
 
+std::optional<ThemeService::BrowserColorScheme>
+ThemeService::GetBuiltinThemeColorScheme() const {
+  if (GetThemeSupplier()) {
+    return std::nullopt;
+  }
+  return aerographene::GetBuiltinThemeScheme(aerographene::GetBuiltinTheme()) ==
+                 aerographene::BuiltinScheme::kLight
+             ? BrowserColorScheme::kLight
+             : BrowserColorScheme::kDark;
+}
