+bool ExpireHistoryBackend::MoveOldDownloadsToCold(
+    std::vector<DownloadRow>* rows) {
+  if (!main_db_ || expiration_threshold_.is_zero()) {
+    return false;
+  }
+  const base::Time threshold = GetCurrentExpirationTime();
+  auto is_cold = [threshold](const DownloadRow& row) {
+    return row.state != DownloadState::IN_PROGRESS &&
+           std::max({row.start_time, row.end_time, row.last_access_time}) <
+               threshold;
+  };
+  if (std::none_of(rows->begin(), rows->end(), is_cold)) {
+    return false;
+  }
+  ColdHistoryDatabase* cold = GetColdDatabase(/*create=*/true);
+  cold_db_missing_ = !cold;
+  if (!cold || !cold->BeginTransaction()) {
+    return false;
+  }
+  bool ok = true;
+  for (const DownloadRow& row : *rows) {
+    if (ok && is_cold(row)) {
+      ok = cold->AddDownloadKeepingID(row);
+    }
+  }
+  if (!ok || !cold->CommitTransaction()) {
+    cold->RollbackTransaction();
+    return false;
+  }
+  for (const DownloadRow& row : *rows) {
+    if (is_cold(row)) {
+      main_db_->RemoveDownload(row.id);
+    }
+  }
+  std::erase_if(*rows, is_cold);
+  return true;
+}
