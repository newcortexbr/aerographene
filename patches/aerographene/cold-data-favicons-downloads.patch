+bool ColdHistoryDatabase::AddDownloadKeepingID(const DownloadRow& row) {
+  if (!open_) {
+    return false;
+  }
+  sql::Statement existing(db_.GetCachedStatement(
+      SQL_FROM_HERE, "SELECT guid FROM downloads WHERE id = ?"));
+  existing.BindInt64(0, row.id);
+  if (existing.Step()) {
+    if (existing.ColumnString(0) == row.guid) {
+      return true;
+    }
+    sql::Statement max_id(db_.GetCachedStatement(
+        SQL_FROM_HERE, "SELECT MAX(id) FROM downloads"));
+    if (!max_id.Step()) {
+      return false;
+    }
+    const int64_t new_id = max_id.ColumnInt64(0) + 1;
+    for (const char* sql :
+         {"UPDATE downloads SET id = ? WHERE id = ?",
+          "UPDATE downloads_url_chains SET id = ? WHERE id = ?",
+          "UPDATE downloads_slices SET download_id = ? WHERE download_id = ?"}) {
+      sql::Statement renumber(db_.GetUniqueStatement(sql));
+      renumber.BindInt64(0, new_id);
+      renumber.BindInt64(1, row.id);
+      if (!renumber.Run()) {
+        return false;
+      }
+    }
+  }
+  return CreateDownload(row);
+}
+
+bool ColdHistoryDatabase::DeleteDownloadsBetween(base::Time begin,
+                                                 base::Time end) {
+  if (!open_) {
+    return false;
+  }
+  if (end.is_null()) {
+    end = base::Time::Max();
+  }
+  std::vector<DownloadId> ids;
+  {
+    sql::Statement statement(db_.GetCachedStatement(
+        SQL_FROM_HERE,
+        "SELECT id FROM downloads WHERE start_time >= ? AND start_time < ?"));
+    statement.BindTime(0, begin);
+    statement.BindTime(1, end);
+    while (statement.Step()) {
+      ids.push_back(static_cast<DownloadId>(statement.ColumnInt64(0)));
+    }
+  }
+  if (ids.empty()) {
+    return true;
+  }
+  if (!BeginTransaction()) {
+    return false;
+  }
+  for (DownloadId id : ids) {
+    RemoveDownload(id);
+  }
+  return CommitTransaction();
+}
