+bool ColdHistoryDatabase::AddIconMapping(URLID url_id,
+                                         const GURL& icon_url,
+                                         int icon_type) {
+  if (!open_) {
+    return false;
+  }
+  sql::Statement statement(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "INSERT OR REPLACE INTO cold_icon_mapping (url_id, icon_url, icon_type) "
+      "VALUES (?, ?, ?)"));
+  statement.BindInt64(0, url_id);
+  statement.BindString(1, database_utils::GurlToDatabaseUrl(icon_url));
+  statement.BindInt(2, icon_type);
+  return statement.Run();
+}
