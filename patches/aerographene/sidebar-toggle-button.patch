+void ToolbarView::UpdateSidebarToggle() {
+  auto* layout = HeliumLayoutStateController::From(browser_view_->browser());
+  auto* state = tabs::VerticalTabStripStateController::From(browser_);
+  sidebar_toggle_->SetVisible(layout && layout->IsVerticalLayout() && state);
+  if (!state) {
+    return;
+  }
+  const bool collapsed = state->IsCollapsed();
+  sidebar_toggle_->SetVectorIcon(
+      collapsed ? (features::IsRoundedIconsEnabled() ? views::kMenuOpenIcon
+                                                     : views::kMenuOpenOldIcon)
+                : views::kMenuCloseCustomIcon);
+  sidebar_toggle_->SetTooltipText(l10n_util::GetStringUTF16(
+      collapsed ? IDS_EXPAND_VERTICAL_TABS : IDS_COLLAPSE_VERTICAL_TABS));
+}
