+TEST(TerminalSessionTest, TerminateKillsJobInOtherProcessGroup) {
+  // `set -m` gives the background job its own process group; it ignores HUP
+  // (nohup), so only the session sweep can reach it.
+  auto s = StartSh("set -m; nohup sleep 1000 >/dev/null 2>&1 & echo bg=$!; wait");
+  ASSERT_TRUE(s);
+  std::string out = ReadUntil(s->master_fd(), "\n");
+  const size_t at = out.find("bg=");
+  ASSERT_NE(at, std::string::npos) << out;
+  int bg = 0;
+  ASSERT_TRUE(base::StringToInt(
+      out.substr(at + 3, out.find_first_of("\r\n", at) - at - 3), &bg));
+  ASSERT_GT(bg, 1);
+  ASSERT_NE(getpgid(bg), s->pid());  // really another group
+  s->Terminate(base::Milliseconds(100));
+  bool gone = false;
+  for (int i = 0; i < 200 && !gone; ++i) {
+    gone = kill(bg, 0) != 0 && errno == ESRCH;
+    if (!gone) {
+      usleep(10000);
+    }
+  }
+  EXPECT_TRUE(gone);
+}
