+// Pids of every process whose session id is `sid` (zombies skipped). Jobs
+// started with job control live in other process groups of the same session,
+// so signalling the shell's group alone misses them.
+std::vector<pid_t> SessionMembers(pid_t sid) {
+  std::vector<pid_t> out;
+  DIR* d = opendir("/proc");
+  if (!d) {
+    return out;
+  }
+  while (const struct dirent* e = readdir(d)) {
+    int pid = 0;
+    if (!base::StringToInt(e->d_name, &pid) || pid <= 0) {
+      continue;
+    }
+    std::string stat;
+    if (!base::ReadFileToString(
+            base::FilePath("/proc/" + std::string(e->d_name) + "/stat"),
+            &stat)) {
+      continue;
+    }
+    // "pid (comm) state ppid pgrp session ..."; comm may contain ')' / ' '.
+    const size_t rp = stat.rfind(')');
+    if (rp == std::string::npos || rp + 2 >= stat.size()) {
+      continue;
+    }
+    char state = 0;
+    int ppid = 0, pgrp = 0, session = 0;
+    if (sscanf(stat.c_str() + rp + 2, "%c %d %d %d", &state, &ppid, &pgrp,
+               &session) == 4 &&
+        session == sid && state != 'Z') {
+      out.push_back(pid);
+    }
+  }
+  closedir(d);
+  return out;
+}
+
+// SIGKILL to every session member, repeated while forks keep appearing.
+void KillSession(pid_t sid) {
+  for (int i = 0; i < 20; ++i) {
+    const std::vector<pid_t> members = SessionMembers(sid);
+    if (members.empty()) {
+      return;
+    }
+    for (pid_t m : members) {
+      kill(m, SIGKILL);
+    }
+    base::PlatformThread::Sleep(base::Milliseconds(5));
+  }
+}
