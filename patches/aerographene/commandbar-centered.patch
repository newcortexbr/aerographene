+void RoundedOmniboxResultsFrame::SetAeroHeaderText(const std::u16string& text) {
+  if (!aero_header_) {
+    return;
+  }
+  // Same prefix rule as OmniboxViewViews::AeroApplyCommandLook: optional
+  // leading spaces, then "t:" or "o:".
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(std::u16string_view(text), base::TRIM_LEADING);
+  const size_t lead = text.size() - trimmed.size();
+  size_t prefix_len = 0;
+  if (trimmed.size() >= 2 && trimmed[1] == u':' &&
+      (trimmed[0] == u't' || trimmed[0] == u'T' || trimmed[0] == u'o' ||
+       trimmed[0] == u'O')) {
+    prefix_len = lead + 2;
+  }
+  aero_prefix_label_->SetText(text.substr(0, prefix_len));
+  aero_prefix_label_->SetVisible(prefix_len != 0);
+  if (text.empty()) {
+    aero_text_label_->SetText(u"Search...");
+    aero_text_label_->SetEnabledColor(kColorOmniboxTextDimmed);
+  } else {
+    aero_text_label_->SetText(text.substr(prefix_len));
+    aero_text_label_->SetEnabledColor(kColorOmniboxText);
+  }
+}
