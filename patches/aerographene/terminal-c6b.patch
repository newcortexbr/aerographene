+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace aerographene {
+
+namespace {
+
+const char kWatcherKey[] = "aero_terminal_launch_watcher";
+
+// Lives as user data of the WebContents it observes; with no pending command
+// its callbacks do nothing.
+class Watcher : public content::WebContentsObserver,
+                public base::SupportsUserData::Data {
+ public:
+  explicit Watcher(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (Relevant(handle)) {
+      OnTerminalTabNavigationStarted(web_contents(), handle->GetNavigationId());
+    }
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (Relevant(handle)) {
+      OnTerminalTabNavigationFinished(
+          web_contents(), handle->GetNavigationId(),
+          handle->HasCommitted() && !handle->IsErrorPage());
+    }
+  }
+
+ private:
+  static bool Relevant(content::NavigationHandle* handle) {
+    return handle->IsInPrimaryMainFrame() && !handle->IsSameDocument();
+  }
+};
+
+}  // namespace
+
+void SetPendingTerminalCommandForNavigation(content::NavigationHandle& navigation,
+                                            std::string command,
+                                            bool run) {
+  content::WebContents* contents = navigation.GetWebContents();
+  if (!contents ||
+      !SetPendingTerminalCommand(contents, std::move(command), run,
+                                 navigation.GetNavigationId())) {
+    return;
+  }
+  if (!contents->GetUserData(kWatcherKey)) {
+    contents->SetUserData(kWatcherKey, std::make_unique<Watcher>(contents));
+  }
+}
+
+}  // namespace aerographene
