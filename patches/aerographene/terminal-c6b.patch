+// Sets a command for navigation kNav and lets that navigation commit.
+bool SetCommitted(FakeTab* tab,
+                  std::string command,
+                  bool run = true,
+                  base::TimeTicks now = base::TimeTicks::Now()) {
+  if (!SetPendingTerminalCommand(tab, std::move(command), run, kNav, now)) {
+    return false;
+  }
