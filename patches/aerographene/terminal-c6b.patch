+TEST(AeroTerminalCommandTest, TypedKeyByKey) {
+  TypedInputTracker t;
+  std::u16string text;
+  for (char16_t c : std::u16string(u"t: ls")) {
+    const std::u16string old = text;
+    text += c;
+    t.OnTextChanged(old, text, false);
+  }
+  EXPECT_TRUE(t.typed());
+  EXPECT_TRUE(TerminalInputWasTyped(u"", false, t));
+}
+
+TEST(AeroTerminalCommandTest, PastedIsNotTyped) {
+  TypedInputTracker t;
+  t.OnTextChanged(u"", u"t: rm x", true);  // Ctrl+V
+  EXPECT_FALSE(t.typed());
+  // Typing more after the paste does not make it typed.
+  t.OnTextChanged(u"t: rm x", u"t: rm xy", false);
+  EXPECT_FALSE(TerminalInputWasTyped(u"", false, t));
+  // Clearing the text starts over.
+  t.OnTextChanged(u"t: rm xy", u"", false);
+  t.OnTextChanged(u"", u"t", false);
+  EXPECT_TRUE(t.typed());
+}
+
+TEST(AeroTerminalCommandTest, UnflaggedMultiCharInsertIsNotTyped) {
+  TypedInputTracker t;  // middle click paste, IME commit
+  t.OnTextChanged(u"t", u"t: ls", false);
+  EXPECT_FALSE(t.typed());
+}
+
+TEST(AeroTerminalCommandTest, DropAndSetTextAreNotTyped) {
+  TypedInputTracker t;
+  t.OnTextSet(u"t: ls");  // OmniboxViewViews::PerformDrop -> SetUserText
+  EXPECT_FALSE(TerminalInputWasTyped(u"", false, t));
+  t.Reset();
+  EXPECT_TRUE(t.typed());
+  t.OnTextSet(u"");
+  EXPECT_TRUE(t.typed());
+}
+
+TEST(AeroTerminalCommandTest, PasteAndGoAndModelPasteAreNotTyped) {
+  TypedInputTracker t;
+  EXPECT_FALSE(TerminalInputWasTyped(u"t: ls", false, t));  // paste-and-go
+  EXPECT_FALSE(TerminalInputWasTyped(u"", true, t));  // PasteState::kPasted
+  EXPECT_TRUE(TerminalInputWasTyped(u"", false, t));
+}
+
 }  // namespace aerographene
