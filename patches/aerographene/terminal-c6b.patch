+  OnTerminalTabNavigationStarted(&tab, kNav + 2);
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab));
+  // Another navigation finishing (e.g. one that never reported its start).
+  ASSERT_TRUE(SetCommitted(&tab, "ls"));
+  OnTerminalTabNavigationFinished(&tab, kNav + 3, false);
+  EXPECT_FALSE(TakePendingTerminalCommand(&tab));
+}
+
+TEST(TerminalLaunchTest, OnlyTheNewPageTakesIt) {
+  EXPECT_TRUE(IsNewTerminalPageUrl("chrome://terminal/?new=1"));
+  for (const char* s :
+       {"chrome://terminal/", "chrome://terminal/?w=3", "chrome://terminal/?new=1#x",
+        "chrome://terminal/?new=1&w=2", "chrome://terminal/?new=0",
+        "chrome://notes/?new=1", ""}) {
+    EXPECT_FALSE(IsNewTerminalPageUrl(s)) << s;
+  }
 }
 
