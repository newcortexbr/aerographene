+// The panel: header with counter, scrollable grid, footer with the keys.
+class SwitcherPanel : public views::View {
+  METADATA_HEADER(SwitcherPanel, views::View)
+
+ public:
+  SwitcherPanel(int columns, int visible_rows, int total_rows)
+      : columns_(columns) {
+    const int grid_width =
+        columns * kCardWidth + (columns - 1) * kCardGap;
+    const int grid_height =
+        total_rows * kCardHeight + (total_rows - 1) * kCardGap;
+    const int visible_height =
+        visible_rows * kCardHeight + (visible_rows - 1) * kCardGap;
+    size_ = gfx::Size(grid_width + 2 * kPanelPadding,
+                      kHeaderHeight + visible_height + kPanelPadding +
+                          kFooterHeight);
+
+    scroll_view_ = AddChildView(std::make_unique<views::ScrollView>(
+        views::ScrollView::ScrollWithLayers::kEnabled));
+    scroll_view_->SetBackgroundColor(std::nullopt);
+    scroll_view_->SetDrawOverflowIndicator(false);
+    scroll_view_->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    grid_ = scroll_view_->SetContents(std::make_unique<views::View>());
+    grid_->SetSize(gfx::Size(grid_width, grid_height));
+    scroll_view_->SetBounds(kPanelPadding, kHeaderHeight, grid_width,
+                            visible_height);
+  }
+  SwitcherPanel(const SwitcherPanel&) = delete;
+  SwitcherPanel& operator=(const SwitcherPanel&) = delete;
+  ~SwitcherPanel() override = default;
+
+  SwitcherCard* AddCard(std::unique_ptr<SwitcherCard> card) {
+    const int index = static_cast<int>(grid_->children().size());
+    const int column = index % columns_;
+    const int row = index / columns_;
+    SwitcherCard* const added = grid_->AddChildView(std::move(card));
+    added->SetBounds(column * (kCardWidth + kCardGap),
+                     row * (kCardHeight + kCardGap), kCardWidth, kCardHeight);
+    return added;
+  }
+
+  void SetCounter(int selected, int total) {
+    selected_ = selected;
+    total_ = total;
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return size_;
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+    const SkColor line = colors->GetColor(kColorToolbarSeparator);
+    const SkColor text = colors->GetColor(ui::kColorSysOnSurface);
+    const SkColor subtle = colors->GetColor(ui::kColorSysOnSurfaceSubtle);
+    const float radius = GetRadius();
+
+    gfx::RectF panel(GetLocalBounds());
+    panel.Inset(0.5f);
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(colors->GetColor(ui::kColorSysSurface));
+    canvas->DrawRoundRect(panel, radius + 2, fill);
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1);
+    stroke.setColor(line);
+    canvas->DrawRoundRect(panel, radius + 2, stroke);
+
+    // Header: title and "3 / 8".
+    const gfx::Rect header(kPanelPadding, 0, width() - 2 * kPanelPadding,
+                           kHeaderHeight);
+    canvas->DrawStringRect(u"RECENT TABS", MonoFont(), subtle, header);
+    const std::u16string count = base::NumberToString16(selected_ + 1);
+    const std::u16string rest = u" / " + base::NumberToString16(total_);
+    const int rest_width = gfx::GetStringWidth(rest, MonoFont());
+    const int count_width = gfx::GetStringWidth(count, MonoFont());
+    canvas->DrawStringRect(
+        rest, MonoFont(), subtle,
+        gfx::Rect(header.right() - rest_width, header.y(), rest_width,
+                  header.height()));
+    canvas->DrawStringRect(
+        count, MonoFont(), accent,
+        gfx::Rect(header.right() - rest_width - count_width, header.y(),
+                  count_width, header.height()));
+
+    // Footer: separator and the key legend.
+    const int footer_top = height() - kFooterHeight;
+    canvas->DrawLine(gfx::Point(1, footer_top),
+                     gfx::Point(width() - 1, footer_top), line);
+    const int key_y = footer_top + (kFooterHeight - kKeyHeight) / 2;
+    int x = kPanelPadding;
+    auto key = [&](const std::u16string& label) {
+      const int w = gfx::GetStringWidth(label, MonoFont()) + 2 * kKeyPadding;
+      const gfx::RectF box(x + 0.5f, key_y + 0.5f, w - 1, kKeyHeight - 1);
+      cc::PaintFlags key_stroke = stroke;
+      canvas->DrawRoundRect(box, 3, key_stroke);
+      canvas->DrawStringRect(label, MonoFont(), text,
+                             gfx::Rect(x + kKeyPadding, key_y, w, kKeyHeight));
+      x += w + 6;
+    };
+    auto label = [&](const std::u16string& s, int after) {
+      const int w = gfx::GetStringWidth(s, SmallFont());
+      canvas->DrawStringRect(s, SmallFont(), subtle,
+                             gfx::Rect(x, key_y, w, kKeyHeight));
+      x += w + after;
+    };
+    key(u"Ctrl");
+    label(u"+", 6);
+    key(u"Tab");
+    label(u"next", 18);
+    key(u"Ctrl");
+    label(u"+", 6);
+    key(u"Shift");
+    label(u"+", 6);
+    key(u"Tab");
+    label(u"previous", 18);
+    key(u"Esc");
+    label(u"cancel", 18);
+    // Right aligned: "release Ctrl to switch", if it still fits.
+    const std::u16string release = u"release";
+    const std::u16string to_switch = u"to switch";
+    const int ctrl_width =
+        gfx::GetStringWidth(u"Ctrl", MonoFont()) + 2 * kKeyPadding;
+    const int right_width = gfx::GetStringWidth(release, SmallFont()) + 6 +
+                            ctrl_width + 6 +
+                            gfx::GetStringWidth(to_switch, SmallFont());
+    const int right_x = width() - kPanelPadding - right_width;
+    if (right_x > x) {
+      x = right_x;
+      label(release, 6);
+      key(u"Ctrl");
+      label(to_switch, 0);
+    }
+  }
+
+ private:
+  const int columns_;
+  gfx::Size size_;
+  raw_ptr<views::ScrollView> scroll_view_ = nullptr;
+  raw_ptr<views::View> grid_ = nullptr;
+  int selected_ = 0;
+  int total_ = 0;
+};
