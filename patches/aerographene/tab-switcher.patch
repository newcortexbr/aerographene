+// One tab in the grid: thumbnail (or big favicon), favicon, title and host.
+class SwitcherCard : public views::View {
+  METADATA_HEADER(SwitcherCard, views::View)
+
+ public:
+  SwitcherCard(content::WebContents* contents,
+               bool pinned,
+               base::RepeatingClosure on_click)
+      : contents_(contents), pinned_(pinned), on_click_(std::move(on_click)) {
+    title_ = contents->GetTitle();
+    if (title_.empty()) {
+      title_ = GetHost(contents->GetLastCommittedURL());
+    }
+    host_ = GetHost(contents->GetLastCommittedURL());
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      const gfx::Image favicon = driver->GetFavicon();
+      if (!favicon.IsEmpty()) {
+        favicon_ = favicon.AsImageSkia();
+      }
+    }
+    // Only show what the hover card already captured: no capture is forced,
+    // and discarded tabs keep the placeholder (no reload, no memory).
+    ThumbnailTabHelper* const helper =
+        ThumbnailTabHelper::FromWebContents(contents);
+    scoped_refptr<ThumbnailImage> thumbnail =
+        helper ? helper->thumbnail() : nullptr;
+    if (thumbnail && thumbnail->has_data() && !contents->WasDiscarded()) {
+      subscription_ = thumbnail->Subscribe();
+      subscription_->SetSizeHint(
+          gfx::Size(kCardWidth - 2 * kCardInset, kThumbHeight));
+      subscription_->SetUncompressedImageCallback(base::BindRepeating(
+          &SwitcherCard::SetThumbnail, base::Unretained(this)));
+      thumbnail->RequestThumbnailImage();
+    }
+    SetTooltipText(title_);
+  }
+  SwitcherCard(const SwitcherCard&) = delete;
+  SwitcherCard& operator=(const SwitcherCard&) = delete;
+  ~SwitcherCard() override = default;
+
+  content::WebContents* contents() const { return contents_; }
+
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kCardWidth, kCardHeight);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return event.IsOnlyLeftMouseButton();
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (HitTestPoint(event.location())) {
+      on_click_.Run();
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+    const SkColor line = colors->GetColor(kColorToolbarSeparator);
+    const SkColor text = colors->GetColor(ui::kColorSysOnSurface);
+    const SkColor subtle = colors->GetColor(ui::kColorSysOnSurfaceSubtle);
+    const float radius = GetRadius();
+
+    gfx::RectF card(GetLocalBounds());
+    card.Inset(0.5f);
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(selected_ ? SkColorSetA(accent, 0x33)
+                            : colors->GetColor(ui::kColorSysSurface2));
+    canvas->DrawRoundRect(card, radius, fill);
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(selected_ ? 2 : 1);
+    stroke.setColor(selected_ ? accent : line);
+    canvas->DrawRoundRect(card, radius, stroke);
+
+    // Thumbnail area.
+    const gfx::Rect thumb(kCardInset, kCardInset, width() - 2 * kCardInset,
+                          kThumbHeight);
+    cc::PaintFlags thumb_fill;
+    thumb_fill.setAntiAlias(true);
+    thumb_fill.setColor(colors->GetColor(ui::kColorSysSurface));
+    canvas->DrawRoundRect(gfx::RectF(thumb), std::max(radius - 2, 0.0f),
+                          thumb_fill);
+    if (!thumbnail_.isNull()) {
+      canvas->Save();
+      canvas->ClipRect(thumb);
+      canvas->DrawImageInt(thumbnail_, 0, 0, thumbnail_.width(),
+                           thumbnail_.height(), thumb.x(), thumb.y(),
+                           thumb.width(), thumb.height(), /*filter=*/true);
+      canvas->Restore();
+    } else {
+      // Placeholder: the favicon large in the middle.
+      const gfx::Rect big(thumb.CenterPoint().x() - kBigFaviconSize / 2,
+                          thumb.CenterPoint().y() - kBigFaviconSize / 2,
+                          kBigFaviconSize, kBigFaviconSize);
+      PaintFavicon(canvas, big, accent);
+    }
+    cc::PaintFlags thumb_stroke = stroke;
+    thumb_stroke.setStrokeWidth(1);
+    thumb_stroke.setColor(line);
+    canvas->DrawRoundRect(gfx::RectF(thumb), std::max(radius - 2, 0.0f),
+                          thumb_stroke);
+
+    if (pinned_) {
+      const gfx::Rect pin(thumb.right() - kPinIconSize - 6, thumb.y() + 6,
+                          kPinIconSize, kPinIconSize);
+      canvas->DrawImageInt(
+          gfx::CreateVectorIcon(views::kKeepFilledIcon, kPinIconSize, text),
+          pin.x(), pin.y());
+    }
+
+    // Favicon, title and host.
+    const int text_top = thumb.bottom() + 8;
+    const gfx::Rect favicon_rect(kCardInset + 4, text_top + 6, kFaviconSize,
+                                 kFaviconSize);
+    PaintFavicon(canvas, favicon_rect, accent);
+    const int text_x = favicon_rect.right() + 8;
+    const int text_width = width() - text_x - kCardInset;
+    const int title_height = TitleFont().GetHeight();
+    canvas->DrawStringRect(
+        gfx::ElideText(title_, TitleFont(), text_width, gfx::ELIDE_TAIL),
+        TitleFont(), text, gfx::Rect(text_x, text_top, text_width,
+                                     title_height));
+    canvas->DrawStringRect(
+        gfx::ElideText(host_, MonoFont(), text_width, gfx::ELIDE_TAIL),
+        MonoFont(), subtle,
+        gfx::Rect(text_x, text_top + title_height + 1, text_width,
+                  MonoFont().GetHeight()));
+  }
+
+ private:
+  void SetThumbnail(gfx::ImageSkia image) {
+    thumbnail_ = std::move(image);
+    SchedulePaint();
+  }
+
+  void PaintFavicon(gfx::Canvas* canvas, const gfx::Rect& rect, SkColor dot) {
+    if (!favicon_.isNull()) {
+      canvas->DrawImageInt(favicon_, 0, 0, favicon_.width(), favicon_.height(),
+                           rect.x(), rect.y(), rect.width(), rect.height(),
+                           /*filter=*/true);
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(dot);
+    canvas->DrawCircle(gfx::PointF(rect.CenterPoint()), rect.width() / 2.0f,
+                       flags);
+  }
+
+  const raw_ptr<content::WebContents> contents_;
+  const bool pinned_;
+  base::RepeatingClosure on_click_;
+  std::u16string title_;
+  std::u16string host_;
+  gfx::ImageSkia favicon_;
+  gfx::ImageSkia thumbnail_;
+  std::unique_ptr<ThumbnailImage::Subscription> subscription_;
+  bool selected_ = false;
+};
