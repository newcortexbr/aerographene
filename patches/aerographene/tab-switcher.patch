+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_AEROGRAPHENE_TAB_SWITCHER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_AEROGRAPHENE_TAB_SWITCHER_H_
+
+class BrowserWindowInterface;
+
+namespace aerographene {
+
+// Ctrl+Tab tab switcher: a centered grid of the window's tabs in MRU order
+// (WebContents::GetLastActiveTimeTicks), with cached thumbnails. The first
+// call opens it with the previous tab selected (or the oldest one when
+// |forward| is false); later calls while it is open move the selection.
+// Releasing Ctrl activates the selected tab; Esc, a click outside, losing
+// focus or any tab strip change cancel. Returns false when nothing was shown
+// (one tab, or no views browser), so the caller can fall back.
+bool ShowOrAdvanceTabSwitcher(BrowserWindowInterface* browser, bool forward);
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_AEROGRAPHENE_TAB_SWITCHER_H_
