+class TabSwitcher;
+TabSwitcher* g_switcher = nullptr;
+
+// Owns the widget; lives while Ctrl is held. Only one exists at a time
+// (there is a single keyboard).
+class TabSwitcher : public ui::EventObserver,
+                    public views::WidgetObserver,
+                    public TabStripModelObserver {
+ public:
+  TabSwitcher(BrowserWindowInterface* browser,
+              BrowserView* browser_view,
+              bool forward)
+      : browser_(browser), model_(browser->GetTabStripModel()) {
+    // MRU: active tab first, then by last activation time.
+    const int active = model_->active_index();
+    std::vector<content::WebContents*> order;
+    for (int i = 0; i < model_->count(); ++i) {
+      if (i != active) {
+        order.push_back(model_->GetWebContentsAt(i));
+      }
+    }
+    std::stable_sort(order.begin(), order.end(),
+                     [](content::WebContents* a, content::WebContents* b) {
+                       return a->GetLastActiveTimeTicks() >
+                              b->GetLastActiveTimeTicks();
+                     });
+    if (active >= 0) {
+      order.insert(order.begin(), model_->GetWebContentsAt(active));
+    }
+    const int count = static_cast<int>(order.size());
+
+    views::Widget* const browser_widget = browser_view->GetWidget();
+    const gfx::Rect window = browser_widget->GetWindowBoundsInScreen();
+    const int fit_columns =
+        (window.width() - 2 * kWindowMargin - 2 * kPanelPadding + kCardGap) /
+        (kCardWidth + kCardGap);
+    const int columns =
+        std::clamp(std::min(fit_columns, count), 1, kMaxColumns);
+    const int total_rows = (count + columns - 1) / columns;
+    const int fit_rows =
+        (window.height() - 2 * kWindowMargin - kHeaderHeight - kPanelPadding -
+         kFooterHeight + kCardGap) /
+        (kCardHeight + kCardGap);
+    const int visible_rows =
+        std::clamp(std::min(fit_rows, total_rows), 1, kMaxVisibleRows);
+
+    auto panel =
+        std::make_unique<SwitcherPanel>(columns, visible_rows, total_rows);
+    for (int i = 0; i < count; ++i) {
+      content::WebContents* const contents = order[i];
+      cards_.push_back(panel->AddCard(std::make_unique<SwitcherCard>(
+          contents, model_->IsTabPinned(model_->GetIndexOfWebContents(contents)),
+          base::BindRepeating(&TabSwitcher::OnCardClicked,
+                              base::Unretained(this), i))));
+    }
+    const gfx::Size size = panel->GetPreferredSize({});
+
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_BUBBLE);
+    params.parent = browser_widget->GetNativeView();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+    params.corner_radius = GetRadius() + 2;
+    params.name = "AerographeneTabSwitcher";
+    params.bounds =
+        gfx::Rect(window.CenterPoint().x() - size.width() / 2,
+                  window.CenterPoint().y() - size.height() / 2, size.width(),
+                  size.height());
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+    panel_ = widget_->SetContentsView(std::move(panel));
+
+    selected_ = forward ? std::min(1, count - 1) : count - 1;
+    UpdateSelection();
+    widget_->ShowInactive();
+
+    event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, browser_widget->GetNativeWindow(),
+        {ui::EventType::kKeyPressed, ui::EventType::kKeyReleased,
+         ui::EventType::kMousePressed});
+    // The monitor only observes: Esc is consumed by a pre-target handler so
+    // it does not also reach the page or exit fullscreen.
+    esc_window_ = browser_widget->GetNativeWindow();
+    esc_window_->AddPreTargetHandler(&esc_filter_);
+    browser_widget_observation_.Observe(browser_widget);
+    model_->AddObserver(this);
+  }
+  TabSwitcher(const TabSwitcher&) = delete;
+  TabSwitcher& operator=(const TabSwitcher&) = delete;
+
+  ~TabSwitcher() override {
+    StopObserving();
+    RemoveEscFilter();
+    event_monitor_.reset();
+    cards_.clear();
+    panel_ = nullptr;
+    widget_.reset();
+  }
+
+  BrowserWindowInterface* browser() const { return browser_; }
+
+  void Advance(bool forward) {
+    const int count = static_cast<int>(cards_.size());
+    selected_ = (selected_ + (forward ? 1 : count - 1)) % count;
+    UpdateSelection();
+  }
+
+  // Ends the switcher; activates the selected tab when |commit|.
+  void Finish(bool commit, bool widget_going_away = false) {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    if (commit && model_) {
+      const int index =
+          model_->GetIndexOfWebContents(cards_[selected_]->contents());
+      if (index != TabStripModel::kNoTab) {
+        model_->ActivateTabAt(
+            index, TabStripUserGestureDetails(
+                       TabStripUserGestureDetails::GestureType::kKeyboard));
+      }
+    }
+    StopObserving();
+    if (widget_going_away) {
+      // The parent is being destroyed and the child widget may have no
+      // native window left: do not Hide(), just drop it.
+      cards_.clear();
+      panel_ = nullptr;
+      widget_.reset();
+    } else if (widget_) {
+      widget_->Hide();
+    }
+    if (g_switcher == this) {
+      g_switcher = nullptr;
+    }
+    // We may be inside our own event monitor or a widget notification.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    if (finished_) {
+      return;
+    }
+    if (event.type() == ui::EventType::kMousePressed) {
+      Finish(/*commit=*/false);
+      return;
+    }
+    if (!event.IsKeyEvent()) {
+      return;
+    }
+    const ui::KeyboardCode key = event.AsKeyEvent()->key_code();
+    const bool is_ctrl = key == ui::VKEY_CONTROL || key == ui::VKEY_LCONTROL ||
+                         key == ui::VKEY_RCONTROL;
+    if (event.type() == ui::EventType::kKeyReleased) {
+      if (is_ctrl) {
+        Finish(/*commit=*/true);
+      }
+      return;
+    }
+    // Esc is handled (and consumed) by EscFilter.
+    if (key == ui::VKEY_ESCAPE) {
+      return;
+    }
+    // A key press without Ctrl held means Ctrl was released before this
+    // monitor existed (the Ctrl+Tab command is dispatched before the
+    // widget is up and there is no portable way to query the modifier
+    // state): an unrelated key must not confirm the switch, so cancel.
+    if (!is_ctrl && key != ui::VKEY_SHIFT &&
+        !(event.flags() & ui::EF_CONTROL_DOWN)) {
+      Finish(/*commit=*/false);
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      Finish(/*commit=*/false);
+    }
+  }
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override {
+    if (!visible) {
+      Finish(/*commit=*/false);
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    // The browser window goes away before our deferred deletion runs.
+    event_monitor_.reset();
+    RemoveEscFilter();
+    Finish(/*commit=*/false, /*widget_going_away=*/true);
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection)
+      override {
+    // Our cards hold WebContents pointers: any insert/remove/replace/move
+    // cancels instead of trying to keep the grid in sync.
+    if (change.type() != TabStripModelChange::kSelectionOnly) {
+      Finish(/*commit=*/false);
+    }
+  }
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override {
+    model_ = nullptr;
+    Finish(/*commit=*/false);
+  }
+
+ private:
+  // Consumes Esc while the switcher is open so it cancels only the switcher.
+  class EscFilter : public ui::EventHandler {
+   public:
+    explicit EscFilter(TabSwitcher* owner) : owner_(owner) {}
+    void OnKeyEvent(ui::KeyEvent* event) override {
+      if (owner_->finished_ || event->key_code() != ui::VKEY_ESCAPE) {
+        return;
+      }
+      if (event->type() == ui::EventType::kKeyPressed) {
+        owner_->Finish(/*commit=*/false);
+      }
+      event->SetHandled();
+      event->StopPropagation();
+    }
+
+   private:
+    const raw_ptr<TabSwitcher> owner_;
+  };
+
+  void RemoveEscFilter() {
+    if (esc_window_) {
+      esc_window_->RemovePreTargetHandler(&esc_filter_);
+      esc_window_ = nullptr;
+    }
+  }
+
+  void StopObserving() {
+    browser_widget_observation_.Reset();
+    if (model_) {
+      model_->RemoveObserver(this);
+      model_ = nullptr;
+    }
+  }
+
+  void UpdateSelection() {
+    for (size_t i = 0; i < cards_.size(); ++i) {
+      cards_[i]->SetSelected(static_cast<int>(i) == selected_);
+    }
+    cards_[selected_]->ScrollViewToVisible();
+    panel_->SetCounter(selected_, static_cast<int>(cards_.size()));
+  }
+
+  void OnCardClicked(int index) {
+    if (finished_) {
+      return;
+    }
+    selected_ = index;
+    Finish(/*commit=*/true);
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<TabStripModel> model_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<SwitcherPanel> panel_ = nullptr;
+  std::vector<raw_ptr<SwitcherCard>> cards_;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  EscFilter esc_filter_{this};
+  raw_ptr<aura::Window> esc_window_ = nullptr;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
+  int selected_ = 0;
+  bool finished_ = false;
+};
+
+}  // namespace
+
+bool ShowOrAdvanceTabSwitcher(BrowserWindowInterface* browser, bool forward) {
+  if (g_switcher && g_switcher->browser() == browser) {
+    g_switcher->Advance(forward);
+    return true;
+  }
+  if (g_switcher) {
+    g_switcher->Finish(/*commit=*/false);
+  }
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget() ||
+      browser->GetTabStripModel()->count() < 2) {
+    return false;
+  }
+  g_switcher = new TabSwitcher(browser, browser_view, forward);
+  return true;
+}
