+constexpr int kMaxColumns = 4;
+constexpr int kCardWidth = 208;
+constexpr int kCardInset = 6;
+constexpr int kThumbHeight = 112;
+constexpr int kCardHeight = 166;
+constexpr int kCardGap = 10;
+constexpr int kPanelPadding = 14;
+constexpr int kHeaderHeight = 30;
+constexpr int kFooterHeight = 38;
+constexpr int kMaxVisibleRows = 3;
+constexpr int kWindowMargin = 16;
+constexpr int kFaviconSize = 16;
+constexpr int kBigFaviconSize = 32;
+constexpr int kPinIconSize = 12;
+constexpr int kKeyPadding = 5;
+constexpr int kKeyHeight = 18;
+
+int GetRadius() {
+  const int radius = views::LayoutProvider::GetAerographeneControlRadius();
+  return radius >= 0 ? radius : 4;
+}
+
+const gfx::FontList& TitleFont() {
+  static const gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(0);
+  return font;
+}
+
+const gfx::FontList& SmallFont() {
+  static const gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(-2);
+  return font;
+}
+
+const gfx::FontList& MonoFont() {
+  static const gfx::FontList font("monospace, 11px");
+  return font;
+}
