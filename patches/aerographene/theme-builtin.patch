+// Applies the active theme's tokens (aerographene_theme.h) through the
+// kTokens name -> ColorId mapping.
+void AddThemeColors(ui::ColorMixer& mixer,
+                    const std::vector<aerographene::ThemeToken>& tokens) {
+  for (const aerographene::ThemeToken& token : tokens) {
+    for (const TokenSpec& spec : kTokens) {
+      if (token.name != spec.name) {
+        continue;
+      }
+      for (ui::ColorId id : spec.ids) {
+        if (id != 0) {
+          mixer[id] = ui::ColorTransform(token.color);
+        }
+      }
+      break;
+    }
+  }
+}
