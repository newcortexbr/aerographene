+namespace aerographene {
+
+namespace {
+BuiltinTheme g_theme = BuiltinTheme::kDefault;
+}  // namespace
+
+BuiltinTheme ParseBuiltinTheme(std::string_view value) {
+  return value == kThemePixelized ? BuiltinTheme::kPixelized
+                                  : BuiltinTheme::kDefault;
+}
+
+BuiltinTheme GetBuiltinTheme() {
+  return g_theme;
+}
+
+bool SetBuiltinTheme(BuiltinTheme theme) {
+  if (g_theme == theme) {
+    return false;
+  }
+  g_theme = theme;
+  return true;
+}
+
+}  // namespace aerographene

