+#ifndef CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_H_
+#define CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace aerographene {
+
+// Profile pref: theme name ("default" | "pixelized"). Read once in
+// ThemeService::Init; a change applies on the next browser start.
+inline constexpr char kThemePref[] = "aerographene.theme";
+inline constexpr char kThemeDefault[] = "default";
+inline constexpr char kThemePixelized[] = "pixelized";
+
+// Compiled icon packs a theme can pick as its base ("icons": {"base": ...}).
+inline constexpr char kIconPackDefault[] = "default";
+inline constexpr char kIconPackPixelized[] = "pixelized";
+
+// Compiled chrome drawing variants (mockups R-r01a): row label case, sidebar
+// background, URL size, new tab page.
+inline constexpr char kStyleDefault[] = "default";
+inline constexpr char kStylePixelized[] = "pixelized";
+
+// Every theme is dark or light by nature; no light/dark toggle.
+enum class ThemeScheme { kDark, kLight };
+
+// One color token, same names as theme.json "tokens".
+struct ThemeToken {
+  std::string name;
+  SkColor color;
+};
+
+// A theme as data. The built-in themes are instances of it; a theme read
+// from theme.json fills the same fields.
+struct ThemeData {
+  ThemeData();
+  ThemeData(const ThemeData&);
+  ThemeData& operator=(const ThemeData&);
+  ~ThemeData();
+
+  std::string name = kThemeDefault;
+  ThemeScheme scheme = ThemeScheme::kDark;
+  // Corner radii in px: controls, fields, menus, dialogs, tab tops / chips,
+  // badges and small inner items.
+  int radius = 4;
+  int radius_small = 3;
+  // UI font; empty family = system UI font.
+  std::string font_family;
+  int font_size_px = 0;
+  // Compiled icon pack (kIconPack*).
+  std::string icons_base = kIconPackDefault;
+  // Compiled chrome drawing variant (kStyle*).
+  std::string style = kStyleDefault;
+  // Applied in order through the theme token -> ColorId mapping.
+  std::vector<ThemeToken> tokens;
+};
+
+// Built-in theme by name; unknown names map to "default".
+const ThemeData& GetBuiltinTheme(std::string_view name);
+
+// Process-wide active theme (UI thread). Last regular profile initialized
+// wins; "default" until set. SetActiveTheme returns true if the active theme
+// name changed.
+const ThemeData& GetActiveTheme();
+bool SetActiveTheme(const ThemeData& theme);
+
+// Shorthand for GetActiveTheme().style == kStylePixelized.
+bool UsesPixelizedStyle();
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_THEMES_AEROGRAPHENE_THEME_H_

