+// Profile pref: "default" | "pixelized". Read once in ThemeService::Init;
+// a change applies on the next browser start.
+inline constexpr char kThemePref[] = "aerographene.theme";
+inline constexpr char kThemeDefault[] = "default";
+inline constexpr char kThemePixelized[] = "pixelized";
+
+enum class BuiltinTheme { kDefault, kPixelized };
+
+// Unknown values map to kDefault.
+BuiltinTheme ParseBuiltinTheme(std::string_view value);
+
+// Process-wide active built-in theme (UI thread). Last regular profile
+// initialized wins. Returns true if the value changed.
+BuiltinTheme GetBuiltinTheme();
+bool SetBuiltinTheme(BuiltinTheme theme);
+
+}  // namespace aerographene
