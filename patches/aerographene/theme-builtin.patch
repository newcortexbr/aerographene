+    {"on_accent", SkColorSetRGB(0x0B, 0x0B, 0x0B)},
+};
+
+template <size_t N>
+std::vector<ThemeToken> ToTokens(const BuiltinToken (&table)[N]) {
+  std::vector<ThemeToken> tokens;
+  tokens.reserve(N);
+  for (const BuiltinToken& token : table) {
+    tokens.push_back({token.name, token.color});
+  }
+  return tokens;
+}
+
+ThemeData MakeDefaultTheme() {
+  ThemeData theme;
+  theme.name = kThemeDefault;
+  theme.scheme = ThemeScheme::kDark;
+  // default.md: 4px controls, 3px inner items; system UI font.
+  theme.radius = 4;
+  theme.radius_small = 3;
+  theme.icons_base = kIconPackDefault;
+  theme.style = kStyleDefault;
+  theme.tokens = ToTokens(kDefaultTokens);
+  return theme;
+}
+
+ThemeData MakePixelizedTheme() {
+  ThemeData theme;
+  theme.name = kThemePixelized;
+  theme.scheme = ThemeScheme::kDark;
+  // pixelized mockups: 0 on fields, buttons, menus and tabs; 2px on
+  // chips/badges; JetBrains Mono 12px (mono size of the mockups).
+  theme.radius = 0;
+  theme.radius_small = 2;
+  theme.font_family = "JetBrains Mono";
+  theme.font_size_px = 12;
+  theme.icons_base = kIconPackPixelized;
+  theme.style = kStylePixelized;
+  theme.tokens = ToTokens(kPixelizedTokens);
+  return theme;
+}
+
+ThemeData& ActiveTheme() {
+  static base::NoDestructor<ThemeData> active(MakeDefaultTheme());
+  return *active;
+}
+
+}  // namespace
+
+ThemeData::ThemeData() = default;
+ThemeData::ThemeData(const ThemeData&) = default;
+ThemeData& ThemeData::operator=(const ThemeData&) = default;
+ThemeData::~ThemeData() = default;
+
+const ThemeData& GetBuiltinTheme(std::string_view name) {
+  static const base::NoDestructor<ThemeData> default_theme(MakeDefaultTheme());
+  static const base::NoDestructor<ThemeData> pixelized_theme(
+      MakePixelizedTheme());
+  return name == kThemePixelized ? *pixelized_theme : *default_theme;
+}
+
+const ThemeData& GetActiveTheme() {
+  return ActiveTheme();
+}
+
+bool SetActiveTheme(const ThemeData& theme) {
+  ThemeData& active = ActiveTheme();
+  if (active.name == theme.name) {
+    return false;
+  }
+  active = theme;
+  return true;
+}
+
+bool UsesPixelizedStyle() {
+  return GetActiveTheme().style == kStylePixelized;
+}
+
+}  // namespace aerographene

