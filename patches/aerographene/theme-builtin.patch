+// Applies one built-in table through the kTokens name -> ColorId mapping.
+template <size_t N>
+void AddBuiltinColors(ui::ColorMixer& mixer, const BuiltinToken (&table)[N]) {
+  for (const BuiltinToken& token : table) {
+    for (const TokenSpec& spec : kTokens) {
+      if (std::string_view(spec.name) != token.name) {
+        continue;
+      }
+      for (ui::ColorId id : spec.ids) {
+        if (id != 0) {
+          mixer[id] = ui::ColorTransform(token.color);
+        }
+      }
+      break;
+    }
+  }
+}
