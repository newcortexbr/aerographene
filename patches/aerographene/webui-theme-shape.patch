+// aerographene: shape (and, for pixelized, font) of the WebUI pages, appended
+// to colors.css so it follows the active built-in theme and is refreshed with
+// the colors. Variables are consumed by cr_elements, chrome://history and
+// chrome://settings with their upstream value as fallback. `html:not(#z)`
+// out-ranks the `html {}` defaults of cr_shared_vars.css (same trick as the
+// colors block).
+std::string AerographeneThemeCss() {
+  // Both themes: no pill, no elevation shadow; contour as an inset hairline.
+  constexpr char kCommon[] =
+      "--cr-card-shadow:inset 0 0 0 1px var(--color-separator,"
+      "rgba(255,255,255,.14));";
+  if (aerographene::UsesPixelizedStyle()) {
+    return base::StrCat(
+        {"html:not(#z){", kCommon,
+         "--aero-radius:0;--aero-radius-sm:0;--cr-card-border-radius:0;"
+         "--cr-dialog-border-radius:0;--cr-menu-border-radius:0;"
+         "--cr-input-border-radius:0;--cr-chip-border-radius:2px;"
+         "--aero-radius-check:0;--aero-radius-radio:0;}"
+         "html:not(#z) body,html:not(#z) button{"
+         "font-family:\"JetBrains Mono\",monospace;}"});
+  }
+  return base::StrCat(
+      {"html:not(#z){", kCommon,
+       "--aero-radius:4px;--aero-radius-sm:3px;--cr-card-border-radius:4px;"
+       "--cr-dialog-border-radius:4px;--cr-menu-border-radius:4px;"
+       "--cr-input-border-radius:4px;--cr-chip-border-radius:4px;}"});
+}
