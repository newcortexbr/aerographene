+#ifndef COMPONENTS_OMNIBOX_BROWSER_AERO_NOTES_COMMAND_H_
+#define COMPONENTS_OMNIBOX_BROWSER_AERO_NOTES_COMMAND_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace aerographene {
+
+// Command bar entry `o:` (notes tab). Accepts "o:" or "o: <term>" (the space
+// after the colon is optional, "o" is case-insensitive, surrounding whitespace
+// is ignored) and returns the search term ("" for a bare "o:"). The term is
+// taken as typed (trimmed, at most kMaxNotesCommandTerm UTF-16 units, no
+// control characters); the page runs the vault search with it. Anything else
+// ("o", "ox:", "o :", "-o") returns nullopt.
+inline constexpr size_t kMaxNotesCommandTerm = 256;
+std::optional<std::u16string> ParseNotesCommand(std::u16string_view text);
+
+// The page the command opens. With a term: "chrome://notes/?q=<term>"
+// (percent-encoded UTF-8), reusing the window's notes tab. Bare "o:":
+// "chrome://notes/?new=1", which chrome::Navigate does not fold into an
+// existing notes tab (the owner wants a new one). Neither opens a document.
+std::string NotesCommandUrl(const std::u16string& term);
+
+}  // namespace aerographene
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_AERO_NOTES_COMMAND_H_
