+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "components/omnibox/browser/aero_notes_command.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+
+TEST(AeroNotesCommandTest, Accepts) {
+  EXPECT_EQ(ParseNotesCommand(u"o:"), u"");
+  EXPECT_EQ(ParseNotesCommand(u"  O:  "), u"");
+  EXPECT_EQ(ParseNotesCommand(u"o: ideias"), u"ideias");
+  EXPECT_EQ(ParseNotesCommand(u"o:ideias"), u"ideias");
+  EXPECT_EQ(ParseNotesCommand(u"O:   dia 2026-10-13 "), u"dia 2026-10-13");
+  EXPECT_EQ(ParseNotesCommand(u"o: pasta/nota"), u"pasta/nota");
+  EXPECT_EQ(ParseNotesCommand(u"o: \u00e7\u00e3o"), u"\u00e7\u00e3o");
+  EXPECT_EQ(ParseNotesCommand(u"o: a: b"), u"a: b");
+}
+
+TEST(AeroNotesCommandTest, Rejects) {
+  for (const char16_t* s : {u"", u"o", u":", u"ox:", u"o :", u"-o", u"-o x",
+                            u"oo:", u"a o:", u"o: a\x01", u"o: a\x7f",
+                            u"o: a\tb"}) {
+    EXPECT_FALSE(ParseNotesCommand(s)) << base::UTF16ToUTF8(s);
+  }
+  EXPECT_FALSE(ParseNotesCommand(u"o: " + std::u16string(257, u'a')));
+  EXPECT_TRUE(ParseNotesCommand(u"o: " + std::u16string(256, u'a')));
+}
+
+TEST(AeroNotesCommandTest, Url) {
+  EXPECT_EQ(NotesCommandUrl(u""), "chrome://notes/?new=1");
+  EXPECT_EQ(NotesCommandUrl(u"ideias"), "chrome://notes/?q=ideias");
+  EXPECT_EQ(NotesCommandUrl(u"a b/c#d&e=f"),
+            "chrome://notes/?q=a%20b%2Fc%23d%26e%3Df");
+  EXPECT_EQ(NotesCommandUrl(u"\u00e7\u00e3o"),
+            "chrome://notes/?q=%C3%A7%C3%A3o");
+}
+
+}  // namespace aerographene
