@@ -0,0 +1,38 @@
+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "components/omnibox/browser/aero_notes_command.h"
+
+#include "base/strings/escape.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace aerographene {
+
+std::optional<std::u16string> ParseNotesCommand(std::u16string_view text) {
+  std::u16string_view t = base::TrimWhitespace(text, base::TRIM_ALL);
+  if (t.size() < 2 || (t[0] != u'o' && t[0] != u'O') || t[1] != u':') {
+    return std::nullopt;
+  }
+  std::u16string_view rest = base::TrimWhitespace(t.substr(2), base::TRIM_ALL);
+  if (rest.size() > kMaxNotesCommandTerm) {
+    return std::nullopt;
+  }
+  for (char16_t c : rest) {
+    if (c < 0x20 || c == 0x7f) {
+      return std::nullopt;
+    }
+  }
+  return std::u16string(rest);
+}
+
+std::string NotesCommandUrl(const std::u16string& term) {
+  if (term.empty()) {
+    return "chrome://notes/?new=1";
+  }
+  return "chrome://notes/?q=" +
+         base::EscapeQueryParamValue(base::UTF16ToUTF8(term),
+                                     /*use_plus=*/false);
+}
+
+}  // namespace aerographene
