+void HistoryBackend::QueryColdHistory(const std::u16string& text_query,
+                                      const QueryOptions& query_options,
+                                      QueryResults* result) {
+  ColdHistoryDatabase* cold = expirer_.GetColdDatabaseIfExists();
+  if (!cold) {
+    result->set_reached_beginning(true);
+    return;
+  }
+  // History-Cold has no context_annotations table.
+  QueryOptions options(query_options);
+  options.policy_for_404_visits = VisitQuery404sPolicy::kInclude404s;
+
+  auto get_url_row = [&](URLID id, URLRow* row) {
+    return cold->GetURLRow(id, row) || db_->GetURLRow(id, row);
+  };
+  auto make_result = [](const URLRow& row, const VisitRow& visit) {
+    URLResult url_result(row);
+    url_result.set_visit_id(visit.visit_id);
+    url_result.set_visit_time(visit.visit_time);
+    url_result.set_app_id(visit.app_id);
+    url_result.set_actor_source(visit.source == SOURCE_ACTOR);
+    url_result.set_blocked_visit(
+        (visit.transition & ui::PAGE_TRANSITION_BLOCKED) != 0);
+    return url_result;
+  };
+
+  std::vector<URLResult> matching;
+  bool has_more_results = false;
+  if (text_query.empty()) {
+    VisitVector visits;
+    has_more_results = cold->GetVisibleVisitsInRange(options, &visits);
+    for (const VisitRow& visit : visits) {
+      URLRow row;
+      if (!get_url_row(visit.url_id, &row) || !row.url().is_valid()) {
+        continue;
+      }
+      matching.push_back(make_result(row, visit));
+    }
+  } else {
+    // Cold rows, plus hot rows of revisited URLs (their old visits are cold).
+    URLRows rows;
+    for (URLDatabase* url_db : {static_cast<URLDatabase*>(cold),
+                                static_cast<URLDatabase*>(db_.get())}) {
+      URLRows found;
+      if (options.host_only) {
+        URLDatabase::URLEnumerator iter;
+        if (url_db->InitURLEnumeratorForEverything(&iter)) {
+          const std::string host = base::UTF16ToUTF8(text_query);
+          URLRow row;
+          while (iter.GetNextURL(&row)) {
+            if (row.url().is_valid() && row.url().GetHost() == host) {
+              found.push_back(row);
+            }
+          }
+        }
+      } else {
+        found = url_db->GetTextMatchesWithAlgorithm(
+            text_query, options.matching_algorithm.value_or(
+                            query_parser::MatchingAlgorithm::DEFAULT));
+      }
+      rows.insert(rows.end(), found.begin(), found.end());
+    }
+    std::set<URLID> seen;
+    for (const URLRow& row : rows) {
+      if (!seen.insert(row.id()).second) {
+        continue;
+      }
+      VisitVector visits;
+      cold->GetVisibleVisitsForURL(row.id(), options, &visits);
+      for (const VisitRow& visit : visits) {
+        matching.push_back(make_result(row, visit));
+      }
+    }
+    std::sort(matching.begin(), matching.end(), URLResult::CompareVisitTime);
+    if (options.max_count > 0 &&
+        matching.size() > static_cast<size_t>(options.max_count)) {
+      has_more_results = true;
+      matching.resize(options.max_count);
+    }
+  }
+  result->SetURLResults(std::move(matching));
+  result->set_reached_beginning(!has_more_results);
+}
