+:root {
+  --bg: #070a12;
+  --grid: #121828;
+  --panel: #0c111d;
+  --text: #dbe6ff;
+  --text2: #8391b3;
+  --line: #22304d;
+  --accent: #5aa2ff;
+  --mono: "JetBrains Mono", "DejaVu Sans Mono", monospace;
+}
+* { box-sizing: border-box; margin: 0; }
+html, body { height: 100%; overflow: hidden; }
+body {
+  background: var(--bg);
+  color: var(--text);
+  display: flex;
+  flex-direction: column;
+  font: 13px/1.4 "Noto Sans", "DejaVu Sans", system-ui, sans-serif;
+}
+.bar {
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+  display: flex;
+  gap: 12px;
+  height: 36px;
+  padding: 0 12px;
+}
+.bar button {
+  background: none;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  color: var(--text);
+  font: inherit;
+  padding: 2px 10px;
+}
+.bar button:hover { border-color: var(--accent); }
+.note { color: var(--text2); font-size: 12px; }
+.board {
+  background-color: var(--bg);
+  background-image:
+      linear-gradient(var(--grid) 1px, transparent 1px),
+      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
+  background-size: 24px 24px;
+  flex: 1;
+  overflow: hidden;
+  position: relative;
+}
+.win {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  display: flex;
+  flex-direction: column;
+  min-height: 120px;
+  min-width: 220px;
+  position: absolute;
+}
+.win.focused { border-color: var(--accent); }
+.win-head {
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+  cursor: grab;
+  display: flex;
+  height: 28px;
+  padding: 0 4px 0 10px;
+  touch-action: none;
+  user-select: none;
+}
+.win-head:active { cursor: grabbing; }
+.win-title {
+  color: var(--text2);
+  flex: 1;
+  font-family: var(--mono);
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.win-close {
+  background: none;
+  border: 0;
+  border-radius: 4px;
+  color: var(--text2);
+  font-size: 16px;
+  height: 22px;
+  width: 22px;
+}
+.win-close:hover { background: var(--line); color: var(--text); }
+.win-body {
+  color: var(--text);
+  flex: 1;
+  font: 12px/1.45 var(--mono);
+  overflow: hidden;
+  padding: 8px 10px;
+  white-space: pre-wrap;
+}
+.win-resize {
+  bottom: 0;
+  cursor: nwse-resize;
+  height: 14px;
+  position: absolute;
+  right: 0;
+  touch-action: none;
+  width: 14px;
+}
