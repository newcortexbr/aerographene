+<!doctype html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8">
+<title>t: 0 terminals</title>
+<meta name="color-scheme" content="dark">
+<link rel="stylesheet" href="terminal.css">
+<script type="module" src="terminal.js"></script>
+</head>
+<body>
+<header class="bar">
+  <button id="add" type="button">+ terminal</button>
+  <span class="note">esqueleto: janelas sem shell (sem pty nesta fatia)</span>
+</header>
+<div class="board" id="board" aria-label="quadro de terminais"></div>
+<template id="winTpl">
+  <section class="win" role="group">
+    <header class="win-head">
+      <span class="win-title"></span>
+      <button class="win-close" type="button" aria-label="fechar">×</button>
+    </header>
+    <pre class="win-body"></pre>
+    <div class="win-resize" aria-hidden="true"></div>
+  </section>
+</template>
+</body>
+</html>
