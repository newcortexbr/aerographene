+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_AERO_TERMINAL_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_AERO_TERMINAL_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class BrowserContext;
+}
+
+inline constexpr char kAeroTerminalHost[] = "terminal";
+
+class AeroTerminalUI;
+
+// chrome://terminal (shown as aerographene://terminal). Only the config
+// lives in the WebUIConfigMap; the controller and its data source are created
+// when a tab navigates to the page, so nothing runs at startup. Linux only.
+class AeroTerminalUIConfig
+    : public content::DefaultWebUIConfig<AeroTerminalUI> {
+ public:
+  AeroTerminalUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kAeroTerminalHost) {}
+
+  // Off the record (incognito and guest) profiles never get the terminal.
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+};
+
+// Static skeleton: no Mojo, no pty, no WebUI message handlers, no network.
+class AeroTerminalUI : public content::WebUIController {
+ public:
+  explicit AeroTerminalUI(content::WebUI* web_ui);
+
+  AeroTerminalUI(const AeroTerminalUI&) = delete;
+  AeroTerminalUI& operator=(const AeroTerminalUI&) = delete;
+
+  ~AeroTerminalUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_AERO_TERMINAL_UI_H_
