+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+// Skeleton of chrome://terminal: a board with fake terminal windows that can
+// be dragged, resized, focused and closed. No pty, no Mojo, no network, no
+// innerHTML (Trusted Types is enforced by the WebUI CSP).
+
+const MIN_W = 220;
+const MIN_H = 120;
+
+const board = document.getElementById('board');
+const tpl = document.getElementById('winTpl');
+let count = 0;
+let nextId = 1;
+let topZ = 1;
+
+function updateTitle() {
+  document.title = count === 1 ? 't: 1 terminal' : `t: ${count} terminals`;
+}
+
+function focusWin(win) {
+  for (const w of board.querySelectorAll('.win.focused')) {
+    w.classList.remove('focused');
+  }
+  win.classList.add('focused');
+  win.style.zIndex = String(++topZ);
+}
+
+function clamp(v, lo, hi) {
+  return Math.max(lo, Math.min(hi, v));
+}
+
+// Calls onMove(dx, dy) while the pointer is captured by `handle`.
+function track(handle, onStart, onMove) {
+  let x0 = 0;
+  let y0 = 0;
+  handle.addEventListener('pointerdown', (e) => {
+    if (e.button !== 0 || e.target.closest('button')) {
+      return;
+    }
+    x0 = e.clientX;
+    y0 = e.clientY;
+    onStart();
+    handle.setPointerCapture(e.pointerId);
+    e.preventDefault();
+  });
+  handle.addEventListener('pointermove', (e) => {
+    if (handle.hasPointerCapture(e.pointerId)) {
+      onMove(e.clientX - x0, e.clientY - y0);
+    }
+  });
+  const stop = (e) => {
+    if (handle.hasPointerCapture(e.pointerId)) {
+      handle.releasePointerCapture(e.pointerId);
+    }
+  };
+  handle.addEventListener('pointerup', stop);
+  handle.addEventListener('pointercancel', stop);
+}
+
+function addWindow() {
+  const id = nextId++;
+  const win = tpl.content.firstElementChild.cloneNode(true);
+  const b = board.getBoundingClientRect();
+  const w = Math.min(520, Math.max(MIN_W, b.width - 48));
+  const h = Math.min(300, Math.max(MIN_H, b.height - 48));
+  const offset = ((id - 1) % 8) * 28;
+  const box = {
+    x: clamp(24 + offset, 0, Math.max(0, b.width - w)),
+    y: clamp(24 + offset, 0, Math.max(0, b.height - h)),
+    w,
+    h,
+  };
+  const apply = () => {
+    win.style.left = `${box.x}px`;
+    win.style.top = `${box.y}px`;
+    win.style.width = `${box.w}px`;
+    win.style.height = `${box.h}px`;
+  };
+  apply();
+
+  win.querySelector('.win-title').textContent = `terminal ${id}`;
+  win.querySelector('.win-body').textContent =
+      `sessão ${id} (falsa)\nsem shell nesta fatia: o pty chega na C2/C3.\n$ `;
+  win.setAttribute('aria-label', `terminal ${id}`);
+
+  let start = {...box};
+  track(win.querySelector('.win-head'), () => {
+    start = {...box};
+    focusWin(win);
+  }, (dx, dy) => {
+    const r = board.getBoundingClientRect();
+    box.x = clamp(start.x + dx, 0, Math.max(0, r.width - box.w));
+    box.y = clamp(start.y + dy, 0, Math.max(0, r.height - box.h));
+    apply();
+  });
+  track(win.querySelector('.win-resize'), () => {
+    start = {...box};
+    focusWin(win);
+  }, (dx, dy) => {
+    const r = board.getBoundingClientRect();
+    box.w = clamp(start.w + dx, MIN_W, Math.max(MIN_W, r.width - box.x));
+    box.h = clamp(start.h + dy, MIN_H, Math.max(MIN_H, r.height - box.y));
+    apply();
+  });
+  win.addEventListener('pointerdown', () => focusWin(win));
+  win.querySelector('.win-close').addEventListener('click', () => {
+    win.remove();
+    count--;
+    updateTitle();
+  });
+
+  board.appendChild(win);
+  count++;
+  focusWin(win);
+  updateTitle();
+}
+
+document.getElementById('add').addEventListener('click', addWindow);
+addWindow();
