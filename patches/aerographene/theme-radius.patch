+#if BUILDFLAG(IS_LINUX)
+  if (profile_->IsRegularProfile()) {
+    // default.md: 4px controls, 3px inner items. pixelized mockups: 0 on
+    // fields, buttons, menus and tabs; 2px on chips/badges.
+    const bool pixelized = aerographene::GetBuiltinTheme() ==
+                           aerographene::BuiltinTheme::kPixelized;
+    views::LayoutProvider::SetAerographeneCornerRadii(pixelized ? 0 : 4,
+                                                      pixelized ? 2 : 3);
+  }
+#endif
 
   InitFromPrefs();
 

