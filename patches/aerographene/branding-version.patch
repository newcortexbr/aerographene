aerographene: versão do produto v0.x.x (aero::kVersion) sem alterar a versão do Chromium.

Origem: aerographene (original; ideia de versão própria como helium/core/add-helium-versioning.patch,
sem alterar mensagens GRIT nem HTML/TS). Licença: GPL-3.0.
Efeito: `--version` imprime "aerographene 0.1.0 (Chromium 154.0.8037.97)"; `--product-version`
imprime 0.1.0; chrome://version e a página Sobre mostram "0.1.0 (Chromium 154.0.8037.97)" no lugar do
número de versão. UA, extensões e PRODUCT_VERSION seguem com a versão do Chromium.
A versão fica em chrome/common/aero_version.h (header pequeno, incluído só por chrome_main_delegate.cc e
version_ui.cc), não no BRANDING nem em base/version_info: subir a versão não recompila a árvore.
build/inner.sh confere se coincide com AERO_VERSION de build/config.sh.
Independente de branding.patch.

diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -38,6 +38,7 @@
 #include "base/time/time.h"
 #include "base/timer/timer.h"
 #include "build/build_config.h"
+#include "chrome/common/aero_version.h"
 #include "chrome/common/buildflags.h"
 #include "chrome/common/channel_info.h"
 #include "chrome/common/chrome_constants.h"
@@ -412,16 +413,17 @@
 bool HandleVersionSwitches(const base::CommandLine& command_line) {
 #if !BUILDFLAG(IS_MAC)
   if (command_line.HasSwitch(switches::kProductVersion)) {
-    UNSAFE_TODO(printf("%s\n", version_info::GetVersionNumber().data()));
+    UNSAFE_TODO(printf("%s\n", aero::kVersion.data()));
     return true;
   }
 #endif
 
   if (command_line.HasSwitch(switches::kVersion)) {
-    UNSAFE_TODO(printf(
-        "%s %s %s\n", version_info::GetProductName().data(),
-        version_info::GetVersionNumber().data(),
-        chrome::GetChannelName(chrome::WithExtendedStable(true)).c_str()));
+    // aerographene: "aerographene 0.1.0 (Chromium 154.0.8037.97)".
+    UNSAFE_TODO(printf("%s %s (Chromium %s)\n",
+                       version_info::GetProductName().data(),
+                       aero::kVersion.data(),
+                       version_info::GetVersionNumber().data()));
     return true;
   }
 
