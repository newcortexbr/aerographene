diff --git a/chrome/common/aero_version.h b/chrome/common/aero_version.h
new file mode 100644
--- /dev/null
+++ b/chrome/common/aero_version.h
@@ -0,0 +1,20 @@
+// Copyright 2026 The aerographene Authors. All rights reserved.
+// Use of this source code is governed by a GPL-3.0 license.
+
+#ifndef CHROME_COMMON_AERO_VERSION_H_
+#define CHROME_COMMON_AERO_VERSION_H_
+
+#include <string_view>
+
+namespace aero {
+
+// aerographene: versão do produto (v0.x.x). Header pequeno e próprio, incluído
+// só por chrome_main_delegate.cc e version_ui.cc: mudar a versão não recompila
+// a árvore (base/version_info e o BRANDING, incluídos em toda parte, ficam
+// intactos). Mantido igual a AERO_VERSION de build/config.sh (checado em
+// build/inner.sh).
+inline constexpr std::string_view kVersion = "0.1.0";
+
+}  // namespace aero
+
+#endif  // CHROME_COMMON_AERO_VERSION_H_
