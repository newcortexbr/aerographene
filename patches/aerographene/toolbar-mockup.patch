+// aerographene: the avatar is a square with the theme corner radius (4px
+// default, 0 pixelized) and a 1px line, never a circle (mockups: .av 28x28,
+// radius var(--r), inset 1px var(--line)). The placeholder of a profile with no
+// picture is the upstream "account circle" vector icon, a circle by itself, so
+// cropping it does not help: it is drawn here as in the mockup (person
+// silhouette: head circle and shoulders on the theme surface). Pictures are
+// scaled to the square and clipped to the rounded rect.
+class AerographeneAvatarSource : public gfx::CanvasImageSource {
+ public:
+  AerographeneAvatarSource(int size,
+                           gfx::ImageSkia picture,
+                           int radius,
+                           SkColor background,
+                           SkColor foreground,
+                           SkColor line)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        size_(size),
+        picture_(std::move(picture)),
+        radius_(radius),
+        background_(background),
+        foreground_(foreground),
+        line_(line) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float s = size_ / 28.0f;  // The mockup draws on a 28x28 grid.
+    canvas->Save();
+    canvas->ClipPath(
+        SkPath::RRect(SkRect::MakeWH(size_, size_), radius_, radius_), true);
+    if (!picture_.isNull()) {
+      canvas->DrawImageInt(picture_, 0, 0);
+    } else {
+      canvas->FillRect(gfx::Rect(size_, size_), background_);
+      cc::PaintFlags fill;
+      fill.setAntiAlias(true);
+      fill.setColor(foreground_);
+      canvas->DrawCircle(gfx::PointF(14 * s, 11 * s), 5 * s, fill);
+      SkPath shoulders;
+      shoulders.moveTo(4 * s, 28 * s);
+      shoulders.cubicTo(5 * s, 21 * s, 9 * s, 18 * s, 14 * s, 18 * s);
+      shoulders.cubicTo(19 * s, 18 * s, 23 * s, 21 * s, 24 * s, 28 * s);
+      shoulders.close();
+      canvas->DrawPath(shoulders, fill);
+    }
+    canvas->Restore();
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1);
+    stroke.setColor(line_);
+    canvas->DrawRoundRect(gfx::RectF(0.5f, 0.5f, size_ - 1, size_ - 1),
+                          radius_ > 0 ? radius_ - 0.5f : 0, stroke);
+  }
+
+ private:
+  const int size_;
+  const gfx::ImageSkia picture_;
+  const int radius_;
+  const SkColor background_;
+  const SkColor foreground_;
+  const SkColor line_;
+};
+
+gfx::Image CropAerographeneAvatar(const gfx::Image& image,
+                                  AvatarIconType icon_type,
+                                  int size,
+                                  const ui::ColorProvider& color_provider) {
+  int radius = views::LayoutProvider::GetAerographeneControlRadius();
+  if (radius < 0) {
+    radius = 4;
+  }
+  gfx::ImageSkia picture;
+  if (icon_type != AvatarIconType::kPlaceholder) {
+    picture = profiles::GetSizedAvatarIcon(image, size, size,
+                                           profiles::SHAPE_SQUARE)
+                  .AsImageSkia();
+  }
+  return gfx::Image(gfx::CanvasImageSource::MakeImageSkia<
+                    AerographeneAvatarSource>(
+      size, std::move(picture), radius,
+      color_provider.GetColor(ui::kColorSysSurface),
+      color_provider.GetColor(ui::kColorSysOnSurface),
+      color_provider.GetColor(kColorToolbarSeparator)));
+}
+
 }  // namespace
 
