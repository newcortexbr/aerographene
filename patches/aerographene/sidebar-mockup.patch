+
+AerographeneSpaceRow::AerographeneSpaceRow(BrowserWindowInterface* browser)
+    : views::Button(base::BindRepeating(
+          [](BrowserWindowInterface* browser, const ui::Event&) {
+            chrome::ExecuteCommand(browser, IDC_SHOW_AVATAR_MENU);
+          },
+          browser)),
+      browser_(browser) {
+  SetVisible(false);
+}
+
+AerographeneSpaceRow::~AerographeneSpaceRow() = default;
+
+gfx::Size AerographeneSpaceRow::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Width comes from the parent (cross-axis stretch).
+  return gfx::Size(0, GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+}
+
+void AerographeneSpaceRow::AddedToWidget() {
+  RefreshName();
+}
+
+void AerographeneSpaceRow::RefreshName() {
+  std::u16string name;
+  Profile* const profile = browser_ ? browser_->GetProfile() : nullptr;
+  if (profile && profile->IsRegularProfile() &&
+      g_browser_process->profile_manager()) {
+    if (ProfileAttributesEntry* entry =
+            g_browser_process->profile_manager()
+                ->GetProfileAttributesStorage()
+                .GetProfileAttributesWithPath(profile->GetPath())) {
+      name = entry->GetName();
+    }
+  }
+  if (name == name_ && GetVisible() == !name.empty()) {
+    return;
+  }
+  name_ = std::move(name);
+  SetTooltipText(name_);
+  GetViewAccessibility().SetName(name_);
+  SetVisible(!name_.empty());
+  SchedulePaint();
+}
+
+void AerographeneSpaceRow::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const colors = GetColorProvider();
+  // Not drawn in the collapsed (narrow) strip.
+  if (!colors || name_.empty() || width() < kMinPaintWidth) {
+    return;
+  }
+  const gfx::Rect bounds = GetLocalBounds();
+  const bool hovered =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  if (hovered) {
+    const int radius = views::LayoutProvider::GetAerographeneControlRadius();
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(colors->GetColor(kColorToolbarInkDropHover));
+    canvas->DrawRoundRect(bounds, radius >= 0 ? radius : 4, fill);
+  }
+  const SkColor text_color = colors->GetColor(
+      hovered ? kColorTabForegroundActiveFrameActive
+              : kColorTabForegroundInactiveFrameActive);
+  const int icon_y = bounds.y() + (bounds.height() - kIconSize) / 2;
+  const int icon_x = bounds.x() + kPadding;
+  canvas->DrawImageInt(
+      gfx::CreateVectorIcon(vector_icons::kFolderFlippableIcon, kIconSize,
+                            colors->GetColor(ui::kColorSysPrimary)),
+      GetMirroredXWithWidthInView(icon_x, kIconSize), icon_y);
+  const int chevron_x = bounds.right() - kPadding - kIconSize;
+  canvas->DrawImageInt(
+      gfx::CreateVectorIcon(vector_icons::kKeyboardArrowDownIcon, kIconSize,
+                            text_color),
+      GetMirroredXWithWidthInView(chevron_x, kIconSize), icon_y);
+  const int text_x = icon_x + kIconSize + kIconGap;
+  canvas->DrawStringRect(
+      name_, gfx::FontList(), text_color,
+      GetMirroredRect(gfx::Rect(text_x, bounds.y(),
+                                std::max(0, chevron_x - kIconGap - text_x),
+                                bounds.height())));
+}
