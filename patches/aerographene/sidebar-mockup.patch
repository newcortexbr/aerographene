+// aerographene: sidebar tab/pinned look of the mockups R-r01a (default and
+// pixelized). Painted with a few rects and one cached 96x32 bitmap; nothing is
+// allocated per frame.
+constexpr int kAeroIndicatorHeight = 2;
+constexpr int kAeroIndicatorInset = 8;
+constexpr int kAeroRampWidth = 96;
+constexpr int kAeroRampHeight = 32;
+constexpr int kAeroDotSize = 2;
+constexpr int kAeroMarkerSize = 6;
+constexpr int kAeroMarkerInset = 3;
+constexpr int kAeroChipPaddingH = 6;
+constexpr int kAeroChipPaddingV = 2;
+
+bool IsAeroPixelized() {
+  return aerographene::GetBuiltinTheme() ==
+         aerographene::BuiltinTheme::kPixelized;
+}
+
+int GetAeroRadius() {
+  const int radius = views::LayoutProvider::GetAerographeneControlRadius();
+  return radius >= 0 ? radius : 4;
+}
+
+// Bayer 4x4 ordered dither with 2px dots; density grows to the right (ramp
+// of assets/ramp-bayer-2.png). Drawn without filtering so it stays crisp.
+const gfx::ImageSkia& GetAeroRamp() {
+  static const base::NoDestructor<gfx::ImageSkia> ramp([] {
+    static constexpr uint8_t kBayer[4][4] = {
+        {0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5}};
+    constexpr int kCols = kAeroRampWidth / kAeroDotSize;
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(kAeroRampWidth, kAeroRampHeight);
+    bitmap.eraseColor(SK_ColorTRANSPARENT);
+    for (int y = 0; y < kAeroRampHeight; ++y) {
+      for (int x = 0; x < kAeroRampWidth; ++x) {
+        const int cx = x / kAeroDotSize;
+        const int cy = y / kAeroDotSize;
+        const float density = (cx + 1.0f) / kCols;
+        const float threshold = (kBayer[cy & 3][cx & 3] + 0.5f) / 16.0f;
+        if (threshold < density) {
+          *bitmap.getAddr32(x, y) = SkColorSetRGB(0xF2, 0xF2, 0xF2);
+        }
+      }
+    }
+    return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+  }());
+  return *ramp;
+}
+
+// Draws the background of a vertical (sidebar) tab: default = faint fill
+// (active: tenuous gradient, 1px outline on top and sides, 2px accent bar on
+// top; no bottom line), pixelized = black block with white outline, Bayer
+// ramp at the end and chips behind the name and the close button. Inactive
+// tabs have no fill; hover uses the theme hover color.
+void PaintAeroVerticalTab(gfx::Canvas* canvas,
+                          const TabView& tab,
+                          bool hovered) {
+  const ui::ColorProvider* const colors = tab.GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const bool pixelized = IsAeroPixelized();
+  const bool pinned = tab.pinned();
+  const bool active = tab.IsActive();
+  const gfx::Rect bounds = tab.GetLocalBounds();
+  const int radius = GetAeroRadius();
+  const SkColor line = colors->GetColor(kColorToolbarSeparator);
+  const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+
+  if (pinned && !active) {
+    // Grid cell: faint fill (pixelized: surface), outline is the view border.
+    flags.setColor(pixelized ? colors->GetColor(ui::kColorSysSurface)
+                             : SkColorSetARGB(0x05, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(bounds, radius, flags);
+  }
+
+  if (active) {
+    if (pixelized) {
+      flags.setColor(colors->GetColor(ui::kColorFrameActive));
+      canvas->DrawRoundRect(bounds, radius, flags);
+      canvas->DrawImageInt(GetAeroRamp(), 0, 0, kAeroRampWidth,
+                           kAeroRampHeight,
+                           std::max(0, bounds.width() - kAeroRampWidth), 0,
+                           std::min(bounds.width(), kAeroRampWidth),
+                           kAeroRampHeight, /*filter=*/false);
+      // Chips: name and close button never sit on the texture.
+      flags.setColor(colors->GetColor(ui::kColorFrameActive));
+      for (const views::View* child : tab.children()) {
+        if (!child->GetVisible()) {
+          continue;
+        }
+        gfx::Rect chip;
+        if (const auto* label = views::AsViewClass<views::Label>(child)) {
+          chip = label->bounds();
+          chip.set_width(
+              std::min(chip.width(), label->GetPreferredSize().width()));
+          chip.Outset(gfx::Outsets::VH(kAeroChipPaddingV, kAeroChipPaddingH));
+        } else if (views::IsViewClass<TabCloseButton>(child)) {
+          chip = child->bounds();
+        } else {
+          continue;
+        }
+        chip.Intersect(bounds);
+        canvas->DrawRect(chip, flags);
+      }
+      cc::PaintFlags stroke;
+      stroke.setAntiAlias(true);
+      stroke.setStyle(cc::PaintFlags::kStroke_Style);
+      stroke.setStrokeWidth(1);
+      stroke.setColor(accent);
+      gfx::RectF outline(bounds);
+      outline.Inset(0.5f);
+      canvas->DrawRoundRect(outline, radius, stroke);
+    } else {
+      flags.setShader(gfx::CreateGradientShader(
+          gfx::Point(0, 0), gfx::Point(0, bounds.height()),
+          SkColorSetARGB(0x24, 0x6C, 0xB6, 0xFF),
+          SkColorSetARGB(0xC7, 0x0A, 0x10, 0x20)));
+      canvas->DrawRoundRect(bounds, radius, flags);
+      flags.setShader(nullptr);
+      // 1px outline on top and sides only.
+      flags.setColor(line);
+      canvas->DrawRect(gfx::Rect(0, 0, bounds.width(), 1), flags);
+      canvas->DrawRect(gfx::Rect(0, 0, 1, bounds.height()), flags);
+      canvas->DrawRect(
+          gfx::Rect(bounds.width() - 1, 0, 1, bounds.height()), flags);
+      // Accent bar on top, inset 8px.
+      flags.setColor(accent);
+      canvas->DrawRect(
+          gfx::Rect(kAeroIndicatorInset, 0,
+                    std::max(0, bounds.width() - 2 * kAeroIndicatorInset),
+                    kAeroIndicatorHeight),
+          flags);
+    }
+  } else if (hovered) {
+    flags.setColor(colors->GetColor(
+        pinned ? kColorToolbarInkDropHover
+               : kColorTabBackgroundInactiveHoverFrameActive));
+    canvas->DrawRoundRect(bounds, radius, flags);
+  }
+
+  if (pinned) {
+    // Live pinned marker: 6x6 accent square at the top right corner.
+    flags.setColor(accent);
+    canvas->DrawRoundRect(
+        gfx::Rect(bounds.width() - kAeroMarkerInset - kAeroMarkerSize,
+                  kAeroMarkerInset, kAeroMarkerSize, kAeroMarkerSize),
+        pixelized ? 0 : 1, flags);
+  }
+}
