+
+// aerographene: sidebar background of the mockups R-r01a: default = subtle
+// vertical gradient, pixelized = flat #111; 1px right border in the theme
+// line color (left when the strip is on the right). Opaque, no corners.
+// Painted from OnPaintBackground: the view keeps its (hidden)
+// CustomCornersBackground because BrowserViewTabbedLayoutImpl requires it.
+void PaintAerographeneSidebar(gfx::Canvas* canvas,
+                              views::View* view,
+                              bool right_aligned) {
+  const ui::ColorProvider* const colors = view->GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const gfx::Rect bounds = view->GetLocalBounds();
+  cc::PaintFlags flags;
+  if (aerographene::GetBuiltinTheme() ==
+      aerographene::BuiltinTheme::kPixelized) {
+    flags.setColor(colors->GetColor(ui::kColorSysSurface));
+  } else {
+    flags.setShader(gfx::CreateGradientShader(
+        gfx::Point(0, 0), gfx::Point(0, bounds.height()),
+        SkColorSetRGB(0x08, 0x0E, 0x1C), SkColorSetRGB(0x05, 0x09, 0x12)));
+  }
+  canvas->DrawRect(bounds, flags);
+
+  cc::PaintFlags line;
+  line.setColor(colors->GetColor(kColorToolbarSeparator));
+  const int x = right_aligned ? 0 : bounds.width() - 1;
+  canvas->DrawRect(gfx::Rect(x, 0, 1, bounds.height()), line);
+}
 }  // namespace
 
