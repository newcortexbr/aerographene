+#ifndef COMPONENTS_HISTORY_CORE_BROWSER_COLD_HISTORY_DATABASE_H_
+#define COMPONENTS_HISTORY_CORE_BROWSER_COLD_HISTORY_DATABASE_H_
+
+#include <optional>
