+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "components/history/core/browser/cold_history_database.h"
+
+#include <tuple>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "components/database_utils/url_converter.h"
+#include "sql/recovery.h"
+#include "sql/statement.h"
+#include "sql/transaction.h"
+#include "url/gurl.h"
+
+namespace history {
+
+namespace {
+
+constexpr int kColdVersionNumber = 1;
+constexpr int kColdCompatibleVersionNumber = 1;
+
+}  // namespace
+
+ColdHistoryDatabase::ColdHistoryDatabase(const base::FilePath& path)
+    : path_(path),
+      db_(sql::DatabaseOptions().set_exclusive_locking(true).set_cache_size(
+              250),
+          // Reuses the History tag (the tag list is generated from the
+          // histogram metadata); only metrics are shared.
+          /*tag=*/"History") {}
+
+ColdHistoryDatabase::~ColdHistoryDatabase() = default;
+
+bool ColdHistoryDatabase::Exists() const {
+  return base::PathExists(path_);
+}
+
+bool ColdHistoryDatabase::Open(bool create) {
+  if (open_) {
+    return true;
+  }
+  if (failed_ || (!create && !Exists())) {
+    return false;
+  }
+  db_.set_error_callback(base::BindRepeating(
+      &ColdHistoryDatabase::OnDatabaseError, base::Unretained(this)));
+  if (!db_.Open(path_) || !InitTables()) {
+    LOG(ERROR) << "History-Cold unavailable: " << db_.GetErrorMessage();
+    db_.Close();
+    failed_ = true;
+    return false;
+  }
+  open_ = true;
+  return true;
+}
+
+bool ColdHistoryDatabase::InitTables() {
+  sql::Transaction transaction(&db_);
+  if (!transaction.Begin()) {
+    return false;
+  }
+  if (!meta_table_.Init(&db_, kColdVersionNumber,
+                        kColdCompatibleVersionNumber)) {
+    return false;
+  }
+  if (meta_table_.GetCompatibleVersionNumber() > kColdVersionNumber) {
+    return false;
+  }
+  if (!CreateURLTable(/*is_temporary=*/false) || !CreateMainURLIndex() ||
+      !InitKeywordSearchTermsTable() || !InitVisitTable()) {
+    return false;
+  }
+  return transaction.Commit();
+}
+
+void ColdHistoryDatabase::OnDatabaseError(int error, sql::Statement* stmt) {
+  // Corruption stays isolated here: the hot History is never touched. The
+  // handle is recovered (or razed by sql::Recovery if unrecoverable) and the
+  // cold store is disabled until the next session.
+  if (sql::Recovery::ShouldAttemptRecovery(&db_, error)) {
+    db_.reset_error_callback();
+    std::ignore = sql::Recovery::RecoverIfPossible(
+        &db_, error, sql::Recovery::Strategy::kRecoverWithMetaVersionOrRaze);
+    open_ = false;
+    failed_ = true;
+  }
+}
+
+sql::Database& ColdHistoryDatabase::GetDB() {
+  return db_;
+}
+
+bool ColdHistoryDatabase::BeginTransaction() {
+  return open_ && db_.BeginTransactionDeprecated();
+}
+
+bool ColdHistoryDatabase::CommitTransaction() {
+  return open_ && db_.CommitTransactionDeprecated();
+}
+
+void ColdHistoryDatabase::RollbackTransaction() {
+  if (open_) {
+    db_.RollbackTransactionDeprecated();
+  }
+}
+
+bool ColdHistoryDatabase::AddURLRowKeepingID(const URLRow& row) {
+  if (!open_) {
+    return false;
+  }
+  // INSERT OR IGNORE by URL: a URL lives in one row.
+  if (GetRowForURL(row.url(), nullptr)) {
+    return true;
+  }
+  sql::Statement statement(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "INSERT OR IGNORE INTO urls "
+      "(id, url, title, visit_count, typed_count, last_visit_time, hidden) "
+      "VALUES (?, ?, ?, ?, ?, ?, ?)"));
+  statement.BindInt64(0, row.id());
+  statement.BindString(1, database_utils::GurlToDatabaseUrl(row.url()));
+  statement.BindString16(2, row.title());
+  statement.BindInt(3, row.visit_count());
+  statement.BindInt(4, row.typed_count());
+  statement.BindTime(5, row.last_visit());
+  statement.BindBool(6, row.hidden());
+  return statement.Run();
+}
+
+bool ColdHistoryDatabase::AddVisitRowKeepingID(const VisitRow& visit) {
+  if (!open_) {
+    return false;
+  }
+  sql::Statement statement(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "INSERT OR IGNORE INTO visits "
+      "(id, url, visit_time, from_visit, external_referrer_url, transition, "
+      "segment_id, visit_duration, incremented_omnibox_typed_score,"
+      "opener_visit, originator_cache_guid, originator_visit_id, "
+      "originator_from_visit, originator_opener_visit, is_known_to_sync, "
+      "consider_for_ntp_most_visited, visited_link_id, app_id) "
+      "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)"));
+  statement.BindInt64(0, visit.visit_id);
+  statement.BindInt64(1, visit.url_id);
+  statement.BindTime(2, visit.visit_time);
+  statement.BindInt64(3, visit.referring_visit);
+  statement.BindString(4, visit.external_referrer_url.spec());
+  statement.BindInt64(5, visit.transition);
+  statement.BindInt64(6, visit.segment_id);
+  statement.BindTimeDelta(7, visit.visit_duration);
+  statement.BindBool(8, visit.incremented_omnibox_typed_score);
+  statement.BindInt64(9, visit.opener_visit);
+  statement.BindString(10, visit.originator_cache_guid);
+  statement.BindInt64(11, visit.originator_visit_id);
+  statement.BindInt64(12, visit.originator_referring_visit);
+  statement.BindInt64(13, visit.originator_opener_visit);
+  statement.BindBool(14, visit.is_known_to_sync);
+  statement.BindBool(15, visit.consider_for_ntp_most_visited);
+  statement.BindInt64(16, visit.visited_link_id);
+  statement.BindString(17, visit.app_id ? *visit.app_id : "");
+  if (!statement.Run()) {
+    return false;
+  }
+
+  const VisitSource source = visit.source.value_or(SOURCE_BROWSED);
+  if (source == SOURCE_BROWSED) {
+    return true;
+  }
+  sql::Statement source_statement(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "INSERT OR IGNORE INTO visit_source (id, source) VALUES (?,?)"));
+  source_statement.BindInt64(0, visit.visit_id);
+  source_statement.BindInt64(1, source);
+  return source_statement.Run();
+}
+
+bool ColdHistoryDatabase::AddKeywordSearchTerm(
+    const KeywordSearchTermRow& row) {
+  if (!open_) {
+    return false;
+  }
+  sql::Statement exists(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "SELECT 1 FROM keyword_search_terms WHERE keyword_id = ? AND url_id = ?"));
+  exists.BindInt64(0, row.keyword_id);
+  exists.BindInt64(1, row.url_id);
+  if (exists.Step()) {
+    return true;
+  }
+  sql::Statement statement(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "INSERT INTO keyword_search_terms "
+      "(keyword_id, url_id, term, normalized_term) VALUES (?,?,?,?)"));
+  statement.BindInt64(0, row.keyword_id);
+  statement.BindInt64(1, row.url_id);
+  statement.BindString16(2, row.term);
+  statement.BindString16(3, row.normalized_term);
+  return statement.Run();
+}
+
+bool ColdHistoryDatabase::DeleteURLRowsByID(const std::set<URLID>& ids) {
+  if (!open_) {
+    return false;
+  }
+  bool ok = true;
+  for (URLID id : ids) {
+    sql::Statement statement(
+        db_.GetCachedStatement(SQL_FROM_HERE, "DELETE FROM urls WHERE id = ?"));
+    statement.BindInt64(0, id);
+    ok = statement.Run() && ok;
+    sql::Statement terms(db_.GetCachedStatement(
+        SQL_FROM_HERE, "DELETE FROM keyword_search_terms WHERE url_id = ?"));
+    terms.BindInt64(0, id);
+    ok = terms.Run() && ok;
+  }
+  return ok;
+}
+
+bool ColdHistoryDatabase::DeleteOrphans() {
+  return db_.Execute(
+             "DELETE FROM visit_source WHERE id NOT IN "
+             "(SELECT id FROM visits)") &&
+         db_.Execute(
+             "DELETE FROM urls WHERE id NOT IN (SELECT url FROM visits)") &&
+         db_.Execute(
+             "DELETE FROM keyword_search_terms WHERE url_id NOT IN "
+             "(SELECT id FROM urls)");
+}
+
+bool ColdHistoryDatabase::DeleteVisitsBetween(
+    const std::set<GURL>& urls,
+    const std::optional<std::string>& app_id,
+    base::Time begin,
+    base::Time end) {
+  if (!open_) {
+    return false;
+  }
+  if (end.is_null()) {
+    end = base::Time::Max();
+  }
+  if (!BeginTransaction()) {
+    return false;
+  }
+  bool ok = true;
+  auto delete_range = [&](std::optional<URLID> url_id) {
+    sql::Statement statement;
+    if (url_id) {
+      statement.Assign(db_.GetUniqueStatement(
+          "DELETE FROM visits WHERE visit_time >= ? AND visit_time < ? "
+          "AND (? = 0 OR app_id = ?) AND url = ?"));
+    } else {
+      statement.Assign(db_.GetUniqueStatement(
+          "DELETE FROM visits WHERE visit_time >= ? AND visit_time < ? "
+          "AND (? = 0 OR app_id = ?)"));
+    }
+    statement.BindTime(0, begin);
+    statement.BindTime(1, end);
+    statement.BindBool(2, app_id.has_value());
+    statement.BindString(3, app_id.value_or(std::string()));
+    if (url_id) {
+      statement.BindInt64(4, *url_id);
+    }
+    ok = statement.Run() && ok;
+  };
+  if (urls.empty()) {
+    delete_range(std::nullopt);
+  } else {
+    for (const GURL& url : urls) {
+      if (URLID id = GetRowForURL(url, nullptr)) {
+        delete_range(id);
+      }
+    }
+  }
+  ok = ok && DeleteOrphans();
+  if (!ok) {
+    RollbackTransaction();
+    return false;
+  }
+  return CommitTransaction();
+}
+
+bool ColdHistoryDatabase::DeleteURLsAndVisits(const std::set<GURL>& urls) {
+  if (!open_) {
+    return false;
+  }
+  if (!BeginTransaction()) {
+    return false;
+  }
+  bool ok = true;
+  for (const GURL& url : urls) {
+    URLID id = GetRowForURL(url, nullptr);
+    if (!id) {
+      continue;
+    }
+    sql::Statement statement(
+        db_.GetCachedStatement(SQL_FROM_HERE, "DELETE FROM visits WHERE url = ?"));
+    statement.BindInt64(0, id);
+    ok = statement.Run() && ok;
+  }
+  ok = ok && DeleteOrphans();
+  if (!ok) {
+    RollbackTransaction();
+    return false;
+  }
+  return CommitTransaction();
+}
+
+bool ColdHistoryDatabase::CloseAndDelete() {
+  db_.Close();
+  open_ = false;
+  return sql::Database::Delete(path_);
+}
+
