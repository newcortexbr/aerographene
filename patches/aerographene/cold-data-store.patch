+#include "sql/meta_table.h"
+
+class GURL;
+
+namespace history {
+
+// aerographene: "History-Cold", the per-profile database that receives the
+// urls/visits/keyword_search_terms rows the expirer moves out of the hot
+// History database (ADR 0007). Same schema as the hot tables (created by the
+// URLDatabase/VisitDatabase helpers), no compression, no size cap. Opened on
+// demand by its owner, never on the History open path. Rows keep the ids they
+// had in the hot database, so visits.url keeps pointing at urls.id. Lives on
+// the history backend sequence.
+class ColdHistoryDatabase : public URLDatabase, public VisitDatabase {
+ public:
+  explicit ColdHistoryDatabase(const base::FilePath& path);
+  ColdHistoryDatabase(const ColdHistoryDatabase&) = delete;
+  ColdHistoryDatabase& operator=(const ColdHistoryDatabase&) = delete;
+  ~ColdHistoryDatabase() override;
+
+  // Opens (creating if `create` and missing) and initializes the tables.
+  // Idempotent. Returns false if the database is unusable; after a failure the
+  // object stays closed for the rest of the session.
+  bool Open(bool create);
+  bool is_open() const { return open_; }
+  bool Exists() const;
+  const base::FilePath& path() const { return path_; }
+
+  bool BeginTransaction();
+  bool CommitTransaction();
+  void RollbackTransaction();
+
+  // Inserts keeping the hot id. Duplicates (same id, or same URL for urls) are
+  // ignored, so replaying a batch after a crash is harmless.
+  bool AddURLRowKeepingID(const URLRow& row);
+  bool AddVisitRowKeepingID(const VisitRow& visit);
+  bool AddKeywordSearchTerm(const KeywordSearchTermRow& row);
+
+  // Removes urls rows (and their keyword terms) by id, keeping visits. Used
+  // when a copied row turned out to stay in the hot database.
+  bool DeleteURLRowsByID(const std::set<URLID>& ids);
+
+  // User-initiated deletion. Removes visits in [begin, end) (null end = no
+  // limit), optionally only for `urls` and/or `app_id`, then urls without
+  // visits and orphaned keyword terms / visit sources.
+  bool DeleteVisitsBetween(const std::set<GURL>& urls,
+                           const std::optional<std::string>& app_id,
+                           base::Time begin,
+                           base::Time end);
+  // Removes the urls rows for `urls` and all their visits.
+  bool DeleteURLsAndVisits(const std::set<GURL>& urls);
+
+  // Closes the handle and deletes the file (and journals).
+  bool CloseAndDelete();
+
+ private:
+  // URLDatabase / VisitDatabase:
+  sql::Database& GetDB() override;
+
+  bool InitTables();
+  bool DeleteOrphans();
+  void OnDatabaseError(int error, sql::Statement* stmt);
+
+  const base::FilePath path_;
+  sql::Database db_;
+  sql::MetaTable meta_table_;
+  bool open_ = false;
+  bool failed_ = false;
+};
+
+}  // namespace history
+
+#endif  // COMPONENTS_HISTORY_CORE_BROWSER_COLD_HISTORY_DATABASE_H_
