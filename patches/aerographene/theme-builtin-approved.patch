+// Approved themes of theming/design-language (2026-10-14). Dark variants:
+// a theme is dark or light by nature, so each enters with its dark mockup.
+// Fonts are not bundled (as pixelized): a family missing from fontconfig
+// falls back to the system monospace (theme-font.patch).
+ThemeData MakeFlatTheme(const char* name,
+                        std::vector<ThemeToken> tokens,
+                        int radius,
+                        int radius_small,
+                        const char* font_family,
+                        int font_size_px,
+                        const char* icons_base) {
+  ThemeData theme;
+  theme.name = name;
+  theme.scheme = ThemeScheme::kDark;
+  theme.radius = radius;
+  theme.radius_small = radius_small;
+  theme.font_family = font_family;
+  theme.font_size_px = font_size_px;
+  theme.icons_base = icons_base;
+  theme.style = kStyleDefault;
+  theme.tokens = std::move(tokens);
+  return theme;
+}
+
+ThemeData MakeBuiltinTheme(std::string_view name) {
+  if (name == kThemePixelized) {
+    return MakePixelizedTheme();
+  }
+  // metro-v2: square corners; Selawik not bundled, system UI font.
