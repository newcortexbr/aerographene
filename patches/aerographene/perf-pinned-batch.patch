+  // Coalesces OnPinnedChanged(): while any batch is alive, changes only mark
+  // the model dirty; the outermost batch notifies once when it ends, if
+  // anything changed. Nests. The model itself is updated immediately, so
+  // reads inside the batch see every change; only observers wait.
+  class ScopedBatch {
+   public:
+    explicit ScopedBatch(PinnedModel* model);
+    ScopedBatch(const ScopedBatch&) = delete;
+    ScopedBatch& operator=(const ScopedBatch&) = delete;
+    ~ScopedBatch();
+
+   private:
+    raw_ptr<PinnedModel> model_;
+  };
