+TEST_F(PinnedModelTest, TopLevelIndexSkipsPlainFolders) {
+  // A folder under the space folder without the drawer flag is not an entry
+  // (GetPinned() leaves it out), so it has no top-level index either.
+  const BookmarkNode* plain = bookmarks_->AddFolder(SpaceFolder(), 0, u"P");
+  ASSERT_TRUE(plain);
+  auto a = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 1);
+  ASSERT_TRUE(a);
+  ASSERT_EQ(1u, model_->GetPinned().size());
+  EXPECT_EQ(-1, model_->GetTopLevelIndex(plain->uuid()));
+  EXPECT_EQ(0, model_->GetTopLevelIndex(*a));
+}
+
+TEST_F(PinnedModelTest, BatchNotifiesOnceAtOutermostEnd) {
+  CountingObserver observer;
+  model_->AddObserver(&observer);
+  std::optional<base::Uuid> a;
+  {
+    PinnedModel::ScopedBatch outer(model_.get());
+    a = model_->AddPinned(GURL("https://a.test/"), u"A", base::Uuid(), 0);
+    ASSERT_TRUE(a);
+    {
+      PinnedModel::ScopedBatch inner(model_.get());
+      EXPECT_TRUE(model_->SetOpen(*a, true));
+      model_->NotifyTabMappingChanged();
+    }
+    EXPECT_TRUE(model_->SetSpan(*a, 2));
+    // Reads inside the batch see the changes; observers do not yet.
+    EXPECT_TRUE(model_->IsOpen(*a));
+    EXPECT_EQ(0, observer.changed);
+  }
+  EXPECT_EQ(1, observer.changed);
+  {
+    // Nothing changed: no notification.
+    PinnedModel::ScopedBatch empty(model_.get());
+  }
+  EXPECT_EQ(1, observer.changed);
+  model_->SetSpan(*a, 3);
+  EXPECT_EQ(2, observer.changed);
+  model_->RemoveObserver(&observer);
+}
