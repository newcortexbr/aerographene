+PinnedModel::ScopedBatch::ScopedBatch(PinnedModel* model) : model_(model) {
+  ++model_->batch_depth_;
+}
+
+PinnedModel::ScopedBatch::~ScopedBatch() {
+  model_->EndBatch();
+}
+
+void PinnedModel::EndBatch() {
+  DCHECK_GT(batch_depth_, 0);
+  if (--batch_depth_ > 0 || !batch_dirty_) {
+    return;
+  }
+  batch_dirty_ = false;
+  NotifyChanged();
+}
+
 void PinnedModel::NotifyChanged() {
+  if (batch_depth_ > 0) {
+    batch_dirty_ = true;
+    return;
+  }
   for (Observer& observer : observers_) {
     observer.OnPinnedChanged();
   }
