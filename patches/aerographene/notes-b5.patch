+// --- B5: the browser watches the vault while this page exists and sends
+// "vaultChanged" (no path). The page re-lists the tree and compares the open
+// note's mtime with the one it opened; a clean note is reloaded, a dirty one
+// goes through the same conflict flow as saving (nothing is lost).
+let changeTimer = 0;
+let syncing = false;
+let resync = false;
+
+function onVaultChanged() {
+  clearTimeout(changeTimer);
+  changeTimer = setTimeout(syncExternal, 100);
+}
+listeners.set('vaultChanged', onVaultChanged);
+
+async function syncExternal() {
+  if (syncing) {
+    resync = true;
+    return;
+  }
+  syncing = true;
+  try {
+    clearImageCache();
+    await refreshTree();
+    if (search.value.trim().length >= 2) {
+      runSearch();
+    }
+    await checkOpenNote();
+  } finally {
+    syncing = false;
+    if (resync) {
+      resync = false;
+      onVaultChanged();
+    }
+  }
+}
+
+async function checkOpenNote() {
+  if (!current || !doc) {
+    return;
+  }
+  if (saving || !banner.hidden) {
+    needCheck = true;  // retried when the save ends / the banner closes
+    return;
+  }
+  const path = current;
+  let note;
+  try {
+    note = await send('readNote', path);
+  } catch (e) {
+    if (path === current && e === 'notFound') {
+      noteGone(path);
+    }
+    return;
+  }
+  if (path !== current || !doc || saving || !banner.hidden) {
+    needCheck = true;
+    return;
+  }
+  if (note.mtime === mtime || note.mtime === dismissedMtime) {
+    return;
+  }
+  goneNotified = '';
+  const dirty = doc.isDirty();
+  if (note.text === doc.getText()) {
+    // Same content on disk (touched, or saved elsewhere): just take the mtime.
+    mtime = note.mtime;
+    if (dirty) {
+      doc.markSaved();
+    }
+    updateState();
+    return;
+  }
+  if (!dirty) {
+    const top = editor.scrollTop;
+    showNote(path, note.text, note.mtime);
+    editor.scrollTop = top;
+    noteState.textContent = 'atualizado do disco';
+    return;
+  }
+  const kept = await resolveConflict(path, doc.getText());
+  if (!kept && current === path && doc && doc.isDirty()) {
+    dismissedMtime = note.mtime;  // do not ask again for this disk version
+  }
+}
+
+function noteGone(path) {
+  if (goneNotified === path) {
+    return;
+  }
+  goneNotified = path;
+  if (doc && doc.isDirty()) {
+    notice(`${baseName(path)} foi apagada ou renomeada no disco. ` +
