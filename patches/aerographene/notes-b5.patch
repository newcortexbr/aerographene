+async function runSearch() {
+  clearTimeout(searchTimer);
+  const q = search.value.trim();
+  const seq = ++searchSeq;
+  if (q.length < 2) {
+    results.hidden = true;
+    tree.hidden = false;
+    return;
+  }
+  tree.hidden = true;
+  results.hidden = false;
+  let r;
+  try {
+    r = await send('searchVault', q);
+  } catch (e) {
+    if (seq === searchSeq) {
+      message(results, 'busca indisponível');
+    }
+    return;
+  }
+  if (seq !== searchSeq) {
+    return;
+  }
+  results.replaceChildren();
+  for (const hit of r.hits) {
+    const row = document.createElement('div');
+    row.className = 'hit';
+    row.setAttribute('role', 'link');
+    row.tabIndex = 0;
+    const name = document.createElement('span');
+    name.className = 'hit-name';
+    name.textContent = baseName(hit.path);
+    row.append(name);
+    if (hit.path.includes('/')) {
+      const d = document.createElement('span');
+      d.className = 'hit-dir';
+      d.textContent = hit.path.slice(0, hit.path.lastIndexOf('/'));
+      row.append(d);
+    }
+    if (hit.snippet) {
+      const s = document.createElement('span');
+      s.className = 'hit-snippet';
+      s.textContent = hit.snippet;
+      row.append(s);
+    }
+    if (hit.path.toLowerCase().endsWith('.md')) {
+      row.addEventListener('click', () => requestOpen(hit.path));
+      row.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
