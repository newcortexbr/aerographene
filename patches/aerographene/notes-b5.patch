+#include "chrome/browser/ui/webui/aero_notes/vault_watcher.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "build/build_config.h"
+
+namespace aerographene::notes {
+
+VaultWatcher::VaultWatcher(const base::FilePath& root,
+                           base::RepeatingClosure changed,
+                           base::OnceCallback<void(bool)> started)
+    : real_root_(base::MakeAbsoluteFilePath(root)),
+      changed_(std::move(changed)) {
+  bool ok = false;
+  if (!real_root_.empty() && base::DirectoryExists(real_root_)) {
+    base::FilePathWatcher::WatchOptions options;
+    options.type = base::FilePathWatcher::Type::kRecursive;
+#if BUILDFLAG(IS_LINUX)
+    options.report_modified_path = true;
+#endif
+    ok = watcher_.WatchWithOptions(
+        real_root_, options,
+        base::BindRepeating(&VaultWatcher::OnPath, base::Unretained(this)));
+  }
+  std::move(started).Run(ok);
+}
+
+VaultWatcher::~VaultWatcher() = default;
+
+// static
+bool VaultWatcher::IsVisibleChange(const base::FilePath& real_root,
+                                   const base::FilePath& path) {
+  base::FilePath rel;
+  if (!real_root.AppendRelativePath(path, &rel)) {
+    return true;  // the root itself or an unexpected form: do not hide it
+  }
+  for (const base::FilePath::StringType& part : rel.GetComponents()) {
+    if (!part.empty() && part[0] == FILE_PATH_LITERAL('.')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void VaultWatcher::OnPath(const base::FilePath& path, bool error) {
+  if (error || IsVisibleChange(real_root_, path)) {
+    changed_.Run();
+  }
+}
+
+}  // namespace aerographene::notes
