+const IMAGE_EXT = /\.(png|jpe?g|gif|webp)$/i;
+
+// Path of a vault image from a Markdown source, or '' when it is not one
+// (URL with a scheme, absolute, protocol-relative, not an image extension).
+function vaultImagePath(src) {
+  if (/^([a-z][a-z0-9+.-]*:|\/|\\)/i.test(src)) {
+    return '';
+  }
+  let p = src.split(/[?#]/)[0];
+  try {
+    p = decodeURIComponent(p);
+  } catch (e) {
+    return '';
+  }
+  p = p.replace(/^(\.\/)+/, '');
+  return IMAGE_EXT.test(p) && !p.includes('\0') ? p : '';
+}
+
+function placeholder(alt) {
+  const s = el('span', `[imagem: ${alt}]`);
+  s.className = 'img-missing';
+  return s;
+}
+
+function image(src, alt, opts, width) {
+  const path = vaultImagePath(src);
+  if (!path || !opts || !opts.loadImage) {
+    return placeholder(alt || src);
+  }
+  const img = document.createElement('img');
+  img.alt = alt || path;
+  img.className = 'vault-img';
+  if (width) {
+    img.style.width = `${width}px`;
+  }
+  opts.loadImage(path, img, () => img.replaceWith(placeholder(alt || path)));
+  return img;
+}
+
+function embed(m, opts) {
+  const target = m[1].trim();
+  if (!vaultImagePath(target)) {
+    return el('span', `[nota embutida: ${target}]`);
+  }
+  const w = /^\d{1,4}$/.test((m[2] || '').trim()) ? Number(m[2]) : 0;
+  return image(target, target, opts, Math.min(w, 4000));
+}
+
 function wrap(tag, text, opts) {
   const e = el(tag);
   appendInline(e, text, opts);
