+  EXPECT_EQ(r.hits[0].path, "img.png");
+  EXPECT_TRUE(r.hits[0].name_match);
+}
+
+TEST_F(VaultSearchTest, BadQueries) {
+  EXPECT_TRUE(SearchVault(root_, "").hits.empty());
+  EXPECT_TRUE(SearchVault(root_, std::string(kMaxSearchQueryBytes + 1, 'a'))
+                  .hits.empty());
+  EXPECT_TRUE(SearchVault(root_, "\xff\xfe").hits.empty());
+  EXPECT_TRUE(SearchVault(root_, "zzzz-nao-existe").hits.empty());
+}
+
+TEST_F(VaultSearchTest, SnippetIsValidUtf8EvenWhenCutMidCharacter) {
+  // 60 two-byte characters before the match: the excerpt starts 40 bytes
+  // before it, inside a character unless the start is realigned.
+  std::string text;
+  for (int i = 0; i < 60; ++i) {
+    text += "\xc3\xa9";  // e acute
+  }
+  text += "alvo";
+  for (int i = 0; i < 200; ++i) {
+    text += "\xc3\xa9";
+  }
+  ASSERT_TRUE(base::WriteFile(root_.Append("utf.md"), text));
+  SearchResult r = SearchVault(root_, "alvo");
+  const SearchHit* h = Find(r, "utf.md");
+  ASSERT_TRUE(h);
+  EXPECT_TRUE(base::IsStringUTF8(h->snippet));
+  EXPECT_LE(h->snippet.size(), kMaxSnippetBytes);
+  EXPECT_NE(h->snippet.find("alvo"), std::string::npos);
+}
+
+TEST_F(VaultSearchTest, CapsHits) {
+  for (size_t i = 0; i < kMaxSearchHits + 20; ++i) {
+    ASSERT_TRUE(base::WriteFile(
+        root_.AppendASCII("many-" + base::NumberToString(i) + ".md"), "x"));
+  }
+  SearchResult r = SearchVault(root_, "many-");
+  EXPECT_EQ(r.hits.size(), kMaxSearchHits);
+  EXPECT_TRUE(r.truncated);
+}
+
+TEST_F(VaultSearchTest, DepthIsBounded) {
+  base::FilePath dir = root_;
+  for (size_t i = 0; i < kMaxSearchDepth + 3; ++i) {
+    dir = dir.AppendASCII("d");
+  }
+  ASSERT_TRUE(base::CreateDirectory(dir));
+  ASSERT_TRUE(base::WriteFile(dir.Append("deep.md"), "profundo"));
+  SearchResult r = SearchVault(root_, "profundo");
+  EXPECT_TRUE(r.hits.empty());
+  EXPECT_TRUE(r.truncated);
+}
+
+TEST_F(VaultSearchTest, FindsFileByName) {
+  ASSERT_TRUE(base::WriteFile(root_.Append("sub/Foto.PNG"), "png"));
+  EXPECT_EQ(FindVaultFileByName(root_, "img.png"), "img.png");
+  EXPECT_EQ(FindVaultFileByName(root_, "foto.png"), "sub/Foto.PNG");
+  EXPECT_FALSE(FindVaultFileByName(root_, "nao-existe.png"));
+  EXPECT_FALSE(FindVaultFileByName(root_, "sub/Foto.PNG"));
+  EXPECT_FALSE(FindVaultFileByName(root_, ".hidden.md"));
+  EXPECT_FALSE(FindVaultFileByName(root_, "secret.md"));  // only outside
+}
+
+TEST_F(VaultSearchTest, ReadsImagesConfined) {
+  std::optional<ImageContent> png = ReadVaultImage(root_, "img.png");
+  ASSERT_TRUE(png);
+  EXPECT_EQ(png->mime, "image/png");
+  EXPECT_EQ(png->bytes, "png");
+  ASSERT_TRUE(base::WriteFile(root_.Append("sub/p.JPG"), "jpg"));
+  ASSERT_TRUE(base::WriteFile(root_.Append("v.svg"), "<svg/>"));
+  EXPECT_EQ(ReadVaultImage(root_, "sub/p.JPG")->mime, "image/jpeg");
+  EXPECT_FALSE(ReadVaultImage(root_, "v.svg"));  // SVG is not served
+  EXPECT_FALSE(ReadVaultImage(root_, "a.md"));
+  EXPECT_FALSE(ReadVaultImage(root_, "../secret.md"));
+  EXPECT_FALSE(ReadVaultImage(root_, "missing.png"));
+  // Symlink to an image outside the vault is refused; inside it works.
+  ASSERT_TRUE(base::WriteFile(outer_.GetPath().Append("out.png"), "x"));
+  ASSERT_TRUE(base::CreateSymbolicLink(outer_.GetPath().Append("out.png"),
+                                       root_.Append("out.png")));
+  EXPECT_FALSE(ReadVaultImage(root_, "out.png"));
+  ASSERT_TRUE(base::CreateSymbolicLink(base::FilePath("img.png"),
+                                       root_.Append("in.png")));
+  EXPECT_TRUE(ReadVaultImage(root_, "in.png"));
+}
+
+TEST_F(VaultSearchTest, FifoImageDoesNotBlockAndHugeImageIsRefused) {
+  ASSERT_EQ(mkfifo(root_.Append("f.png").value().c_str(), 0600), 0);
+  EXPECT_FALSE(ReadVaultImage(root_, "f.png"));
+  const base::FilePath big = root_.Append("big.png");
+  base::File f(big, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+  ASSERT_TRUE(f.IsValid());
+  ASSERT_TRUE(f.SetLength(kMaxImageBytes + 1));
+  f.Close();
+  EXPECT_FALSE(ReadVaultImage(root_, "big.png"));
+}
