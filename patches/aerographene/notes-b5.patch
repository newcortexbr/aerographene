+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_WATCHER_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_WATCHER_H_
+
+#include "base/files/file_path.h"
+#include "base/files/file_path_watcher.h"
+#include "base/functional/callback.h"
+
+namespace aerographene::notes {
+
+// Recursive watch of the vault root (inotify on Linux) for the notes page
+// (B5). Lives and dies on one MayBlock sequence (use base::SequenceBound);
+// destroying it removes every watch, so it never outlives the tab's handler.
+// `changed` runs on that sequence for each change that is not under a hidden
+// (leading '.') path component, which also hides the editor's own
+// ".aero-N.tmp" files, ".git" and ".obsidian"; it carries no path: the page
+// re-lists and compares mtimes. `started` runs once with whether the watch
+// could be set up (false: bad root or inotify limit).
+class VaultWatcher {
+ public:
+  VaultWatcher(const base::FilePath& root,
+               base::RepeatingClosure changed,
+               base::OnceCallback<void(bool)> started);
+  VaultWatcher(const VaultWatcher&) = delete;
+  VaultWatcher& operator=(const VaultWatcher&) = delete;
+  ~VaultWatcher();
+
+  // False when `path` (inside `real_root`) has a hidden component.
+  static bool IsVisibleChange(const base::FilePath& real_root,
+                              const base::FilePath& path);
+
+ private:
+  void OnPath(const base::FilePath& path, bool error);
+
+  base::FilePath real_root_;
+  base::RepeatingClosure changed_;
+  base::FilePathWatcher watcher_;  // last: destroyed first
+};
+
+}  // namespace aerographene::notes
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_NOTES_VAULT_WATCHER_H_
