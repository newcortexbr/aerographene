+// args = [callback_id]. Replaces any earlier watcher; the reply says whether
+// the watch is running (false: no vault, unsupported system, or inotify limit).
+void NotesHandler::HandleWatchVault(const base::ListValue& args) {
+  if (args.size() != 1 || !FromNotesPage()) {
+    return;
+  }
+  AllowJavascript();
+  watcher_.Reset();
+  change_pending_ = false;
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  if (root.empty() || !kVaultReadSupported) {
+    ResolveJavascriptCallback(args[0], base::Value(false));
+    return;
+  }
+  // Both callbacks run on the watcher's sequence and are posted back here.
+  watcher_ = base::SequenceBound<VaultWatcher>(
+      base::ThreadPool::CreateSequencedTaskRunner(kIoTraits), root,
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &NotesHandler::OnVaultChanged, weak_ptr_factory_.GetWeakPtr())),
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&NotesHandler::OnWatchStarted,
+                         weak_ptr_factory_.GetWeakPtr(), args[0].Clone())));
+}
+
+void NotesHandler::OnWatchStarted(base::Value callback_id, bool ok) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!ok) {
+    watcher_.Reset();
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(ok));
+}
+
+void NotesHandler::OnVaultChanged() {
+  if (!IsJavascriptAllowed() || change_pending_) {
+    return;
+  }
+  change_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&NotesHandler::FlushVaultChanged,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kChangeWindow);
+}
+
+void NotesHandler::FlushVaultChanged() {
+  change_pending_ = false;
+  if (IsJavascriptAllowed() && watcher_) {
+    FireWebUIListener("vaultChanged");
+  }
+}
