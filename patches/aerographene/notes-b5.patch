+// --- B5: images embedded from the vault. The browser reads the file with the
+// same confinement as notes and answers {mime, data (base64)}; it becomes a
+// data: URL (img-src allows data: only). Cached per note folder + source.
+const imageCache = new Map();
+let imageCacheChars = 0;
+const IMAGE_CACHE_CHARS = 48 * 1024 * 1024;
+
+function loadImage(path, img, onFail) {
+  const dir = dirOf(current);
+  const key = `${dir}\0${path}`;
+  let entry = imageCache.get(key);
+  if (!entry) {
+    entry = {size: 0};
+    entry.url = send('readImage', path, dir).then(
+        (r) => `data:${r.mime};base64,${r.data}`, () => null);
+    imageCache.set(key, entry);
+    entry.url.then((u) => {
+      if (u && imageCache.get(key) === entry) {
+        entry.size = u.length;
+        imageCacheChars += u.length;
+        while (imageCacheChars > IMAGE_CACHE_CHARS && imageCache.size > 1) {
+          const [oldKey, old] = imageCache.entries().next().value;
+          imageCache.delete(oldKey);
+          imageCacheChars -= old.size;
+        }
+      }
+    });
+  }
+  entry.url.then((u) => {
+    if (u) {
+      img.src = u;
+    } else {
+      onFail();
+    }
+  });
+}
+
+function clearImageCache() {
+  imageCache.clear();
+  imageCacheChars = 0;
+}
+
+// --- B5: search by name and content (done in the browser, bounded there).
+let searchSeq = 0;
+let searchTimer = 0;
