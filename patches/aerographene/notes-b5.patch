+
+#include "chrome/browser/ui/webui/aero_notes/vault_watcher.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/run_loop.h"
+#include "base/task/bind_post_task.h"
+#include "base/threading/sequence_bound.h"
+#include "base/task/thread_pool.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene::notes {
+namespace {
+
+TEST(VaultWatcherTest, HiddenComponentsAreNotChanges) {
+  const base::FilePath root("/v");
+  EXPECT_TRUE(VaultWatcher::IsVisibleChange(root, base::FilePath("/v/a.md")));
+  EXPECT_TRUE(VaultWatcher::IsVisibleChange(root, base::FilePath("/v")));
+  EXPECT_TRUE(
+      VaultWatcher::IsVisibleChange(root, base::FilePath("/v/sub/b.md")));
+  EXPECT_FALSE(
+      VaultWatcher::IsVisibleChange(root, base::FilePath("/v/.aero-1.tmp")));
+  EXPECT_FALSE(
+      VaultWatcher::IsVisibleChange(root, base::FilePath("/v/.git/HEAD")));
+  EXPECT_FALSE(VaultWatcher::IsVisibleChange(
+      root, base::FilePath("/v/sub/.obsidian/x.json")));
+}
+
+void OnStarted(bool* out, base::OnceClosure quit, bool started) {
+  *out = started;
+  std::move(quit).Run();
+}
+
+class VaultWatcherLiveTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    root_ = dir_.GetPath();
+    ASSERT_TRUE(base::CreateDirectory(root_.Append("sub")));
+  }
+
+  // Starts the watcher and waits until it is armed.
+  void Start() {
+    base::RunLoop armed;
+    bool ok = false;
+    watcher_ = base::SequenceBound<VaultWatcher>(
+        base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()}), root_,
+        base::BindPostTaskToCurrentDefault(base::BindRepeating(
+            &VaultWatcherLiveTest::OnChanged, base::Unretained(this))),
+        base::BindPostTaskToCurrentDefault(
+            base::BindOnce(&OnStarted, &ok, armed.QuitClosure())));
+    armed.Run();
+    ASSERT_TRUE(ok);
+  }
+
+  void OnChanged() {
+    ++changes_;
+    if (quit_) {
+      std::move(quit_).Run();
+    }
+  }
+
+  void WaitForChange() {
+    base::RunLoop loop;
+    quit_ = loop.QuitClosure();
+    loop.Run();
+  }
+
+  base::test::TaskEnvironment env_{
+      base::test::TaskEnvironment::TimeSource::SYSTEM_TIME};
+  base::ScopedTempDir dir_;
+  base::FilePath root_;
+  base::SequenceBound<VaultWatcher> watcher_;
+  base::OnceClosure quit_;
+  int changes_ = 0;
+};
+
+TEST_F(VaultWatcherLiveTest, ReportsFileCreatedOutsideAndInSubfolder) {
+  Start();
+  ASSERT_TRUE(base::WriteFile(root_.Append("novo.md"), "x"));
+  WaitForChange();
+  EXPECT_GE(changes_, 1);
+  const int before = changes_;
+  ASSERT_TRUE(base::WriteFile(root_.Append("sub/fundo.md"), "y"));
+  WaitForChange();
+  EXPECT_GT(changes_, before);
+}
+
+TEST_F(VaultWatcherLiveTest, IgnoresHiddenFilesAndStopsAfterReset) {
+  ASSERT_TRUE(base::CreateDirectory(root_.Append(".git")));
+  Start();
+  ASSERT_TRUE(base::WriteFile(root_.Append(".git/obj"), "x"));
+  ASSERT_TRUE(base::WriteFile(root_.Append(".aero-1.tmp"), "x"));
+  base::RunLoop settle;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, settle.QuitClosure(), base::Milliseconds(300));
+  settle.Run();
+  EXPECT_EQ(changes_, 0);  // hidden changes were seen and dropped
+  // Destroying the holder removes the watch: nothing is reported afterwards.
+  watcher_.Reset();
+  env_.RunUntilIdle();
+  ASSERT_TRUE(base::WriteFile(root_.Append("depois.md"), "x"));
+  base::RunLoop wait;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, wait.QuitClosure(), base::Milliseconds(300));
+  wait.Run();
+  EXPECT_EQ(changes_, 0);
+}
+
+TEST_F(VaultWatcherLiveTest, FailsOnMissingRoot) {
+  base::RunLoop done;
+  bool ok = true;
+  watcher_ = base::SequenceBound<VaultWatcher>(
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()}),
+      root_.Append("nao-existe"), base::DoNothing(),
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&OnStarted, &ok, done.QuitClosure())));
+  done.Run();
+  EXPECT_FALSE(ok);
+}
