+// args = [callback_id, query]
+void NotesHandler::HandleSearchVault(const base::ListValue& args) {
+  const std::string* query = RelativeArg(args);  // same shape: id + string
+  if (!query || !FromNotesPage()) {
+    return;
+  }
+  AllowJavascript();
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  if (root.empty()) {
+    RejectJavascriptCallback(args[0], base::Value("noVault"));
+    return;
+  }
+  if (!kVaultReadSupported) {
+    RejectJavascriptCallback(args[0], base::Value("unsupported"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kIoTraits,
+      base::BindOnce(
+          [](base::FilePath root, std::string query) {
+            return SearchVault(root, query);
+          },
+          root, *query),
+      base::BindOnce(&NotesHandler::OnSearched, weak_ptr_factory_.GetWeakPtr(),
+                     args[0].Clone()));
+}
+
+void NotesHandler::OnSearched(base::Value callback_id, SearchResult result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::ListValue hits;
+  for (SearchHit& h : result.hits) {
+    base::DictValue item;
+    item.Set("path", std::move(h.path));
+    item.Set("nameMatch", h.name_match);
+    item.Set("snippet", std::move(h.snippet));
+    hits.Append(std::move(item));
+  }
+  base::DictValue reply;
+  reply.Set("hits", std::move(hits));
+  reply.Set("truncated", result.truncated);
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(reply)));
+}
+
+// args = [callback_id, path, note_dir]. Tries `note_dir + path` (relative to
+// the open note), then `path` from the vault root, then, for a bare file name,
+// the first file with that name anywhere in the vault (Obsidian embeds).
+void NotesHandler::HandleReadImage(const base::ListValue& args) {
+  if (args.size() != 3 || !args[1].is_string() || !args[2].is_string() ||
+      !FromNotesPage()) {
+    return;
+  }
+  AllowJavascript();
+  const base::FilePath root = prefs_->GetFilePath(kVaultPathPref);
+  if (root.empty() || !kVaultReadSupported) {
+    RejectJavascriptCallback(args[0], base::Value(root.empty()
+                                                      ? "noVault"
+                                                      : "unsupported"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kIoTraits,
+      base::BindOnce(
+          [](base::FilePath root, std::string path, std::string note_dir)
+              -> std::optional<ImageContent> {
+            if (!note_dir.empty()) {
+              if (std::optional<ImageContent> image =
+                      ReadVaultImage(root, note_dir + path)) {
+                return image;
+              }
+            }
+            if (std::optional<ImageContent> image =
+                    ReadVaultImage(root, path)) {
+              return image;
+            }
+            if (std::optional<std::string> found =
+                    FindVaultFileByName(root, path)) {
+              return ReadVaultImage(root, *found);
+            }
+            return std::nullopt;
+          },
+          root, args[1].GetString(), args[2].GetString()),
+      base::BindOnce(&NotesHandler::OnImage, weak_ptr_factory_.GetWeakPtr(),
+                     args[0].Clone()));
+}
+
+void NotesHandler::OnImage(base::Value callback_id,
+                           std::optional<ImageContent> image) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!image) {
+    RejectJavascriptCallback(callback_id, base::Value("notFound"));
+    return;
+  }
+  base::DictValue reply;
+  reply.Set("mime", std::move(image->mime));
+  reply.Set("data", base::Base64Encode(image->bytes));
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(reply)));
+}
