+
+#ifndef CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_SESSION_H_
+#define CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/process/process.h"
+#include "base/time/time.h"
+
+namespace aerographene {
+
+// One local shell attached to a pseudo terminal (Linux only). The browser
+// owns the master side; the child is a session leader with the slave as its
+// controlling terminal, in its own process group, with a clean environment.
+// Start() and Terminate() block (open, waitpid) and must run on a MayBlock
+// sequence; I/O on the master never blocks. Not exposed over Mojo yet
+// (fatia C3).
+class TerminalSession {
+ public:
+  struct Options {
+    Options();
+    Options(const Options&);
+    Options& operator=(const Options&);
+    ~Options();
+
+    // Program and arguments. Always chosen by the browser, never by the
+    // renderer. Empty means the user's login shell (DefaultShell()).
+    std::vector<std::string> argv;
+    // Working directory; empty means $HOME.
+    base::FilePath cwd;
+    uint16_t cols = 80;
+    uint16_t rows = 24;
+  };
+
+  // Upper bounds accepted by Start() and Resize().
+  static constexpr uint16_t kMaxCols = 1000;
+  static constexpr uint16_t kMaxRows = 1000;
+
+  // Returns nullptr when the pty or the child cannot be created.
+  static std::unique_ptr<TerminalSession> Start(const Options& options);
+
+  // Shell from the passwd entry, then $SHELL, then /bin/sh.
+  static std::string DefaultShell();
+
+  TerminalSession(const TerminalSession&) = delete;
+  TerminalSession& operator=(const TerminalSession&) = delete;
+
+  // Kills the process group (see Terminate()).
+  ~TerminalSession();
+
+  // Master side of the pty (O_CLOEXEC | O_NONBLOCK). Readers and writers
+  // should watch it with base::FileDescriptorWatcher; EIO means the slave
+  // side is closed.
+  int master_fd() const { return master_.get(); }
+  base::ProcessId pid() const { return process_.Pid(); }
+
+  // Writes as many bytes as the pty accepts now, never blocking (a program
+  // that does not read its input fills the pty buffer). Returns the number
+  // written (0 when the buffer is full: wait for writability), or nullopt on
+  // error or after Terminate().
+  std::optional<size_t> WriteSome(std::string_view bytes);
+
+  // TIOCSWINSZ on the master (the kernel sends SIGWINCH to the foreground
+  // group). False for out-of-range sizes or ioctl failure.
+  bool Resize(uint16_t cols, uint16_t rows);
+
+  // Sends SIGHUP to the whole process group, waits up to `grace` for the
+  // leader, then SIGKILLs the group and reaps the leader. Idempotent.
+  // Returns the leader's exit code when it was reaped.
+  std::optional<int> Terminate(base::TimeDelta grace = base::Seconds(1));
+
+ private:
+  TerminalSession(base::ScopedFD master, base::Process process);
+
+  base::ScopedFD master_;
+  base::Process process_;
+  bool terminated_ = false;
+};
+
+}  // namespace aerographene
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERO_TERMINAL_TERMINAL_SESSION_H_
