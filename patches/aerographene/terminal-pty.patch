+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_session.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pwd.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <utility>
+
+#include "base/environment.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/memory/ptr_util.h"
+#include "base/path_service.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/process/launch.h"
+#include "base/threading/platform_thread.h"
+
+namespace aerographene {
+
+namespace {
+
+constexpr char kFallbackShell[] = "/bin/sh";
+constexpr char kDefaultPath[] = "/usr/local/bin:/usr/bin:/bin";
+
+// Runs in the child between fork and exec: new session, pty as the
+// controlling terminal. Only async-signal-safe calls.
+class PtyPreExecDelegate : public base::LaunchOptions::PreExecDelegate {
+ public:
+  void RunAsyncSafe() override {
+    setsid();
+    ioctl(STDIN_FILENO, TIOCSCTTY, 0);
+  }
+};
+
+bool ValidSize(uint16_t cols, uint16_t rows) {
+  return cols > 0 && rows > 0 && cols <= TerminalSession::kMaxCols &&
+         rows <= TerminalSession::kMaxRows;
+}
+
+bool SetWindowSize(int fd, uint16_t cols, uint16_t rows) {
+  struct winsize ws = {};
+  ws.ws_col = cols;
+  ws.ws_row = rows;
+  return HANDLE_EINTR(ioctl(fd, TIOCSWINSZ, &ws)) == 0;
+}
+
+// True when the leader has exited (zombie, not yet reaped).
+bool LeaderExited(pid_t pid) {
+  siginfo_t info = {};
+  if (HANDLE_EINTR(waitid(P_PID, pid, &info, WEXITED | WNOHANG | WNOWAIT)) !=
+      0) {
+    return true;  // ECHILD: already reaped elsewhere.
+  }
+  return info.si_pid == pid;
+}
+
+}  // namespace
+
+TerminalSession::Options::Options() = default;
+TerminalSession::Options::Options(const Options&) = default;
+TerminalSession::Options& TerminalSession::Options::operator=(
+    const Options&) = default;
+TerminalSession::Options::~Options() = default;
+
+// static
+std::string TerminalSession::DefaultShell() {
+  if (const struct passwd* pw = getpwuid(getuid());
+      pw && pw->pw_shell && pw->pw_shell[0] == '/') {
+    return pw->pw_shell;
+  }
+  std::optional<std::string> shell = base::Environment::Create()->GetVar(
+      "SHELL");
+  if (shell && !shell->empty() && (*shell)[0] == '/') {
+    return *shell;
+  }
+  return kFallbackShell;
+}
+
+// static
+std::unique_ptr<TerminalSession> TerminalSession::Start(
+    const Options& options) {
+  if (!ValidSize(options.cols, options.rows)) {
+    return nullptr;
+  }
+
+  base::ScopedFD master(
+      HANDLE_EINTR(posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC)));
+  if (!master.is_valid()) {
+    PLOG(ERROR) << "posix_openpt";
+    return nullptr;
+  }
+  if (grantpt(master.get()) != 0 || unlockpt(master.get()) != 0) {
+    PLOG(ERROR) << "grantpt/unlockpt";
+    return nullptr;
+  }
+  // Never block the owning sequence on the master (see WriteSome()).
+  if (!base::SetNonBlocking(master.get())) {
+    PLOG(ERROR) << "O_NONBLOCK";
+    return nullptr;
+  }
+  char name[128];
+  if (ptsname_r(master.get(), name, sizeof(name)) != 0) {
+    PLOG(ERROR) << "ptsname_r";
+    return nullptr;
+  }
+  base::ScopedFD slave(HANDLE_EINTR(open(name, O_RDWR | O_NOCTTY | O_CLOEXEC)));
+  if (!slave.is_valid()) {
+    PLOG(ERROR) << "open pty slave";
+    return nullptr;
+  }
+  if (!SetWindowSize(master.get(), options.cols, options.rows)) {
+    PLOG(ERROR) << "TIOCSWINSZ";
+    return nullptr;
+  }
+
+  const std::string shell = DefaultShell();
+  std::vector<std::string> argv = options.argv;
+  if (argv.empty()) {
+    argv.push_back(shell);
+  }
+
+  base::FilePath home;
+  base::PathService::Get(base::DIR_HOME, &home);
+
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  base::LaunchOptions launch;
+  launch.clear_environment = true;
+  launch.environment["TERM"] = "xterm-256color";
+  launch.environment["COLORTERM"] = "truecolor";
+  launch.environment["HOME"] = home.value();
+  launch.environment["SHELL"] = shell;
+  launch.environment["PATH"] = env->GetVar("PATH").value_or(kDefaultPath);
+  // Display/session variables let clipboard tools (wl-copy, xclip) and
+  // TUI apps inside the terminal reach the user's desktop session.
+  for (const std::string name_var :
+       {"USER", "LOGNAME", "LANG", "LC_ALL", "WAYLAND_DISPLAY", "DISPLAY",
+        "XDG_RUNTIME_DIR", "XAUTHORITY", "XDG_SESSION_TYPE",
+        "DBUS_SESSION_BUS_ADDRESS"}) {
+    if (std::optional<std::string> v = env->GetVar(name_var)) {
+      launch.environment[name_var] = *v;
+    }
+  }
+  launch.current_directory = options.cwd.empty() ? home : options.cwd;
+  // sudo and other setuid tools need this; the terminal is the user's shell.
+  launch.allow_new_privs = true;
+  // Only the slave goes to the child; LaunchProcess closes every other fd.
+  launch.fds_to_remap.emplace_back(slave.get(), STDIN_FILENO);
+  launch.fds_to_remap.emplace_back(slave.get(), STDOUT_FILENO);
+  launch.fds_to_remap.emplace_back(slave.get(), STDERR_FILENO);
+  // setsid() in the child already creates a new process group whose id is
+  // the child's pid; new_process_group would make setsid() fail.
+  PtyPreExecDelegate delegate;
+  launch.pre_exec_delegate = &delegate;
+
+  base::Process process = base::LaunchProcess(argv, launch);
+  if (!process.IsValid()) {
+    LOG(ERROR) << "launch failed: " << argv[0];
+    return nullptr;
+  }
+  return base::WrapUnique(
+      new TerminalSession(std::move(master), std::move(process)));
+}
+
+TerminalSession::TerminalSession(base::ScopedFD master, base::Process process)
+    : master_(std::move(master)), process_(std::move(process)) {}
+
+TerminalSession::~TerminalSession() {
+  Terminate(base::Milliseconds(200));
+}
+
+std::optional<size_t> TerminalSession::WriteSome(std::string_view bytes) {
+  if (terminated_) {
+    return std::nullopt;
+  }
+  size_t done = 0;
+  while (done < bytes.size()) {
+    const ssize_t n = HANDLE_EINTR(
+        write(master_.get(), bytes.data() + done, bytes.size() - done));
+    if (n < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK) {
+        break;
+      }
+      return std::nullopt;
+    }
+    done += static_cast<size_t>(n);
+  }
+  return done;
+}
+
+bool TerminalSession::Resize(uint16_t cols, uint16_t rows) {
+  if (terminated_ || !ValidSize(cols, rows)) {
+    return false;
+  }
+  return SetWindowSize(master_.get(), cols, rows);
+}
+
+std::optional<int> TerminalSession::Terminate(base::TimeDelta grace) {
+  if (terminated_) {
+    return std::nullopt;
+  }
+  terminated_ = true;
+  const pid_t pid = process_.Pid();
+  // The leader is not reaped until the end, so `pid` (also the process group
+  // id) cannot be reused while we signal the group.
+  kill(-pid, SIGHUP);
+  kill(-pid, SIGCONT);
+  const base::TimeTicks deadline = base::TimeTicks::Now() + grace;
+  while (!LeaderExited(pid) && base::TimeTicks::Now() < deadline) {
+    base::PlatformThread::Sleep(base::Milliseconds(10));
+  }
+  kill(-pid, SIGKILL);
+  int code = -1;
+  std::optional<int> result;
+  if (process_.WaitForExit(&code)) {
+    result = code;
+  }
+  master_.reset();
+  return result;
+}
+
+}  // namespace aerographene
