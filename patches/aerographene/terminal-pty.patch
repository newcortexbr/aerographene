+// Copyright 2026 The aerographene Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/webui/aero_terminal/terminal_session.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include <string>
+
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerographene {
+namespace {
+
+// Reads the master until `needle` shows up, EOF/EIO, or timeout.
+std::string ReadUntil(int fd, std::string_view needle,
+                      base::TimeDelta timeout = base::Seconds(10)) {
+  std::string out;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + timeout;
+  while (out.find(needle) == std::string::npos) {
+    const int ms = (deadline - base::TimeTicks::Now()).InMilliseconds();
+    if (ms <= 0) {
+      break;
+    }
+    struct pollfd p = {fd, POLLIN, 0};
+    if (HANDLE_EINTR(poll(&p, 1, ms)) <= 0) {
+      break;
+    }
+    char buf[4096];
+    const ssize_t n = HANDLE_EINTR(read(fd, buf, sizeof(buf)));
+    if (n <= 0) {
+      break;  // EIO once the slave side is closed.
+    }
+    out.append(buf, static_cast<size_t>(n));
+  }
+  return out;
+}
+
+std::unique_ptr<TerminalSession> StartSh(const std::string& script,
+                                         uint16_t cols = 80,
+                                         uint16_t rows = 24) {
+  TerminalSession::Options o;
+  o.argv = {"/bin/sh", "-c", script};
+  o.cols = cols;
+  o.rows = rows;
+  return TerminalSession::Start(o);
+}
+
+TEST(TerminalSessionTest, EchoOk) {
+  auto s = StartSh("echo ok");
+  ASSERT_TRUE(s);
+  EXPECT_NE(ReadUntil(s->master_fd(), "ok").find("ok"), std::string::npos);
+  EXPECT_EQ(s->Terminate(), 0);
+}
+
+TEST(TerminalSessionTest, IsSessionLeaderWithControllingTty) {
+  // $$ is the shell pid: it must lead its own session and process group.
+  // /proc/<pid>/stat after "comm": state ppid pgrp session tty_nr ...
+  auto s = StartSh("tty; sed 's/.*) //' /proc/$$/stat; echo end");
+  ASSERT_TRUE(s);
+  const std::string pid = base::NumberToString(s->pid());
+  std::string out = ReadUntil(s->master_fd(), "end");
+  EXPECT_NE(out.find("/dev/pts/"), std::string::npos) << out;
+  // " <pgrp> <session> " must both equal the shell pid.
+  EXPECT_NE(out.find(" " + pid + " " + pid + " "), std::string::npos) << out;
+  s->Terminate();
+}
+
+TEST(TerminalSessionTest, InitialSizeAndResize) {
+  auto s = StartSh("stty size; read x; stty size; echo done", 100, 30);
+  ASSERT_TRUE(s);
+  EXPECT_NE(ReadUntil(s->master_fd(), "30 100").find("30 100"),
+            std::string::npos);
+  ASSERT_TRUE(s->Resize(132, 43));
+  ASSERT_EQ(s->WriteSome("\n"), 1u);
+  std::string out = ReadUntil(s->master_fd(), "done");
+  EXPECT_NE(out.find("43 132"), std::string::npos) << out;
+  s->Terminate();
+}
+
+TEST(TerminalSessionTest, RejectsBadSizes) {
+  EXPECT_FALSE(StartSh("true", 0, 24));
+  EXPECT_FALSE(StartSh("true", 80, TerminalSession::kMaxRows + 1));
+  auto s = StartSh("sleep 5");
+  ASSERT_TRUE(s);
+  EXPECT_FALSE(s->Resize(0, 10));
+  EXPECT_FALSE(s->Resize(TerminalSession::kMaxCols + 1, 10));
+  s->Terminate();
+}
+
+TEST(TerminalSessionTest, CleanEnvironment) {
+  setenv("AERO_SECRET_SHOULD_NOT_LEAK", "1", 1);
+  setenv("WAYLAND_DISPLAY", "aero-test-wl", 1);
+  auto s = StartSh(
+      "echo T=$TERM; echo W=$WAYLAND_DISPLAY;"
+      " echo L=${AERO_SECRET_SHOULD_NOT_LEAK-none}");
+  unsetenv("AERO_SECRET_SHOULD_NOT_LEAK");
+  unsetenv("WAYLAND_DISPLAY");
+  ASSERT_TRUE(s);
+  std::string out = ReadUntil(s->master_fd(), "L=");
+  out += ReadUntil(s->master_fd(), "\n", base::Seconds(2));
+  EXPECT_NE(out.find("T=xterm-256color"), std::string::npos) << out;
+  EXPECT_NE(out.find("W=aero-test-wl"), std::string::npos) << out;
+  EXPECT_NE(out.find("L=none"), std::string::npos) << out;
+  s->Terminate();
+}
+
+TEST(TerminalSessionTest, TerminateKillsWholeGroup) {
+  // The background child ignores SIGHUP; SIGKILL to the group must get it.
+  auto s = StartSh("trap '' HUP; sleep 100 & echo bg=$!; trap '' HUP; wait");
+  ASSERT_TRUE(s);
+  const pid_t pgid = s->pid();
+  std::string out = ReadUntil(s->master_fd(), "\n");
+  ASSERT_NE(out.find("bg="), std::string::npos) << out;
+  s->Terminate(base::Milliseconds(100));
+  // Orphans may be zombies briefly until init reaps them; poll.
+  bool gone = false;
+  for (int i = 0; i < 200 && !gone; ++i) {
+    gone = kill(-pgid, 0) != 0 && errno == ESRCH;
+    if (!gone) {
+      usleep(10000);
+    }
+  }
+  EXPECT_TRUE(gone);
+}
+
+TEST(TerminalSessionTest, WriteNeverBlocks) {
+  // `sleep` never reads its input: the pty buffer fills up and WriteSome()
+  // must return a short count instead of blocking, then 0.
+  auto s = StartSh("sleep 100");
+  ASSERT_TRUE(s);
+  const std::string chunk(1024 * 1024, 'x');
+  std::optional<size_t> n = s->WriteSome(chunk);
+  ASSERT_TRUE(n);
+  EXPECT_LT(*n, chunk.size());
+  EXPECT_EQ(s->WriteSome(chunk), 0u);
+  const base::TimeTicks start = base::TimeTicks::Now();
+  s->Terminate(base::Milliseconds(50));
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(5));
+}
+
+TEST(TerminalSessionTest, TerminateIsIdempotentAndBlocksIo) {
+  auto s = StartSh("sleep 100");
+  ASSERT_TRUE(s);
+  s->Terminate(base::Milliseconds(50));
+  EXPECT_EQ(s->Terminate(), std::nullopt);
+  EXPECT_EQ(s->WriteSome("x"), std::nullopt);
+  EXPECT_FALSE(s->Resize(80, 24));
+}
+
+}  // namespace
+}  // namespace aerographene
