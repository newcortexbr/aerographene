#!/bin/bash
# wrapper do aerographene: lê flags de /etc/aerographene-flags.conf e de
# ${XDG_CONFIG_HOME:-$HOME/.config}/aerographene-flags.conf (uma por linha; '#' e linhas vazias ignorados)
set -eu

flags=()
read_flags() {
  [ -r "$1" ] || return 0
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in ''|'#'*) continue ;; esac
    flags+=("$line")
  done < "$1"
}

read_flags /etc/aerographene-flags.conf
read_flags "${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/aerographene-flags.conf"

# o Chromium usa CHROME_DESKTOP para achar o .desktop (ícone, associação na barra)
export CHROME_DESKTOP=aerographene.desktop

exec "${AEROGRAPHENE_BIN:-/opt/aerographene/aerographene}" ${flags[@]+"${flags[@]}"} "$@"
