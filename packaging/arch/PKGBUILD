# Maintainer: newcortexbr
pkgname=aerographene
# pkgver = versão da release (tag v${pkgver}); packaging/build-native.sh passa AERO_PKGVER
pkgver=${AERO_PKGVER:-0.3.3}
pkgrel=1
_chromium=154.0.8037.97   # base do ungoogled-chromium; independente do pkgver
pkgdesc="Navegador baseado em ungoogled-chromium ${_chromium}"
arch=('x86_64')
url="https://github.com/newcortexbr/aerographene"
license=('GPL-3.0-only')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libcups' 'libxkbcommon' 'mesa'
         'dbus' 'at-spi2-core' 'cairo' 'pango' 'expat' 'libx11' 'libxcb' 'libxext'
         'libxcomposite' 'libxdamage' 'libxfixes' 'libxrandr' 'systemd-libs'
         'xdg-utils' 'ttf-liberation' 'hicolor-icon-theme')
# pixelized usa JetBrains Mono; sem ela cai na mono do sistema (theme-font.patch)
optdepends=('ttf-jetbrains-mono: fonte do tema pixelized')
options=('!strip' '!debug')
# O pacote sai do tarball compilado: packaging/build-native.sh coloca o tarball local no diretório com o
# nome abaixo (makepkg usa o arquivo presente e não baixa). Sem ele, baixa o asset do release.yml.
source=("${pkgname}-${pkgver}-x86_64_linux.tar.zst::${url}/releases/download/v${pkgver}/avx2-linux--${pkgname}-v${pkgver}.tar.zst"
        "${pkgname}.desktop"
        "${pkgname}-theme-import.desktop"
        "${pkgname}-mime.xml"
        "${pkgname}-wrapper"
        "initial_preferences"
        "LICENSE")
# AERO_TARBALL_SHA256 (calculado por build-native.sh) confere o tarball local; sem ele, SKIP
sha256sums=("${AERO_TARBALL_SHA256:-SKIP}" 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
noextract=("${pkgname}-${pkgver}-x86_64_linux.tar.zst")

prepare() {
  mkdir -p app
  # o tarball tem um diretório raiz aerographene-<versão>-<tag>-<sha>-x86_64_linux
  bsdtar -xf "${pkgname}-${pkgver}-x86_64_linux.tar.zst" -C app --strip-components=1
}

package() {
  install -d "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin"
  cp -a app/. "$pkgdir/opt/$pkgname/"
  # sandbox setuid (build/inner.sh copia out/Default/chrome_sandbox): o Chromium só o usa se for
  # root:root 4755 ao lado do binário; sem ele vale o sandbox de user namespaces do kernel
  if [ -f app/chrome-sandbox ]; then
    install -m4755 app/chrome-sandbox "$pkgdir/opt/$pkgname/chrome-sandbox"
  fi
  install -Dm755 "$pkgname-wrapper" "$pkgdir/usr/bin/aerographene"
  install -Dm644 initial_preferences "$pkgdir/opt/$pkgname/initial_preferences"
  install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  # .aerotheme: tipo MIME + entry oculta que chama --import-theme=%f (theme-import-cli.patch);
  # hooks do pacman rodam update-mime-database e update-desktop-database
  install -Dm644 "$pkgname-theme-import.desktop" \
    "$pkgdir/usr/share/applications/$pkgname-theme-import.desktop"
  install -Dm644 "$pkgname-mime.xml" "$pkgdir/usr/share/mime/packages/$pkgname.xml"
  # ícones hicolor gerados de branding/ (build/inner.sh os põe em icons/ no tarball)
  for n in 16 24 32 48 64 128 256; do
    install -Dm644 "app/icons/hicolor/${n}x${n}/apps/aerographene.png" \
      "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/$pkgname.png"
    # ícone do tipo .aerotheme = ícone do aerographene
    install -Dm644 "app/icons/hicolor/${n}x${n}/apps/aerographene.png" \
      "$pkgdir/usr/share/icons/hicolor/${n}x${n}/mimetypes/application-x-aerotheme.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
