#!/usr/bin/env python3
"""aero-poweroff: encerra os runners self-hosted do cezanne com aviso e reinicia (no Windows, por padrão).

Ordem:
  1. para as units dos runners ociosos (saem do pool na hora, não pegam job novo);
  2. para cada runner ocupado: acha o job pela API (runner_name), comenta no PR (ou no commit)
     da run e cancela a run (uma vez por run); para o Listener na hora; espera o Runner.Worker
     sair até --grace s; se não sair, force-cancel e SIGKILL no Worker e filhos;
     garantia final: se ainda houver Worker vivo, repete; se persistir, aborta sem reiniciar (rc 1);
  3. para containers docker ainda rodando;
  4. sync, BootNext = Windows Boot Manager (efibootmgr, só para o próximo boot), reboot.

Só stdlib + `gh` (logado como o dono dos runners) + systemctl/efibootmgr/docker.
Roda como root (reexecuta com sudo); chamadas ao gh rodam como o dono dos runners.

  aero-poweroff --dry-run          # mostra o que faria, sem efeito
  aero-poweroff                    # pede confirmação, cancela/comenta, para runners, reinicia no Windows
  aero-poweroff --yes --off        # sem confirmação; desliga em vez de reiniciar
  aero-poweroff --no-reboot        # só encerra os runners (usado também pelo down do WSL)
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

ROOT = os.environ.get("AERO_RUNNERS_DIR", "/home/dasher")
OWNER = os.environ.get("AERO_RUNNERS_USER", "dasher")
ORG = os.environ.get("AERO_RUNNERS_ORG", "newcortexbr")
HOST = os.uname().nodename
WINDOWS_LABEL = "Windows Boot Manager"
DRY = False


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def run(cmd, check=True, capture=True, effect=False):
    """effect=True: comando com efeito colateral; em --dry-run só é mostrado."""
    if effect and DRY:
        log("(dry-run) " + " ".join(cmd))
        return ""
    p = subprocess.run(cmd, capture_output=capture, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} -> rc={p.returncode}: {(p.stderr or '').strip()[:300]}")
    return p.stdout if capture else ""


def gh(args, effect=False, data=None):
    cmd = ["runuser", "-u", OWNER, "--", "gh", "api"] + args
    if data is not None:
        for k, v in data.items():
            cmd += ["-f", f"{k}={v}"]
    out = run(cmd, effect=effect)
    return json.loads(out) if out.strip() else None


# --- runners locais

def runners():
    """lista de {n, dir, name, unit} a partir de actions-runner-N/.runner e .service."""
    out = []
    for d in sorted(glob.glob(os.path.join(ROOT, "actions-runner-*"))):
        m = re.search(r"actions-runner-(\d+)$", d)
        if not m:
            continue
        try:
            with open(os.path.join(d, ".runner"), encoding="utf-8-sig") as f:
                name = json.load(f)["agentName"]
            with open(os.path.join(d, ".service")) as f:
                unit = f.read().strip()
        except (OSError, KeyError, ValueError):
            continue
        out.append({"n": int(m.group(1)), "dir": d, "name": name, "unit": unit})
    return out


def workers():
    """n -> pid dos Runner.Worker ativos (mesmo critério do aero-top e do cpu-quota-manager)."""
    found = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read(300).split(b"\0")[0].decode("utf-8", "replace")
        except OSError:
            continue
        if cmd.endswith("/Runner.Worker"):
            m = re.search(r"actions-runner-(\d+)/", cmd)
            if m:
                found[int(m.group(1))] = int(pid)
    return found


def unit_active(unit):
    return run(["systemctl", "is-active", unit], check=False).strip() in ("active", "activating", "deactivating")


def stop_unit(unit, kill_after=60):
    if not unit_active(unit):
        return
    run(["systemctl", "stop", "--no-block", unit], effect=True)
    if DRY:
        return
    t0 = time.time()
    while unit_active(unit) and time.time() - t0 < kill_after:
        time.sleep(1)
    if unit_active(unit):
        log(f"{unit} não parou em {kill_after}s; SIGKILL")
        run(["systemctl", "kill", "-s", "SIGKILL", unit], check=False, effect=True)


def kill_worker(r, pid):
    """mata Worker e filhos: KillMode=process deixa o Worker fora do stop da unit."""
    log(f"{r['name']}: matando Runner.Worker pid {pid} e filhos")
    run(["systemctl", "kill", "--kill-whom=all", "-s", "SIGKILL", r["unit"]], check=False, effect=True)
    if DRY:
        return
    for p in [pid] + children(pid):  # fallback se o Worker estiver fora do cgroup da unit
        try:
            os.kill(p, 9)
        except OSError:
            pass


def children(pid):
    out = run(["pgrep", "-P", str(pid)], check=False).split()
    kids = [int(x) for x in out]
    return kids + [g for k in kids for g in children(k)]


def handle_busy(busy, names_handled, grace):
    """comenta+cancela os jobs dos runners `busy`, para os Listeners, espera, força e mata Workers.
    Escolha: o Listener é parado logo após o cancel (KillMode=process mantém o Worker vivo para
    concluir o cancelamento), assim nenhum runner ocupado volta ao pool para pegar job novo."""
    jobs, ok = safe_busy_jobs({r["name"] for r in busy})
    if ok and not jobs:
        log("AVISO: Runner.Worker ativo mas nenhum job in_progress na API para esses runners")
    new = {k: v for k, v in jobs.items() if k not in names_handled}
    for rid, (repo, r, j) in new.items():
        notify_and_cancel(repo, r, j)
        names_handled.add(rid)
    for r in busy:
        log(f"{r['name']}: parando Listener {r['unit']} (Worker termina o cancelamento)")
        stop_unit(r["unit"])
    if DRY:
        return
    t0 = time.time()
    while time.time() - t0 < grace and any(r["n"] in workers() for r in busy):
        time.sleep(2)
    alive = workers()
    left = [r for r in busy if r["n"] in alive]
    if left:
        log(f"{len(left)} runner(s) ainda com Worker após {grace}s; force-cancel e kill")
        for repo, r, j in jobs.values():
            force_cancel(repo, r)
        if not ok:
            log("AVISO: API falhou; Workers serão mortos SEM comentário no PR/commit")
        for r in left:
            kill_worker(r, alive[r["n"]])
        time.sleep(2)


# --- jobs na API

def gh_lines(path):
    """GET paginado; devolve os itens (um JSON por linha via --jq)."""
    out = run(["runuser", "-u", OWNER, "--", "gh", "api", "--paginate", path[0], "--jq", path[1]])
    return [json.loads(l) for l in out.splitlines() if l.strip()]


def busy_jobs(names):
    """{run_id: (repo, run, job)} dos jobs in_progress num dos runners `names`.
    Só runs in_progress importam (queued não tem job rodando); dedup por run (matrix em 2 runners)."""
    found = {}
    repos = run(["runuser", "-u", OWNER, "--", "gh", "api", "--paginate",
                 f"/orgs/{ORG}/repos?per_page=100", "--jq", ".[].full_name"]).split()
    for repo in repos:
        for r in gh_lines((f"/repos/{repo}/actions/runs?status=in_progress&per_page=100", ".workflow_runs[]")):
            for j in gh_lines((f"/repos/{repo}/actions/runs/{r['id']}/jobs?per_page=100", ".jobs[]")):
                if j.get("status") == "in_progress" and j.get("runner_name") in names:
                    found.setdefault(r["id"], (repo, r, j))
    return found


def safe_busy_jobs(names):
    """busy_jobs sem derrubar o script: falha de API vira aviso e lista vazia."""
    try:
        return busy_jobs(names), True
    except (RuntimeError, ValueError, KeyError) as e:
        log(f"AVISO: consulta de jobs na API falhou ({e}); segue sem comentar/cancelar")
        return {}, False


def comment_body(r, j):
    when = time.strftime("%d/%m %H:%M")
    return (f"run [{r.get('name')} #{r.get('run_number')}]({r.get('html_url')}) cancelada em {when}: "
            f"o host `{HOST}` (runner `{j.get('runner_name')}`) está sendo desligado pelo dono para trocar "
            f"de sistema. não é falha do código; reexecute quando os runners voltarem a ficar online.")


def notify_and_cancel(repo, r, j):
    body = comment_body(r, j)
    prs = r.get("pull_requests") or []
    if prs:
        target = f"PR #{prs[0]['number']}"
        path = f"/repos/{repo}/issues/{prs[0]['number']}/comments"
    else:
        target = f"commit {r['head_sha'][:7]}"
        path = f"/repos/{repo}/commits/{r['head_sha']}/comments"
    log(f"{repo}: comentando em {target}: {body}")
    try:
        gh(["-X", "POST", path], effect=True, data={"body": body})
    except RuntimeError as e:
        log(f"AVISO: comentário falhou ({e}); segue o cancelamento")
    log(f"{repo}: cancelando run {r['id']} ({r.get('html_url')})")
    try:
        gh(["-X", "POST", f"/repos/{repo}/actions/runs/{r['id']}/cancel"], effect=True)
    except RuntimeError as e:
        log(f"AVISO: cancel falhou ({e})")


def force_cancel(repo, r):
    log(f"{repo}: force-cancel da run {r['id']}")
    try:
        gh(["-X", "POST", f"/repos/{repo}/actions/runs/{r['id']}/force-cancel"], effect=True)
    except RuntimeError as e:
        log(f"AVISO: force-cancel falhou ({e})")


# --- boot

def windows_bootnum():
    out = run(["efibootmgr"], check=False)
    for line in out.splitlines():
        m = re.match(r"Boot([0-9A-Fa-f]{4})\*?\s+(.*)", line)
        if m and m.group(2).startswith(WINDOWS_LABEL):
            return m.group(1)
    return None


def main():
    global DRY
    ap = argparse.ArgumentParser(description="encerra os runners com aviso e reinicia no Windows")
    ap.add_argument("--dry-run", action="store_true", help="só mostra o que faria")
    ap.add_argument("--yes", action="store_true", help="não pede confirmação")
    ap.add_argument("--grace", type=int, default=180, help="segundos esperando o job cancelado sair (180)")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--off", action="store_true", help="desliga em vez de reiniciar no Windows")
    g.add_argument("--no-reboot", action="store_true", help="só encerra os runners")
    a = ap.parse_args()
    DRY = a.dry_run

    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])

    rs = runners()
    if not rs:
        sys.exit(f"nenhum runner em {ROOT}/actions-runner-*")
    names = {r["name"] for r in rs}
    wk = workers()
    busy = [r for r in rs if r["n"] in wk]
    idle = [r for r in rs if r["n"] not in wk]
    dest = "nada (só runners)" if a.no_reboot else ("desligar" if a.off else "reiniciar no Windows")
    log(f"runners: {', '.join(r['name'] for r in rs)}; ocupados: {', '.join(r['name'] for r in busy) or 'nenhum'}; depois: {dest}")

    bootnum = None
    if not (a.no_reboot or a.off):
        bootnum = windows_bootnum()
        if not bootnum:
            sys.exit(f"entrada UEFI '{WINDOWS_LABEL}' não encontrada no efibootmgr; nada foi feito")
        log(f"entrada do Windows: Boot{bootnum}")

    if not a.yes and not DRY:
        ans = input(f"cancelar {len(busy)} job(s) com comentário, parar runners e {dest}? [s/N] ")
        if ans.strip().lower() not in ("s", "sim", "y", "yes"):
            sys.exit("abortado; nada foi feito")

    if not DRY:
        run(["wall", f"aero-poweroff: encerrando runners e {dest} em instantes"], check=False)

    # 1. ociosos saem do pool primeiro
    for r in idle:
        log(f"{r['name']}: ocioso, parando {r['unit']}")
        stop_unit(r["unit"])

    # 2. ocupados: comenta + cancela; para Listener; espera; força
    handled = set()
    if busy:
        handle_busy(busy, handled, a.grace)

    # um runner pode ter pego job entre a listagem e o stop: confere unidades de novo
    for r in rs:
        if unit_active(r["unit"]) and not DRY:
            log(f"{r['name']}: ainda ativo; parando")
            stop_unit(r["unit"])

    # 3. containers
    ids = run(["docker", "ps", "-q"], check=False).split()
    if ids:
        log(f"parando {len(ids)} container(s) docker")
        run(["docker", "stop", "-t", "20"] + ids, check=False, effect=True)

    # garantia final: nenhum Worker vivo antes de retornar/reiniciar
    for attempt in range(2):
        wk = workers()
        left = [r for r in rs if r["n"] in wk]
        if not left or DRY:
            break
        log(f"garantia final: Worker vivo em {', '.join(r['name'] for r in left)}")
        handle_busy(left, handled, a.grace)
    wk = {} if DRY else workers()
    if any(r["n"] in wk for r in rs):
        sys.exit(f"ERRO: Runner.Worker ainda vivo (pids {sorted(wk.values())}); {dest} ABORTADO")

    if a.no_reboot:
        log("runners encerrados")
        return
    run(["sync"], effect=True)
    if a.off:
        log("desligando")
        run(["systemctl", "poweroff"], effect=True)
    else:
        run(["efibootmgr", "--bootnext", bootnum], effect=True)
        log("reiniciando no Windows (só este boot; o padrão continua o Ubuntu)")
        run(["systemctl", "reboot"], effect=True)


if __name__ == "__main__":
    main()
