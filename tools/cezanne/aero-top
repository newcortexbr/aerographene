def make_charset(ascii_only=False):
    enc = (sys.stdout.encoding or locale.getpreferredencoding(False) or "").lower()
    utf8 = "utf" in enc and not ascii_only
    return Charset(utf8, os.environ.get("TERM", "") == "linux")


def init_colors():
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    rich = curses.COLORS >= 256
    # (fg 256, fg 8, bold8)
    spec = {
        "ok": (78, curses.COLOR_GREEN, 0), "warn": (221, curses.COLOR_YELLOW, 0),
        "crit": (203, curses.COLOR_RED, 0), "act": (51, curses.COLOR_CYAN, 0),
        "idle": (67, curses.COLOR_BLUE, 0), "dim": (243, curses.COLOR_BLACK, 1),
        "off": (240, curses.COLOR_BLACK, 1), "info": (75, curses.COLOR_CYAN, 0),
        "label": (110, curses.COLOR_WHITE, 0), "text": (252, curses.COLOR_WHITE, 0),
        "title": (255, curses.COLOR_WHITE, 1),
    }
    attrs = {}
    for i, (name, (f256, f8, bold)) in enumerate(spec.items(), 1):
        try:
            curses.init_pair(i, f256 if rich else f8, -1)
        except curses.error:
            curses.init_pair(i, f8, -1)
        a = curses.color_pair(i)
        if not rich and bold:
            a |= curses.A_BOLD
        if name == "title":
            a |= curses.A_BOLD
        attrs[name] = a
    return attrs


def blit(win, cv, attrs):
    for y in range(cv.h):
        x = 0
        while x < cv.w:
            a = cv.at[y][x]
            x2 = x
            while x2 < cv.w and cv.at[y][x2] == a:
                x2 += 1
            s = "".join(cv.ch[y][x:x2])
            if y == cv.h - 1 and x2 == cv.w:
                s = s[:-1]   # curses falha ao escrever a última célula
            if s.strip() or a != "text":
                try:
                    win.addstr(y, x, s, attrs.get(a, 0))
                except curses.error:
                    pass
            x = x2


def tui(stdscr, st, cs):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    attrs = init_colors()
    stdscr.timeout(1000)
    while True:
        st.tick()
        h, w = stdscr.getmaxyx()
        cv = Canvas(w, h)
        render(cv, st, cs)
        stdscr.erase()
        blit(stdscr, cv, attrs)
        stdscr.noutrefresh()
        curses.doupdate()
        k = stdscr.getch()
        if k in (ord("q"), ord("Q"), 27):
            return


def snapshot(size, ascii_only):
    st = Sampler()
    st.tick()
    time.sleep(0.6)
    st.tick()
    w, h = size
    cv = Canvas(w, h)
    render(cv, st, make_charset(ascii_only))
    print("\n".join(cv.rows()))


def main():
    ap = argparse.ArgumentParser(description="monitor TUI dos runners do cezanne")
    ap.add_argument("--once", action="store_true", help="renderiza um frame em texto e sai")
    ap.add_argument("--size", default=None, help="WxH para --once (padrão: terminal ou 80x24)")
    ap.add_argument("--ascii", action="store_true", help="só ASCII (bordas e barras)")
    a = ap.parse_args()
    locale.setlocale(locale.LC_ALL, "")
    if a.once:
        if a.size:
            w, h = map(int, a.size.lower().split("x"))
        else:
            ts = shutil.get_terminal_size((80, 24))
            w, h = ts.columns, ts.lines
        snapshot((w, h), a.ascii)
        return
    st = Sampler()
    try:
        curses.wrapper(tui, st, make_charset(a.ascii))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
