#!/usr/bin/env python3
"""aero-top: monitor TUI dos runners self-hosted do cezanne + recursos da máquina.

Só stdlib (curses). Camadas:
  - coleta: Sampler (rápido a cada tick, lento a cada SLOW_EVERY s)
  - render: render(canvas, state) desenha numa grade de caracteres+atributos
  - saída: blit para curses, ou texto puro com --once (usado em testes)
"""
import argparse
import curses
import glob
import locale
import math
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

SLOW_EVERY = 5.0
RUNNERS_ROOT = os.environ.get("AERO_RUNNERS_DIR", "/home/dasher")
DISK_RE = re.compile(r"^(sd[a-z]+|vd[a-z]+|nvme\d+n\d+)$")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
PAGE_TS_RE = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ?")
GHA_CMD_RE = re.compile(r"^##\[\w+\]")
RUNNING_RE = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)Z INFO Terminal\] WRITE LINE: \S+ \S+ Running job: (.*)$")
DONE_RE = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)Z INFO Terminal\] WRITE LINE: \S+ \S+ Job (.*) completed with result: (\w+)\s*$")
WORKER_NAME_RE = re.compile(r"Worker_(\d{8})-(\d{6})-utc\.log$")


# ---------------------------------------------------------------- utilitários

def read_file(path, default=""):
    try:
        with open(path, "r", errors="replace") as f:
            return f.read()
    except OSError:
        return default


def read_tail(path, nbytes=8192):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - nbytes))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def read_head(path, nbytes=200000):
    try:
        with open(path, "rb") as f:
            return f.read(nbytes).decode("utf-8", "replace")
    except OSError:
        return ""


def run_cmd(args, timeout=3):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def utc_to_epoch(s):
    """'2026-10-10 05:49:59' (UTC) -> epoch."""
    return datetime.strptime(s, "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc).timestamp()


def worker_start_epoch(path):
    m = WORKER_NAME_RE.search(path)
    if not m:
        return None
    return datetime.strptime(m.group(1) + m.group(2), "%Y%m%d%H%M%S").replace(tzinfo=timezone.utc).timestamp()


def parse_quota(s):
    """CPUQuotaPerSecUSec ('12s', '800ms', 'infinity') -> núcleos (float) ou None."""
    s = (s or "").strip()
    m = re.fullmatch(r"([\d.]+)(us|ms|s)", s)
    if not m:
        return None
    mult = {"us": 1e-6, "ms": 1e-3, "s": 1.0}[m.group(2)]
    return float(m.group(1)) * mult


def clean_log_line(raw):
    """Última linha útil de um trecho de log de step (timestamp/ANSI/##[cmd] removidos)."""
    for piece in reversed(re.split(r"[\r\n]+", raw)):
        t = ANSI_RE.sub("", piece)
        t = PAGE_TS_RE.sub("", t)
        t = GHA_CMD_RE.sub("", t).strip()
        if t:
            return t
    return ""


def parse_runner_log(text):
    """Extrai [(start_epoch|None, end_epoch|None, job, result|None)] de um Runner_*.log."""
    runs, cur = [], None
    for line in text.splitlines():
        if "WRITE LINE" not in line:
            continue
        m = RUNNING_RE.match(line)
        if m:
            if cur:
                runs.append(cur)
            cur = [utc_to_epoch(m.group(1)), None, m.group(2).strip(), None]
            continue
        m = DONE_RE.match(line)
        if m:
            end = utc_to_epoch(m.group(1))
            if cur:
                cur[1], cur[3] = end, m.group(3)
                runs.append(cur)
                cur = None
            else:
                runs.append([None, end, m.group(2).strip(), m.group(3)])
    if cur:
        runs.append(cur)
    return runs


def parse_worker_head(text):
    def g(pat):
        m = re.search(pat, text)
        return m.group(1) if m else ""
    return {
        "repo": g(r'"k":\s*"repository",\s*"v":\s*"([^"]+)"'),
        "workflow": g(r'"k":\s*"workflow",\s*"v":\s*"([^"]*)"'),
        "job": g(r'"jobDisplayName":\s*"([^"]*)"'),
    }


def fmt_dur(sec):
    if sec is None:
        return "-"
    sec = max(0, int(sec))
    if sec >= 3600:
        return "%dh%02dm" % (sec // 3600, sec % 3600 // 60)
    if sec >= 60:
        return "%dm%02ds" % (sec // 60, sec % 60)
    return "%ds" % sec


def fmt_bytes_rate(bps):
    mb = bps / 1048576.0
    return "%.1f MB/s" % mb if mb < 100 else "%.0f MB/s" % mb


def gib(kb):
    return kb / 1048576.0


# ------------------------------------------------------------------- coleta

class Sampler:
    def __init__(self):
        self.prev_cpu = None
        self.prev_disk = None
        self.prev_t = None
        self.slow_t = 0.0
        self.cpu = []          # [total, t0, t1...] em %
        self.mem = (0, 0)
        self.zram = (0, 0)
        self.swapd = (0, 0)
        self.io = {}           # nome -> (r_bps, w_bps)
        self.temp = None
        self.gpu = None
        self.load = (0, 0, 0)
        self.uptime = 0
        self.host = os.uname().nodename
        self.hwmon_temp = self._find_temp()
        self.runner_dirs = self._find_runners()
        self.units = {}        # n -> unit
        self.quota = {}        # n -> núcleos
        self.svc_state = {}    # n -> active/inactive...
        self.runs = []
        self.docker = {}       # n -> última linha do container
        self.head_cache = {}   # path -> info
        self.log_cache = {}    # (path,size,mtime) -> runs
        self.runners = []

    # --- descoberta
    def _find_runners(self):
        out = []
        for d in glob.glob(os.path.join(RUNNERS_ROOT, "actions-runner-*")):
            m = re.search(r"actions-runner-(\d+)$", d)
            if m and os.path.isdir(d):
                out.append((int(m.group(1)), d))
        return sorted(out)

    def _find_temp(self):
        for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            if read_file(d + "/name").strip() == "k10temp":
                return d + "/temp1_input"
        return None

    # --- rápido
    def tick(self):
        now = time.time()
        self._fast(now)
        if time.monotonic() - self.slow_t >= SLOW_EVERY:
            self.slow_t = time.monotonic()
            self._slow(now)
        self._runners(now)
        return self

    def _fast(self, now):
        # CPU
        cur = {}
        for line in read_file("/proc/stat").splitlines():
            if line.startswith("cpu"):
                p = line.split()
                v = list(map(int, p[1:9]))
                cur[p[0]] = (v[3] + v[4], sum(v))
        names = ["cpu"] + sorted((k for k in cur if k != "cpu"), key=lambda k: int(k[3:]))
        if self.prev_cpu:
            pct = []
            for k in names:
                i0, t0 = self.prev_cpu.get(k, cur[k])
                i1, t1 = cur[k]
                dt = t1 - t0
                pct.append(100.0 * (1 - (i1 - i0) / dt) if dt > 0 else 0.0)
            self.cpu = pct
        elif not self.cpu:
            self.cpu = [0.0] * len(names)
        self.prev_cpu = cur
        # memória
        mi = {}
        for line in read_file("/proc/meminfo").splitlines():
            k, _, v = line.partition(":")
            mi[k] = int(v.split()[0]) if v.split() else 0
        self.mem = (mi.get("MemTotal", 0) - mi.get("MemAvailable", 0), mi.get("MemTotal", 0))
        z = [0, 0]
        d = [0, 0]
        for line in read_file("/proc/swaps").splitlines()[1:]:
            p = line.split()
            if len(p) >= 4:
                t = z if p[0].startswith("/dev/zram") else d
                t[0] += int(p[3])
                t[1] += int(p[2])
        self.zram, self.swapd = tuple(z), tuple(d)
        # disco
        disk = {}
        for line in read_file("/proc/diskstats").splitlines():
            p = line.split()
            if len(p) > 9 and DISK_RE.match(p[2]):
                disk[p[2]] = (int(p[5]) * 512, int(p[9]) * 512)
        mono = time.monotonic()
        if self.prev_disk is not None and mono > self.prev_t:
            dt = mono - self.prev_t
            self.io = {k: (max(0, (v[0] - self.prev_disk.get(k, v)[0]) / dt),
                           max(0, (v[1] - self.prev_disk.get(k, v)[1]) / dt)) for k, v in disk.items()}
        self.prev_disk, self.prev_t = disk, mono
        # temperatura, load, uptime
        if self.hwmon_temp:
            try:
                self.temp = int(read_file(self.hwmon_temp).strip()) / 1000.0
            except ValueError:
                self.temp = None
        try:
            self.load = os.getloadavg()
        except OSError:
            pass
        try:
            self.uptime = float(read_file("/proc/uptime").split()[0])
        except (ValueError, IndexError):
            pass

    # --- lento (cada SLOW_EVERY s)
    def _slow(self, now):
        # units
        for n, d in self.runner_dirs:
            u = read_file(d + "/.service").strip()
            if not u:
                g = glob.glob("/etc/systemd/system/actions.runner.*-%d.service" % n)
                u = os.path.basename(g[0]) if g else ""
            self.units[n] = u
        units = [u for u in self.units.values() if u]
        if units:
            out = run_cmd(["systemctl", "show", "-p", "Id", "-p", "CPUQuotaPerSecUSec",
                           "-p", "ActiveState"] + units)
            info = {}
            for block in out.strip().split("\n\n"):
                kv = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
                if "Id" in kv:
                    info[kv["Id"]] = kv
            for n, u in self.units.items():
                kv = info.get(u, {})
                self.quota[n] = parse_quota(kv.get("CPUQuotaPerSecUSec"))
                self.svc_state[n] = kv.get("ActiveState", "?")
        # GPU
        self.gpu = None
        if shutil.which("nvidia-smi"):
            out = run_cmd(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
                           "--format=csv,noheader,nounits"]).strip().splitlines()
            if out:
                try:
                    p = [x.strip() for x in out[0].split(",")]
                    self.gpu = (p[0], float(p[1]), float(p[2]), float(p[3]), float(p[4]))
                except (ValueError, IndexError):
                    pass
        # histórico
        self._history()
        # docker (só se alguém estiver ativo)
        self.docker = {}
        if any(r.get("active") for r in self.runners) and shutil.which("docker"):
            out = run_cmd(["docker", "ps", "--no-trunc", "--format", "{{.ID}}|{{.Mounts}}"])
            for line in out.splitlines():
                cid, _, mounts = line.partition("|")
                for n, d in self.runner_dirs:
                    if d + "/_work" in mounts and n not in self.docker:
                        tail = run_cmd(["docker", "logs", "--tail", "3", cid], timeout=3)
                        # docker logs manda stderr junto com stdout só em 2>&1; ok perder stderr
                        l = clean_log_line(tail)
                        if l:
                            self.docker[n] = l

    def _worker_head(self, path):
        h = self.head_cache.get(path)
        if h is None:
            h = parse_worker_head(read_head(path))
            if h["repo"]:   # só cacheia quando já tem dados (log pode estar no começo)
                self.head_cache[path] = h
        return h

    def _history(self):
        runs = []
        for n, d in self.runner_dirs:
            diag = d + "/_diag"
            workers = sorted(glob.glob(diag + "/Worker_*.log"))
            wstarts = [(worker_start_epoch(w), w) for w in workers]
            wstarts = [(t, w) for t, w in wstarts if t]
            for path in sorted(glob.glob(diag + "/Runner_*.log"))[-8:]:
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                key = (path, st.st_size, int(st.st_mtime))
                if key not in self.log_cache:
                    self.log_cache[key] = parse_runner_log(read_file(path))
                for s, e, job, res in self.log_cache[key]:
                    repo = ""
                    wf = ""
                    if s:
                        for t, w in wstarts:
                            if s - 5 <= t <= s + 120:
                                h = self._worker_head(w)
                                repo, wf = h["repo"], h["workflow"]
                                break
                    runs.append({"n": n, "start": s, "end": e, "job": job, "result": res, "repo": repo, "workflow": wf})
        # dedup (mesmo run visto em 2 arquivos não ocorre, mas sessões reiniciadas sim)
        seen, uniq = set(), []
        for r in runs:
            k = (r["n"], r["start"], r["end"], r["job"])
            if k not in seen:
                seen.add(k)
                uniq.append(r)
        uniq.sort(key=lambda r: (r["start"] or r["end"] or 0))
        self.runs = uniq[-60:]
        # limita cache
        if len(self.log_cache) > 64:
            self.log_cache.clear()

    # --- runners (todo tick: só /proc + tail de arquivo pequeno)
    def _workers(self):
        """n -> pid dos Runner.Worker ativos."""
        found = {}
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                with open("/proc/%s/cmdline" % pid, "rb") as f:
                    cmd = f.read(300).split(b"\0")[0].decode("utf-8", "replace")
            except OSError:
                continue
            if cmd.endswith("/Runner.Worker"):
                m = re.search(r"actions-runner-(\d+)/", cmd)
                if m:
                    found[int(m.group(1))] = int(pid)
        return found

    def _runners(self, now):
        workers = self._workers()
        out = []
        for n, d in self.runner_dirs:
            r = {"n": n, "name": "runner-%d" % n, "quota": self.quota.get(n),
                 "svc": self.svc_state.get(n, "?"), "active": n in workers,
                 "job": "", "repo": "", "workflow": "", "started": None,
                 "log": "", "last": None}
            mine = [x for x in self.runs if x["n"] == n]
            finished = [x for x in mine if x["result"]]
            r["last"] = finished[-1] if finished else None
            r["failed"] = bool(mine) and not r["active"] and mine[-1]["result"] == "Failed"
            if r["active"]:
                diag = d + "/_diag"
                wl = sorted(glob.glob(diag + "/Worker_*.log"))
                if wl:
                    h = self._worker_head(wl[-1])
                    r["repo"], r["workflow"], r["job"] = h["repo"], h["workflow"], h["job"]
                    r["started"] = worker_start_epoch(wl[-1])
                cur = [x for x in mine if not x["result"] and x["start"]]
                if cur:
                    r["started"] = cur[-1]["start"]
                    r["job"] = r["job"] or cur[-1]["job"]
                r["log"] = self._live_line(n, diag, now)
            out.append(r)
        self.runners = out

    def _live_line(self, n, diag, now):
        pages = glob.glob(diag + "/pages/*.log")
        line, age = "", None
        if pages:
            try:
                p = max(pages, key=os.path.getmtime)
                age = now - os.path.getmtime(p)
                raw = read_tail(p, 8192)
                if not raw.endswith(("\n", "\r")):   # runner descarrega em blocos: a última linha pode estar pela metade
                    raw = raw.rsplit("\n", 1)[0] if "\n" in raw else ""
                line = clean_log_line(raw)
            except OSError:
                pass
        dk = self.docker.get(n)
        if dk and (not line or (age is not None and age > SLOW_EVERY)):
            return dk
        return line or "iniciando…"


# ------------------------------------------------------------------- canvas

class Canvas:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.ch = [[" "] * w for _ in range(h)]
        self.at = [["text"] * w for _ in range(h)]

    def put(self, y, x, s, attr="text"):
        if not (0 <= y < self.h):
            return
        for i, c in enumerate(s):
            if 0 <= x + i < self.w:
                self.ch[y][x + i] = c
                self.at[y][x + i] = attr

    def rows(self):
        return ["".join(r).rstrip() for r in self.ch]


class Charset:
    def __init__(self, utf8, linux):
        if utf8:
            self.tl, self.tr, self.bl, self.br, self.h, self.v = "┌┐└┘─│"
            self.full, self.empty = "█", "░"
            self.dot = "■" if linux else "●"
            self.ell = "~" if linux else "…"
        else:
            self.tl = self.tr = self.bl = self.br = "+"
            self.h, self.v = "-", "|"
            self.full, self.empty, self.dot, self.ell = "#", ".", "o", "~"


def trunc(s, n, cs):
    if n <= 0:
        return ""
    return s if len(s) <= n else (s[:n - 1] + cs.ell if n > 1 else s[:n])


def level(p):
    return "ok" if p < 50 else ("warn" if p < 80 else "crit")


def bar(cv, cs, y, x, w, frac, attr=None):
    if w <= 0:
        return
    frac = min(1.0, max(0.0, frac))
    n = int(round(frac * w))
    a = attr or level(frac * 100)
    cv.put(y, x, cs.full * n, a)
    cv.put(y, x + n, cs.empty * (w - n), "dim")


def labelled_bar(cv, cs, y, x, w, label, frac, suffix, attr=None):
    cv.put(y, x, label, "label")
    bw = w - len(label) - len(suffix) - 1
    bar(cv, cs, y, x + len(label), bw, frac, attr)
    cv.put(y, x + len(label) + bw + 1, suffix, "text")


def result_style(res):
    return {"Succeeded": ("Sucesso", "ok"), "Failed": ("Falhou", "crit"),
            "Canceled": ("Cancelado", "warn"), "Skipped": ("Ignorado", "dim")}.get(res, (res or "interrompido", "warn"))


def local_hm(epoch, fmt="%H:%M"):
    return datetime.fromtimestamp(epoch).strftime(fmt) if epoch else "--:--"


def runner_state(r):
    if r["svc"] not in ("active", "?") and not r["active"]:
        return "off", "offline", "off"
    if r["active"]:
        return "active", "ativo", "act"
    if r["failed"]:
        return "failed", "falhou", "crit"
    return "idle", "ocioso", "idle"


def draw_box(cv, cs, y, x, w, h, attr, title_parts):
    """title_parts: [(texto, attr)] embutido na borda superior."""
    cv.put(y, x, cs.tl + cs.h * (w - 2) + cs.tr, attr)
    cv.put(y + h - 1, x, cs.bl + cs.h * (w - 2) + cs.br, attr)
    for i in range(1, h - 1):
        cv.put(y + i, x, cs.v, attr)
        cv.put(y + i, x + w - 1, cs.v, attr)
    cx = x + 2
    for text, a in title_parts:
        cv.put(y, cx, text, a)
        cx += len(text)


def render(cv, st, cs, now=None):
    W, H = cv.w, cv.h
    now = now or time.time()
    if W < 60 or H < 10:
        cv.put(0, 0, "terminal pequeno (mín 80x24)", "crit")
        return
    # cabeçalho
    up = fmt_dur(st.uptime)
    head = " aero-top · %s · load %.2f %.2f %.2f · up %s · %s" % (
        st.host, st.load[0], st.load[1], st.load[2], up, datetime.fromtimestamp(now).strftime("%H:%M:%S"))
    cv.put(0, 0, head.ljust(W), "title")
    cv.put(0, W - 8, "q sai ", "title")
    y = 1
    # CPU total
    tot = st.cpu[0] if st.cpu else 0
    temp = "  %d°C" % round(st.temp) if st.temp is not None else ""
    suffix = "%3d%%%s" % (round(tot), temp)
    labelled_bar(cv, cs, y, 1, W - 2, "CPU ", tot / 100.0, suffix)
    y += 1
    # threads
    th = st.cpu[1:]
    cols = max(1, min(6, W // 24, len(th) or 1))
    rows = math.ceil(len(th) / cols) if th else 0
    cw = W // cols
    for i, p in enumerate(th):
        r, c = i % rows, i // rows
        x = c * cw + 1
        labelled_bar(cv, cs, y + r, x, cw - 2, "%2d " % i, p / 100.0, "%3d%%" % round(p))
    y += rows
    # memória / swap / gpu
    half = W // 2
    used, total = st.mem
    labelled_bar(cv, cs, y, 1, half - 2, "RAM  ", used / max(total, 1), "%.1f/%.1fG" % (gib(used), gib(total)))
    zu, zt = st.zram
    labelled_bar(cv, cs, y, half + 1, W - half - 2, "ZRAM ", zu / max(zt, 1), "%.1f/%.1fG" % (gib(zu), gib(zt)))
    y += 1
    su, stt = st.swapd
    labelled_bar(cv, cs, y, 1, half - 2, "SWAP ", su / max(stt, 1), "%.1f/%.1fG" % (gib(su), gib(stt)))
    if st.gpu:
        name, util, mu, mt, gt = st.gpu
        labelled_bar(cv, cs, y, half + 1, W - half - 2, "GPU  ", util / 100.0,
                     "%d%% %.0f/%.0fM %d°C" % (util, mu, mt, gt))
    else:
        cv.put(y, half + 1, "GPU  ", "label")
        cv.put(y, half + 6, trunc("RTX 3060 · nouveau: sem métricas", W - half - 7, cs), "dim")
    y += 1
    # I/O de disco
    rd = sum(v[0] for v in st.io.values())
    wr = sum(v[1] for v in st.io.values())
    cv.put(y, 1, "DISCO ", "label")
    cv.put(y, 7, "leit ", "dim")
    cv.put(y, 12, fmt_bytes_rate(rd).rjust(9), "info")
    cv.put(y, 22, "grav ", "dim")
    cv.put(y, 27, fmt_bytes_rate(wr).rjust(9), "info")
    per = "r/w " + "  ".join("%s %.0f/%.0f" % (k, v[0] / 1048576.0, v[1] / 1048576.0) for k, v in sorted(st.io.items()))
    cv.put(y, 38, trunc(per, W - 39, cs), "dim")
    y += 1
    # runners
    bh = 4
    for r in st.runners:
        if y + bh > H - 2:
            break
        key, label, attr = runner_state(r)
        q = r["quota"]
        qs = "%.1f núcleos" % q if q is not None else "sem limite"
        title = [(cs.dot + " ", attr), (r["name"], "title"), (" · " + label + " ", attr)]
        draw_box(cv, cs, y, 0, W, bh, attr, title)
        qx = W - len(qs) - 5
        cv.put(y, qx, " " + qs + " ", "info")
        iw = W - 4
        if key == "active":
            el = fmt_dur(now - r["started"]) if r["started"] else "-"
            bits = [b for b in (r["job"], r["repo"], r["workflow"].rsplit("/", 1)[-1]) if b]
            line1 = " · ".join(bits) + "  " + el
            cv.put(y + 1, 2, trunc(line1, iw, cs), "text")
            cv.put(y + 2, 2, trunc(r["log"], iw, cs), "act")
        else:
            la = r["last"]
            if la:
                rs, ra = result_style(la["result"])
                dur = fmt_dur(la["end"] - la["start"]) if la["start"] and la["end"] else "-"
                cv.put(y + 1, 2, "última: ", "dim")
                cv.put(y + 1, 10, rs, ra)
                rest = "  %s · %s · %s" % (local_hm(la["end"]), la["repo"] or la["job"], dur)
                cv.put(y + 1, 10 + len(rs), trunc(rest, iw - 8 - len(rs), cs), "dim")
            else:
                cv.put(y + 1, 2, "sem runs registradas", "dim")
            cv.put(y + 2, 2, "Nada rodando aqui", "dim")
        y += bh
    # runs recentes
    if y + 2 <= H:
        t = " runs recentes "
        cv.put(y, 0, cs.h * 2, "dim")
        cv.put(y, 2, t, "title")
        cv.put(y, 2 + len(t), cs.h * (W - 2 - len(t)), "dim")
        y += 1
        avail = H - y
        runs = sorted(st.runs, key=lambda r: r["start"] or r["end"] or 0, reverse=True)[:max(avail, 0)]
        for r in runs:
            running = not r["result"] and r["start"] and any(x["active"] and x["n"] == r["n"] for x in st.runners) \
                and r is [q for q in st.runs if q["n"] == r["n"]][-1]
            if running:
                rs, ra = "rodando", "act"
                dur = fmt_dur(now - r["start"])
            else:
                rs, ra = result_style(r["result"])
                dur = fmt_dur(r["end"] - r["start"]) if r["start"] and r["end"] else "-"
            when = local_hm(r["start"] or r["end"], "%d/%m %H:%M")
            what = " · ".join(b for b in (r["repo"], r["job"]) if b)
            cv.put(y, 1, when, "dim")
            cv.put(y, 13, "runner-%d" % r["n"], "label")
            cv.put(y, 22, trunc(what, W - 22 - 12 - 8 - 2, cs), "text")
            cv.put(y, W - 21, rs.rjust(12), ra)
            cv.put(y, W - 8, dur.rjust(7), "dim")
            y += 1


